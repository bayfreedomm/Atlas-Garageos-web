{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasgarageos.com/schemas/vehicle-fitment-record.schema.json",
  "title": "Atlas GarageOS vehicle fitment revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recordId", "revisionId", "make", "model", "generation",
    "market", "yearFrom", "yearTo", "tireSize", "wheelSize", "boltPattern",
    "lugCount", "fastenerType", "confidence", "sources", "observedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "revisionId": { "type": "string", "minLength": 8 },
    "supersedesRevisionId": { "type": "string", "minLength": 8 },
    "make": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "generation": { "type": "string", "minLength": 1 },
    "market": { "type": "string", "minLength": 2 },
    "yearFrom": { "type": "integer", "minimum": 1886, "maximum": 2200 },
    "yearTo": { "type": "integer", "minimum": 1886, "maximum": 2200 },
    "tireSize": { "type": "string", "pattern": "^[0-9]{3}/[0-9]{2,3}R[0-9]{2}$" },
    "wheelSize": { "type": "string", "minLength": 3 },
    "boltPattern": { "type": "string", "pattern": "^[3-8]x[0-9]+(?:\\.[0-9]+)?$" },
    "lugCount": { "type": "integer", "minimum": 3, "maximum": 8 },
    "centerBoreMm": { "type": "number", "exclusiveMinimum": 0 },
    "torqueNm": { "type": "number", "exclusiveMinimum": 0 },
    "fastenerType": { "enum": ["lug-nut", "wheel-bolt"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "reference", "checkedAt"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "checkedAt": { "type": "string", "format": "date-time" },
          "rawSnapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}

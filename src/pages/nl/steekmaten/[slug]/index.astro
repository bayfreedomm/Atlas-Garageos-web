---
// Localized bolt-pattern detail pages (nl): one page per row of boltPatternCatalog.
import { boltPatternImage } from '../../../../seo/entity-images';
import SiteLayout from '../../../../components/SiteLayout.astro';
import BoltPatternEntity from '../../../../components/BoltPatternEntity.astro';
import { boltPatternCatalog, type BoltPatternEntry } from '../../../../data/bolt-pattern-catalog';
import { boltPatternDetailMeta } from '../../../../ui/entity-page-model';
import BoltMakeBody from '../../../../components/BoltMakeBody.astro';
import { boltMakeMeta, boltMakes, type BoltMake } from '../../../../ui/bolt-make';

export function getStaticPaths() {
  return [
    ...boltPatternCatalog.map((entry) => ({ params: { slug: entry.slug }, props: { entry, make: undefined } })),
    ...boltMakes.map((make) => ({ params: { slug: make.makeSlug }, props: { entry: undefined, make } })),
  ];
}

interface Props { entry: BoltPatternEntry | undefined; make: BoltMake | undefined; }
const { entry, make } = Astro.props as Props;
const meta = entry ? boltPatternDetailMeta(entry, 'nl') : boltMakeMeta(make!, 'nl');
---
<SiteLayout title={meta.title} description={meta.description} pathname={meta.pathname} active="tools" locale="nl" alternates={meta.alternates} breadcrumbs={meta.breadcrumbs} image={entry ? boltPatternImage(entry, 'nl') : undefined}>
  {entry ? <BoltPatternEntity entry={entry} locale="nl" /> : <BoltMakeBody make={make!} locale="nl" />}
</SiteLayout>

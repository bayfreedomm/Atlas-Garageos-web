---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('power-to-weight-calculator');
const c = localizedTool('power-to-weight-calculator', 'nl');
---
<ToolPage {definition} locale="nl" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('power-to-weight-calculator')}>
  <form slot="tool" class="calculator-form" data-utility-calculator="power-weight" novalidate>
    <div class="utility-fields"><label>Vermogen<input name="power" type="number" value="180" min="0" step="any" inputmode="decimal" /></label><label>Vermogenseenheid<select name="powerUnit"><option value="hp">hp (mechanisch)</option><option value="kw">kW</option></select></label><label>Voertuiggewicht<input name="weight" type="number" value="1350" min="0" step="any" inputmode="decimal" /></label><label>Gewichtseenheid<select name="weightUnit"><option value="kg">kg</option><option value="lb">lb</option></select></label></div>
    <button type="submit">Vermogen-gewichtsverhouding berekenen</button>
    <UtilityResultStandard locale="nl" primaryLabel="Vermogen-gewichtsverhouding" pending="Vul het vermogen en het voertuiggewicht in." visualTitle="VERMOGEN ÷ MASSA = VERHOUDING" visualNote="Natuurkundige normalisatie, geen prestatiescore" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

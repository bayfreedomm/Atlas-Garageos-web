---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import WheelOffsetTechnicalVisual from '../../../../components/WheelOffsetTechnicalVisual.astro';
import EngineeringVisualStudio from '../../../../components/EngineeringVisualStudio.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('wheel-offset-calculator');
const c = localizedTool('wheel-offset-calculator', 'nl');
---
<ToolPage {definition} locale="nl" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/nl/tools/ruimte-in-wielkast-meten/" alternates={toolAlternates('wheel-offset-calculator')}>
  <form slot="tool" class="calculator-form" data-calculator="wheel-offset" novalidate>
    <div class="garage-quick-load" data-garage-quick-load data-gql-target="wheel-offset" data-gql-locale="nl" hidden></div>
    <div class="calculator-columns">
      <fieldset class="calculator-group"><legend>Originele velg</legend><div class="grid"><label>Breedte · J<input name="originalWidthInches" type="number" value="8" step="0.5" inputmode="decimal" /></label><label>ET (inpersdiepte)<input name="originalOffsetMm" type="number" value="40" inputmode="numeric" /></label></div></fieldset>
      <fieldset class="calculator-group"><legend>Nieuwe velg</legend><div class="grid"><label>Breedte · J<input name="newWidthInches" type="number" value="8.5" step="0.5" inputmode="decimal" /></label><label>ET (inpersdiepte)<input name="newOffsetMm" type="number" value="35" inputmode="numeric" /></label></div></fieldset>
    </div>
    <div class="form-actions"><button type="submit">Wielpositie vergelijken</button><button type="button" class="secondary" data-share-result>Deellink kopiëren</button></div>
    <div class="inline-errors" data-errors role="alert" hidden></div>
    <section class="wheel-primary-result is-pending" data-wheel-primary-result aria-live="polite" aria-label="Hoofdresultaat wielpositie">
      <div class="wheel-primary-result__answer">
        <span>Verschuiving buitenrand</span>
        <strong data-wheel-primary-outer>—</strong>
        <p data-wheel-primary-outer-copy>Vergelijk de velgen om te zien hoeveel de buitenrand verschuift.</p>
      </div>
      <div class="wheel-primary-result__inner">
        <span>Verschuiving binnenrand</span>
        <strong data-wheel-primary-inner>—</strong>
        <small data-wheel-primary-inner-copy>Laat zien hoeveel het wiel naar of van de wielophanging verschuift.</small>
      </div>
    </section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Je samenvatting van de wielpositie verschijnt hier.</p>
    <EngineeringVisualStudio mode="offset" locale="nl"><WheelOffsetTechnicalVisual locale="nl" /></EngineeringVisualStudio>
    <div class="wheel-detail-heading" aria-hidden="true"><span>Details</span><small>Statische wielgeometrie</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeShareableToolState } from '../../../../ui/shareable-tool-state'; import { initializeToolCalculators } from '../../../../ui/tool-calculators'; import { initializeGarageQuickLoad } from '../../../../ui/garage-quick-load'; initializeShareableToolState(); initializeToolCalculators(); initializeGarageQuickLoad();</script>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
import { vehicleMakes } from '../../../../data/vehicle-fitment';
import { indexedVehicleMakes } from '../../../../data/vehicle-model-index';
const definition = toolById('vehicle-fitment-finder');
const c = localizedTool('vehicle-fitment-finder', 'nl');
const makeCount = vehicleMakes().length;
const searchableMakeCount = new Set([...vehicleMakes(), ...indexedVehicleMakes()]).size;
---
<ToolPage {definition} locale="nl" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} alternates={toolAlternates('vehicle-fitment-finder')}>
  <form slot="tool" class="calculator-form" data-calculator="vehicle-finder" novalidate>
    <fieldset><legend>Voertuig</legend>
      <div class="utility-fields">
        <label>Merk<select name="make" data-vehicle-make></select></label>
        <label>Model<select name="model" data-vehicle-model disabled></select></label>
      </div>
    </fieldset>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Kies een merk en model om de referentiegegevens te zien.</p>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="vehicle-meta" data-vehicle-meta hidden>
      <span class="vehicle-confidence" data-vehicle-confidence></span>
      <p class="vehicle-sources" data-vehicle-sources></p>
      <p class="vehicle-notes" data-vehicle-notes hidden></p>
    </div>
    <div class="vehicle-actions" data-vehicle-actions hidden>
      <a class="studio-cta studio-cta--row" data-vehicle-tire-link data-base-href="/nl/tools/bandenmaat-calculator/"><span><small>Ingevuld met de gegevens van dit voertuig</small><strong>Openen in de bandenmaat-calculator</strong></span><i aria-hidden="true">›</i></a>
      <a class="studio-cta studio-cta--row" data-vehicle-bolt-link data-base-href="/nl/tools/steekmaat-calculator/"><span><small>Ingevuld met de gegevens van dit voertuig</small><strong>Openen in de steekmaat-calculator</strong></span><i aria-hidden="true">›</i></a>
    </div>
  </form>
  <div slot="explanation">
    {c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}
    <h2>Momenteel {makeCount} merken met gedocumenteerde Atlas-pasvormgegevens</h2>
    <p>Dit is een eerste selectie van veelvoorkomende voertuigen, geen volledige fabrieksdatabase — de lijst groeit met de tijd. Staat jouw exacte voertuig er nog niet tussen? De fabrieksspecificatie vind je op de sticker in de deurstijl aan de bestuurderskant of in het instructieboekje. Die kun je direct invullen in de <a href="/nl/tools/bandenmaat-calculator/">bandenmaat-calculator</a> of de <a href="/nl/tools/steekmaat-calculator/">steekmaat-calculator</a>.</p>
    <p>De merk- en modelkiezer zoekt in een bredere lijst — {searchableMakeCount} merken in totaal — zodat je je voertuig ook kunt kiezen als Atlas er nog geen gedocumenteerde gegevens voor heeft. In dat geval zeggen we dat eerlijk, in plaats van een maat te gokken.</p>
    <p>Op zoek naar een deelbare link voor een specifiek voertuig? Bekijk de pagina's van de <a href="/nl/voertuigen/">pasvormreferentie per voertuig</a> — één pagina per gedocumenteerd model.</p>
  </div>
</ToolPage>
<script>import { initializeVehicleFitmentFinder } from '../../../../ui/vehicle-fitment-finder'; initializeVehicleFitmentFinder();</script>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import Parametric3DPanel from '../../../../components/Parametric3DPanel.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('compression-ratio-calculator');
const c = localizedTool('compression-ratio-calculator', 'nl');
---
<ToolPage {definition} locale="nl" titleOverride={c.title} descriptionOverride={c.description} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('compression-ratio-calculator')}>
  <form slot="tool" class="calculator-form" data-calculator="compression-ratio" novalidate>
    <div class="utility-fields">
      <label>Boring · mm<input name="bore" type="number" value="86" min="0" step="any" inputmode="decimal" /></label>
      <label>Slag · mm<input name="stroke" type="number" value="86" min="0" step="any" inputmode="decimal" /></label>
      <label>Volume verbrandingskamer · cc<input name="chamber" type="number" value="48" min="0" step="any" inputmode="decimal" /></label>
      <label>Extra volume · cc<input name="otherVolume" type="number" value="4" step="any" inputmode="decimal" /></label>
    </div>
    <UtilityResultStandard locale="nl" primaryLabel="Statische compressieverhouding" pending="Vul de boring, de slag en het kamervolume in." visualTitle="Slagvolume + compressievolume ÷ compressievolume" visualNote="Statische geometrische verhouding, geen dynamische compressie" />
    <Parametric3DPanel mode="compression" locale="nl" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeCompressionRatioCalculator } from '../../../../ui/compression-ratio-calculator'; initializeCompressionRatioCalculator();</script>

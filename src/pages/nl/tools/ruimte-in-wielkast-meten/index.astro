---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('measure-my-car');
const c = localizedTool('measure-my-car', 'nl');
---
<ToolPage {definition} locale="nl" titleOverride={c.title} descriptionOverride={c.description} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/nl/fitment-studio/#measure-flow" alternates={toolAlternates('measure-my-car')}>
  <div slot="tool" class="entry-workspace">
    <div><p class="eyebrow">Meetchecklist</p><h2>Twee vrije ruimtes, één uitgangssituatie</h2><p>Controleer welke velg en band er nu op zitten voordat je gaat meten. Gebruik aan elke kant de kleinste relevante statische vrije ruimte.</p>
      <ol class="entry-steps">
        <li><strong>Vrije ruimte binnenkant</strong><span>Van de rand van velg of band tot het dichtstbijzijnde vaste onderdeel van wielophanging of carrosserie.</span></li>
        <li><strong>Vrije ruimte buitenkant</strong><span>Van de buitenrand van velg of band tot de rand van het spatbord dat je beoordeelt.</span></li>
        <li><strong>Optionele doelen</strong><span>Voeg alleen marges toe die je zelf kiest; Atlas verzint er geen.</span></li>
      </ol>
    </div>
    <a class="button" href="/nl/fitment-studio/#measure-flow">Open de wizard in vijf stappen</a>
  </div>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>

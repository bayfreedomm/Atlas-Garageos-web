---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import FuelFields from '../../../../components/FuelFields.astro';
import FuelCostTechnicalVisual from '../../../../components/FuelCostTechnicalVisual.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('fuel-cost-calculator');
const c = localizedTool('fuel-cost-calculator', 'nl');
---
<ToolPage {definition} locale="nl" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('fuel-cost-calculator')}>
  <form slot="tool" class="calculator-form fuel-cost-form" data-utility-calculator="fuel-cost" novalidate>
    <FuelFields locale="nl" currency="EUR" />
    <a class="fuel-price-hint" href="/gas-prices-today/">Brandstofprijzen in de VS (Engels) <span aria-hidden="true">→</span></a>
    <button type="submit">Brandstofkosten berekenen</button>
    <div class="fuel-primary-result is-pending" data-fuel-primary-result aria-live="polite" aria-label="Hoofdresultaat brandstofkosten">
      <div class="fuel-primary-result__cost"><span>Geschatte brandstofkosten</span><strong data-fuel-primary-cost>—</strong><p data-fuel-primary-copy>Vul je ritgegevens in om de geschatte brandstofkosten te zien.</p></div>
      <div class="fuel-primary-result__fuel"><span>Benodigde brandstof</span><strong data-fuel-primary-fuel>—</strong><small data-fuel-primary-rate>De kosten per kilometer verschijnen hier.</small></div>
    </div>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Je brandstofschatting verschijnt hier.</p>
    <FuelCostTechnicalVisual locale="nl" />
    <div class="fuel-detail-heading" aria-hidden="true"><span>Details</span><small>Uitsplitsing van brandstof en kosten</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

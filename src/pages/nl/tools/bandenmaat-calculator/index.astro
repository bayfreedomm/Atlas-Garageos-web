---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import TireSizeTechnicalVisual from '../../../../components/TireSizeTechnicalVisual.astro';
import TireCodeExplainer from '../../../../components/TireCodeExplainer.astro';
import Parametric3DPanel from '../../../../components/Parametric3DPanel.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('tire-size-calculator');
const c = localizedTool('tire-size-calculator', 'nl');
---
<ToolPage {definition} locale="nl" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} alternates={toolAlternates('tire-size-calculator')}>
  <form slot="tool" class="calculator-form" data-calculator="tire-size" novalidate>
    <fieldset><legend>Bandenmaat</legend><div class="tire-input-row"><label>Breedte<input name="widthMm" type="number" value="225" inputmode="numeric" /></label><span aria-hidden="true">/</span><label>Hoogte (%)<input name="aspectRatio" type="number" value="45" inputmode="numeric" /></label><span aria-hidden="true">R</span><label>Velg<input name="rimDiameterInches" type="number" value="18" step="0.5" inputmode="decimal" /></label></div></fieldset>
    <button type="submit">Bandafmetingen berekenen</button><div class="inline-errors" data-errors role="alert" hidden></div><p class="result-summary is-pending" data-result-summary aria-live="polite">Je resultaat verschijnt hier.</p><Parametric3DPanel mode="single" locale="nl" /><TireSizeTechnicalVisual locale="nl" /><dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="near-sizes" data-near-sizes hidden>
      <h3 data-near-sizes-heading></h3>
      <p class="near-sizes__note" data-near-sizes-note></p>
      <ul class="near-sizes__list" data-near-sizes-list></ul>
    </div>
  </form>
  <div slot="explanation"><TireCodeExplainer locale="nl" />{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeToolCalculators } from '../../../../ui/tool-calculators'; import { initializeShareableToolState } from '../../../../ui/shareable-tool-state'; initializeToolCalculators(); initializeShareableToolState();</script>

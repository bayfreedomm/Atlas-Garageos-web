---
// Localized bolt-pattern detail pages (EN).
//
// One route file generates every page in this locale: getStaticPaths() returns one entry per
// row of boltPatternCatalog, which is itself derived from vehicleFitmentData. Adding a vehicle with a
// new bolt pattern publishes a new page here on the next build with no new file.
import SiteLayout from '../../../components/SiteLayout.astro';
import BoltPatternEntity from '../../../components/BoltPatternEntity.astro';
import { boltPatternCatalog, type BoltPatternEntry } from '../../../data/bolt-pattern-catalog';
import { boltPatternDetailMeta } from '../../../ui/entity-page-model';
import BoltMakeBody from '../../../components/BoltMakeBody.astro';
import { boltMakeMeta, boltMakes, type BoltMake } from '../../../ui/bolt-make';

export function getStaticPaths() {
  // boltPatternCatalog has already had malformed and vehicle-less entries excluded, so anything
  // reaching this point is a page with real, validated data behind it.
  return [
    ...boltPatternCatalog.map((entry) => ({ params: { slug: entry.slug }, props: { entry, make: undefined } })),
    ...boltMakes.map((make) => ({ params: { slug: make.makeSlug }, props: { entry: undefined, make } })),
  ];
}

interface Props { entry: BoltPatternEntry | undefined; make: BoltMake | undefined; }
const { entry, make } = Astro.props as Props;
const meta = entry ? boltPatternDetailMeta(entry, 'en') : boltMakeMeta(make!, 'en');
---
<SiteLayout title={meta.title} description={meta.description} pathname={meta.pathname} active="tools" alternates={meta.alternates} breadcrumbs={meta.breadcrumbs}>
  {entry ? <BoltPatternEntity entry={entry} locale="en" /> : <BoltMakeBody make={make!} locale="en" />}
</SiteLayout>

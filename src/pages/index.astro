---
import SiteLayout from '../components/SiteLayout.astro';
import HomeLauncher from '../components/HomeLauncher.astro';
import ToolIcon from '../components/ToolIcon.astro';
---
<SiteLayout title="Atlas GarageOS" description="Fast, accurate automotive calculators for tires, fuel, road trips, pressure, power, torque, and fitment." pathname="/" active="home">
  <HomeLauncher />
  <section class="launcher-products" aria-label="Atlas GarageOS product areas">
    <a href="/en/fitment-studio/"><ToolIcon id="fitment-studio" category="Advanced"/><strong>Open Fitment Studio</strong><i aria-hidden="true">›</i></a>
    <a href="/en/fitment-studio/#garage"><ToolIcon id="garage" category="Advanced"/><strong>Open My Garage</strong><i aria-hidden="true">›</i></a>
  </section>
</SiteLayout>

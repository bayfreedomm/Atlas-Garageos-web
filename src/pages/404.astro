---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,follow" />
    <meta name="description" content="The requested Atlas GarageOS page could not be found." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#173f38" />
    <title>Page Not Found — Atlas GarageOS</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="app-header"><div class="app-header__inner">
      <a class="brand" href="/en/fitment-studio/" aria-label="Atlas GarageOS home"><span class="brand-mark" aria-hidden="true">AG</span><span class="brand-copy"><strong>Atlas GarageOS</strong><span>Automotive tools</span></span></a>
      <span class="locale-chip">EN</span>
    </div></header>
    <main id="main-content" class="error-page">
      <section class="error-panel" aria-labelledby="error-heading">
        <p class="eyebrow">Error 404</p>
        <h1 id="error-heading">That page is not in the garage.</h1>
        <p class="hero-copy">The address may have changed, or the link may be incomplete. Your saved Garage data remains on this device.</p>
        <div class="error-actions">
          <a class="button" href="/en/fitment-studio/">Open Fitment Studio</a>
          <a class="button secondary" href="/en/tools/tire-size-calculator/">Browse tools</a>
        </div>
      </section>
    </main>
  </body>
</html>

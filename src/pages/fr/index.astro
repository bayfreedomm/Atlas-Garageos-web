---
import { platformAlternates } from '../../seo/locale-alternates';
import SiteLayout from '../../components/SiteLayout.astro';
import HomeLauncher from '../../components/HomeLauncher.astro';
import { platformCatalog } from '../../localization/site-catalog';
const c = platformCatalog['fr'].home;
const alternates = platformAlternates('/');
---
<SiteLayout title={c.title} description={c.description} pathname="/fr/" active="home" locale="fr" alternates={alternates}>
  <HomeLauncher locale="fr" />
</SiteLayout>

---
// French home. French publishes the reference families (tire sizes, tire heights, bolt
// patterns); this page is their front door: size lookup first, then the hubs.
import SiteLayout from '../../components/SiteLayout.astro';
import TireSizeLookup from '../../components/TireSizeLookup.astro';
import { entityHubPath } from '../../seo/entity-routes';
import { tireSizeCatalog } from '../../data/tire-size-catalog';
import { boltPatternCatalog } from '../../data/bolt-pattern-catalog';
import { vehicleFitmentData } from '../../data/vehicle-fitment';
import { tireDiameterGroupPath, tireDiameterGroups } from '../../ui/entity-page-model';
import { tireSizeShortcuts } from '../../ui/reference-links';

const shortcuts = tireSizeShortcuts('fr');
const heights = tireDiameterGroups().filter((group) => group.inches >= 24 && group.inches <= 35);
const tireHub = entityHubPath('tire-size', 'fr');
const boltHub = entityHubPath('bolt-pattern', 'fr');
const pathname = '/fr/';
const alternates = [{ hreflang: 'fr', href: 'https://atlasgarageos.com/fr/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/fr/' }];
---
<SiteLayout title="Dimensions de pneus et entraxes" description={`Recherchez une taille de pneu : diamètre, circonférence, dimensions en pouces et équivalences pour ${tireSizeCatalog.length} tailles, plus ${boltPatternCatalog.length} entraxes de jantes.`} pathname={pathname} active="home" locale="fr" alternates={alternates} breadcrumbs={[{ name: 'Accueil', href: pathname }]}>
  <header class="entity-hero">
    <p class="eyebrow">Atlas GarageOS · référence pneus</p>
    <h1 class="entity-hero__title">Dimensions de pneus, équivalences et entraxes</h1>
    <p class="entity-hero__lead">Saisissez la taille inscrite sur le flanc : diamètre, circonférence, hauteur de flanc, équivalences sur d’autres jantes et écart du compteur, calculés pour {tireSizeCatalog.length} tailles fabriquées.</p>
  </header>

  <section class="entity-section" aria-labelledby="fr-lookup">
    <h2 id="fr-lookup">Rechercher une taille de pneu</h2>
    <TireSizeLookup locale="fr" id="tire-lookup-fr-home" />
    <ul class="entity-chiplist">
      {shortcuts.map((shortcut) => <li><a class="entity-chip" href={shortcut.href}>{shortcut.label}</a></li>)}
    </ul>
  </section>

  <section class="entity-section" aria-labelledby="fr-reference">
    <h2 id="fr-reference">Données de référence</h2>
    <div class="entity-links">
      <a class="entity-link-card" href={tireHub}><strong>Toutes les dimensions de pneus</strong><span>{tireSizeCatalog.length} tailles classées par diamètre de jante</span><i aria-hidden="true">›</i></a>
      <a class="entity-link-card" href="/fr/vehicules/"><strong>Pneus et entraxe par véhicule</strong><span>{vehicleFitmentData.length} véhicules : taille de pneu, entraxe, alésage, couple</span><i aria-hidden="true">›</i></a>
      <a class="entity-link-card" href={boltHub}><strong>Entraxes de jantes</strong><span>PCD, écart entre trous et véhicules pour {boltPatternCatalog.length} entraxes</span><i aria-hidden="true">›</i></a>
      <a class="entity-link-card" href="/tools/" hreflang="en"><strong>Calculateurs (en anglais)</strong><span>Taille de pneu, déport ET, compteur, carburant et plus</span><i aria-hidden="true">›</i></a>
    </div>
  </section>

  <section class="entity-section" aria-labelledby="fr-heights">
    <h2 id="fr-heights">Pneus par hauteur</h2>
    <p class="entity-note">Toutes les tailles regroupées par diamètre extérieur en pouces, comme on désigne souvent les pneus tout-terrain et pick-up.</p>
    <ul class="entity-chiplist">
      {heights.map((group) => <li><a class="entity-chip" href={tireDiameterGroupPath(group.inches, 'fr')}>Pneus {group.inches}″</a></li>)}
    </ul>
  </section>
</SiteLayout>

---
import SiteLayout from '../../../components/SiteLayout.astro';
import { vehiclePageText } from '../../../content/vehicle-page-text';
import { vehicleFitmentData } from '../../../data/vehicle-fitment';
import { vehicleAlternates, vehiclePagePath } from '../../../ui/entity-page-model';

const t = vehiclePageText.fr;
const pathname = '/fr/vehicules/';
const sorted = vehicleFitmentData.slice().sort((a, b) => `${a.make} ${a.model}`.localeCompare(`${b.make} ${b.model}`));
const groups = (['eu', 'us'] as const).map((market) => ({ market, label: market === 'us' ? t.hubUsMarket : t.hubEuMarket, vehicles: sorted.filter((v) => v.market === market) }));
---
<SiteLayout title={t.hubTitle} description={t.hubDescription} pathname={pathname} active="tools" locale="fr" alternates={vehicleAlternates()} breadcrumbs={[{ name: t.breadcrumbHome, href: '/fr/' }, { name: t.breadcrumbVehicles, href: pathname }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/fr/">{t.breadcrumbHome}</a><span aria-hidden="true">/</span><span aria-current="page">{t.breadcrumbVehicles}</span></nav>
  <header class="directory-identity methodology-hero">
    <p class="eyebrow">{sorted.length} · {t.breadcrumbVehicles}</p>
    <h1>{t.hubTitle}</h1>
    <p>{t.hubLead}</p>
  </header>
  <section class="vehicle-fuel-journey" aria-label="Références">
    <div class="vehicle-fuel-journey__cards">
      <a class="vehicle-fuel-card" href="/fr/dimensions-pneus/"><strong>Dimensions de pneus</strong><span>Diamètre, largeur et équivalences pour près de 1 000 tailles.</span><i aria-hidden="true">›</i></a>
      <a class="vehicle-fuel-card" href="/fr/entraxes/"><strong>Entraxes de jantes</strong><span>PCD, alésage et véhicules compatibles par entraxe.</span><i aria-hidden="true">›</i></a>
    </div>
  </section>
  {groups.map((group) => group.vehicles.length > 0 && (
    <section class="entity-section" aria-label={group.label}>
      <h2>{group.label} <span class="entity-card__meta">· {group.vehicles.length}</span></h2>
      <div class="methodology-source-links">
        {group.vehicles.map((v) => <a href={vehiclePagePath('fr', v.id)}>{v.make} {v.model} — {v.tireSize.replace(/R(\d)/, ' R$1')} · {v.boltPattern} <span>›</span></a>)}
      </div>
    </section>
  ))}
</SiteLayout>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import EmbedCodePanel from '../../../../components/EmbedCodePanel.astro';
import TireInputGroup from '../../../../components/TireInputGroup.astro';
import TireVisualStudio from '../../../../components/TireVisualStudio.astro';
import GuidedTireDecision from '../../../../components/GuidedTireDecision.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('tire-size-comparison');
const c = localizedTool('tire-size-comparison', 'fr');
---
<ToolPage {definition} locale="fr" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} alternates={toolAlternates('tire-size-comparison')}>
  <form slot="tool" class="calculator-form" data-calculator="tire-comparison" novalidate>
    <div class="garage-quick-load" data-garage-quick-load data-gql-target="tire-comparison" data-gql-locale="fr" hidden></div>
    <div class="calculator-columns">
      <TireInputGroup locale="fr" prefix="original-" title="Pneu d'origine" width={225} aspect={45} rim={18} />
      <TireInputGroup locale="fr" prefix="new-" title="Nouveau pneu" width={235} aspect={40} rim={19} />
    </div>
    <div class="form-actions">
      <button type="submit">Comparer les tailles de pneus</button>
      <button type="button" class="secondary" data-share-result>Copier le lien de partage</button>
    </div>
    <div class="inline-errors" data-errors role="alert" hidden></div>
    <section class="tire-primary-result is-pending" data-tire-primary-result aria-live="polite" aria-label="Résultat principal de la comparaison de pneus">
      <div class="tire-primary-result__answer">
        <span>Écart de diamètre</span>
        <strong data-tire-primary-percent>—</strong>
        <p data-tire-primary-copy>Comparez les deux tailles pour voir l'écart principal.</p>
      </div>
      <div class="tire-primary-result__speed">
        <span>À 100 km/h affichés</span>
        <strong data-tire-speed-example>—</strong>
        <small>Exemple théorique basé sur la géométrie de roulement</small>
      </div>
    </section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Votre résumé de comparaison apparaîtra ici.</p>
    <TireVisualStudio locale="fr" />
    <GuidedTireDecision locale="fr" />
    <div class="tire-detail-heading" aria-hidden="true"><span>Détails</span><small>Géométrie nominale</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
  <EmbedCodePanel slot="explanation" locale="fr" />
</ToolPage>
<script>import { initializeShareableToolState } from '../../../../ui/shareable-tool-state'; import { initializeToolCalculators } from '../../../../ui/tool-calculators'; import { initializeGarageQuickLoad } from '../../../../ui/garage-quick-load'; initializeShareableToolState(); initializeToolCalculators(); initializeGarageQuickLoad();</script>

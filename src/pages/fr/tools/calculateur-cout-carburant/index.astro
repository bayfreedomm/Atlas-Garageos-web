---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import FuelFields from '../../../../components/FuelFields.astro';
import FuelCostTechnicalVisual from '../../../../components/FuelCostTechnicalVisual.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('fuel-cost-calculator');
const c = localizedTool('fuel-cost-calculator', 'fr');
---
<ToolPage {definition} locale="fr" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('fuel-cost-calculator')}>
  <form slot="tool" class="calculator-form fuel-cost-form" data-utility-calculator="fuel-cost" novalidate>
    <FuelFields locale="fr" currency="EUR" />
    <a class="fuel-price-hint" href="/gas-prices-today/">Prix des carburants aux États-Unis (anglais) <span aria-hidden="true">→</span></a>
    <button type="submit">Calculer le coût du carburant</button>
    <div class="fuel-primary-result is-pending" data-fuel-primary-result aria-live="polite" aria-label="Résultat principal du coût du carburant">
      <div class="fuel-primary-result__cost"><span>Coût du carburant estimé</span><strong data-fuel-primary-cost>—</strong><p data-fuel-primary-copy>Saisissez les données de votre trajet pour voir le coût du carburant estimé.</p></div>
      <div class="fuel-primary-result__fuel"><span>Carburant nécessaire</span><strong data-fuel-primary-fuel>—</strong><small data-fuel-primary-rate>Le coût au kilomètre apparaîtra ici.</small></div>
    </div>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Votre estimation de carburant apparaîtra ici.</p>
    <FuelCostTechnicalVisual locale="fr" />
    <div class="fuel-detail-heading" aria-hidden="true"><span>Détails</span><small>Détail du carburant et du coût</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import WheelOffsetTechnicalVisual from '../../../../components/WheelOffsetTechnicalVisual.astro';
import EngineeringVisualStudio from '../../../../components/EngineeringVisualStudio.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('wheel-offset-calculator');
const c = localizedTool('wheel-offset-calculator', 'fr');
---
<ToolPage {definition} locale="fr" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/fr/tools/mesurer-degagement-roue/" alternates={toolAlternates('wheel-offset-calculator')}>
  <form slot="tool" class="calculator-form" data-calculator="wheel-offset" novalidate>
    <div class="garage-quick-load" data-garage-quick-load data-gql-target="wheel-offset" data-gql-locale="fr" hidden></div>
    <div class="calculator-columns">
      <fieldset class="calculator-group"><legend>Jante d'origine</legend><div class="grid"><label>Largeur · J<input name="originalWidthInches" type="number" value="8" step="0.5" inputmode="decimal" /></label><label>Déport · ET<input name="originalOffsetMm" type="number" value="40" inputmode="numeric" /></label></div></fieldset>
      <fieldset class="calculator-group"><legend>Nouvelle jante</legend><div class="grid"><label>Largeur · J<input name="newWidthInches" type="number" value="8.5" step="0.5" inputmode="decimal" /></label><label>Déport · ET<input name="newOffsetMm" type="number" value="35" inputmode="numeric" /></label></div></fieldset>
    </div>
    <div class="form-actions"><button type="submit">Comparer la position de la roue</button><button type="button" class="secondary" data-share-result>Copier le lien de partage</button></div>
    <div class="inline-errors" data-errors role="alert" hidden></div>
    <section class="wheel-primary-result is-pending" data-wheel-primary-result aria-live="polite" aria-label="Résultat principal de la position de la roue">
      <div class="wheel-primary-result__answer">
        <span>Décalage du bord extérieur</span>
        <strong data-wheel-primary-outer>—</strong>
        <p data-wheel-primary-outer-copy>Comparez les jantes pour voir de combien le bord extérieur se déplace.</p>
      </div>
      <div class="wheel-primary-result__inner">
        <span>Décalage du bord intérieur</span>
        <strong data-wheel-primary-inner>—</strong>
        <small data-wheel-primary-inner-copy>Indique le déplacement vers les éléments de suspension ou en s'en éloignant.</small>
      </div>
    </section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Votre résumé de position apparaîtra ici.</p>
    <EngineeringVisualStudio mode="offset" locale="fr"><WheelOffsetTechnicalVisual locale="fr" /></EngineeringVisualStudio>
    <div class="wheel-detail-heading" aria-hidden="true"><span>Détails</span><small>Géométrie statique de la roue</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeShareableToolState } from '../../../../ui/shareable-tool-state'; import { initializeToolCalculators } from '../../../../ui/tool-calculators'; import { initializeGarageQuickLoad } from '../../../../ui/garage-quick-load'; initializeShareableToolState(); initializeToolCalculators(); initializeGarageQuickLoad();</script>

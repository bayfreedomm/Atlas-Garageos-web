---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('measure-my-car');
const c = localizedTool('measure-my-car', 'fr');
---
<ToolPage {definition} locale="fr" titleOverride={c.title} descriptionOverride={c.description} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/fr/fitment-studio/#measure-flow" alternates={toolAlternates('measure-my-car')}>
  <div slot="tool" class="entry-workspace">
    <div><p class="eyebrow">Check-list de mesure</p><h2>Deux dégagements, une base de référence</h2><p>Vérifiez la jante et le pneu actuellement montés avant de mesurer. De chaque côté, retenez le plus petit dégagement statique pertinent.</p>
      <ol class="entry-steps">
        <li><strong>Dégagement intérieur</strong><span>Du bord de la jante ou du pneu jusqu'à l'élément fixe de suspension ou de carrosserie le plus proche.</span></li>
        <li><strong>Dégagement extérieur</strong><span>Du bord extérieur de la jante ou du pneu jusqu'au bord de l'aile concerné.</span></li>
        <li><strong>Objectifs facultatifs</strong><span>Ajoutez uniquement les marges que vous avez choisies ; Atlas n'en invente aucune.</span></li>
      </ol>
    </div>
    <a class="button" href="/fr/fitment-studio/#measure-flow">Ouvrir l'assistant en cinq étapes</a>
  </div>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('power-to-weight-calculator');
const c = localizedTool('power-to-weight-calculator', 'fr');
---
<ToolPage {definition} locale="fr" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('power-to-weight-calculator')}>
  <form slot="tool" class="calculator-form" data-utility-calculator="power-weight" novalidate>
    <div class="utility-fields"><label>Puissance<input name="power" type="number" value="180" min="0" step="any" inputmode="decimal" /></label><label>Unité de puissance<select name="powerUnit"><option value="hp">hp (chevaux mécaniques)</option><option value="kw">kW</option></select></label><label>Poids du véhicule<input name="weight" type="number" value="1350" min="0" step="any" inputmode="decimal" /></label><label>Unité de poids<select name="weightUnit"><option value="kg">kg</option><option value="lb">lb</option></select></label></div>
    <button type="submit">Calculer le rapport poids/puissance</button>
    <UtilityResultStandard locale="fr" primaryLabel="Rapport poids/puissance" pending="Saisissez la puissance et le poids du véhicule." visualTitle="PUISSANCE ÷ MASSE = RAPPORT" visualNote="Normalisation physique, pas une note de performance" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('quarter-mile-calculator');
const c = localizedTool('quarter-mile-calculator', 'fr');
---
<ToolPage {definition} locale="fr" titleOverride={c.title} descriptionOverride={c.description} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('quarter-mile-calculator')}>
  <form slot="tool" class="calculator-form" data-calculator="quarter-mile" novalidate>
    <div class="utility-fields">
      <label>Poids du véhicule<input name="weight" type="number" value="3400" min="0" step="any" inputmode="decimal" /></label>
      <label>Unité de poids<select name="weightUnit"><option value="lb" selected>lb</option><option value="kg">kg</option></select></label>
      <label>Puissance<input name="power" type="number" value="300" min="0" step="any" inputmode="decimal" /></label>
      <label>Unité de puissance<select name="powerUnit"><option value="hp" selected>hp (chevaux mécaniques)</option><option value="kw">kW</option></select></label>
    </div>
    <UtilityResultStandard locale="fr" primaryLabel="Temps estimé sur le quart de mile" pending="Saisissez le poids du véhicule et la puissance." visualTitle="Poids ÷ puissance → temps final" visualNote="Estimation classique poids-puissance en accélération (dragster)" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeQuarterMileCalculator } from '../../../../ui/quarter-mile-calculator'; initializeQuarterMileCalculator();</script>

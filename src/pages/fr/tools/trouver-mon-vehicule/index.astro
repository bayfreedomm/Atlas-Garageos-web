---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
import { vehicleMakes } from '../../../../data/vehicle-fitment';
import { indexedVehicleMakes } from '../../../../data/vehicle-model-index';
const definition = toolById('vehicle-fitment-finder');
const c = localizedTool('vehicle-fitment-finder', 'fr');
const makeCount = vehicleMakes().length;
const searchableMakeCount = new Set([...vehicleMakes(), ...indexedVehicleMakes()]).size;
---
<ToolPage {definition} locale="fr" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} alternates={toolAlternates('vehicle-fitment-finder')}>
  <form slot="tool" class="calculator-form" data-calculator="vehicle-finder" novalidate>
    <fieldset><legend>Véhicule</legend>
      <div class="utility-fields">
        <label>Marque<select name="make" data-vehicle-make></select></label>
        <label>Modèle<select name="model" data-vehicle-model disabled></select></label>
      </div>
    </fieldset>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Choisissez une marque et un modèle pour voir les données de référence.</p>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="vehicle-meta" data-vehicle-meta hidden>
      <span class="vehicle-confidence" data-vehicle-confidence></span>
      <p class="vehicle-sources" data-vehicle-sources></p>
      <p class="vehicle-notes" data-vehicle-notes hidden></p>
    </div>
    <div class="vehicle-actions" data-vehicle-actions hidden>
      <a class="studio-cta studio-cta--row" data-vehicle-tire-link data-base-href="/fr/tools/calculateur-taille-pneus/"><span><small>Prérempli avec les données de ce véhicule</small><strong>Ouvrir dans le calculateur de taille de pneus</strong></span><i aria-hidden="true">›</i></a>
      <a class="studio-cta studio-cta--row" data-vehicle-bolt-link data-base-href="/fr/tools/calculateur-entraxe/"><span><small>Prérempli avec les données de ce véhicule</small><strong>Ouvrir dans le calculateur d'entraxe</strong></span><i aria-hidden="true">›</i></a>
    </div>
  </form>
  <div slot="explanation">
    {c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}
    <h2>Couvre actuellement {makeCount} marques avec des fiches de compatibilité Atlas documentées</h2>
    <p>Il s'agit d'une première sélection de véhicules courants, pas d'une base de données constructeur complète — elle s'enrichira avec le temps. Si votre véhicule exact n'y figure pas encore, l'étiquette sur le montant de la portière conducteur ou le manuel du propriétaire indique la spécification du constructeur, que vous pouvez saisir directement dans le <a href="/fr/tools/calculateur-taille-pneus/">calculateur de taille de pneus</a> ou le <a href="/fr/tools/calculateur-entraxe/">calculateur d'entraxe</a>.</p>
    <p>Le sélecteur de marque et de modèle puise dans une liste plus large — {searchableMakeCount} marques au total — pour que vous puissiez choisir votre véhicule même si Atlas n'a pas encore de fiche documentée pour lui. Dans ce cas, nous vous le disons clairement au lieu de deviner une dimension.</p>
    <p>Vous cherchez un lien à partager pour un véhicule précis ? Consultez les pages <a href="/fr/vehicules/">Référence de compatibilité des véhicules</a> — une page par modèle documenté.</p>
  </div>
</ToolPage>
<script>import { initializeVehicleFitmentFinder } from '../../../../ui/vehicle-fitment-finder'; initializeVehicleFitmentFinder();</script>

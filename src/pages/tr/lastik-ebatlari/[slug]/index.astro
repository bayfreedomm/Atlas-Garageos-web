---
// Localized tire-size detail pages (tr): one page per catalog size plus one page per tire-height group.
import SiteLayout from '../../../../components/SiteLayout.astro';
import TireSizeEntity from '../../../../components/TireSizeEntity.astro';
import TireDiameterGroup from '../../../../components/TireDiameterGroup.astro';
import { tireSizeCatalog, type TireSizeEntry } from '../../../../data/tire-size-catalog';
import { tireDiameterGroupMeta, tireDiameterGroupSlug, tireDiameterGroups, tireSizeDetailMeta, type TireDiameterGroup as DiameterGroup } from '../../../../ui/entity-page-model';

export function getStaticPaths() {
  return [
    ...tireSizeCatalog.map((entry) => ({ params: { slug: entry.slug }, props: { entry, group: undefined } })),
    ...tireDiameterGroups().map((group) => ({ params: { slug: tireDiameterGroupSlug(group.inches, 'tr') }, props: { entry: undefined, group } })),
  ];
}

interface Props { entry: TireSizeEntry | undefined; group: DiameterGroup | undefined; }
const { entry, group } = Astro.props as Props;
const meta = entry ? tireSizeDetailMeta(entry, 'tr') : tireDiameterGroupMeta(group!, 'tr');
---
<SiteLayout title={meta.title} description={meta.description} pathname={meta.pathname} active="tools" locale="tr" alternates={meta.alternates} breadcrumbs={meta.breadcrumbs}>
  {entry ? <TireSizeEntity entry={entry} locale="tr" /> : <TireDiameterGroup group={group!} locale="tr" />}
</SiteLayout>

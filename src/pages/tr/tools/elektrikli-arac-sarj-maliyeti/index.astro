---
import ToolDrawingFrame from '../../../../components/ToolDrawingFrame.astro';
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import Parametric3DPanel from '../../../../components/Parametric3DPanel.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('ev-charging-cost-calculator');
const c = localizedTool('ev-charging-cost-calculator', 'tr');
---
<ToolPage {definition} locale="tr" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('ev-charging-cost-calculator')}>
  <form slot="tool" class="calculator-form ev-charging-calculator" data-calculator="ev-charging" novalidate>
    <div class="utility-fields">
      <label>Batarya kapasitesi · kWh<input name="batteryCapacityKwh" type="number" value="64" min="1" max="250" step="1" inputmode="decimal" /></label>
      <label>Elektrik fiyatı · kWh başına<input name="pricePerKwh" type="number" value="3.50" min="0" max="10" step="0.01" inputmode="decimal" /></label>
      <label>Para birimi<select name="currency"><option value="TRY" selected>TRY</option><option value="EUR">EUR</option><option value="USD">USD</option><option value="GBP">GBP</option><option value="CAD">CAD</option><option value="AUD">AUD</option><option value="PLN">PLN</option><option value="BRL">BRL</option></select></label>
      <label>Başlangıç şarjı · %<input name="startPercent" type="number" value="20" min="0" max="100" step="1" inputmode="numeric" /></label>
      <label>Hedef şarj · %<input name="endPercent" type="number" value="80" min="0" max="100" step="1" inputmode="numeric" /></label>
      <label>Şarj gücü · kW<input name="chargerPowerKw" type="number" value="11" min="0.1" max="400" step="0.1" inputmode="decimal" /></label>
      <label>Şarj verimi · %<input name="chargingEfficiency" type="number" value="90" min="50" max="100" step="1" inputmode="numeric" /></label>
    </div>
    <button type="submit">Şarj maliyetini hesaplayın</button>
    <section class="standard-answer ev-answer is-pending" data-ev-answer aria-live="polite"><div class="standard-answer__main"><span>Tahmini şarj maliyeti</span><strong data-ev-cost>—</strong><p data-ev-context>Şarj tahmininiz burada görünecek.</p></div><div class="standard-answer__secondary"><span>İdeal şarj süresi</span><strong data-ev-time>—</strong><small data-ev-grid>Şebekeden çekilecek enerji burada görünecek.</small></div></section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Şarj tahmininiz burada görünecek.</p>
    <Parametric3DPanel mode="ev" locale="tr" />
    <figure class="ev-technical-visual is-pending" data-ev-visual>
      <figcaption><span>BATARYA → ŞEBEKE ENERJİSİ → MALİYET + SÜRE</span><small>Şarj aralığı orantılıdır; süre sabit şarj gücü varsayar</small></figcaption>
      <ToolDrawingFrame kind="ev-charge" labels={{}} locale="tr" />
      <div class="ev-visual-stats"><div><small>Bataryaya giren</small><strong data-ev-battery-energy>—</strong></div><div><small>Şebekeden çekilen</small><strong data-ev-grid-energy>—</strong></div><div><small>Verim kaybı</small><strong data-ev-loss>—</strong></div></div>
    </figure>
    <div class="fuel-detail-heading" aria-hidden="true"><span>Ayrıntılar</span><small>Enerji, maliyet ve ideal süre</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeEvChargingCalculators } from '../../../../ui/ev-charging-calculator'; initializeEvChargingCalculators();</script>

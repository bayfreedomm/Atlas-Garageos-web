---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('power-to-weight-calculator');
const c = localizedTool('power-to-weight-calculator', 'tr');
---
<ToolPage {definition} locale="tr" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('power-to-weight-calculator')}>
  <form slot="tool" class="calculator-form" data-utility-calculator="power-weight" novalidate>
    <div class="utility-fields"><label>Güç<input name="power" type="number" value="180" min="0" step="any" inputmode="decimal" /></label><label>Güç birimi<select name="powerUnit"><option value="hp">Mekanik beygir gücü (hp)</option><option value="kw">kW</option></select></label><label>Araç ağırlığı<input name="weight" type="number" value="1350" min="0" step="any" inputmode="decimal" /></label><label>Ağırlık birimi<select name="weightUnit"><option value="kg">kg</option><option value="lb">lb</option></select></label></div>
    <button type="submit">Güç-ağırlık oranını hesaplayın</button>
    <UtilityResultStandard locale="tr" primaryLabel="Güç-ağırlık oranı" pending="Motor gücünü ve araç ağırlığını girin." visualTitle="GÜÇ ÷ KÜTLE = ORAN" visualNote="Fiziksel normalleştirme; performans puanı değildir" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

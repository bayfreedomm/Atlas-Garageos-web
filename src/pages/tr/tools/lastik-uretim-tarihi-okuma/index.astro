---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('tire-date-code-decoder');
const c = localizedTool('tire-date-code-decoder', 'tr');
---
<ToolPage {definition} locale="tr" titleOverride={c.title} descriptionOverride={c.description} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('tire-date-code-decoder')}>
  <form slot="tool" class="calculator-form" data-calculator="tire-date-code" novalidate>
    <div class="utility-fields">
      <label class="field-wide">DOT kodunun son 4 hanesi<input name="code" type="text" value="2219" maxlength="4" inputmode="numeric" pattern="[0-9]{4}" placeholder="örn. 2219" /></label>
    </div>
    <UtilityResultStandard locale="tr" primaryLabel="Üretim tarihi" pending="4 haneli hafta/yıl kodunu girin." visualTitle="HHYY → hafta + yıl" visualNote="DOT seri numarasının son grubu" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeTireDateCodeDecoder } from '../../../../ui/tire-date-code-decoder'; initializeTireDateCodeDecoder();</script>

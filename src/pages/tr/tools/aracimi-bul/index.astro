---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
import { vehicleMakes } from '../../../../data/vehicle-fitment';
import { indexedVehicleMakes } from '../../../../data/vehicle-model-index';
const definition = toolById('vehicle-fitment-finder');
const c = localizedTool('vehicle-fitment-finder', 'tr');
const makeCount = vehicleMakes().length;
const searchableMakeCount = new Set([...vehicleMakes(), ...indexedVehicleMakes()]).size;
---
<ToolPage {definition} locale="tr" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} alternates={toolAlternates('vehicle-fitment-finder')}>
  <form slot="tool" class="calculator-form" data-calculator="vehicle-finder" novalidate>
    <fieldset><legend>Araç</legend>
      <div class="utility-fields">
        <label>Marka<select name="make" data-vehicle-make></select></label>
        <label>Model<select name="model" data-vehicle-model disabled></select></label>
      </div>
    </fieldset>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Referans verileri görmek için bir marka ve model seçin.</p>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="vehicle-meta" data-vehicle-meta hidden>
      <span class="vehicle-confidence" data-vehicle-confidence></span>
      <p class="vehicle-sources" data-vehicle-sources></p>
      <p class="vehicle-notes" data-vehicle-notes hidden></p>
    </div>
    <div class="vehicle-actions" data-vehicle-actions hidden>
      <a class="studio-cta studio-cta--row" data-vehicle-tire-link data-base-href="/tr/tools/lastik-ebadi-hesaplama/"><span><small>Bu aracın verileriyle doldurulur</small><strong>Lastik Ebadı Hesaplama aracında açın</strong></span><i aria-hidden="true">›</i></a>
      <a class="studio-cta studio-cta--row" data-vehicle-bolt-link data-base-href="/tr/tools/bijon-araligi-hesaplama/"><span><small>Bu aracın verileriyle doldurulur</small><strong>Bijon Aralığı Hesaplama aracında açın</strong></span><i aria-hidden="true">›</i></a>
    </div>
  </form>
  <div slot="explanation">
    {c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}
    <h2>Şu anda belgelenmiş Atlas uyum kayıtlarıyla {makeCount} markayı kapsıyor</h2>
    <p>Bu, yaygın araçlardan oluşan bir başlangıç listesidir; üreticinin eksiksiz veritabanı değildir ve zamanla büyüyecektir. Aracınız henüz listede yoksa sürücü kapısı direğindeki etikette veya kullanım kılavuzunda üretici değerlerini bulabilir, bunları doğrudan <a href="/tr/tools/lastik-ebadi-hesaplama/">Lastik Ebadı Hesaplama</a> veya <a href="/tr/tools/bijon-araligi-hesaplama/">Bijon Aralığı Hesaplama</a> aracına girebilirsiniz.</p>
    <p>Marka ve model seçici daha geniş bir listede arama yapar — toplam {searchableMakeCount} marka — böylece Atlas’ta henüz belgelenmiş bir kaydı olmasa bile aracınızı seçebilirsiniz. Bu durumda bir ölçü tahmin etmek yerine bunu size açıkça söyleriz.</p>
    <p>Belirli bir araç için paylaşılabilir bir bağlantı mı arıyorsunuz? <a href="/tr/araclar/">Araçlara göre uyum referansı</a> sayfalarına göz atın — belgelenmiş her model için ayrı bir sayfa.</p>
  </div>
</ToolPage>
<script>import { initializeVehicleFitmentFinder } from '../../../../ui/vehicle-fitment-finder'; initializeVehicleFitmentFinder();</script>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('measure-my-car');
const c = localizedTool('measure-my-car', 'tr');
---
<ToolPage {definition} locale="tr" titleOverride={c.title} descriptionOverride={c.description} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/tr/fitment-studio/#measure-flow" alternates={toolAlternates('measure-my-car')}>
  <div slot="tool" class="entry-workspace">
    <div><p class="eyebrow">Ölçüm kontrol listesi</p><h2>İki boşluk, tek başlangıç noktası</h2><p>Ölçüme başlamadan önce takılı olan jantı ve lastiği doğrulayın. Her iki tarafta da ilgili en dar statik boşluğu kullanın.</p>
      <ol class="entry-steps">
        <li><strong>İç boşluk</strong><span>Jant veya lastik kenarından en yakın sabit süspansiyon ya da kaporta parçasına kadar.</span></li>
        <li><strong>Dış boşluk</strong><span>Jantın veya lastiğin dış kenarından değerlendirilen çamurluk kenarına kadar.</span></li>
        <li><strong>İsteğe bağlı hedefler</strong><span>Yalnızca kendi seçtiğiniz payları ekleyin; Atlas kendiliğinden pay uydurmaz.</span></li>
      </ol>
    </div>
    <a class="button" href="/tr/fitment-studio/#measure-flow">Beş adımlı sihirbazı açın</a>
  </div>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>

---
import { platformAlternates } from '../../../seo/locale-alternates';
import SiteLayout from '../../../components/SiteLayout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import { platformCatalog } from '../../../localization/site-catalog';
const c = platformCatalog.tr.toolsHub;
const alternates = platformAlternates('/tools/');
---
<SiteLayout title={c.title} description={c.description} pathname="/tr/tools/" active="tools" locale="tr" alternates={alternates} breadcrumbs={[{ name: 'Ana sayfa', href: '/tr/' }, { name: 'Araçlar', href: '/tr/tools/' }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/tr/">Ana sayfa</a><span aria-hidden="true">/</span><span aria-current="page">Araçlar</span></nav>
  <header class="directory-identity"><h1>{c.h1}</h1><p>{c.lead}</p></header>
  <ToolDirectory mode="all" locale="tr" />
  <a class="fitment-directory-row" href="/tr/fitment-studio/"><strong>{c.fitmentRowTitle}</strong><span>{c.fitmentRowCopy}</span><i aria-hidden="true">›</i></a>
  <a class="fitment-directory-row" href="/tr/araclar/"><strong>Araçlara göre uyum referansı</strong><span>Marka ve modele göre belgelenmiş lastik ebadı, bijon aralığı ve kaynaklı sıkma torku</span><i aria-hidden="true">›</i></a>
</SiteLayout>

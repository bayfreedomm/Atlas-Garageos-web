---
// Localized tire-size detail pages (ES).
//
// One route file generates every page in this locale: one page per row of tireSizeCatalog
// (production-size reference, flotation sizes and documented vehicle-only OEM sizes), plus one
// "N-inch tires" page per tire-height group. Adding a sourced size publishes its page and
// updates its height group on the next build with no new file.
import { tireComparisonImage, tireSizeImage } from '../../../../seo/entity-images';
import SiteLayout from '../../../../components/SiteLayout.astro';
import TireSizeEntity from '../../../../components/TireSizeEntity.astro';
import TireComparisonEntity from '../../../../components/TireComparisonEntity.astro';
import TireDiameterGroup from '../../../../components/TireDiameterGroup.astro';
import { tireSizeCatalog, type TireSizeEntry } from '../../../../data/tire-size-catalog';
import { tireDiameterGroupMeta, tireDiameterGroupSlug, tireDiameterGroups, tireSizeDetailMeta, type TireDiameterGroup as DiameterGroup } from '../../../../ui/entity-page-model';
import { tireComparisonPairs, type TireComparisonPair } from '../../../../data/tire-comparisons';
import { tireComparisonMeta } from '../../../../ui/tire-comparison';

export function getStaticPaths() {
  // tireSizeCatalog has already rejected malformed/out-of-range source data, so anything reaching
  // this point is a page with real, validated reference data behind it.
  return [
    ...tireSizeCatalog.map((entry) => ({ params: { slug: entry.slug }, props: { entry, group: undefined, pair: undefined } })),
    ...tireDiameterGroups().map((group) => ({ params: { slug: tireDiameterGroupSlug(group.inches, 'es') }, props: { entry: undefined, group, pair: undefined } })),
    // Factory-backed "X vs Y" comparisons (src/data/tire-comparisons.ts), e.g. 205-55-r16-vs-225-45-r17.
    ...tireComparisonPairs.map((pair) => ({ params: { slug: pair.slug }, props: { entry: undefined, group: undefined, pair } })),
  ];
}

interface Props { entry: TireSizeEntry | undefined; group: DiameterGroup | undefined; pair: TireComparisonPair | undefined; }
const { entry, group, pair } = Astro.props as Props;
const meta = entry ? tireSizeDetailMeta(entry, 'es') : pair ? tireComparisonMeta(pair, 'es') : tireDiameterGroupMeta(group!, 'es');
---
<SiteLayout title={meta.title} description={meta.description} pathname={meta.pathname} active="tools" locale="es" alternates={meta.alternates} breadcrumbs={meta.breadcrumbs} image={entry ? tireSizeImage(entry, 'es') : pair ? tireComparisonImage(pair, 'es') : undefined}>
  {entry ? <TireSizeEntity entry={entry} locale="es" /> : pair ? <TireComparisonEntity pair={pair} locale="es" /> : <TireDiameterGroup group={group!} locale="es" />}
</SiteLayout>

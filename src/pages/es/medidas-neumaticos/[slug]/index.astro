---
// Localized tire-size detail pages (ES).
//
// One route file generates every page in this locale: getStaticPaths() returns one entry per
// row of tireSizeCatalog, sourced from the production-size reference plus documented vehicle-only
// OEM sizes. Adding a sourced size publishes a new page here on the next build with no new file.
import SiteLayout from '../../../../components/SiteLayout.astro';
import TireSizeEntity from '../../../../components/TireSizeEntity.astro';
import { tireSizeCatalog, type TireSizeEntry } from '../../../../data/tire-size-catalog';
import { tireSizeDetailMeta } from '../../../../ui/entity-page-model';

export function getStaticPaths() {
  // tireSizeCatalog has already rejected malformed/out-of-range source data, so anything reaching
  // this point is a page with real, validated reference data behind it.
  return tireSizeCatalog.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: TireSizeEntry; }
const { entry } = Astro.props as Props;
const meta = tireSizeDetailMeta(entry, 'es');
---
<SiteLayout title={meta.title} description={meta.description} pathname={meta.pathname} active="tools" locale="es" alternates={meta.alternates} breadcrumbs={meta.breadcrumbs}>
  <TireSizeEntity entry={entry} locale="es" />
</SiteLayout>

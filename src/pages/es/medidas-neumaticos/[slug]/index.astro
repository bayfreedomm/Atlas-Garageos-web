---
// Localized tire-size detail pages (ES).
//
// One route file generates every page in this locale: one page per row of tireSizeCatalog
// (production-size reference, flotation sizes and documented vehicle-only OEM sizes), plus one
// "N-inch tires" page per tire-height group. Adding a sourced size publishes its page and
// updates its height group on the next build with no new file.
import SiteLayout from '../../../../components/SiteLayout.astro';
import TireSizeEntity from '../../../../components/TireSizeEntity.astro';
import TireDiameterGroup from '../../../../components/TireDiameterGroup.astro';
import { tireSizeCatalog, type TireSizeEntry } from '../../../../data/tire-size-catalog';
import { tireSizeIndexing } from '../../../../seo/index-policy';
import { tireDiameterGroupMeta, tireDiameterGroupSlug, tireDiameterGroups, tireSizeDetailMeta, type TireDiameterGroup as DiameterGroup } from '../../../../ui/entity-page-model';

export function getStaticPaths() {
  // tireSizeCatalog has already rejected malformed/out-of-range source data, so anything reaching
  // this point is a page with real, validated reference data behind it.
  return [
    ...tireSizeCatalog.map((entry) => ({ params: { slug: entry.slug }, props: { entry, group: undefined } })),
    ...tireDiameterGroups().map((group) => ({ params: { slug: tireDiameterGroupSlug(group.inches, 'es') }, props: { entry: undefined, group } })),
  ];
}

interface Props { entry: TireSizeEntry | undefined; group: DiameterGroup | undefined; }
const { entry, group } = Astro.props as Props;
const meta = entry ? tireSizeDetailMeta(entry, 'es') : tireDiameterGroupMeta(group!, 'es');
// Low-value localized sizes stay live but noindex; see src/seo/index-policy.ts.
const indexing = entry ? tireSizeIndexing(entry, 'es') : undefined;
---
<SiteLayout title={meta.title} description={meta.description} pathname={meta.pathname} active="tools" locale="es" alternates={meta.alternates} indexable={indexing?.indexable ?? true} hreflangAlternates={indexing?.hreflang} breadcrumbs={meta.breadcrumbs}>
  {entry ? <TireSizeEntity entry={entry} locale="es" /> : <TireDiameterGroup group={group!} locale="es" />}
</SiteLayout>

---
import ToolPage from '../../../../components/ToolPage.astro';
import WheelOffsetTechnicalVisual from '../../../../components/WheelOffsetTechnicalVisual.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('wheel-offset-calculator');
const c = localizedTool('wheel-offset-calculator', 'es');
---
<ToolPage {definition} locale="es" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/es/tools/medir-holgura-coche/" alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/wheel-offset-calculator/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/felgen-et-rechner/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/calculadora-offset-llantas/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/wheel-offset-calculator/' }]}>
  <form slot="tool" class="calculator-form" data-calculator="wheel-offset" novalidate>
    <div class="calculator-columns">
      <fieldset class="calculator-group"><legend>Llanta original</legend><div class="grid"><label>Ancho · J<input name="originalWidthInches" type="number" value="8" step="0.5" inputmode="decimal" /></label><label>Offset · ET<input name="originalOffsetMm" type="number" value="40" inputmode="numeric" /></label></div></fieldset>
      <fieldset class="calculator-group"><legend>Llanta nueva</legend><div class="grid"><label>Ancho · J<input name="newWidthInches" type="number" value="8.5" step="0.5" inputmode="decimal" /></label><label>Offset · ET<input name="newOffsetMm" type="number" value="35" inputmode="numeric" /></label></div></fieldset>
    </div>
    <div class="form-actions"><button type="submit">Comparar posición de la rueda</button><button type="button" class="secondary" data-share-result>Copiar enlace para compartir</button></div>
    <div class="inline-errors" data-errors role="alert" hidden></div>
    <section class="wheel-primary-result is-pending" data-wheel-primary-result aria-live="polite" aria-label="Resultado principal de la posición de la rueda">
      <div class="wheel-primary-result__answer">
        <span>Cambio en el borde exterior</span>
        <strong data-wheel-primary-outer>—</strong>
        <p data-wheel-primary-outer-copy>Compare las llantas para ver cuánto se desplaza el borde exterior.</p>
      </div>
      <div class="wheel-primary-result__inner">
        <span>Cambio en el borde interior</span>
        <strong data-wheel-primary-inner>—</strong>
        <small data-wheel-primary-inner-copy>Muestra el movimiento hacia o desde el tren de rodaje.</small>
      </div>
    </section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Su resumen de posición aparecerá aquí.</p>
    <WheelOffsetTechnicalVisual />
    <div class="wheel-detail-heading" aria-hidden="true"><span>Detalles</span><small>Geometría estática de la rueda</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeShareableToolState } from '../../../../ui/shareable-tool-state'; import { initializeToolCalculators } from '../../../../ui/tool-calculators'; initializeShareableToolState(); initializeToolCalculators();</script>

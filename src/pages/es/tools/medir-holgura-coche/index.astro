---
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('measure-my-car');
const c = localizedTool('measure-my-car', 'es');
---
<ToolPage {definition} locale="es" titleOverride={c.title} descriptionOverride={c.description} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/es/fitment-studio/#measure-flow" alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/measure-my-car/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/freigang-messen/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/medir-holgura-coche/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/measure-my-car/' }]}>
  <div slot="tool" class="entry-workspace">
    <div><p class="eyebrow">Lista de comprobación de medición</p><h2>Dos holguras, una línea base</h2><p>Confirme la llanta y el neumático actualmente montados antes de medir. Use en cada lado la holgura estática relevante más corta.</p>
      <ol class="entry-steps">
        <li><strong>Holgura interior</strong><span>Del borde de la llanta o el neumático al componente fijo de suspensión o carrocería más cercano.</span></li>
        <li><strong>Holgura exterior</strong><span>Del borde exterior de la llanta o el neumático hasta el borde del guardabarros evaluado.</span></li>
        <li><strong>Objetivos opcionales</strong><span>Añada solo márgenes elegidos por usted; Atlas no inventa ninguno.</span></li>
      </ol>
    </div>
    <a class="button" href="/es/fitment-studio/#measure-flow">Abrir el asistente de cinco pasos</a>
  </div>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>

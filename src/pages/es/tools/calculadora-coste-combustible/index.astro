---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import FuelFields from '../../../../components/FuelFields.astro';
import FuelCostTechnicalVisual from '../../../../components/FuelCostTechnicalVisual.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
import rawFuelPrices from '../../../../data/fuel-prices.json';
import { asFuelPrices } from '../../../../data/fuel-prices-types';
const definition = toolById('fuel-cost-calculator');
const c = localizedTool('fuel-cost-calculator', 'es');
const fuelPrices = asFuelPrices(rawFuelPrices);
const e5 = fuelPrices.es.products.find((p) => p.id === 'e5');
const livePrice = fuelPrices.es.status !== 'pending' ? e5?.value : undefined;
---
<ToolPage {definition} locale="es" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('fuel-cost-calculator')}>
  <form slot="tool" class="calculator-form fuel-cost-form" data-utility-calculator="fuel-cost" novalidate>
    <FuelFields locale="es" price={livePrice} currency="EUR" />
    <a class="fuel-price-hint" href="/es/precio-gasolina-hoy/">Ver el precio de la gasolina hoy <span aria-hidden="true">→</span></a>
    <button type="submit">Calcular coste de combustible</button>
    <div class="fuel-primary-result is-pending" data-fuel-primary-result aria-live="polite" aria-label="Resultado principal del coste de combustible">
      <div class="fuel-primary-result__cost"><span>Coste de combustible estimado</span><strong data-fuel-primary-cost>—</strong><p data-fuel-primary-copy>Introduzca los datos de su trayecto para ver el coste de combustible estimado.</p></div>
      <div class="fuel-primary-result__fuel"><span>Combustible necesario</span><strong data-fuel-primary-fuel>—</strong><small data-fuel-primary-rate>El coste por distancia aparecerá aquí.</small></div>
    </div>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Su estimación de combustible aparecerá aquí.</p>
    <FuelCostTechnicalVisual locale="es" />
    <div class="fuel-detail-heading" aria-hidden="true"><span>Detalles</span><small>Desglose de combustible y coste</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

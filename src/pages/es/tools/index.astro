---
import { platformAlternates } from '../../../seo/locale-alternates';
import SiteLayout from '../../../components/SiteLayout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import { platformCatalog } from '../../../localization/site-catalog';
const c = platformCatalog.es.toolsHub;
const alternates = platformAlternates('/tools/');
---
<SiteLayout title={c.title} description={c.description} pathname="/es/tools/" active="tools" locale="es" alternates={alternates} breadcrumbs={[{ name: 'Inicio', href: '/es/' }, { name: 'Herramientas', href: '/es/tools/' }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/es/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Herramientas</span></nav>
  <header class="directory-identity"><h1>{c.h1}</h1><p>{c.lead}</p></header>
  <ToolDirectory mode="all" locale="es" />
  <a class="fitment-directory-row" href="/es/fitment-studio/"><strong>{c.fitmentRowTitle}</strong><span>{c.fitmentRowCopy}</span><i aria-hidden="true">›</i></a>
  <a class="fitment-directory-row" href="/es/vehiculos/"><strong>Referencia de Ajuste de Vehículos</strong><span>Neumático documentado, patrón de birlos y par cualificado por marca y modelo</span><i aria-hidden="true">›</i></a>
</SiteLayout>

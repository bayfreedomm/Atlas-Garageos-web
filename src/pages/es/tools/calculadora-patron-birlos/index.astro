---
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import Parametric3DPanel from '../../../../components/Parametric3DPanel.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('bolt-pattern-calculator');
const c = localizedTool('bolt-pattern-calculator', 'es');
---
<ToolPage {definition} locale="es" titleOverride={c.title} descriptionOverride={c.description} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/bolt-pattern-calculator/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/lochkreis-rechner/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/calculadora-patron-birlos/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/bolt-pattern-calculator/' }]}>
  <form slot="tool" class="calculator-form" data-calculator="bolt-pattern" novalidate>
    <div class="utility-fields">
      <label>Número de birlos<select name="lugCount"><option value="3">3</option><option value="4">4</option><option value="5" selected>5</option><option value="6">6</option><option value="8">8</option><option value="10">10</option></select></label>
      <label>Distancia entre orificios<input name="spacing" type="number" value="67.1" min="0" step="any" inputmode="decimal" /></label>
      <label>Unidad<select name="spacingUnit"><option value="mm" selected>mm</option><option value="in">in</option></select></label>
    </div>
    <UtilityResultStandard locale="es" primaryLabel="Diámetro del círculo de birlos (PCD)" pending="Introduzca el número de birlos y la distancia entre orificios." visualTitle="Orificios adyacentes → círculo de birlos" visualNote="Relación trigonométrica, no una medida en línea recta" />
    <Parametric3DPanel mode="pcd" locale="es" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeBoltPatternCalculator } from '../../../../ui/bolt-pattern-calculator'; import { initializeShareableToolState } from '../../../../ui/shareable-tool-state'; initializeBoltPatternCalculator(); initializeShareableToolState();</script>

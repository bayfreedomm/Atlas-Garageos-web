---
import SiteLayout from '../../../components/SiteLayout.astro';
import { vehiclePageText } from '../../../content/vehicle-page-text';
import { vehicleFitmentData } from '../../../data/vehicle-fitment';
import { vehicleAlternates, vehiclePagePath } from '../../../ui/entity-page-model';

const t = vehiclePageText.es;
const pathname = '/es/vehiculos/';
const sorted = vehicleFitmentData.slice().sort((a, b) => `${a.make} ${a.model}`.localeCompare(`${b.make} ${b.model}`));
const groups = (['eu', 'us'] as const).map((market) => ({ market, label: market === 'us' ? t.hubUsMarket : t.hubEuMarket, vehicles: sorted.filter((v) => v.market === market) }));
---
<SiteLayout title={t.hubTitle} description={t.hubDescription} pathname={pathname} active="tools" locale="es" alternates={vehicleAlternates()} breadcrumbs={[{ name: t.breadcrumbHome, href: '/es/' }, { name: t.breadcrumbVehicles, href: pathname }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/es/">{t.breadcrumbHome}</a><span aria-hidden="true">/</span><span aria-current="page">{t.breadcrumbVehicles}</span></nav>
  <header class="directory-identity methodology-hero">
    <p class="eyebrow">{sorted.length} · {t.breadcrumbVehicles}</p>
    <h1>{t.hubTitle}</h1>
    <p>{t.hubLead}</p>
  </header>
  <section class="vehicle-fuel-journey" aria-labelledby="vehicle-hub-fuel-heading">
    <h2 id="vehicle-hub-fuel-heading">{t.fuelHeading}</h2>
    <div class="vehicle-fuel-journey__cards">
      <a class="vehicle-fuel-card" href="/es/vehiculos/comparar/"><strong>Comparar dos vehículos</strong><span>Contrastar diferencias documentadas de ruedas, neumáticos y ajuste.</span><i aria-hidden="true">›</i></a>
      <a class="vehicle-fuel-card" href="/es/precio-gasolina-hoy/"><strong>{t.fuelCardTitle}</strong><span>{t.fuelCardCopy}</span><i aria-hidden="true">›</i></a>
      <a class="vehicle-fuel-card" href="/es/tools/calculadora-coste-viaje/"><strong>{t.tripCardTitle}</strong><span>{t.tripCardCopy}</span><i aria-hidden="true">›</i></a>
    </div>
  </section>
  {groups.map((group) => group.vehicles.length > 0 && (
    <section class="entity-section" aria-label={group.label}>
      <h2>{group.label} <span class="entity-card__meta">· {group.vehicles.length}</span></h2>
      <div class="methodology-source-links">
        {group.vehicles.map((v) => <a href={vehiclePagePath('es', v.id)}>{v.make} {v.model} — {v.tireSize} · {v.boltPattern} <span>›</span></a>)}
      </div>
    </section>
  ))}
</SiteLayout>

---
import SiteLayout from '../../../components/SiteLayout.astro';
import FuelMarketSwitcher from '../../../components/FuelMarketSwitcher.astro';
import FuelMarketHeader from '../../../components/FuelMarketHeader.astro';
import FuelPriceBoard from '../../../components/FuelPriceBoard.astro';
import FuelMarketSnapshot from '../../../components/FuelMarketSnapshot.astro';
import FuelTrendPanel from '../../../components/FuelTrendPanel.astro';
import FuelActionPanel from '../../../components/FuelActionPanel.astro';
import { serializeJsonLd } from '../../../seo/safe-json-ld';
import rawFuelPrices from '../../../data/fuel-prices.json';
import rawFuelPriceHistory from '../../../data/fuel-price-history.json';
import { asFuelPrices, asFuelPriceHistory } from '../../../data/fuel-prices-types';
import { summarizeSeries, type RangeOption, type SnapshotMetric } from '../../../ui/fuel-market-metrics';

const fuelPrices = asFuelPrices(rawFuelPrices);
const fuelPriceHistory = asFuelPriceHistory(rawFuelPriceHistory);
const data = fuelPrices.es;
const title = 'Precio de la gasolina hoy en España — Gasolina 95, 98 y diésel';
const description = 'Precio medio nacional de la gasolina y el diésel en España según el conjunto de datos oficial del Ministerio, con métricas de mercado, histórico y acceso directo a las calculadoras.';
const pathname = '/es/precio-gasolina-hoy/';
// These market dashboards are different datasets, not translations. Keep navigation in
// FuelMarketSwitcher, but publish no hreflang relationship between them.
const alternates: readonly [] = [];

const referenceDate = data.status === 'pending' ? null : data.status === 'stale' ? data.lastSuccessAt : (data.lastSuccessAt ?? data.lastAttemptAt);
const dateLabel = referenceDate ? new Date(referenceDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }) : null;
const timeLabel = referenceDate ? new Date(referenceDate).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) : null;

const historyPoints = (id: string) => fuelPriceHistory.es.map((row) => ({ date: row.date, value: row.products[id] ?? 0 })).filter((point) => point.value > 0);

const e5 = data.products.find((product) => product.id === 'e5');
const e5Summary = summarizeSeries(historyPoints('e5'), e5?.value ?? null);
const euro = (value: number | null) => (value === null ? null : `${value.toFixed(3).replace('.', ',')} €`);
const changeTone = e5Summary.changeAbs === null || e5Summary.changeAbs === 0 ? 'flat' : e5Summary.changeAbs > 0 ? 'up' : 'down';
const notEnough = 'Aún no hay datos suficientes';

const metrics: readonly SnapshotMetric[] = [
  { label: 'Gasolina 95 actual', value: euro(e5Summary.current), placeholder: 'Sin precio verificado', detail: dateLabel ? `Dato de ${dateLabel}` : undefined },
  { label: 'Valor anterior', value: euro(e5Summary.previous), placeholder: notEnough, detail: e5Summary.previous !== null ? 'Última medición anterior' : undefined },
  {
    label: 'Variación',
    value: e5Summary.changeAbs === null ? null : `${e5Summary.changeAbs > 0 ? '+' : '−'}${Math.abs(e5Summary.changeAbs).toFixed(3).replace('.', ',')} €`,
    placeholder: notEnough,
    detail: e5Summary.changePct === null ? undefined : `${e5Summary.changePct > 0 ? '+' : '−'}${Math.abs(e5Summary.changePct).toFixed(1).replace('.', ',')} % respecto a la medición anterior`,
    tone: changeTone,
  },
  { label: 'Media del periodo', value: euro(e5Summary.average), placeholder: notEnough, detail: e5Summary.count > 0 ? `${e5Summary.count} medición${e5Summary.count === 1 ? '' : 'es'} verificada${e5Summary.count === 1 ? '' : 's'}` : undefined },
  { label: 'Mínimo reciente', value: euro(e5Summary.low), placeholder: notEnough, detail: e5Summary.firstDate ? `Desde ${e5Summary.firstDate}` : undefined },
  { label: 'Estaciones en la media', value: e5 ? `${e5.sampleSize}` : null, placeholder: notEnough, detail: e5 ? 'Estaciones que reportan Gasolina 95' : 'Número de estaciones incluidas' },
];

const ranges: readonly RangeOption[] = [
  { id: '7d', label: '7D', days: 7 },
  { id: '30d', label: '30D', days: 30 },
  { id: '90d', label: '90D', days: 90 },
  { id: '6m', label: '6M', days: 182 },
  { id: '1y', label: '1A', days: 365 },
];

const statusLabel = data.status === 'fresh' ? 'Verificado' : data.status === 'stale' ? 'Último valor verificado' : 'Sin verificar todavía';
const actionNote = data.status === 'pending'
  ? 'Todavía no hay un precio verificado, así que las calculadoras parten de su valor por defecto — introduzca el de su gasolinera.'
  : 'Las calculadoras parten del último precio por litro verificado; puede cambiarlo en cualquier momento.';

const faqs = [
  {
    q: '¿De dónde salen estos precios de la gasolina?',
    a: data.status === 'pending' ? 'Todavía no hemos completado una consulta verificada al Ministerio — vuelva a comprobarlo pronto.' : `Los precios provienen de ${data.source}, el conjunto de datos público oficial de precios de carburantes en España, que cubre las estaciones de todo el país.`,
  },
  {
    q: '¿Con qué frecuencia se actualizan los precios?',
    a: 'De forma automática mediante una consulta programada varias veces al día, no en cada visita, para no sobrecargar la fuente oficial. Si una consulta falla, mostramos honestamente el último valor confirmado en lugar de inventar una cifra.',
  },
  {
    q: '¿Por qué el mercado alemán muestra una muestra y no una media nacional?',
    a: 'Alemania no dispone de un conjunto de datos oficial nacional y gratuito comparable al español. Lo que sí se puede obtener son precios de estaciones concretas, así que la página alemana informa de una muestra supervisada por Atlas de estaciones de ciudades seleccionadas y lo dice claramente.',
  },
  {
    q: '¿Puedo usar este precio para mi gasolinera concreta?',
    a: 'No. Es una media nacional orientativa, no el precio de una estación en particular. Puede ajustar el precio manualmente en cualquiera de nuestras calculadoras.',
  },
];
const faqJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const datasetJsonLd = data.status !== 'pending' ? serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Precio de la gasolina en España (media nacional)',
  description: 'Precio medio nacional de la gasolina y el diésel en España a partir del conjunto de datos oficial del Ministerio.',
  license: 'https://www.mites.gob.es/es/informacion/avisoLegal/index.htm',
  temporalCoverage: referenceDate,
  url: 'https://atlasgarageos.com/es/precio-gasolina-hoy/',
  creator: { '@type': 'Organization', name: 'Atlas GarageOS' },
}) : null;
---
<SiteLayout title={title} description={description} pathname={pathname} active="tools" locale="es" alternates={alternates} breadcrumbs={[{ name: 'Inicio', href: '/es/' }, { name: 'Precio de la gasolina hoy', href: pathname }]}>
  <script is:inline type="application/ld+json" set:html={faqJsonLd}></script>
  {datasetJsonLd && <script is:inline type="application/ld+json" set:html={datasetJsonLd}></script>}
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/es/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Precio de la gasolina hoy</span></nav>

  <FuelMarketSwitcher
    current="es"
    legend="Mercados de carburante"
    markets={[
      { id: 'us', href: '/gas-prices-today/', label: 'Estados Unidos', note: 'Media semanal de la EIA' },
      { id: 'de', href: '/de/kraftstoffpreise/', label: 'Alemania', note: 'Muestra supervisada de estaciones' },
      { id: 'es', href: '/es/precio-gasolina-hoy/', label: 'España', note: 'Conjunto de datos oficial' },
    ]}
  />

  <FuelMarketHeader
    market="Precio de la gasolina hoy en España"
    status={data.status}
    statusLabel={statusLabel}
    sourceKind="Conjunto de datos nacional oficial — Ministerio para la Transición Ecológica, estaciones de toda España."
    meta={[
      { label: 'Dato de', value: dateLabel ? `${dateLabel}, ${timeLabel}` : 'Sin datos' },
      { label: 'Última verificación', value: dateLabel ?? 'Nunca' },
      { label: 'Frecuencia de la fuente', value: 'Diaria (consulta programada varias veces al día)' },
      { label: 'Actualización', value: 'Automática y programada' },
    ]}
  />

  <FuelPriceBoard
    market="España"
    ariaLabel="Panel de precios de combustible actual para España"
    cadence="live"
    status={data.status}
    cadenceLabel={data.status === 'pending' ? 'DATOS PENDIENTES' : 'ACTUALIZADO VARIAS VECES AL DÍA'}
    updatedLabel={dateLabel ? `${dateLabel}, ${timeLabel}` : 'Sin datos verificados'}
    sourceLabel={data.source}
    pendingMessage="Todavía no hemos completado una consulta verificada. Aquí no se muestra ningún precio hasta que sea real."
    staleLabel={dateLabel ? `Confirmado por última vez el ${dateLabel}` : 'Último valor conocido'}
    rows={data.products.map((p) => ({ label: p.label, value: p.value.toFixed(2).replace('.', ','), unit: '€/L' }))}
  />

  <FuelMarketSnapshot heading="Resumen del mercado — Gasolina 95" metrics={metrics} />

  <FuelTrendPanel
    heading="Histórico de precios"
    rangeLegend="Elegir un periodo"
    ranges={ranges}
    buildingLabel="El histórico se construye con cada medición verificada — todavía no hay suficientes puntos para una tendencia."
    sinceLabelTemplate="Últimas {days} mediciones"
    lowLabel="Mín"
    highLabel="Máx"
    series={[
      { id: 'es-e5', label: 'Gasolina 95', unit: '€', points: historyPoints('e5') },
      { id: 'es-diesel', label: 'Gasóleo A', unit: '€', points: historyPoints('diesel') },
    ]}
  />

  <FuelActionPanel
    heading="Calcular con este precio"
    note={actionNote}
    actions={[
      { href: '/es/tools/calculadora-coste-combustible/', title: 'Usar este precio en la calculadora de combustible', detail: 'Combustible usado y coste total del trayecto' },
      { href: '/es/tools/calculadora-coste-viaje/', title: 'Calcular el coste de un viaje', detail: 'Trayecto, extras y coste por persona' },
      { href: '/es/vehiculos/', title: 'Estimar el coste por vehículo', detail: 'Partir de un vehículo concreto' },
    ]}
  />

  <div class="fuel-dash-prose">
    <section class="methodology-sources" aria-labelledby="fuel-source-heading">
      <p class="eyebrow">Fuente</p>
      <h2 id="fuel-source-heading">¿De dónde salen estos datos?</h2>
      <p>{data.source}. {fuelPrices.disclaimer}</p>
      <p>España sí dispone de un conjunto de datos nacional oficial, así que estas cifras se describen como media nacional. El mercado alemán, en cambio, es una muestra supervisada de estaciones de ciudades seleccionadas y se identifica como tal.</p>
      <div class="methodology-source-links"><a href={data.sourceUrl} rel="external noopener">Ver fuente <span>↗</span></a></div>
    </section>

    <section aria-labelledby="fuel-faq-heading">
      <h2 id="fuel-faq-heading">Preguntas frecuentes</h2>
      {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
  </div>
</SiteLayout>

---
import { platformAlternates } from '../../seo/locale-alternates';
import SiteLayout from '../../components/SiteLayout.astro';
import HomeLauncher from '../../components/HomeLauncher.astro';
import { platformCatalog } from '../../localization/site-catalog';
const c = platformCatalog.es.home;
const alternates = platformAlternates('/');
---
<SiteLayout title={c.title} description={c.description} pathname="/es/" active="home" locale="es" alternates={alternates}>
  <HomeLauncher locale="es" />
</SiteLayout>

---
// Localized tire-size detail pages (pl): one page per catalog size plus one page per tire-height group.
import SiteLayout from '../../../../components/SiteLayout.astro';
import TireSizeEntity from '../../../../components/TireSizeEntity.astro';
import TireComparisonEntity from '../../../../components/TireComparisonEntity.astro';
import TireDiameterGroup from '../../../../components/TireDiameterGroup.astro';
import { tireSizeCatalog, type TireSizeEntry } from '../../../../data/tire-size-catalog';
import { tireDiameterGroupMeta, tireDiameterGroupSlug, tireDiameterGroups, tireSizeDetailMeta, type TireDiameterGroup as DiameterGroup } from '../../../../ui/entity-page-model';
import { tireComparisonPairs, type TireComparisonPair } from '../../../../data/tire-comparisons';
import { tireComparisonMeta } from '../../../../ui/tire-comparison';

export function getStaticPaths() {
  return [
    ...tireSizeCatalog.map((entry) => ({ params: { slug: entry.slug }, props: { entry, group: undefined, pair: undefined } })),
    ...tireDiameterGroups().map((group) => ({ params: { slug: tireDiameterGroupSlug(group.inches, 'pl') }, props: { entry: undefined, group, pair: undefined } })),
    // Factory-backed "X vs Y" comparisons (src/data/tire-comparisons.ts), e.g. 205-55-r16-vs-225-45-r17.
    ...tireComparisonPairs.map((pair) => ({ params: { slug: pair.slug }, props: { entry: undefined, group: undefined, pair } })),
  ];
}

interface Props { entry: TireSizeEntry | undefined; group: DiameterGroup | undefined; pair: TireComparisonPair | undefined; }
const { entry, group, pair } = Astro.props as Props;
const meta = entry ? tireSizeDetailMeta(entry, 'pl') : pair ? tireComparisonMeta(pair, 'pl') : tireDiameterGroupMeta(group!, 'pl');
---
<SiteLayout title={meta.title} description={meta.description} pathname={meta.pathname} active="tools" locale="pl" alternates={meta.alternates} breadcrumbs={meta.breadcrumbs}>
  {entry ? <TireSizeEntity entry={entry} locale="pl" /> : pair ? <TireComparisonEntity pair={pair} locale="pl" /> : <TireDiameterGroup group={group!} locale="pl" />}
</SiteLayout>

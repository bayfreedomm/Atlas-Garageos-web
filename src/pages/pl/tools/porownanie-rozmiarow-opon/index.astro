---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import EmbedCodePanel from '../../../../components/EmbedCodePanel.astro';
import TireInputGroup from '../../../../components/TireInputGroup.astro';
import TireVisualStudio from '../../../../components/TireVisualStudio.astro';
import GuidedTireDecision from '../../../../components/GuidedTireDecision.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('tire-size-comparison');
const c = localizedTool('tire-size-comparison', 'pl');
---
<ToolPage {definition} locale="pl" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} alternates={toolAlternates('tire-size-comparison')}>
  <form slot="tool" class="calculator-form" data-calculator="tire-comparison" novalidate>
    <div class="garage-quick-load" data-garage-quick-load data-gql-target="tire-comparison" data-gql-locale="pl" hidden></div>
    <div class="calculator-columns">
      <TireInputGroup locale="pl" prefix="original-" title="Opona oryginalna" width={225} aspect={45} rim={18} />
      <TireInputGroup locale="pl" prefix="new-" title="Nowa opona" width={235} aspect={40} rim={19} />
    </div>
    <div class="form-actions">
      <button type="submit">Porównaj rozmiary opon</button>
      <button type="button" class="secondary" data-share-result>Kopiuj link do udostępnienia</button>
    </div>
    <div class="inline-errors" data-errors role="alert" hidden></div>
    <section class="tire-primary-result is-pending" data-tire-primary-result aria-live="polite" aria-label="Główny wynik porównania opon">
      <div class="tire-primary-result__answer">
        <span>Zmiana średnicy</span>
        <strong data-tire-primary-percent>—</strong>
        <p data-tire-primary-copy>Porównaj oba rozmiary, aby zobaczyć główną zmianę.</p>
      </div>
      <div class="tire-primary-result__speed">
        <span>Przy wskazaniu 100 km/h</span>
        <strong data-tire-speed-example>—</strong>
        <small>Teoretyczny przykład geometrii toczenia</small>
      </div>
    </section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Tutaj pojawi się podsumowanie porównania.</p>
    <TireVisualStudio locale="pl" />
    <GuidedTireDecision locale="pl" />
    <div class="tire-detail-heading" aria-hidden="true"><span>Szczegóły</span><small>Geometria nominalna</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
  <EmbedCodePanel slot="explanation" locale="pl" />
</ToolPage>
<script>import { initializeShareableToolState } from '../../../../ui/shareable-tool-state'; import { initializeToolCalculators } from '../../../../ui/tool-calculators'; import { initializeGarageQuickLoad } from '../../../../ui/garage-quick-load'; initializeShareableToolState(); initializeToolCalculators(); initializeGarageQuickLoad();</script>

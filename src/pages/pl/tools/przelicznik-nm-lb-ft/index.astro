---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('nm-lb-ft-converter');
const c = localizedTool('nm-lb-ft-converter', 'pl');
---
<ToolPage {definition} locale="pl" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('nm-lb-ft-converter')}>
  <form slot="tool" class="calculator-form instant-calculator" data-utility-calculator="torque" novalidate>
    <div class="instant-input"><label>Moment obrotowy<input name="value" type="number" value="300" min="0" step="any" inputmode="decimal" /></label><label>Jednostka<select name="unit"><option value="nm">Nm</option><option value="lb-ft">lb-ft</option></select></label></div>
    <UtilityResultStandard locale="pl" primaryLabel="Przeliczony moment obrotowy" pending="Wpisz wartość momentu obrotowego." visualTitle="Jeden moment obrotowy, dwie jednostki" visualNote="Dokładne przeliczenie jednostek, a nie szacunek dla silnika" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

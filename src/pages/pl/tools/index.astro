---
import { platformAlternates } from '../../../seo/locale-alternates';
import SiteLayout from '../../../components/SiteLayout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import { platformCatalog } from '../../../localization/site-catalog';
const c = platformCatalog.pl.toolsHub;
const alternates = platformAlternates('/tools/');
---
<SiteLayout title={c.title} description={c.description} pathname="/pl/tools/" active="tools" locale="pl" alternates={alternates} breadcrumbs={[{ name: 'Strona główna', href: '/pl/' }, { name: 'Narzędzia', href: '/pl/tools/' }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/pl/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">Narzędzia</span></nav>
  <header class="directory-identity"><h1>{c.h1}</h1><p>{c.lead}</p></header>
  <ToolDirectory mode="all" locale="pl" />
  <a class="fitment-directory-row" href="/pl/fitment-studio/"><strong>{c.fitmentRowTitle}</strong><span>{c.fitmentRowCopy}</span><i aria-hidden="true">›</i></a>
  <a class="fitment-directory-row" href="/pl/pojazdy/"><strong>Baza dopasowania pojazdów</strong><span>Udokumentowany rozmiar opon, rozstaw śrub (PCD) i moment dokręcania według marki i modelu</span><i aria-hidden="true">›</i></a>
</SiteLayout>

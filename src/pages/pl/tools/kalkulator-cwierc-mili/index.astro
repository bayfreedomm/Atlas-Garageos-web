---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('quarter-mile-calculator');
const c = localizedTool('quarter-mile-calculator', 'pl');
---
<ToolPage {definition} locale="pl" titleOverride={c.title} descriptionOverride={c.description} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('quarter-mile-calculator')}>
  <form slot="tool" class="calculator-form" data-calculator="quarter-mile" novalidate>
    <div class="utility-fields">
      <label>Masa pojazdu<input name="weight" type="number" value="3400" min="0" step="any" inputmode="decimal" /></label>
      <label>Jednostka masy<select name="weightUnit"><option value="lb" selected>lb</option><option value="kg">kg</option></select></label>
      <label>Moc<input name="power" type="number" value="300" min="0" step="any" inputmode="decimal" /></label>
      <label>Jednostka mocy<select name="powerUnit"><option value="hp" selected>KM mechaniczne (hp)</option><option value="kw">kW</option></select></label>
    </div>
    <UtilityResultStandard locale="pl" primaryLabel="Szacowany czas na ćwierć mili" pending="Wpisz masę pojazdu i moc." visualTitle="Masa ÷ moc → czas przejazdu" visualNote="Klasyczny szacunek stosunku masy do mocy w wyścigach równoległych" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeQuarterMileCalculator } from '../../../../ui/quarter-mile-calculator'; initializeQuarterMileCalculator();</script>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import FuelFields from '../../../../components/FuelFields.astro';
import FuelCostTechnicalVisual from '../../../../components/FuelCostTechnicalVisual.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('fuel-cost-calculator');
const c = localizedTool('fuel-cost-calculator', 'pl');
---
<ToolPage {definition} locale="pl" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('fuel-cost-calculator')}>
  <form slot="tool" class="calculator-form fuel-cost-form" data-utility-calculator="fuel-cost" novalidate>
    <FuelFields locale="pl" currency="PLN" />
    <a class="fuel-price-hint" href="/gas-prices-today/">Ceny paliw w USA (po angielsku) <span aria-hidden="true">→</span></a>
    <button type="submit">Oblicz koszt paliwa</button>
    <div class="fuel-primary-result is-pending" data-fuel-primary-result aria-live="polite" aria-label="Główny wynik kosztu paliwa">
      <div class="fuel-primary-result__cost"><span>Szacowany koszt paliwa</span><strong data-fuel-primary-cost>—</strong><p data-fuel-primary-copy>Wpisz dane trasy, aby zobaczyć szacowany koszt paliwa.</p></div>
      <div class="fuel-primary-result__fuel"><span>Potrzebne paliwo</span><strong data-fuel-primary-fuel>—</strong><small data-fuel-primary-rate>Tutaj pojawi się koszt na kilometr.</small></div>
    </div>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Tutaj pojawi się szacunek zużycia paliwa.</p>
    <FuelCostTechnicalVisual locale="pl" />
    <div class="fuel-detail-heading" aria-hidden="true"><span>Szczegóły</span><small>Zestawienie paliwa i kosztów</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('measure-my-car');
const c = localizedTool('measure-my-car', 'pl');
---
<ToolPage {definition} locale="pl" titleOverride={c.title} descriptionOverride={c.description} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/pl/fitment-studio/#measure-flow" alternates={toolAlternates('measure-my-car')}>
  <div slot="tool" class="entry-workspace">
    <div><p class="eyebrow">Lista kontrolna pomiaru</p><h2>Dwa luzy, jeden punkt odniesienia</h2><p>Przed pomiarem upewnij się, jaka felga i opona są obecnie zamontowane. Po każdej stronie użyj najmniejszego istotnego luzu statycznego.</p>
      <ol class="entry-steps">
        <li><strong>Luz wewnętrzny</strong><span>Od krawędzi felgi lub opony do najbliższego stałego elementu zawieszenia lub nadwozia.</span></li>
        <li><strong>Luz zewnętrzny</strong><span>Od zewnętrznej krawędzi felgi lub opony do ocenianej krawędzi nadkola.</span></li>
        <li><strong>Opcjonalne cele</strong><span>Dodaj tylko wybrane przez siebie marginesy; Atlas żadnych nie wymyśla.</span></li>
      </ol>
    </div>
    <a class="button" href="/pl/fitment-studio/#measure-flow">Otwórz pięciokrokowy kreator</a>
  </div>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>

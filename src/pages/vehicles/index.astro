---
import SiteLayout from '../../components/SiteLayout.astro';
import { vehiclePageText } from '../../content/vehicle-page-text';
import { vehicleFitmentData } from '../../data/vehicle-fitment';

const t = vehiclePageText.en;
const pathname = '/vehicles/';
const vehicles = vehicleFitmentData.filter((v) => v.market === 'us').slice().sort((a, b) => `${a.make} ${a.model}`.localeCompare(`${b.make} ${b.model}`));
---
<SiteLayout title={t.hubTitle} description={t.hubDescription} pathname={pathname} active="tools" alternates={[{ hreflang: 'en', href: `https://atlasgarageos.com${pathname}` }, { hreflang: 'x-default', href: `https://atlasgarageos.com${pathname}` }]} breadcrumbs={[{ name: t.breadcrumbHome, href: '/' }, { name: t.breadcrumbVehicles, href: pathname }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">{t.breadcrumbHome}</a><span aria-hidden="true">/</span><span aria-current="page">{t.breadcrumbVehicles}</span></nav>
  <header class="directory-identity methodology-hero">
    <p class="eyebrow">{t.hubUsMarket}</p>
    <h1>{t.hubTitle}</h1>
    <p>{t.hubLead}</p>
  </header>
  <section class="vehicle-fuel-journey" aria-labelledby="vehicle-hub-fuel-heading">
    <h2 id="vehicle-hub-fuel-heading">{t.fuelHeading}</h2>
    <div class="vehicle-fuel-journey__cards">
      <a class="vehicle-fuel-card" href="/vehicles/compare/"><strong>Compare two vehicles</strong><span>See documented wheel, tire and fitment differences side by side.</span><i aria-hidden="true">›</i></a>
      <a class="vehicle-fuel-card" href="/gas-prices-today/"><strong>{t.fuelCardTitle}</strong><span>{t.fuelCardCopy}</span><i aria-hidden="true">›</i></a>
      <a class="vehicle-fuel-card" href="/tools/road-trip-cost-calculator/"><strong>{t.tripCardTitle}</strong><span>{t.tripCardCopy}</span><i aria-hidden="true">›</i></a>
    </div>
  </section>
  <div class="methodology-source-links">
    {vehicles.map((v) => <a href={`/vehicles/${v.id}/`}>{v.make} {v.model} — {v.tireSize} <span>↗</span></a>)}
  </div>
</SiteLayout>

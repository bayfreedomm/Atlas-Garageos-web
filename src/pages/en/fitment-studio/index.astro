---
import { canonicalForPath, toolById } from '../../../seo/tool-registry';
import { translate } from '../../../localization/catalog';
import '../../../styles/global.css';

const seo = toolById('fitment-studio');
const t = (key: Parameters<typeof translate>[1]) => translate('en', key);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={seo.description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalForPath('/en/fitment-studio/')} />
    <link rel="alternate" hreflang="en" href={canonicalForPath('/en/fitment-studio/')} />
    <link rel="alternate" hreflang="x-default" href={canonicalForPath('/')} />
    <title>{seo.title} — Atlas GarageOS</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to Fitment Studio</a>

    <header class="app-header">
      <div class="app-header__inner">
        <a class="brand" href="/en/fitment-studio/" aria-label="Atlas GarageOS Fitment Studio">
          <span class="brand-mark" aria-hidden="true">AG</span>
          <span class="brand-copy"><strong>Atlas GarageOS</strong><span>Fitment Studio</span></span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="#garage" data-product-nav="garage">Garage</a>
          <a href="#fitment" data-product-nav="fitment" aria-current="page">Fitment</a>
          <a href="/en/tools/tire-size-calculator/">Tools</a>
        </nav>
        <span id="shell-vehicle" class="active-vehicle-chip">No vehicle selected</span>
      </div>
    </header>

    <main id="main-content">
      <section class="studio-hero" id="fitment" aria-labelledby="studio-heading">
        <p class="eyebrow">Fitment Studio</p>
        <h1 id="studio-heading">What do you want to do?</h1>
        <p class="hero-copy">Start with your goal. Technical wheel, tire, and measurement details appear only when you need them.</p>
        <div class="intent-grid">
          <a class="intent-card" href="#compare"><span class="intent-card__number">01</span><strong>Compare setups</strong><p>See wheel position and tire geometry changes.</p></a>
          <a class="intent-card" href="#what-fits-section"><span class="intent-card__number">02</span><strong>Find what fits</strong><p>Search bounded wheel and tire combinations.</p></a>
          <a class="intent-card" href="#measure-flow"><span class="intent-card__number">03</span><strong>Measure my car</strong><p>Record the clearances your vehicle actually has.</p></a>
          <a class="intent-card" href="#fitment-map-section"><span class="intent-card__number">04</span><strong>Explore Fitment Map</strong><p>Inspect width and offset geometry cell by cell.</p></a>
        </div>
      </section>

      <aside id="shared-setup" class="shared-panel" hidden aria-labelledby="shared-heading">
        <h2 id="shared-heading">{t('sharedTitle')}</h2>
        <p id="shared-message">{t('sharedNotice')}</p>
        <div class="setup-save">
          <label for="shared-name">Saved setup name<input id="shared-name" name="shared-setup-name" value="Shared setup" maxlength="80" /></label>
          <button id="save-shared" type="button">Save shared setup</button>
        </div>
      </aside>

      <section class="product-section" id="compare" aria-labelledby="compare-heading">
        <div class="section-heading">
          <div><p class="eyebrow">Setup comparison</p><h2 id="compare-heading">Current vs new</h2><p>Enter the tire line and wheel specification exactly as marked.</p></div>
        </div>
        <form id="fitment-form" novalidate>
          <div class="setup-columns">
            <fieldset class="setup-card" data-setup="current">
              <legend class="setup-card__header"><span>Current setup</span><span class="setup-tag">Baseline</span></legend>
              <div class="spec-group"><p class="spec-group__title">Tire</p><div class="spec-row">
                <label for="current-tire-width">Width<input id="current-tire-width" name="current-tireWidthMm" type="number" value="225" step="1" inputmode="numeric" required /></label>
                <label for="current-aspect">Profile<input id="current-aspect" name="current-tireAspectRatio" type="number" value="45" step="1" inputmode="numeric" required /></label>
                <label for="current-rim">Rim R<input id="current-rim" name="current-rimDiameterInches" type="number" value="18" step="0.5" inputmode="decimal" required /></label>
              </div></div>
              <div class="spec-group"><p class="spec-group__title">Wheel</p><div class="spec-row spec-row--wheel">
                <label for="current-wheel-diameter">Diameter<input id="current-wheel-diameter" value="18" type="number" step="0.5" inputmode="decimal" data-wheel-diameter="current" readonly aria-readonly="true" /></label>
                <label for="current-wheel-width">Width J<input id="current-wheel-width" name="current-wheelWidthInches" type="number" value="8" step="0.5" inputmode="decimal" required /></label>
                <label for="current-offset">Offset ET<input id="current-offset" name="current-wheelOffsetMm" type="number" value="40" step="1" inputmode="numeric" required /></label>
              </div></div>
              <div class="setup-save"><label for="current-name">Setup name<input id="current-name" name="current-setup-name" value="Current setup" maxlength="80" /></label><button id="save-current" type="button" class="secondary">Save current</button></div>
            </fieldset>

            <fieldset class="setup-card" data-setup="proposed">
              <legend class="setup-card__header"><span>New setup</span><span class="setup-tag">Candidate</span></legend>
              <div class="spec-group"><p class="spec-group__title">Tire</p><div class="spec-row">
                <label for="new-tire-width">Width<input id="new-tire-width" name="proposed-tireWidthMm" type="number" value="235" step="1" inputmode="numeric" required /></label>
                <label for="new-aspect">Profile<input id="new-aspect" name="proposed-tireAspectRatio" type="number" value="40" step="1" inputmode="numeric" required /></label>
                <label for="new-rim">Rim R<input id="new-rim" name="proposed-rimDiameterInches" type="number" value="19" step="0.5" inputmode="decimal" required /></label>
              </div></div>
              <div class="spec-group"><p class="spec-group__title">Wheel</p><div class="spec-row spec-row--wheel">
                <label for="new-wheel-diameter">Diameter<input id="new-wheel-diameter" value="19" type="number" step="0.5" inputmode="decimal" data-wheel-diameter="proposed" readonly aria-readonly="true" /></label>
                <label for="new-wheel-width">Width J<input id="new-wheel-width" name="proposed-wheelWidthInches" type="number" value="8.5" step="0.5" inputmode="decimal" required /></label>
                <label for="new-offset">Offset ET<input id="new-offset" name="proposed-wheelOffsetMm" type="number" value="35" step="1" inputmode="numeric" required /></label>
              </div></div>
              <div class="setup-save"><label for="new-name">Setup name<input id="new-name" name="proposed-setup-name" value="New setup" maxlength="80" /></label><button id="save-proposed" type="button" class="secondary">Save new</button></div>
            </fieldset>
          </div>
          <div class="form-actions"><button type="submit">Compare setups</button><button id="copy-share" type="button" class="secondary">Share comparison</button></div>
        </form>
        <div id="errors" class="inline-errors" role="alert" aria-live="assertive" hidden></div>
        <div class="comparison-layout" aria-labelledby="results-heading">
          <figure id="comparison-visual" class="comparison-visual">
            <figcaption><p class="eyebrow">Side-view foundation</p><h3 id="results-heading">Diameter comparison</h3><p>Schematic scale reflects calculated overall diameter only.</p></figcaption>
            <div class="diameter-track" aria-hidden="true"><span class="diameter-line diameter-line--current"></span><span class="diameter-line diameter-line--new"></span></div>
            <div class="visual-legend"><span id="visual-current">Current</span><span id="visual-new">New</span></div>
          </figure>
          <dl id="results" class="metric-grid" aria-live="polite"></dl>
        </div>
      </section>

      <section class="product-section" id="measure-flow" aria-labelledby="measure-heading">
        <div class="section-heading"><div><p class="eyebrow">Measure my car</p><h2 id="measure-heading">Use your vehicle’s real gaps</h2><p>Static geometry starts with measurements you control.</p></div></div>
        <nav class="step-nav" aria-label="Measurement steps">
          <button type="button" data-measure-go="1">Current</button><button type="button" data-measure-go="2" class="secondary">Inner</button><button type="button" data-measure-go="3" class="secondary">Outer</button><button type="button" data-measure-go="4" class="secondary">Targets</button><button type="button" data-measure-go="5" class="secondary">Review</button>
        </nav>
        <div class="step-progress" aria-hidden="true"><div id="measure-progress" class="step-progress__bar"></div></div>
        <div class="step-meta"><span id="measure-step-label">Step 1 of 5</span><span>USER MEASURED</span></div>
        <div class="measure-panel" data-measure-step="1"><p class="eyebrow">Step 1</p><h3>Confirm the current setup</h3><p>The Current Setup above is the baseline for every projection. Correct it before taking measurements.</p><a class="button secondary" href="#compare">Review current setup</a></div>
        <div class="measure-panel" data-measure-step="2" hidden><p class="eyebrow">Step 2</p><h3>Measure inner clearance</h3><div class="measure-media-slot" aria-label="Reserved space for a future inner-clearance measurement illustration">Measurement illustration slot<br />Inner wheel to nearest fixed component</div><p>Measure the shortest static gap from the inner wheel or tire area to the nearest fixed suspension or body component.</p><label for="measured-inner">Inner clearance · mm<input id="measured-inner" name="measured-inner" type="number" min="0" max="1000" step="0.1" inputmode="decimal" placeholder="Required" /></label></div>
        <div class="measure-panel" data-measure-step="3" hidden><p class="eyebrow">Step 3</p><h3>Measure outer clearance</h3><div class="measure-media-slot" aria-label="Reserved space for a future outer-clearance measurement illustration">Measurement illustration slot<br />Outer wheel to fender boundary</div><p>Measure the shortest static gap from the outer wheel or tire area to the fender boundary you are evaluating.</p><label for="measured-outer">Outer clearance · mm<input id="measured-outer" name="measured-outer" type="number" min="0" max="1000" step="0.1" inputmode="decimal" placeholder="Required" /></label></div>
        <div class="measure-panel" data-measure-step="4" hidden><p class="eyebrow">Step 4</p><h3>Add optional targets</h3><p>Leave either field empty if you do not have a target. Atlas will not invent a minimum margin.</p><div class="grid"><label for="desired-inner">Desired inner · mm<input id="desired-inner" name="desired-inner" type="number" min="0" max="1000" step="0.1" inputmode="decimal" placeholder="No target" /></label><label for="desired-outer">Desired outer · mm<input id="desired-outer" name="desired-outer" type="number" min="0" max="1000" step="0.1" inputmode="decimal" placeholder="No target" /></label></div></div>
        <div class="measure-panel" data-measure-step="5" hidden><p class="eyebrow">Step 5</p><h3>Review measurements</h3><div id="measurement-review" aria-live="polite"></div><div id="measurement-errors" role="alert" aria-live="assertive" hidden></div><button id="save-clearance" type="button">Save to selected vehicle</button></div>
        <div class="step-actions"><button id="measure-back" type="button" class="secondary">Back</button><button id="measure-next" type="button">Continue</button></div>
      </section>

      <section class="product-section" id="what-fits-section" aria-labelledby="what-fits-heading">
        <div class="section-heading"><div><p class="eyebrow">Find what fits</p><h2 id="what-fits-heading">Set your intent, then your range</h2><p>Results combine wheel geometry with tire calculations. GREEN never means road-safe.</p></div></div>
        <label class="goal-select" for="explorer-goal">What are you trying to do?<select id="explorer-goal" name="explorer-goal"><option value="closestToCurrent">Stay closest to current geometry</option><option value="moreOuterPresence">Increase outer presence</option><option value="moreInnerClearance">Prioritize inner clearance</option><option value="balancedClearance">Balance inner and outer clearance</option><option value="targetOuterClearance">Reach my outer-clearance target</option></select></label>
        <div class="range-groups">
          <fieldset class="range-card"><legend>Wheel range</legend><div class="grid"><label>Width min · J<input name="wf-width-min" type="number" value="7" step="0.5" inputmode="decimal" /></label><label>Width max · J<input name="wf-width-max" type="number" value="10" step="0.5" inputmode="decimal" /></label><label>Width step<input name="wf-width-step" type="number" value="0.5" min="0.1" step="0.1" inputmode="decimal" /></label><label>Offset min · ET<input name="wf-offset-min" type="number" value="20" step="1" inputmode="numeric" /></label><label>Offset max · ET<input name="wf-offset-max" type="number" value="55" step="1" inputmode="numeric" /></label><label>Offset step<input name="wf-offset-step" type="number" value="5" min="1" step="1" inputmode="numeric" /></label></div></fieldset>
          <fieldset class="range-card"><legend>Tire range</legend><div class="grid"><label>Target rim · in<input name="explorer-rim" type="number" value="19" step="0.5" inputmode="decimal" /></label><label>Tire width min<input name="tire-width-min" type="number" value="215" step="10" inputmode="numeric" /></label><label>Tire width max<input name="tire-width-max" type="number" value="255" step="10" inputmode="numeric" /></label><label>Tire width step<input name="tire-width-step" type="number" value="10" min="1" step="1" inputmode="numeric" /></label><label>Aspect min<input name="aspect-min" type="number" value="35" step="5" inputmode="numeric" /></label><label>Aspect max<input name="aspect-max" type="number" value="50" step="5" inputmode="numeric" /></label><label>Aspect step<input name="aspect-step" type="number" value="5" min="1" step="1" inputmode="numeric" /></label><label>Max diameter change · %<input name="max-diameter-difference" type="number" min="0" step="0.1" inputmode="decimal" placeholder="No constraint" /></label><label>Results<input name="wf-max-results" type="number" value="10" min="1" max="100" step="1" inputmode="numeric" /></label></div></fieldset>
        </div>
        <p id="search-preflight" class="search-summary" aria-live="polite"></p><button id="search-what-fits" type="button">Find geometric matches</button><p id="what-fits-summary" class="search-summary" aria-live="polite"></p><div id="what-fits-errors" role="alert" aria-live="assertive" hidden></div><div id="what-fits-results" class="search-results"></div><article id="explorer-detail" class="map-detail" hidden aria-live="polite"></article>
      </section>

      <section class="product-section" id="fitment-map-section" aria-labelledby="map-heading">
        <div class="section-heading"><div><p class="eyebrow">Advanced geometry</p><h2 id="map-heading">Fitment Map</h2><p>Explore wheel width and offset. Select any cell for its calculated detail.</p></div></div>
        <div class="map-inputs"><label>Width min · J<input name="map-width-min" type="number" value="7" step="0.5" inputmode="decimal" /></label><label>Width max · J<input name="map-width-max" type="number" value="10" step="0.5" inputmode="decimal" /></label><label>Width step<input name="map-width-step" type="number" value="0.5" min="0.1" step="0.1" inputmode="decimal" /></label><label>Offset min · ET<input name="map-offset-min" type="number" value="20" step="1" inputmode="numeric" /></label><label>Offset max · ET<input name="map-offset-max" type="number" value="55" step="1" inputmode="numeric" /></label><label>Offset step<input name="map-offset-step" type="number" value="5" min="1" step="1" inputmode="numeric" /></label></div>
        <div class="form-actions"><button id="generate-map" type="button">Generate map</button></div>
        <div class="map-legend" aria-label="Map status legend"><span class="legend-item"><span class="legend-dot status-green">✓</span><span><strong>GREEN</strong> · meets supplied geometric targets</span></span><span class="legend-item"><span class="legend-dot status-yellow">!</span><span><strong>YELLOW</strong> · below a supplied target</span></span><span class="legend-item"><span class="legend-dot status-red">×</span><span><strong>RED</strong> · calculated geometric overlap</span></span></div>
        <div id="map-errors" role="alert" aria-live="assertive" hidden></div><div id="fitment-map" class="map-scroll" aria-live="polite"></div><article id="map-detail" class="map-detail" hidden aria-live="polite"></article>
      </section>

      <section class="product-section" id="garage" aria-labelledby="garage-heading">
        <div class="section-heading"><div><p class="eyebrow">Vehicle memory</p><h2 id="garage-heading">{t('garageTitle')}</h2><p>Measurements and saved setups stay attached to the selected vehicle.</p></div></div>
        <div class="garage-shell"><article id="vehicle-summary" class="vehicle-card"></article><div><label for="active-vehicle">Current vehicle<select id="active-vehicle"><option value="">No saved vehicle</option></select></label><label for="vehicle-nickname">New vehicle nickname<input id="vehicle-nickname" name="vehicle-nickname" value="My Vehicle" maxlength="80" /></label><p id="garage-status" role="status" aria-live="polite"></p><div id="saved-setups"></div></div></div>
      </section>

      <section class="product-section subtle-panel" id="tools" aria-labelledby="tools-heading"><p class="eyebrow">Related tools</p><h2 id="tools-heading">Continue with one focused calculation</h2><p>Use the same transparent geometry engines through a task-specific entry point.</p><div class="related-grid"><a class="related-card" href="/en/tools/tire-size-comparison/"><span>Tires & wheels</span><strong>Tire Size Comparison</strong><p>Compare diameter, sidewall, circumference, and speedometer changes.</p></a><a class="related-card" href="/en/tools/wheel-offset-calculator/"><span>Fitment</span><strong>Wheel Offset Calculator</strong><p>See inner-position and outer-poke changes before using measured clearance.</p></a><a class="related-card" href="#garage"><span>Vehicle memory</span><strong>My Garage</strong><p>Return to measurements and setups stored for your active vehicle.</p></a></div></section>
    </main>

    <nav class="bottom-nav" aria-label="Mobile navigation"><a href="#garage" data-product-nav="garage">Garage</a><a href="#fitment" data-product-nav="fitment" aria-current="page">Fitment</a><a href="/en/tools/tire-size-calculator/">Tools</a></nav>

    <script>
      import { initializeFitmentPage } from '../../../ui/fitment-page';
      void initializeFitmentPage();
    </script>
  </body>
</html>

---
import SiteLayout from '../../components/SiteLayout.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import ToolIcon from '../../components/ToolIcon.astro';
---
<SiteLayout title="Atlas GarageOS" description="Fast, accurate automotive calculators for tires, fuel, road trips, pressure, power, torque, and fitment." pathname="/en/" active="home">
  <header class="toolbox-identity" aria-labelledby="home-heading"><h1 id="home-heading">Atlas GarageOS</h1><p>Every automotive tool in one place.</p></header>
  <ToolDirectory mode="home" />
  <section class="product-rows" aria-label="Atlas GarageOS product areas">
    <a href="/en/fitment-studio/"><ToolIcon id="fitment-studio" category="Advanced"/><span><small>Flagship workspace</small><strong>Fitment Studio</strong><em>Compare · What Fits · Measure · Map</em></span><i aria-hidden="true">›</i></a>
    <a href="/en/fitment-studio/#garage"><ToolIcon id="garage" category="Advanced"/><span><small>Shared vehicle memory</small><strong>My Garage</strong><em>Save vehicles and reuse their setup data</em></span><i aria-hidden="true">›</i></a>
  </section>
</SiteLayout>

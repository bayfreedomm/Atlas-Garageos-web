---
import SiteLayout from '../../../components/SiteLayout.astro';
---
<SiteLayout title="Privacy Policy" description="How Atlas GarageOS handles calculator inputs and locally saved vehicle data." pathname="/en/privacy-policy/" active="tools" breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Privacy Policy', href: '/en/privacy-policy/' }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Toolbox</a><span aria-hidden="true">/</span><span aria-current="page">Privacy Policy</span></nav>
  <header class="directory-identity"><h1>Privacy policy</h1><p>Last updated September 2026.</p></header>
  <div class="tool-facts privacy-copy">
    <div>
      <h2>Calculator inputs</h2><p>You can use Atlas GarageOS without creating an account. Calculator values are processed in your browser to produce a result.</p>
      <h2>Saved vehicle data</h2><p>Vehicles, measurements, and setups saved in My Garage stay in your browser’s local storage on that device.</p>
      <h2>Cookies</h2><p>Atlas does not use advertising cookies. If that changes, this policy will be updated before the change goes live.</p>
      <h2>Hosting</h2><p>The hosting provider may process standard request information needed to deliver and protect the website.</p>
    </div>
  </div>
</SiteLayout>

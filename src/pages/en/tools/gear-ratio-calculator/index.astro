---
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
const definition = toolById('gear-ratio-calculator');
const ratios = [3.08, 3.31, 3.55, 3.73, 4.10, 4.56];
---
<ToolPage {definition} visual={false} eyebrow="Drivetrain geometry" intro="See how a tire diameter change alters effective axle ratio, then scan RPM across common tire and gear combinations." limitation="RPM uses a direct 1.00:1 transmission ratio and excludes converter slip. It is a transparent comparison, not a gearing recommendation.">
  <form slot="tool" class="calculator-form gear-ratio-calculator" data-calculator="gear-ratio" novalidate>
    <div class="utility-fields gear-ratio-inputs"><label>Current tire diameter · in<input name="currentDiameter" type="number" value="31" min="15" max="60" step="0.1" inputmode="decimal" /></label><label>New tire diameter · in<input name="newDiameter" type="number" value="35" min="15" max="60" step="0.1" inputmode="decimal" /></label><label>Current axle ratio<input name="currentRatio" type="number" value="3.73" min="1" max="8" step="0.01" inputmode="decimal" /></label><label>Road speed · mph<input name="speedMph" type="number" value="65" min="1" max="200" step="1" inputmode="numeric" /></label></div>
    <button type="submit">Compare gearing</button><div class="inline-errors" data-errors role="alert" hidden></div>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Your effective gearing will appear here.</p><dl class="tool-results" data-results aria-live="polite"></dl>
    <section class="rpm-matrix" aria-labelledby="rpm-matrix-heading"><div><p class="eyebrow">25–44 INCH TIRES</p><h2 id="rpm-matrix-heading">RPM map at <span data-matrix-speed>65</span> mph</h2><p>Direct drive (1.00:1). Colour shows relative RPM inside this table only.</p></div><div class="rpm-matrix__scroll"><table><thead><tr><th scope="col">Tire</th>{ratios.map((ratio) => <th scope="col">{ratio.toFixed(2)}</th>)}</tr></thead><tbody data-rpm-matrix></tbody></table></div><p class="rpm-matrix__legend"><span>Lower relative RPM</span><i aria-hidden="true"></i><span>Higher relative RPM</span></p></section>
  </form>
  <div slot="explanation"><h2>Two answers, not one vague number</h2><p><strong>Effective ratio</strong> describes how the installed axle ratio behaves after the tire change. A taller tire lowers that effective number.</p><p><strong>Matching axle ratio</strong> estimates the numerical ratio that restores the original tire-to-axle relationship. Transmission gearing and real engine RPM can still differ.</p></div>
</ToolPage>
<script>import { initializeGearRatioCalculators } from '../../../../ui/gear-ratio-calculator'; initializeGearRatioCalculators();</script>

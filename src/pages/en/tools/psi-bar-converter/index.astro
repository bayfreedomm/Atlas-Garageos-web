---
import ToolPage from '../../../../components/ToolPage.astro'; import UtilityResults from '../../../../components/UtilityResults.astro'; import { toolById } from '../../../../seo/tool-registry'; const definition = toolById('psi-bar-converter');
---
<ToolPage {definition} eyebrow="Converter" intro="Convert pressure instantly between PSI, bar, and kilopascals." limitation="This tool converts pressure units only. It does not recommend a vehicle-specific tire pressure; use the vehicle manufacturer’s sourced specification." studioCta="Open Wheel & Tire Compare"><form slot="tool" class="calculator-form instant-calculator" data-utility-calculator="pressure" novalidate><div class="instant-input"><label>Pressure<input name="value" type="number" value="32" min="0" step="any" inputmode="decimal" /></label><label>Unit<select name="unit"><option value="psi">PSI</option><option value="bar">Bar</option><option value="kpa">kPa</option></select></label></div><UtilityResults pending="Enter a pressure value." /></form><div slot="explanation"><h2>Three common pressure units</h2><p>PSI is pounds per square inch. Bar and kilopascals are metric pressure units, with exactly 100 kPa in one bar.</p><h2>The number you actually need isn't on the tire</h2><p>The pressure printed on the tire's sidewall is the tire's maximum safe rating, not your car's recommended pressure. The correct number for your vehicle is on a sticker inside the driver's door jamb (or in the owner's manual) — this converter just moves that number between units once you have it. If you're also comparing a different tire size, the <a href="/en/tools/tire-size-calculator/">Tire Size Calculator</a> shows how the physical dimensions change.</p></div></ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

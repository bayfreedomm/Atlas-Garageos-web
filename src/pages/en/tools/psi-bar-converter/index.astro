---
import ToolPage from '../../../../components/ToolPage.astro'; import UtilityResults from '../../../../components/UtilityResults.astro'; import { toolById } from '../../../../seo/tool-registry'; const definition = toolById('psi-bar-converter');
---
<ToolPage {definition} eyebrow="Converter" intro="Convert pressure instantly between PSI, bar, and kilopascals." limitation="This tool converts pressure units only. It does not recommend a vehicle-specific tire pressure; use the vehicle manufacturer’s sourced specification." studioCta="Open Fitment Studio"><form slot="tool" class="calculator-form instant-calculator" data-utility-calculator="pressure" novalidate><div class="instant-input"><label>Pressure<input name="value" type="number" value="32" min="0" step="any" inputmode="decimal" /></label><label>Unit<select name="unit"><option value="psi">PSI</option><option value="bar">Bar</option><option value="kpa">kPa</option></select></label></div><UtilityResults pending="Enter a pressure value." /></form><div slot="explanation"><h2>Three common pressure units</h2><p>PSI is pounds per square inch. Bar and kilopascals are metric pressure units, with exactly 100 kPa in one bar.</p></div></ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

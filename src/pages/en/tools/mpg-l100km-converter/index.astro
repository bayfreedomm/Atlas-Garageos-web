---
import ToolPage from '../../../../components/ToolPage.astro'; import UtilityResults from '../../../../components/UtilityResults.astro'; import { toolById } from '../../../../seo/tool-registry'; const definition = toolById('mpg-l100km-converter');
---
<ToolPage {definition} eyebrow="Converter" intro="Convert US MPG, Imperial MPG, and litres per 100 kilometres without mixing the two gallon standards." limitation="US and Imperial gallons have different volumes. This converter keeps them explicit and never treats the two MPG values as interchangeable."><form slot="tool" class="calculator-form instant-calculator" data-utility-calculator="fuel-economy" novalidate><div class="instant-input"><label>Fuel economy<input name="value" type="number" value="30" min="0" step="any" inputmode="decimal" /></label><label>Unit<select name="unit"><option value="us-mpg">US MPG</option><option value="imperial-mpg">Imperial MPG</option><option value="l100km">L/100km</option></select></label></div><UtilityResults pending="Enter a fuel economy value." /></form><div slot="explanation"><h2>Why the MPG results differ</h2><p>An Imperial gallon is larger than a US gallon. The same L/100km consumption therefore produces a higher Imperial MPG number.</p><p>Lower L/100km means less fuel used, while higher MPG means more distance per gallon.</p></div></ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

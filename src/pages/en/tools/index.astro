---
import SiteLayout from '../../../components/SiteLayout.astro';
import { routeForTool, TOOL_CATEGORY_ORDER, toolRegistry } from '../../../seo/tool-registry';
const tools = toolRegistry.filter(({ kind }) => kind === 'tool');
const glyphs = new Map([['Fuel & Trips', 'F'], ['Tires & Wheels', 'T'], ['Converters', '↔'], ['Performance', 'P']]);
const toolGlyphs = new Map([
  ['fuel-cost-calculator', 'FC'], ['road-trip-cost-calculator', 'RT'], ['tire-size-calculator', 'TS'], ['tire-size-comparison', 'TC'], ['wheel-offset-calculator', 'ET'], ['speedometer-error-calculator', 'SP'], ['fitment-map', 'FM'], ['measure-my-car', 'MM'], ['mpg-l100km-converter', 'MP'], ['psi-bar-converter', 'PB'], ['hp-kw-converter', 'HP'], ['nm-lb-ft-converter', 'NM'], ['power-to-weight-calculator', 'PW'],
]);
---
<SiteLayout title="Automotive Tools" description="Explore fast automotive tools for fuel costs, road trips, tires, wheels, pressure, power, torque, and fitment." pathname="/en/tools/" active="tools" breadcrumbs={[{ name: 'Home', href: '/en/' }, { name: 'Tools', href: '/en/tools/' }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/en/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Tools</span></nav>
  <header class="hub-intro"><p class="eyebrow">Tools</p><h1>Choose the job. Get the answer.</h1><p>Fuel, trips, tires, fitment, pressure, power, and torque—each tool opens ready to use.</p></header>
  <div class="tool-directory">{TOOL_CATEGORY_ORDER.map((category) => { const categoryTools = tools.filter((tool) => tool.category === category); const categoryId = `category-${category.toLowerCase().replaceAll('&', 'and').replaceAll(' ', '-')}`; return <section class="tool-category" aria-labelledby={categoryId}><header><span class="category-glyph" aria-hidden="true">{glyphs.get(category)}</span><div><h2 id={categoryId}>{category}</h2><p>{categoryTools.length} {categoryTools.length === 1 ? 'tool' : 'tools'}</p></div></header><div class="compact-tool-grid">{categoryTools.map((tool) => <a href={routeForTool(tool)}><span class="tool-glyph" aria-hidden="true">{toolGlyphs.get(tool.id)}</span><div><strong>{tool.title}</strong><span>{tool.description}</span></div><i aria-hidden="true">↗</i></a>)}</div></section> })}</div>
  <aside class="hub-note"><strong>Need deeper tire and wheel work?</strong><p>Fitment Studio remains the advanced workspace for setup comparison, real measurements, and geometric search.</p><a class="text-link" href="/en/fitment-studio/">Open Fitment Studio →</a></aside>
</SiteLayout>

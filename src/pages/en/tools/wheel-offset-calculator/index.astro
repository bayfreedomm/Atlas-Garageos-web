---
import ToolPage from '../../../../components/ToolPage.astro';
import FitmentVisualizer from '../../../../components/FitmentVisualizer.astro';
import { toolById } from '../../../../seo/tool-registry';
const definition = toolById('wheel-offset-calculator');
---
<ToolPage {definition} visual={false} eyebrow="Fitment geometry" intro="Compare wheel width and offset to see how the inner edge and outer face move relative to the original wheel." limitation="Position changes are geometric. Actual clearance depends on your vehicle, tire shape, suspension, brakes, bodywork, alignment, and operating conditions." studioCta="Measure your actual clearance" studioHref="/en/tools/measure-my-car/">
  <form slot="tool" class="calculator-form" data-calculator="wheel-offset" novalidate><div class="calculator-columns"><fieldset class="calculator-group"><legend>Original wheel</legend><div class="grid"><label>Width · J<input name="originalWidthInches" type="number" value="8" step="0.5" inputmode="decimal" /></label><label>Offset · ET<input name="originalOffsetMm" type="number" value="40" inputmode="numeric" /></label></div></fieldset><fieldset class="calculator-group"><legend>New wheel</legend><div class="grid"><label>Width · J<input name="newWidthInches" type="number" value="8.5" step="0.5" inputmode="decimal" /></label><label>Offset · ET<input name="newOffsetMm" type="number" value="35" inputmode="numeric" /></label></div></fieldset></div><button type="submit">Compare wheel position</button><div class="inline-errors" data-errors role="alert" hidden></div><p class="result-summary is-pending" data-result-summary aria-live="polite">Your position summary will appear here.</p><FitmentVisualizer mode="wheel" title="Wheel position comparison" /><dl class="tool-results" data-results aria-live="polite"></dl></form>
  <div slot="explanation"><h2>Two directions, one transparent comparison</h2><p>A positive inner-position change means the new inner wheel edge moves farther inward. A positive outer-poke change means the outer wheel edge moves farther outward.</p><p>Use Measure My Car before interpreting either number as available clearance.</p></div>
</ToolPage>
<script>import { initializeToolCalculators } from '../../../../ui/tool-calculators'; initializeToolCalculators();</script>

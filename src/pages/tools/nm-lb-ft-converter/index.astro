---
import ToolPage from '../../../components/ToolPage.astro'; import UtilityResults from '../../../components/UtilityResults.astro'; import { toolById } from '../../../seo/tool-registry'; const definition = toolById('nm-lb-ft-converter');
---
<ToolPage {definition} eyebrow="Converter" intro="Convert torque instantly between newton-metres and pound-feet." limitation="This is a unit conversion, not an engine-output estimate. It does not infer torque from power, RPM, or vehicle data."><form slot="tool" class="calculator-form instant-calculator" data-utility-calculator="torque" novalidate><div class="instant-input"><label>Torque<input name="value" type="number" value="300" min="0" step="any" inputmode="decimal" /></label><label>Unit<select name="unit"><option value="nm">Nm</option><option value="lb-ft">lb-ft</option></select></label></div><UtilityResults pending="Enter a torque value." /></form><div slot="explanation"><h2>Two expressions of torque</h2><p>Newton-metres and pound-feet measure the same physical quantity. Atlas converts through the exact pound-foot relationship without rounding the underlying result.</p></div></ToolPage>
<script>import { initializeUtilityCalculators } from '../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

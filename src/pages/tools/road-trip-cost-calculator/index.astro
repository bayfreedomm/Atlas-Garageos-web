---
import ToolPage from '../../../components/ToolPage.astro';
import FuelFields from '../../../components/FuelFields.astro';
import UtilityResults from '../../../components/UtilityResults.astro';
import { toolById } from '../../../seo/tool-registry';
const definition = toolById('road-trip-cost-calculator');
---
<ToolPage {definition} eyebrow="Fuel & trips" intro="Estimate one-way or return fuel cost, add trip expenses, and split the total between travellers." limitation="Trip costs are estimates based on the numbers you enter. Actual consumption can vary with traffic, weather, load, speed, and driving style.">
  <form slot="tool" class="calculator-form" data-utility-calculator="road-trip" novalidate><FuelFields distance={420} economy={6.5} /><fieldset class="trip-options"><legend>Trip</legend><div class="utility-fields"><label>Direction<select name="tripType"><option value="one">One way</option><option value="round">Round trip</option></select></label></div><details><summary>Add tolls, extras, or travellers</summary><div class="utility-fields"><label>Extra trip cost<input name="extraCost" type="number" value="0" min="0" step="any" inputmode="decimal" /></label><label>People<input name="people" type="number" value="1" min="1" step="1" inputmode="numeric" /></label></div></details></fieldset><button type="submit">Estimate road trip</button><UtilityResults pending="Your trip estimate will appear here." /></form>
  <div slot="explanation"><h2>What is included</h2><p>Return trips double the entered one-way distance before fuel is calculated. Optional costs are then added, and the complete total is divided by the number of people.</p><p>Cost per distance includes the optional trip costs, giving one comparable journey figure.</p></div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

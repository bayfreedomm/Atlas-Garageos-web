---
import ToolPage from '../../../components/ToolPage.astro';
import WheelOffsetTechnicalVisual from '../../../components/WheelOffsetTechnicalVisual.astro';
import EngineeringVisualStudio from '../../../components/EngineeringVisualStudio.astro';
import { toolById } from '../../../seo/tool-registry';
const definition = toolById('wheel-offset-calculator');
---
<ToolPage {definition} alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/wheel-offset-calculator/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/felgen-et-rechner/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/calculadora-offset-llantas/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/wheel-offset-calculator/' }]} visual={false} eyebrow="Fitment geometry" intro="Compare wheel width and offset to see how the inner edge and outer face move relative to the original wheel." limitation="Position changes are geometric. Actual clearance depends on your vehicle, tire shape, suspension, brakes, bodywork, alignment, and operating conditions." studioCta="Measure your actual clearance" studioHref="/tools/measure-my-car/">
  <form slot="tool" class="calculator-form" data-calculator="wheel-offset" novalidate>
    <div class="calculator-columns">
      <fieldset class="calculator-group"><legend>Original wheel</legend><div class="grid"><label>Width · J<input name="originalWidthInches" type="number" value="8" step="0.5" inputmode="decimal" /></label><label>Offset · ET<input name="originalOffsetMm" type="number" value="40" inputmode="numeric" /></label></div></fieldset>
      <fieldset class="calculator-group"><legend>New wheel</legend><div class="grid"><label>Width · J<input name="newWidthInches" type="number" value="8.5" step="0.5" inputmode="decimal" /></label><label>Offset · ET<input name="newOffsetMm" type="number" value="35" inputmode="numeric" /></label></div></fieldset>
    </div>

    <div class="form-actions"><button type="submit">Compare wheel position</button><button type="button" class="secondary" data-share-result>Copy share link</button></div>
    <div class="inline-errors" data-errors role="alert" hidden></div>

    <section class="wheel-primary-result is-pending" data-wheel-primary-result aria-live="polite" aria-label="Primary wheel position result">
      <div class="wheel-primary-result__answer">
        <span>Outer edge change</span>
        <strong data-wheel-primary-outer>—</strong>
        <p data-wheel-primary-outer-copy>Compare the wheels to see how far the outer edge moves.</p>
      </div>
      <div class="wheel-primary-result__inner">
        <span>Inner edge change</span>
        <strong data-wheel-primary-inner>—</strong>
        <small data-wheel-primary-inner-copy>Shows movement toward or away from the suspension.</small>
      </div>
    </section>

    <p class="result-summary is-pending" data-result-summary aria-live="polite">Your position summary will appear here.</p>

    <EngineeringVisualStudio mode="offset" locale="en"><WheelOffsetTechnicalVisual /></EngineeringVisualStudio>

    <div class="wheel-detail-heading" aria-hidden="true"><span>Details</span><small>Static wheel geometry</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
  </form>
  <div slot="explanation"><h2>Two directions, one transparent comparison</h2><p>A positive inner-position change means the new inner wheel edge moves farther inward. A positive outer-poke change means the outer wheel edge moves farther outward.</p><p>Use Measure My Car before interpreting either number as available clearance.</p></div>
</ToolPage>
<script>import { initializeShareableToolState } from '../../../ui/shareable-tool-state'; import { initializeToolCalculators } from '../../../ui/tool-calculators'; initializeShareableToolState(); initializeToolCalculators();</script>

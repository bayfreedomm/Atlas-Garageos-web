---
import ToolPage from '../../../components/ToolPage.astro'; import UtilityResults from '../../../components/UtilityResults.astro'; import { toolById } from '../../../seo/tool-registry'; const definition = toolById('hp-kw-converter');
---
<ToolPage {definition} eyebrow="Converter" intro="Convert mechanical horsepower and kilowatts instantly with an explicit horsepower standard." limitation="This page uses mechanical horsepower. Metric horsepower, often labelled PS, is a different unit and is not silently treated as hp."><form slot="tool" class="calculator-form instant-calculator" data-utility-calculator="power" novalidate><div class="instant-input"><label>Power<input name="value" type="number" value="180" min="0" step="any" inputmode="decimal" /></label><label>Unit<select name="unit"><option value="hp">Mechanical hp</option><option value="kw">Kilowatts</option></select></label></div><UtilityResults pending="Enter a power value." /></form><div slot="explanation"><h2>Mechanical hp, not PS</h2><p>One mechanical horsepower is 745.6998715822702 watts. This distinction keeps manufacturer figures and calculations unambiguous.</p></div></ToolPage>
<script>import { initializeUtilityCalculators } from '../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

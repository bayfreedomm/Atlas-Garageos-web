---
import ToolDrawingFrame from '../../../components/ToolDrawingFrame.astro';
import { toolAlternates } from '../../../seo/locale-alternates';
import ToolPage from '../../../components/ToolPage.astro';
import Parametric3DPanel from '../../../components/Parametric3DPanel.astro';
import { toolById } from '../../../seo/tool-registry';
const definition = toolById('ev-charging-cost-calculator');
---
<ToolPage {definition} alternates={toolAlternates('ev-charging-cost-calculator')} visual={false} explanationBeforeInsights eyebrow="Fuel & trips" intro="See the energy, cost, and time to charge your EV — from your own battery size and electricity price." limitation="This estimate includes the efficiency you enter. Battery temperature, charge taper, and the vehicle's real charging curve can still change the result.">
  <form slot="tool" class="calculator-form ev-charging-calculator" data-calculator="ev-charging" novalidate>
    <div class="utility-fields">
      <label>Battery capacity · kWh<input name="batteryCapacityKwh" type="number" value="64" min="1" max="250" step="1" inputmode="decimal" /></label>
      <label>Electricity price · per kWh<input name="pricePerKwh" type="number" value="0.18" min="0" max="10" step="0.01" inputmode="decimal" /></label>
      <label>Currency<select name="currency"><option value="USD">USD</option><option value="EUR">EUR</option><option value="GBP">GBP</option><option value="CAD">CAD</option><option value="AUD">AUD</option></select></label>
      <label>Charge from · %<input name="startPercent" type="number" value="20" min="0" max="100" step="1" inputmode="numeric" /></label>
      <label>Charge to · %<input name="endPercent" type="number" value="80" min="0" max="100" step="1" inputmode="numeric" /></label>
      <label>Charger power · kW<input name="chargerPowerKw" type="number" value="11" min="0.1" max="400" step="0.1" inputmode="decimal" /></label>
      <label>Charging efficiency · %<input name="chargingEfficiency" type="number" value="90" min="50" max="100" step="1" inputmode="numeric" /></label>
    </div>
    <button type="submit">Calculate charging cost</button>
    <section class="standard-answer ev-answer is-pending" data-ev-answer aria-live="polite"><div class="standard-answer__main"><span>Estimated charging cost</span><strong data-ev-cost>—</strong><p data-ev-context>Your charging estimate will appear here.</p></div><div class="standard-answer__secondary"><span>Ideal charging time</span><strong data-ev-time>—</strong><small data-ev-grid>Grid energy appears here.</small></div></section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Your charging estimate will appear here.</p>
    <Parametric3DPanel mode="ev" locale="en" />
    <figure class="ev-technical-visual is-pending" data-ev-visual>
      <figcaption><span>BATTERY → GRID ENERGY → COST + TIME</span><small>Charge window is proportional; time assumes constant power</small></figcaption>
      <ToolDrawingFrame kind="ev-charge" labels={{}} locale="en" />
      <div class="ev-visual-stats"><div><small>Into battery</small><strong data-ev-battery-energy>—</strong></div><div><small>From grid</small><strong data-ev-grid-energy>—</strong></div><div><small>Efficiency loss</small><strong data-ev-loss>—</strong></div></div>
    </figure>
    <div class="fuel-detail-heading" aria-hidden="true"><span>Details</span><small>Energy, cost, and ideal time</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" hidden></div>
  </form>
  <div slot="explanation"><h2>Why the number is an estimate, not a promise</h2><p>Charging efficiency accounts for energy lost between the wall and battery. A 90% setting means 10% of grid energy does not reach the battery.</p><p>The time estimate assumes the entered charging power stays constant. Real charging can be slower because the vehicle, battery temperature, state of charge, and charging curve can limit power.</p></div>
</ToolPage>
<script>import { initializeEvChargingCalculators } from '../../../ui/ev-charging-calculator'; initializeEvChargingCalculators();</script>

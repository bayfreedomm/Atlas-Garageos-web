---
import ToolPage from '../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../seo/tool-registry';
const definition = toolById('tire-load-speed-rating');
const loadIndexes = Array.from({ length: 126 - 75 + 1 }, (_, index) => 75 + index);
const speedRatings: readonly string[] = ['L', 'M', 'N', 'P', 'Q', 'R', 'S', 'T', 'U', 'H', 'V', 'W', 'Y'];
---
<ToolPage {definition} visual={false} explanationBeforeInsights eyebrow="Tires & wheels" intro="Look up the load-carrying capacity and maximum speed behind a tire load index and speed rating letter." limitation="This is a standard reference lookup, not a vehicle-specific recommendation. Always match or exceed your vehicle's tire placard values.">
  <form slot="tool" class="calculator-form" data-calculator="tire-load-speed" novalidate>
    <div class="utility-fields">
      <label>Load index<select name="loadIndex">{loadIndexes.map((index) => <option value={index} selected={index === 91}>{index}</option>)}</select></label>
      <label>Speed rating<select name="speedRating">{speedRatings.map((rating) => <option value={rating} selected={rating === 'V'}>{rating}</option>)}</select></label>
    </div>
    <UtilityResultStandard primaryLabel="Load capacity per tire" pending="Choose a load index and speed rating." visualTitle="Code → standard capacity" visualNote="Standard ETRTO / speed-symbol reference table" />
  </form>
  <div slot="explanation">
    <h2>How to read a tire size like 225/45R18 91V</h2>
    <p>The "91" is the load index — a code for a fixed load-capacity table, not a direct weight. The "V" is the speed symbol, describing the maximum speed the tire is rated to sustain for an extended period under load, not a speed you should drive at.</p>
    <h2>Why matching your placard matters</h2>
    <p>Your vehicle's door-jamb placard lists the minimum load index and speed rating it was engineered around. Fitting a tire with a lower load index reduces your safety margin under full load; fitting a lower speed rating can affect handling characteristics the vehicle was tuned for, even if you never approach that top speed.</p>
  </div>
</ToolPage>
<script>import { initializeTireLoadSpeedReference } from '../../../ui/tire-load-speed-reference'; initializeTireLoadSpeedReference();</script>

---
import ToolPage from '../../../components/ToolPage.astro'; import UtilityResults from '../../../components/UtilityResults.astro'; import { toolById } from '../../../seo/tool-registry'; const definition = toolById('power-to-weight-calculator');
---
<ToolPage {definition} eyebrow="Performance" intro="Normalize vehicle power and weight to comparable hp/tonne, kW/tonne, and W/kg figures." limitation="Power-to-weight is a physical ratio, not a performance score. Acceleration also depends on traction, gearing, aerodynamics, drivetrain losses, and conditions."><form slot="tool" class="calculator-form" data-utility-calculator="power-weight" novalidate><div class="utility-fields"><label>Power<input name="power" type="number" value="180" min="0" step="any" inputmode="decimal" /></label><label>Power unit<select name="powerUnit"><option value="hp">Mechanical hp</option><option value="kw">kW</option></select></label><label>Vehicle weight<input name="weight" type="number" value="1350" min="0" step="any" inputmode="decimal" /></label><label>Weight unit<select name="weightUnit"><option value="kg">kg</option><option value="lb">lb</option></select></label></div><button type="submit">Calculate power-to-weight</button><UtilityResults pending="Enter power and vehicle weight." /></form><div slot="explanation"><h2>One ratio, normalized three ways</h2><p>Power is normalized to watts and weight to kilograms. The result is then expressed as mechanical hp per metric tonne, kilowatts per tonne, and watts per kilogram.</p></div></ToolPage>
<script>import { initializeUtilityCalculators } from '../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

---
import SiteLayout from '../../components/SiteLayout.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
const alternates = [
  { hreflang: 'en', href: 'https://atlasgarageos.com/tools/' },
  { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/' },
  { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/' },
  { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/' },
];
---
<SiteLayout title="Automotive Tools" description="Explore fast automotive tools for fuel costs, road trips, tires, wheels, pressure, power, torque, and fitment." pathname="/tools/" active="tools" alternates={alternates} breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Tools', href: '/tools/' }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Tools</span></nav>
  <header class="directory-identity"><h1>Automotive tools</h1><p>Choose a job and get a clear answer.</p></header>
  <ToolDirectory mode="all" />
  <a class="home-fuel-feature" href="/gas-prices-today/"><span class="home-fuel-feature__badge"><i aria-hidden="true"></i>LIVE FUEL DATA</span><span class="home-fuel-feature__copy"><strong>Gas Prices Today</strong><small>Current national average for regular gasoline and diesel, with price history. Use it to set the price in the calculators below.</small></span><span class="home-fuel-feature__arrow" aria-hidden="true">→</span></a>
  <a class="fitment-directory-row" href="/fitment-studio/"><strong>Wheel &amp; Tire Compare</strong><span>Advanced setup comparison and geometry</span><i aria-hidden="true">›</i></a>
  <a class="fitment-directory-row" href="/vehicles/"><strong>Vehicle Fitment Reference</strong><span>OEM tire size, bolt pattern, and torque by make and model</span><i aria-hidden="true">›</i></a>
</SiteLayout>

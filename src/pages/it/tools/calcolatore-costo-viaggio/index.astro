---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import FuelFields from '../../../../components/FuelFields.astro';
import VehicleTripContext from '../../../../components/VehicleTripContext.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('road-trip-cost-calculator');
const c = localizedTool('road-trip-cost-calculator', 'it');
---
<ToolPage {definition} locale="it" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('road-trip-cost-calculator')}>
  <VehicleTripContext slot="tool" locale="it" />
  <form slot="tool" class="calculator-form road-trip-form" data-utility-calculator="road-trip" novalidate>
    <FuelFields locale="it" currency="EUR" />
    <a class="fuel-price-hint" href="/gas-prices-today/">Prezzi del carburante negli Stati Uniti (inglese) <span aria-hidden="true">→</span></a>
    <fieldset class="trip-options"><legend>Viaggio</legend>
      <div class="utility-fields"><label class="field-wide">Percorso<select name="tripType"><option value="one">Solo andata</option><option value="round">Andata e ritorno</option></select></label></div>
      <details><summary>Aggiungi pedaggi, extra o compagni di viaggio</summary><div class="utility-fields">
        <label>Costi extra del viaggio<input name="extraCost" type="number" value="0" min="0" step="any" inputmode="decimal" /></label>
        <label>Persone<input name="people" type="number" value="1" min="1" step="1" inputmode="numeric" /></label>
      </div></details>
    </fieldset>
    <button type="submit">Stima il costo del viaggio</button>
    <section class="trip-primary is-pending" data-trip-primary aria-live="polite" aria-label="Costo stimato del viaggio">
      <div class="trip-primary__main"><span>Costo totale stimato del viaggio</span><strong data-trip-total>—</strong><p data-trip-context>Inserisci i dati del viaggio per vedere il costo completo.</p></div>
      <div class="trip-primary__support"><div><span>Carburante consumato</span><strong data-trip-fuel>—</strong><small data-trip-fuel-cost>Il costo del carburante apparirà qui.</small></div><div><span>Percorso</span><strong data-trip-direction>—</strong><small data-trip-distance>La distanza apparirà qui.</small></div><div data-trip-person-wrap hidden><span>A persona</span><strong data-trip-person>—</strong><small data-trip-people>Ripartizione del totale</small></div></div>
    </section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">La stima del viaggio apparirà qui.</p>
    <figure class="trip-technical-visual is-pending" data-trip-visual aria-label="Distanza del viaggio e ripartizione proporzionale dei costi">
      <div class="trip-technical-visual__head"><span>PERCORSO → CARBURANTE + EXTRA → TOTALE</span><small>Schema del percorso; le barre dei costi sono in scala</small></div>
      <div class="trip-route" aria-hidden="true"><span>PARTENZA</span><div class="trip-route__track"><i></i><i data-trip-return hidden></i></div><span data-trip-end>DESTINAZIONE</span></div>
      <div class="trip-visual-stats"><div><small>Distanza percorsa</small><strong data-trip-visual-distance>—</strong></div><div><small>Carburante necessario</small><strong data-trip-visual-fuel>—</strong></div><div><small>Totale</small><strong data-trip-visual-total>—</strong></div></div>
      <div class="trip-cost-track" role="img" aria-label="Ripartizione tra costo del carburante ed extra" data-trip-cost-track><span class="trip-cost-track__fuel" data-trip-fuel-bar></span><span class="trip-cost-track__extras" data-trip-extra-bar></span></div>
      <figcaption><span><i class="trip-key trip-key--fuel"></i>Carburante <strong data-trip-visual-fuel-cost>—</strong></span><span><i class="trip-key trip-key--extras"></i>Extra <strong data-trip-visual-extras>—</strong></span></figcaption>
    </figure>
    <div class="fuel-detail-heading" aria-hidden="true"><span>Dettagli</span><small>Dettaglio completo del viaggio</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

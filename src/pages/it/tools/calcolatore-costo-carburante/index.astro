---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import FuelFields from '../../../../components/FuelFields.astro';
import FuelCostTechnicalVisual from '../../../../components/FuelCostTechnicalVisual.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('fuel-cost-calculator');
const c = localizedTool('fuel-cost-calculator', 'it');
---
<ToolPage {definition} locale="it" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('fuel-cost-calculator')}>
  <form slot="tool" class="calculator-form fuel-cost-form" data-utility-calculator="fuel-cost" novalidate>
    <FuelFields locale="it" currency="EUR" />
    <a class="fuel-price-hint" href="/gas-prices-today/">Prezzi del carburante negli Stati Uniti (inglese) <span aria-hidden="true">→</span></a>
    <button type="submit">Calcola il costo del carburante</button>
    <div class="fuel-primary-result is-pending" data-fuel-primary-result aria-live="polite" aria-label="Risultato principale del costo del carburante">
      <div class="fuel-primary-result__cost"><span>Costo del carburante stimato</span><strong data-fuel-primary-cost>—</strong><p data-fuel-primary-copy>Inserisci i dati del tragitto per vedere il costo stimato del carburante.</p></div>
      <div class="fuel-primary-result__fuel"><span>Carburante necessario</span><strong data-fuel-primary-fuel>—</strong><small data-fuel-primary-rate>Il costo per distanza apparirà qui.</small></div>
    </div>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">La stima del carburante apparirà qui.</p>
    <FuelCostTechnicalVisual locale="it" />
    <div class="fuel-detail-heading" aria-hidden="true"><span>Dettagli</span><small>Dettaglio di carburante e costi</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

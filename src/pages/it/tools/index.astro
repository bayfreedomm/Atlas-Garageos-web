---
import { platformAlternates } from '../../../seo/locale-alternates';
import SiteLayout from '../../../components/SiteLayout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import { platformCatalog } from '../../../localization/site-catalog';
const c = platformCatalog['it'].toolsHub;
const alternates = platformAlternates('/tools/');
---
<SiteLayout title={c.title} description={c.description} pathname="/it/tools/" active="tools" locale="it" alternates={alternates} breadcrumbs={[{ name: 'Home', href: '/it/' }, { name: 'Strumenti', href: '/it/tools/' }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/it/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Strumenti</span></nav>
  <header class="directory-identity"><h1>{c.h1}</h1><p>{c.lead}</p></header>
  <ToolDirectory mode="all" locale="it" />
  <a class="fitment-directory-row" href="/it/fitment-studio/"><strong>{c.fitmentRowTitle}</strong><span>{c.fitmentRowCopy}</span><i aria-hidden="true">›</i></a>
  <a class="fitment-directory-row" href="/it/veicoli/"><strong>Riferimento misure per veicolo</strong><span>Pneumatici documentati, foratura e coppia di serraggio verificata per marca e modello</span><i aria-hidden="true">›</i></a>
</SiteLayout>

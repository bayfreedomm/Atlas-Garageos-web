---
import ToolDrawingFrame from '../../../../components/ToolDrawingFrame.astro';
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import Parametric3DPanel from '../../../../components/Parametric3DPanel.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('ev-charging-cost-calculator');
const c = localizedTool('ev-charging-cost-calculator', 'it');
---
<ToolPage {definition} locale="it" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('ev-charging-cost-calculator')}>
  <form slot="tool" class="calculator-form ev-charging-calculator" data-calculator="ev-charging" novalidate>
    <div class="utility-fields">
      <label>Capacità batteria · kWh<input name="batteryCapacityKwh" type="number" value="64" min="1" max="250" step="1" inputmode="decimal" /></label>
      <label>Prezzo dell’energia · per kWh<input name="pricePerKwh" type="number" value="0.30" min="0" max="10" step="0.01" inputmode="decimal" /></label>
      <label>Valuta<select name="currency"><option value="EUR" selected>EUR</option><option value="USD">USD</option><option value="GBP">GBP</option><option value="CAD">CAD</option><option value="AUD">AUD</option><option value="TRY">TRY</option><option value="PLN">PLN</option><option value="BRL">BRL</option></select></label>
      <label>Ricarica da · %<input name="startPercent" type="number" value="20" min="0" max="100" step="1" inputmode="numeric" /></label>
      <label>Ricarica fino a · %<input name="endPercent" type="number" value="80" min="0" max="100" step="1" inputmode="numeric" /></label>
      <label>Potenza di ricarica · kW<input name="chargerPowerKw" type="number" value="11" min="0.1" max="400" step="0.1" inputmode="decimal" /></label>
      <label>Efficienza di ricarica · %<input name="chargingEfficiency" type="number" value="90" min="50" max="100" step="1" inputmode="numeric" /></label>
    </div>
    <button type="submit">Calcola il costo di ricarica</button>
    <section class="standard-answer ev-answer is-pending" data-ev-answer aria-live="polite"><div class="standard-answer__main"><span>Costo di ricarica stimato</span><strong data-ev-cost>—</strong><p data-ev-context>La stima della ricarica apparirà qui.</p></div><div class="standard-answer__secondary"><span>Tempo di ricarica ideale</span><strong data-ev-time>—</strong><small data-ev-grid>L’energia prelevata dalla rete apparirà qui.</small></div></section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">La stima della ricarica apparirà qui.</p>
    <Parametric3DPanel mode="ev" locale="it" />
    <figure class="ev-technical-visual is-pending" data-ev-visual>
      <figcaption><span>BATTERIA → ENERGIA DI RETE → COSTO + TEMPO</span><small>La finestra di ricarica è in scala; il tempo presuppone una potenza costante</small></figcaption>
      <ToolDrawingFrame kind="ev-charge" labels={{}} locale="it" />
      <div class="ev-visual-stats"><div><small>Nella batteria</small><strong data-ev-battery-energy>—</strong></div><div><small>Dalla rete</small><strong data-ev-grid-energy>—</strong></div><div><small>Perdite di efficienza</small><strong data-ev-loss>—</strong></div></div>
    </figure>
    <div class="fuel-detail-heading" aria-hidden="true"><span>Dettagli</span><small>Energia, costo e tempo ideale</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeEvChargingCalculators } from '../../../../ui/ev-charging-calculator'; initializeEvChargingCalculators();</script>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import Parametric3DPanel from '../../../../components/Parametric3DPanel.astro';
import GearRatioTechnicalVisual from '../../../../components/GearRatioTechnicalVisual.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('gear-ratio-calculator');
const c = localizedTool('gear-ratio-calculator', 'it');
const ratios = [3.08, 3.31, 3.55, 3.73, 4.10, 4.56];
---
<ToolPage {definition} locale="it" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('gear-ratio-calculator')}>
  <form slot="tool" class="calculator-form gear-ratio-calculator" data-calculator="gear-ratio" novalidate>
    <div class="utility-fields gear-ratio-inputs"><label>Diametro pneumatico attuale · pollici<input name="currentDiameter" type="number" value="31" min="15" max="60" step="0.1" inputmode="decimal" /></label><label>Diametro pneumatico nuovo · pollici<input name="newDiameter" type="number" value="35" min="15" max="60" step="0.1" inputmode="decimal" /></label><label>Rapporto al ponte attuale<input name="currentRatio" type="number" value="3.73" min="1" max="8" step="0.01" inputmode="decimal" /></label><label>Velocità di crociera · mph<input name="speedMph" type="number" value="65" min="1" max="200" step="1" inputmode="numeric" /></label></div>
    <button type="submit">Confronta il rapporto di trasmissione</button>
    <section class="standard-answer gear-answer is-pending" data-gear-answer aria-live="polite"><div class="standard-answer__main"><span>Rapporto al ponte effettivo</span><strong data-gear-effective>—</strong><p data-gear-context>Il confronto dei rapporti di trasmissione apparirà qui.</p></div><div class="standard-answer__secondary"><span>Rapporto per ritrovare la sensazione originale</span><strong data-gear-matching>—</strong><small data-gear-rpm>I giri in presa diretta appariranno qui.</small></div></section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Il tuo rapporto effettivo apparirà qui.</p>
    <Parametric3DPanel mode="gear" locale="it" />
    <GearRatioTechnicalVisual locale="it" />
    <div class="fuel-detail-heading" aria-hidden="true"><span>Dettagli</span><small>Rapporto e calcolo in presa diretta</small></div><dl class="tool-results" data-results aria-live="polite"></dl><div class="inline-errors" data-errors role="alert" hidden></div>
    <section class="rpm-matrix" aria-labelledby="rpm-matrix-heading"><div><p class="eyebrow">PNEUMATICI DA 25–44 POLLICI</p><h2 id="rpm-matrix-heading">Mappa dei giri a <span data-matrix-speed>65</span> mph</h2><p>Presa diretta (1,00:1). Il colore indica i giri relativi solo all’interno di questa tabella.</p></div><div class="rpm-matrix__scroll"><table><thead><tr><th scope="col">Pneumatico</th>{ratios.map((ratio) => <th scope="col">{ratio.toFixed(2)}</th>)}</tr></thead><tbody data-rpm-matrix></tbody></table></div><p class="rpm-matrix__legend"><span>Giri relativi più bassi</span><i aria-hidden="true"></i><span>Giri relativi più alti</span></p></section>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeGearRatioCalculators } from '../../../../ui/gear-ratio-calculator'; initializeGearRatioCalculators();</script>

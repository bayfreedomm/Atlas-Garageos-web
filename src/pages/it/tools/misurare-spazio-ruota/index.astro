---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('measure-my-car');
const c = localizedTool('measure-my-car', 'it');
---
<ToolPage {definition} locale="it" titleOverride={c.title} descriptionOverride={c.description} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/it/fitment-studio/#measure-flow" alternates={toolAlternates('measure-my-car')}>
  <div slot="tool" class="entry-workspace">
    <div><p class="eyebrow">Checklist di misurazione</p><h2>Due spazi, una base di partenza</h2><p>Prima di misurare, verifica quali cerchi e pneumatici sono montati. Su ogni lato usa lo spazio statico rilevante più ridotto.</p>
      <ol class="entry-steps">
        <li><strong>Spazio interno</strong><span>Dal bordo del cerchio o del pneumatico al componente fisso di sospensione o carrozzeria più vicino.</span></li>
        <li><strong>Spazio esterno</strong><span>Dal bordo esterno del cerchio o del pneumatico al bordo del parafango considerato.</span></li>
        <li><strong>Obiettivi facoltativi</strong><span>Aggiungi solo margini scelti da te: Atlas non ne inventa nessuno.</span></li>
      </ol>
    </div>
    <a class="button" href="/it/fitment-studio/#measure-flow">Apri la procedura guidata in cinque passaggi</a>
  </div>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>

---
import { platformAlternates } from '../../seo/locale-alternates';
import SiteLayout from '../../components/SiteLayout.astro';
import HomeLauncher from '../../components/HomeLauncher.astro';
import { platformCatalog } from '../../localization/site-catalog';
const c = platformCatalog['it'].home;
const alternates = platformAlternates('/');
---
<SiteLayout title={c.title} description={c.description} pathname="/it/" active="home" locale="it" alternates={alternates}>
  <HomeLauncher locale="it" />
</SiteLayout>

---
// Localized tire-size detail pages (pt-br): one page per catalog size plus one page per tire-height group.
import SiteLayout from '../../../../components/SiteLayout.astro';
import TireSizeEntity from '../../../../components/TireSizeEntity.astro';
import TireDiameterGroup from '../../../../components/TireDiameterGroup.astro';
import { tireSizeCatalog, type TireSizeEntry } from '../../../../data/tire-size-catalog';
import { tireSizeIndexing } from '../../../../seo/index-policy';
import { tireDiameterGroupMeta, tireDiameterGroupSlug, tireDiameterGroups, tireSizeDetailMeta, type TireDiameterGroup as DiameterGroup } from '../../../../ui/entity-page-model';

export function getStaticPaths() {
  return [
    ...tireSizeCatalog.map((entry) => ({ params: { slug: entry.slug }, props: { entry, group: undefined } })),
    ...tireDiameterGroups().map((group) => ({ params: { slug: tireDiameterGroupSlug(group.inches, 'pt-br') }, props: { entry: undefined, group } })),
  ];
}

interface Props { entry: TireSizeEntry | undefined; group: DiameterGroup | undefined; }
const { entry, group } = Astro.props as Props;
const meta = entry ? tireSizeDetailMeta(entry, 'pt-br') : tireDiameterGroupMeta(group!, 'pt-br');
// Low-value localized sizes stay live but noindex; see src/seo/index-policy.ts.
const indexing = entry ? tireSizeIndexing(entry, 'pt-br') : undefined;
---
<SiteLayout title={meta.title} description={meta.description} pathname={meta.pathname} active="tools" locale="pt-br" alternates={meta.alternates} indexable={indexing?.indexable ?? true} hreflangAlternates={indexing?.hreflang} breadcrumbs={meta.breadcrumbs}>
  {entry ? <TireSizeEntity entry={entry} locale="pt-br" /> : <TireDiameterGroup group={group!} locale="pt-br" />}
</SiteLayout>

---
import { platformAlternates } from '../../seo/locale-alternates';
import SiteLayout from '../../components/SiteLayout.astro';
import HomeLauncher from '../../components/HomeLauncher.astro';
import { platformCatalog } from '../../localization/site-catalog';
const c = platformCatalog['pt-br'].home;
const alternates = platformAlternates('/');
---
<SiteLayout title={c.title} description={c.description} pathname="/pt-br/" active="home" locale="pt-br" alternates={alternates}>
  <HomeLauncher locale="pt-br" />
</SiteLayout>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import WheelOffsetTechnicalVisual from '../../../../components/WheelOffsetTechnicalVisual.astro';
import EngineeringVisualStudio from '../../../../components/EngineeringVisualStudio.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('wheel-offset-calculator');
const c = localizedTool('wheel-offset-calculator', 'pt-br');
---
<ToolPage {definition} locale="pt-br" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/pt-br/tools/medir-folga-carro/" alternates={toolAlternates('wheel-offset-calculator')}>
  <form slot="tool" class="calculator-form" data-calculator="wheel-offset" novalidate>
    <div class="garage-quick-load" data-garage-quick-load data-gql-target="wheel-offset" data-gql-locale="pt-br" hidden></div>
    <div class="calculator-columns">
      <fieldset class="calculator-group"><legend>Roda original</legend><div class="grid"><label>Tala · J<input name="originalWidthInches" type="number" value="8" step="0.5" inputmode="decimal" /></label><label>Offset · ET<input name="originalOffsetMm" type="number" value="40" inputmode="numeric" /></label></div></fieldset>
      <fieldset class="calculator-group"><legend>Roda nova</legend><div class="grid"><label>Tala · J<input name="newWidthInches" type="number" value="8.5" step="0.5" inputmode="decimal" /></label><label>Offset · ET<input name="newOffsetMm" type="number" value="35" inputmode="numeric" /></label></div></fieldset>
    </div>
    <div class="form-actions"><button type="submit">Comparar posição da roda</button><button type="button" class="secondary" data-share-result>Copiar link para compartilhar</button></div>
    <div class="inline-errors" data-errors role="alert" hidden></div>
    <section class="wheel-primary-result is-pending" data-wheel-primary-result aria-live="polite" aria-label="Resultado principal da posição da roda">
      <div class="wheel-primary-result__answer">
        <span>Mudança na borda externa</span>
        <strong data-wheel-primary-outer>—</strong>
        <p data-wheel-primary-outer-copy>Compare as rodas para ver quanto a borda externa se desloca.</p>
      </div>
      <div class="wheel-primary-result__inner">
        <span>Mudança na borda interna</span>
        <strong data-wheel-primary-inner>—</strong>
        <small data-wheel-primary-inner-copy>Mostra o deslocamento em direção à suspensão ou para longe dela.</small>
      </div>
    </section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Seu resumo de posição aparecerá aqui.</p>
    <EngineeringVisualStudio mode="offset" locale="pt-br"><WheelOffsetTechnicalVisual locale="pt-br" /></EngineeringVisualStudio>
    <div class="wheel-detail-heading" aria-hidden="true"><span>Detalhes</span><small>Geometria estática da roda</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeShareableToolState } from '../../../../ui/shareable-tool-state'; import { initializeToolCalculators } from '../../../../ui/tool-calculators'; import { initializeGarageQuickLoad } from '../../../../ui/garage-quick-load'; initializeShareableToolState(); initializeToolCalculators(); initializeGarageQuickLoad();</script>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import FuelFields from '../../../../components/FuelFields.astro';
import FuelCostTechnicalVisual from '../../../../components/FuelCostTechnicalVisual.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('fuel-cost-calculator');
const c = localizedTool('fuel-cost-calculator', 'pt-br');
---
<ToolPage {definition} locale="pt-br" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('fuel-cost-calculator')}>
  <form slot="tool" class="calculator-form fuel-cost-form" data-utility-calculator="fuel-cost" novalidate>
    <FuelFields locale="pt-br" currency="BRL" />
    <a class="fuel-price-hint" href="/gas-prices-today/">Preços dos combustíveis nos EUA (inglês) <span aria-hidden="true">→</span></a>
    <button type="submit">Calcular gasto com combustível</button>
    <div class="fuel-primary-result is-pending" data-fuel-primary-result aria-live="polite" aria-label="Resultado principal do gasto com combustível">
      <div class="fuel-primary-result__cost"><span>Gasto estimado com combustível</span><strong data-fuel-primary-cost>—</strong><p data-fuel-primary-copy>Digite os dados do seu trajeto para ver o gasto estimado com combustível.</p></div>
      <div class="fuel-primary-result__fuel"><span>Combustível necessário</span><strong data-fuel-primary-fuel>—</strong><small data-fuel-primary-rate>O custo por distância aparecerá aqui.</small></div>
    </div>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Sua estimativa de combustível aparecerá aqui.</p>
    <FuelCostTechnicalVisual locale="pt-br" />
    <div class="fuel-detail-heading" aria-hidden="true"><span>Detalhes</span><small>Detalhamento de combustível e custo</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

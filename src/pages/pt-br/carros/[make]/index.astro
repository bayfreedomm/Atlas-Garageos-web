---
// Localized make pages (pt-br): one per make with wheel fitment data.
import SiteLayout from '../../../../components/SiteLayout.astro';
import CarMakeLocaleBody from '../../../../components/CarMakeLocaleBody.astro';
import { carLocaleText } from '../../../../content/car-locale-text';
import type { CarMake } from '../../../../data/cars';
import { carHubPathFor, carMakeAlternates, carMakeLocaleMeta, carMakePathFor, localizedCarMakes } from '../../../../ui/car-locale';
import { homePath } from '../../../../ui/entity-page-model';

export function getStaticPaths() {
  return localizedCarMakes.map((make) => ({ params: { make: make.makeSlug }, props: { make } }));
}

interface Props { make: CarMake; }
const { make } = Astro.props as Props;
const t = carLocaleText['pt-br'];
const meta = carMakeLocaleMeta(make, 'pt-br');
const pathname = carMakePathFor('pt-br', make.makeSlug);
---
<SiteLayout title={meta.title} description={meta.description} pathname={pathname} active="tools" locale="pt-br" alternates={carMakeAlternates(make.makeSlug)} breadcrumbs={[{ name: t.breadcrumbHome, href: homePath('pt-br') }, { name: t.hub, href: carHubPathFor('pt-br') }, { name: make.make, href: pathname }]}>
  <CarMakeLocaleBody make={make} locale="pt-br" />
</SiteLayout>

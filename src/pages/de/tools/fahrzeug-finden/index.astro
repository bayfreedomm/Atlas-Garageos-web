---
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
import { vehicleMakes } from '../../../../data/vehicle-fitment';
import { indexedVehicleMakes } from '../../../../data/vehicle-model-index';
const definition = toolById('vehicle-fitment-finder');
const c = localizedTool('vehicle-fitment-finder', 'de');
const makeCount = vehicleMakes().length;
const searchableMakeCount = new Set([...vehicleMakes(), ...indexedVehicleMakes()]).size;
---
<ToolPage {definition} locale="de" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/find-my-vehicle/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/fahrzeug-finden/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/encontrar-mi-vehiculo/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/find-my-vehicle/' }]}>
  <form slot="tool" class="calculator-form" data-calculator="vehicle-finder" novalidate>
    <fieldset><legend>Fahrzeug</legend>
      <div class="utility-fields">
        <label>Marke<select name="make" data-vehicle-make></select></label>
        <label>Modell<select name="model" data-vehicle-model disabled></select></label>
      </div>
    </fieldset>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Wählen Sie Marke und Modell, um Referenzwerte zur Bereifung zu sehen.</p>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="vehicle-meta" data-vehicle-meta hidden>
      <span class="vehicle-confidence" data-vehicle-confidence></span>
      <p class="vehicle-sources" data-vehicle-sources></p>
      <p class="vehicle-notes" data-vehicle-notes hidden></p>
    </div>
    <div class="vehicle-actions" data-vehicle-actions hidden>
      <a class="studio-cta studio-cta--row" data-vehicle-tire-link data-base-href="/de/tools/reifengroesse-rechner/"><span><small>Aus diesem Fahrzeug vorausgefüllt</small><strong>Im Reifengrößen-Rechner öffnen</strong></span><i aria-hidden="true">›</i></a>
      <a class="studio-cta studio-cta--row" data-vehicle-bolt-link data-base-href="/de/tools/lochkreis-rechner/"><span><small>Aus diesem Fahrzeug vorausgefüllt</small><strong>Im Lochkreis-Rechner öffnen</strong></span><i aria-hidden="true">›</i></a>
    </div>
  </form>
  <div slot="explanation">
    {c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}
    <h2>Aktuell {makeCount} Marken mit geprüften Referenzwerten</h2>
    <p>Dies ist ein Startbestand häufig gesuchter Fahrzeuge, keine vollständige Herstellerdatenbank — er wächst mit der Zeit. Falls Ihr genaues Fahrzeug noch nicht gelistet ist, finden Sie die Herstellerangabe auf dem Aufkleber an der Fahrertür oder im Handbuch, die Sie direkt im <a href="/de/tools/reifengroesse-rechner/">Reifengrößen-Rechner</a> oder <a href="/de/tools/lochkreis-rechner/">Lochkreis-Rechner</a> eingeben können.</p>
    <p>Die Marken-/Modellauswahl selbst durchsucht eine größere Liste — insgesamt {searchableMakeCount} Marken —, damit Sie Ihr Fahrzeug auch dann finden und auswählen können, wenn wir noch keine geprüfte Reifen-/Lochkreis-Referenz dafür haben. In diesem Fall sagen wir das offen, statt eine Zahl zu raten.</p>
    <p>Suchen Sie einen teilbaren Link für ein bestimmtes Fahrzeug? Sehen Sie sich die <a href="/de/fahrzeuge/">Fahrzeug-Referenzdaten</a> an — eine eigene Seite pro Modell mit denselben geprüften Daten.</p>
  </div>
</ToolPage>
<script>import { initializeVehicleFitmentFinder } from '../../../../ui/vehicle-fitment-finder'; initializeVehicleFitmentFinder();</script>

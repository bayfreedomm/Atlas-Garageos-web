---
import ToolPage from '../../../../components/ToolPage.astro';
import WheelOffsetTechnicalVisual from '../../../../components/WheelOffsetTechnicalVisual.astro';
import EngineeringVisualStudio from '../../../../components/EngineeringVisualStudio.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('wheel-offset-calculator');
const c = localizedTool('wheel-offset-calculator', 'de');
---
<ToolPage {definition} locale="de" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/de/tools/freigang-messen/" alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/wheel-offset-calculator/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/felgen-et-rechner/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/calculadora-offset-llantas/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/wheel-offset-calculator/' }]}>
  <form slot="tool" class="calculator-form" data-calculator="wheel-offset" novalidate>
    <div class="garage-quick-load" data-garage-quick-load data-gql-target="wheel-offset" data-gql-locale="de" hidden></div>
    <div class="calculator-columns">
      <fieldset class="calculator-group"><legend>Ursprüngliche Felge</legend><div class="grid"><label>Breite · J<input name="originalWidthInches" type="number" value="8" step="0.5" inputmode="decimal" /></label><label>Einpresstiefe · ET<input name="originalOffsetMm" type="number" value="40" inputmode="numeric" /></label></div></fieldset>
      <fieldset class="calculator-group"><legend>Neue Felge</legend><div class="grid"><label>Breite · J<input name="newWidthInches" type="number" value="8.5" step="0.5" inputmode="decimal" /></label><label>Einpresstiefe · ET<input name="newOffsetMm" type="number" value="35" inputmode="numeric" /></label></div></fieldset>
    </div>
    <div class="form-actions"><button type="submit">Radposition vergleichen</button><button type="button" class="secondary" data-share-result>Link zum Teilen kopieren</button></div>
    <div class="inline-errors" data-errors role="alert" hidden></div>
    <section class="wheel-primary-result is-pending" data-wheel-primary-result aria-live="polite" aria-label="Primäres Radpositionsergebnis">
      <div class="wheel-primary-result__answer">
        <span>Änderung Außenkante</span>
        <strong data-wheel-primary-outer>—</strong>
        <p data-wheel-primary-outer-copy>Vergleichen Sie die Felgen, um zu sehen, wie weit sich die Außenkante verschiebt.</p>
      </div>
      <div class="wheel-primary-result__inner">
        <span>Änderung Innenkante</span>
        <strong data-wheel-primary-inner>—</strong>
        <small data-wheel-primary-inner-copy>Zeigt Bewegung zum oder vom Fahrwerk weg.</small>
      </div>
    </section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Ihre Positionszusammenfassung erscheint hier.</p>
    <EngineeringVisualStudio mode="offset" locale="de"><WheelOffsetTechnicalVisual locale="de" /></EngineeringVisualStudio>
    <div class="wheel-detail-heading" aria-hidden="true"><span>Details</span><small>Statische Radgeometrie</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeShareableToolState } from '../../../../ui/shareable-tool-state'; import { initializeToolCalculators } from '../../../../ui/tool-calculators'; import { initializeGarageQuickLoad } from '../../../../ui/garage-quick-load'; initializeShareableToolState(); initializeToolCalculators(); initializeGarageQuickLoad();</script>

---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('hp-kw-converter');
const c = localizedTool('hp-kw-converter', 'de');
---
<ToolPage {definition} locale="de" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={toolAlternates('hp-kw-converter')}>
  <form slot="tool" class="calculator-form instant-calculator" data-utility-calculator="power" novalidate>
    <div class="instant-input">
      <label>Leistung<input name="value" type="number" value="180" min="0" step="any" inputmode="decimal" /></label>
      <label>Einheit<select name="unit"><option value="hp">Mechanische PS</option><option value="kw">Kilowatt</option></select></label>
    </div>
    <UtilityResultStandard locale="de" primaryLabel="Umgerechnete Leistung" pending="Geben Sie einen Leistungswert ein." visualTitle="Mechanische Leistungsumrechnung" visualNote="Mechanische PS bleiben von metrischer PS-Angabe getrennt" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

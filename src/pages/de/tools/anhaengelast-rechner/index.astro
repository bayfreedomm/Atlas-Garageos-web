---
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('towing-capacity-calculator');
const c = localizedTool('towing-capacity-calculator', 'de');
---
<ToolPage {definition} locale="de" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/towing-capacity-calculator/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/anhaengelast-rechner/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/calculadora-capacidad-remolque/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/towing-capacity-calculator/' }]}>
  <form slot="tool" class="calculator-form" data-calculator="towing-capacity" novalidate>
    <div class="utility-fields">
      <label class="field-wide">Einheit<select name="unit"><option value="lb" selected>Pfund (lb)</option><option value="kg">Kilogramm (kg)</option></select></label>
      <label>Zulässiges Gesamtzuggewicht (GCWR)<input name="gcwr" type="number" value="17000" min="0" step="any" inputmode="decimal" /></label>
      <label>Leergewicht Zugfahrzeug<input name="curbWeight" type="number" value="5500" min="0" step="any" inputmode="decimal" /></label>
      <label>Passagiere + Ladung im Fahrzeug<input name="loadWeight" type="number" value="500" min="0" step="any" inputmode="decimal" /></label>
    </div>
    <UtilityResultStandard locale="de" primaryLabel="Maximale Anhängerlast" pending="Geben Sie GCWR, Leergewicht und Zuladung ein." visualTitle="GCWR − beladenes Fahrzeug = Anhängerkapazität" visualNote="Vereinfachte Schätzung, keine Herstellerangabe" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeTowingCapacityCalculator } from '../../../../ui/towing-capacity-calculator'; initializeTowingCapacityCalculator();</script>

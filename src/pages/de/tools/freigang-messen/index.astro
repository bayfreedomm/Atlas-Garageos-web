---
import { toolAlternates } from '../../../../seo/locale-alternates';
import ToolPage from '../../../../components/ToolPage.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('measure-my-car');
const c = localizedTool('measure-my-car', 'de');
---
<ToolPage {definition} locale="de" titleOverride={c.title} descriptionOverride={c.description} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} studioCta={c.studioCta} studioHref="/de/fitment-studio/#measure-flow" alternates={toolAlternates('measure-my-car')}>
  <div slot="tool" class="entry-workspace">
    <div><p class="eyebrow">Checkliste zur Messung</p><h2>Zwei Abstände, eine Basislinie</h2><p>Bestätigen Sie die aktuell montierte Felge und Reifen, bevor Sie messen. Nutzen Sie auf jeder Seite den kürzesten relevanten statischen Abstand.</p>
      <ol class="entry-steps">
        <li><strong>Innenfreigang</strong><span>Felgen- oder Reifenbereich zum nächstgelegenen festen Fahrwerks- oder Karosserieteil.</span></li>
        <li><strong>Außenfreigang</strong><span>Äußerer Felgen- oder Reifenbereich bis zur bewerteten Kotflügelkante.</span></li>
        <li><strong>Optionale Ziele</strong><span>Fügen Sie nur selbst gewählte Margen hinzu; Atlas erfindet keine.</span></li>
      </ol>
    </div>
    <a class="button" href="/de/fitment-studio/#measure-flow">Fünf-Schritte-Assistenten öffnen</a>
  </div>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>

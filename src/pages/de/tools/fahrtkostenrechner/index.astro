---
import ToolPage from '../../../../components/ToolPage.astro';
import FuelFields from '../../../../components/FuelFields.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
import fuelPrices from '../../../../data/fuel-prices.json';
const definition = toolById('road-trip-cost-calculator');
const c = localizedTool('road-trip-cost-calculator', 'de');
const livePrice = fuelPrices.de.e5 ?? 1.75;
---
<ToolPage {definition} locale="de" titleOverride={c.title} descriptionOverride={c.description} visual={false} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/road-trip-cost-calculator/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/fahrtkostenrechner/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/calculadora-coste-viaje/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/road-trip-cost-calculator/' }]}>
  <form slot="tool" class="calculator-form road-trip-form" data-utility-calculator="road-trip" novalidate>
    <FuelFields locale="de" distance={420} economy={6.5} price={livePrice} currency="EUR" />
    <fieldset class="trip-options"><legend>Fahrt</legend>
      <div class="utility-fields"><label class="field-wide">Richtung<select name="tripType"><option value="one">Einfache Fahrt</option><option value="round">Hin- und Rückfahrt</option></select></label></div>
      <details><summary>Maut, Extras oder Mitreisende hinzufügen</summary><div class="utility-fields">
        <label>Zusätzliche Fahrtkosten<input name="extraCost" type="number" value="0" min="0" step="any" inputmode="decimal" /></label>
        <label>Personen<input name="people" type="number" value="1" min="1" step="1" inputmode="numeric" /></label>
      </div></details>
    </fieldset>
    <button type="submit">Reisekosten schätzen</button>
    <section class="trip-primary is-pending" data-trip-primary aria-live="polite" aria-label="Geschätzte Reisekosten">
      <div class="trip-primary__main"><span>Geschätzte Gesamtreisekosten</span><strong data-trip-total>—</strong><p data-trip-context>Geben Sie Ihre Reisedaten ein, um die vollständigen Kosten zu sehen.</p></div>
      <div class="trip-primary__support"><div><span>Verbrauchter Kraftstoff</span><strong data-trip-fuel>—</strong><small data-trip-fuel-cost>Kraftstoffkosten erscheinen hier.</small></div><div><span>Fahrt</span><strong data-trip-direction>—</strong><small data-trip-distance>Distanz erscheint hier.</small></div><div data-trip-person-wrap hidden><span>Pro Person</span><strong data-trip-person>—</strong><small data-trip-people>Aufteilung der Gesamtsumme</small></div></div>
    </section>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Ihre Reiseschätzung erscheint hier.</p>
    <figure class="trip-technical-visual is-pending" data-trip-visual aria-label="Reisedistanz und proportionale Kostenaufschlüsselung">
      <div class="trip-technical-visual__head"><span>FAHRT → KRAFTSTOFF + EXTRAS → GESAMT</span><small>Routen-Schema; Kostenanteile proportional</small></div>
      <div class="trip-route" aria-hidden="true"><span>START</span><div class="trip-route__track"><i></i><i data-trip-return hidden></i></div><span data-trip-end>ZIEL</span></div>
      <div class="trip-visual-stats"><div><small>Fahrstrecke</small><strong data-trip-visual-distance>—</strong></div><div><small>Kraftstoffbedarf</small><strong data-trip-visual-fuel>—</strong></div><div><small>Gesamtsumme</small><strong data-trip-visual-total>—</strong></div></div>
      <div class="trip-cost-track" role="img" aria-label="Kraftstoff- und Extra-Kostenanteile" data-trip-cost-track><span class="trip-cost-track__fuel" data-trip-fuel-bar></span><span class="trip-cost-track__extras" data-trip-extra-bar></span></div>
      <figcaption><span><i class="trip-key trip-key--fuel"></i>Kraftstoff <strong data-trip-visual-fuel-cost>—</strong></span><span><i class="trip-key trip-key--extras"></i>Extras <strong data-trip-visual-extras>—</strong></span></figcaption>
    </figure>
    <div class="fuel-detail-heading" aria-hidden="true"><span>Details</span><small>Vollständige Fahrtaufschlüsselung</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

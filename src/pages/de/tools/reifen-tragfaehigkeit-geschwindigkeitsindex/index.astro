---
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('tire-load-speed-rating');
const c = localizedTool('tire-load-speed-rating', 'de');
const loadIndexes = Array.from({ length: 126 - 75 + 1 }, (_, index) => 75 + index);
const speedRatings: readonly string[] = ['L', 'M', 'N', 'P', 'Q', 'R', 'S', 'T', 'U', 'H', 'V', 'W', 'Y'];
---
<ToolPage {definition} locale="de" titleOverride={c.title} descriptionOverride={c.description} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/tire-load-speed-rating/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/reifen-tragfaehigkeit-geschwindigkeitsindex/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/indice-carga-velocidad-neumatico/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/tire-load-speed-rating/' }]}>
  <form slot="tool" class="calculator-form" data-calculator="tire-load-speed" novalidate>
    <div class="utility-fields">
      <label>Tragfähigkeitsindex<select name="loadIndex">{loadIndexes.map((index) => <option value={index} selected={index === 91}>{index}</option>)}</select></label>
      <label>Geschwindigkeitsindex<select name="speedRating">{speedRatings.map((rating) => <option value={rating} selected={rating === 'V'}>{rating}</option>)}</select></label>
    </div>
    <UtilityResultStandard locale="de" primaryLabel="Tragfähigkeit pro Reifen" pending="Wählen Sie Tragfähigkeits- und Geschwindigkeitsindex." visualTitle="Code → Standard-Tragfähigkeit" visualNote="Standard ETRTO-/Geschwindigkeitssymbol-Referenztabelle" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeTireLoadSpeedReference } from '../../../../ui/tire-load-speed-reference'; initializeTireLoadSpeedReference();</script>

---
import ToolPage from '../../../../components/ToolPage.astro';
import FuelFields from '../../../../components/FuelFields.astro';
import FuelCostTechnicalVisual from '../../../../components/FuelCostTechnicalVisual.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('fuel-cost-calculator');
const c = localizedTool('fuel-cost-calculator', 'de');
---
<ToolPage {definition} locale="de" titleOverride={c.title} descriptionOverride={c.description} visual={false} eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/fuel-cost-calculator/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/spritkostenrechner/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/calculadora-coste-combustible/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/fuel-cost-calculator/' }]}>
  <form slot="tool" class="calculator-form fuel-cost-form" data-utility-calculator="fuel-cost" novalidate>
    <FuelFields locale="de" />
    <button type="submit">Kraftstoffkosten berechnen</button>
    <div class="fuel-primary-result is-pending" data-fuel-primary-result aria-live="polite" aria-label="Primäres Kraftstoffkosten-Ergebnis">
      <div class="fuel-primary-result__cost"><span>Geschätzte Kraftstoffkosten</span><strong data-fuel-primary-cost>—</strong><p data-fuel-primary-copy>Geben Sie Ihre Fahrtdaten ein, um die geschätzten Kraftstoffkosten zu sehen.</p></div>
      <div class="fuel-primary-result__fuel"><span>Kraftstoffbedarf</span><strong data-fuel-primary-fuel>—</strong><small data-fuel-primary-rate>Kosten pro Strecke erscheinen hier.</small></div>
    </div>
    <p class="result-summary is-pending" data-result-summary aria-live="polite">Ihre Kraftstoffschätzung erscheint hier.</p>
    <FuelCostTechnicalVisual />
    <div class="fuel-detail-heading" aria-hidden="true"><span>Details</span><small>Kraftstoff- und Kostenaufschlüsselung</small></div>
    <dl class="tool-results" data-results aria-live="polite"></dl>
    <div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeUtilityCalculators } from '../../../../ui/utility-calculators'; initializeUtilityCalculators();</script>

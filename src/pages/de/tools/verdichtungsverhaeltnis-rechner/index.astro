---
import ToolPage from '../../../../components/ToolPage.astro';
import UtilityResultStandard from '../../../../components/UtilityResultStandard.astro';
import Parametric3DPanel from '../../../../components/Parametric3DPanel.astro';
import { toolById } from '../../../../seo/tool-registry';
import { localizedTool } from '../../../../localization/site-catalog';
const definition = toolById('compression-ratio-calculator');
const c = localizedTool('compression-ratio-calculator', 'de');
---
<ToolPage {definition} locale="de" titleOverride={c.title} descriptionOverride={c.description} explanationBeforeInsights eyebrow={c.eyebrow} intro={c.intro} limitation={c.limitation} alternates={[{ hreflang: 'en', href: 'https://atlasgarageos.com/tools/compression-ratio-calculator/' }, { hreflang: 'de', href: 'https://atlasgarageos.com/de/tools/verdichtungsverhaeltnis-rechner/' }, { hreflang: 'es', href: 'https://atlasgarageos.com/es/tools/calculadora-relacion-compresion/' }, { hreflang: 'x-default', href: 'https://atlasgarageos.com/tools/compression-ratio-calculator/' }]}>
  <form slot="tool" class="calculator-form" data-calculator="compression-ratio" novalidate>
    <div class="utility-fields">
      <label>Bohrung · mm<input name="bore" type="number" value="86" min="0" step="any" inputmode="decimal" /></label>
      <label>Hub · mm<input name="stroke" type="number" value="86" min="0" step="any" inputmode="decimal" /></label>
      <label>Brennraumvolumen · cc<input name="chamber" type="number" value="48" min="0" step="any" inputmode="decimal" /></label>
      <label>Weiteres Volumen · cc<input name="otherVolume" type="number" value="4" step="any" inputmode="decimal" /></label>
    </div>
    <UtilityResultStandard locale="de" primaryLabel="Statisches Verdichtungsverhältnis" pending="Geben Sie Bohrung, Hub und Brennraumvolumen ein." visualTitle="Hubvolumen + Verdichtungsvolumen ÷ Verdichtungsvolumen" visualNote="Statisches geometrisches Verhältnis, keine dynamische Verdichtung" />
    <Parametric3DPanel mode="compression" locale="de" />
  </form>
  <div slot="explanation">{c.explanation.map((s) => <><h2>{s.heading}</h2>{s.paragraphs.map((p) => <p>{p}</p>)}</>)}</div>
</ToolPage>
<script>import { initializeCompressionRatioCalculator } from '../../../../ui/compression-ratio-calculator'; initializeCompressionRatioCalculator();</script>

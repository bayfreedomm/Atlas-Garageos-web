---
import { platformAlternates } from '../../seo/locale-alternates';
import SiteLayout from '../../components/SiteLayout.astro';
import HomeLauncher from '../../components/HomeLauncher.astro';
import { platformCatalog } from '../../localization/site-catalog';
const c = platformCatalog.de.home;
const alternates = platformAlternates('/');
---
<SiteLayout title={c.title} description={c.description} pathname="/de/" active="home" locale="de" alternates={alternates}>
  <HomeLauncher locale="de" />
</SiteLayout>

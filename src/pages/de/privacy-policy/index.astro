---
import { platformAlternates } from '../../../seo/locale-alternates';
import SiteLayout from '../../../components/SiteLayout.astro';
import PrivacyEmailReports from '../../../components/PrivacyEmailReports.astro';
import { platformCatalog } from '../../../localization/site-catalog';
const c = platformCatalog.de.privacy;
const alternates = platformAlternates('/privacy-policy/');
---
<SiteLayout title={c.title} description={c.description} pathname="/de/privacy-policy/" active="tools" locale="de" alternates={alternates} breadcrumbs={[{ name: 'Start', href: '/de/' }, { name: c.h1, href: '/de/privacy-policy/' }]}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/de/">Start</a><span aria-hidden="true">/</span><span aria-current="page">{c.h1}</span></nav>
  <header class="directory-identity"><h1>{c.h1}</h1><p>{c.updated}</p></header>
  <div class="tool-explanation privacy-copy">
    {c.sections.map((s) => <><h2>{s.heading}</h2><p>{s.body}</p></>)}
    <PrivacyEmailReports locale="de" />
  </div>
</SiteLayout>

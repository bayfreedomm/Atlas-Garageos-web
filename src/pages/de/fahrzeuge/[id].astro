---
import SiteLayout from '../../../components/SiteLayout.astro';
import { serializeJsonLd } from '../../../seo/safe-json-ld';
import { vehiclePageText } from '../../../content/vehicle-page-text';
import { vehicleFitmentData, type VehicleFitment } from '../../../data/vehicle-fitment';
import { tireSizeSlug } from '../../../data/tire-size-catalog';
import { boltPatternSlug } from '../../../data/bolt-pattern-catalog';
import { entityDetailPath, type EntityLocale } from '../../../seo/entity-routes';
import { torqueJsonLdProperty, torquePresentation } from '../../../ui/vehicle-torque';

// The sourced tire size and bolt pattern below link through to their own reference pages.
const LOCALE: EntityLocale = 'de';

export function getStaticPaths() {
  return vehicleFitmentData
    .filter((v) => v.market === 'eu')
    .map((vehicle) => ({ params: { id: vehicle.id }, props: { vehicle } }));
}

interface Props { vehicle: VehicleFitment; }
const { vehicle } = Astro.props as Props;
const t = vehiclePageText.de;
const pathname = `/de/fahrzeuge/${vehicle.id}/`;
const esPathname = `/es/vehiculos/${vehicle.id}/`;
const title = `${vehicle.make} ${vehicle.model} Reifengröße & Lochkreis`;
const description = `Atlas-Referenz für Reifengröße ${vehicle.tireSize} und Lochkreis ${vehicle.boltPattern} des ${vehicle.make} ${vehicle.model} (${vehicle.generation}), mit Quellenangabe und Verlässlichkeitsbewertung.`;
const torque = torquePresentation(vehicle, LOCALE);
const faqs = [
  { q: t.faqTireQ(vehicle), a: t.faqTireA(vehicle) },
  { q: t.faqBoltQ(vehicle), a: t.faqBoltA(vehicle) },
  { q: t.faqTorqueQ(vehicle), a: t.faqTorqueA(vehicle) },
];
const faqJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const vehicleJsonLd = serializeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'Vehicle',
  name: `${vehicle.make} ${vehicle.model}`,
  brand: { '@type': 'Brand', name: vehicle.make },
  model: vehicle.model,
  vehicleModelDate: vehicle.generation,
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Reifengröße', value: vehicle.tireSize },
    { '@type': 'PropertyValue', name: 'Lochkreis', value: vehicle.boltPattern },
    { '@type': 'PropertyValue', name: 'Felgengröße', value: vehicle.wheelSize },
    ...torqueJsonLdProperty(vehicle, 'Anzugsdrehmoment (Nm)'),
  ],
});
---
<SiteLayout title={title} description={description} pathname={pathname} active="tools" locale="de" alternates={[{ hreflang: 'de', href: `https://atlasgarageos.com${pathname}` }, { hreflang: 'es', href: `https://atlasgarageos.com${esPathname}` }, { hreflang: 'x-default', href: `https://atlasgarageos.com${pathname}` }]} breadcrumbs={[{ name: t.breadcrumbHome, href: '/de/' }, { name: t.breadcrumbVehicles, href: '/de/fahrzeuge/' }, { name: `${vehicle.make} ${vehicle.model}`, href: pathname }]}>
  <script is:inline type="application/ld+json" set:html={faqJsonLd}></script>
  <script is:inline type="application/ld+json" set:html={vehicleJsonLd}></script>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/de/">{t.breadcrumbHome}</a><span aria-hidden="true">/</span><a href="/de/fahrzeuge/">{t.breadcrumbVehicles}</a><span aria-hidden="true">/</span><span aria-current="page">{vehicle.make} {vehicle.model}</span></nav>

  <header class="directory-identity methodology-hero">
    <p class="eyebrow">{t.kicker}</p>
    <h1>{t.h1(vehicle)}</h1>
    <p>{t.intro(vehicle)}</p>
  </header>

  <div class="methodology-grid">
    <section><h2>{t.tireSize}</h2><p><strong><a href={entityDetailPath('tire-size', LOCALE, tireSizeSlug(vehicle.tireSize))}>{vehicle.tireSize}</a></strong></p></section>
    <section><h2>{t.boltPattern}</h2><p><strong><a href={entityDetailPath('bolt-pattern', LOCALE, boltPatternSlug(vehicle.boltPattern))}>{vehicle.boltPattern}</a></strong> ({vehicle.lugCount} {vehicle.fastenerType === 'lug-nut' ? t.lugNut : t.wheelBolt})</p></section>
    <section><h2>{t.wheelSize}</h2><p><strong>{vehicle.wheelSize}</strong></p></section>
    <section><h2>{t.torque}</h2><p><strong class={torque.qualified ? 'entity-soft' : undefined}>{torque.value}</strong>{torque.qualifier && <><br /><small>{torque.qualifier}</small></>}</p></section>
    {vehicle.centerBoreMm !== undefined && <section><h2>{t.centerBore}</h2><p><strong>{vehicle.centerBoreMm} mm</strong></p></section>}
    <section><h2>{t.generation}</h2><p><strong>{vehicle.generation}</strong></p></section>
  </div>

  <section class="methodology-sources" aria-labelledby="vehicle-confidence-heading">
    <p class="eyebrow">{t.confidenceNote}</p>
    <h2 id="vehicle-confidence-heading"><span class="vehicle-confidence" data-confidence={vehicle.confidence}>{t.confidence[vehicle.confidence]}</span></h2>
    <p>{t.sourcesLabel}: {vehicle.sources.join(', ')}</p>
    {vehicle.notes && <p>{t.notesLabel}: {vehicle.notes}</p>}
    <p>{t.disclaimer}</p>
  </section>

  <section aria-labelledby="vehicle-faq-heading">
    <h2 id="vehicle-faq-heading">{t.faqHeading}</h2>
    {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>

  <section class="methodology-sources" aria-labelledby="vehicle-tools-heading">
    <h2 id="vehicle-tools-heading">{t.toolsHeading}</h2>
    <div class="methodology-source-links">
      <a href="/de/tools/reifengroesse-rechner/">{t.openTireTool} <span>↗</span></a>
      <a href="/de/tools/lochkreis-rechner/">{t.openBoltTool} <span>↗</span></a>
      <a href="/de/tools/nm-lb-ft-umrechner/">{t.openTorqueTool} <span>↗</span></a>
    </div>
  </section>

  <section class="vehicle-fuel-journey" aria-labelledby="vehicle-fuel-heading">
    <h2 id="vehicle-fuel-heading">{t.fuelHeading}</h2>
    <div class="vehicle-fuel-journey__cards">
      <a class="vehicle-fuel-card" href="/de/kraftstoffpreise/"><strong>{t.fuelCardTitle}</strong><span>{t.fuelCardCopy}</span><i aria-hidden="true">›</i></a>
      <a class="vehicle-fuel-card" href="/de/tools/fahrtkostenrechner/"><strong>{t.tripCardTitle}</strong><span>{t.tripCardCopy}</span><i aria-hidden="true">›</i></a>
    </div>
  </section>
</SiteLayout>

---
// Localized tire-size detail pages (EN).
//
// One route file generates every page in this locale: getStaticPaths() returns one entry per
// row of tireSizeCatalog, which is itself derived from vehicleFitmentData. Adding a vehicle with a
// new tire size publishes a new page here on the next build with no new file.
import SiteLayout from '../../../components/SiteLayout.astro';
import TireSizeEntity from '../../../components/TireSizeEntity.astro';
import { tireSizeCatalog, type TireSizeEntry } from '../../../data/tire-size-catalog';
import { tireSizeDetailMeta } from '../../../ui/entity-page-model';

export function getStaticPaths() {
  // tireSizeCatalog has already had malformed and vehicle-less entries excluded, so anything
  // reaching this point is a page with real, validated data behind it.
  return tireSizeCatalog.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: TireSizeEntry; }
const { entry } = Astro.props as Props;
const meta = tireSizeDetailMeta(entry, 'en');
---
<SiteLayout title={meta.title} description={meta.description} pathname={meta.pathname} active="tools" alternates={meta.alternates} breadcrumbs={meta.breadcrumbs}>
  <TireSizeEntity entry={entry} locale="en" />
</SiteLayout>

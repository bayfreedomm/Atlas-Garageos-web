---
// Localized tire-size hub (EN). A thin wrapper: the listing, the notation explainer and
// the filter all live in TireSizeHubBody.astro so there is one copy of that markup, not three.
import SiteLayout from '../../components/SiteLayout.astro';
import TireSizeHubBody from '../../components/TireSizeHubBody.astro';
import { tireSizeHubMeta } from '../../ui/entity-page-model';

const meta = tireSizeHubMeta('en');
---
<SiteLayout title={meta.title} description={meta.description} pathname={meta.pathname} active="tools" alternates={meta.alternates} breadcrumbs={meta.breadcrumbs}>
  <TireSizeHubBody locale="en" />
</SiteLayout>

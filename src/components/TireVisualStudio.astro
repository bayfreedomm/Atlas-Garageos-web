---
import Parametric3DPanel from './Parametric3DPanel.astro';
import TireComparisonVisual from './TireComparisonVisual.astro';
import type { Visualization3DLocale } from '../localization/visualization-3d';

interface Props { readonly locale?: Visualization3DLocale | undefined; }
const { locale = 'en' } = Astro.props;
const copy = {
  en: { badge: 'Visual studio', title: 'See your setup as a product', intro: 'The engineering drawing opens instantly; load the interactive 3D model only when you want to inspect it.', studio: '3D Studio', drawings: 'Engineering 2D' },
  de: { badge: 'Visual Studio', title: 'Konfiguration als Produkt ansehen', intro: 'Die technische Zeichnung öffnet sofort; laden Sie das interaktive 3D-Modell nur bei Bedarf.', studio: '3D Studio', drawings: 'Technische 2D-Ansicht' },
  es: { badge: 'Estudio visual', title: 'Mira la configuración como un producto', intro: 'El dibujo técnico se abre al instante; carga el modelo 3D interactivo solo cuando quieras inspeccionarlo.', studio: 'Estudio 3D', drawings: 'Ingeniería 2D' },
  fr: { badge: 'Studio visuel', title: 'Voyez votre montage comme un produit', intro: 'Le plan technique s’ouvre instantanément ; chargez le modèle 3D interactif seulement si vous voulez l’inspecter.', studio: 'Studio 3D', drawings: 'Plan technique 2D' },
  it: { badge: 'Studio visivo', title: 'Guarda la configurazione come un prodotto', intro: 'Il disegno tecnico si apre subito; carica il modello 3D interattivo solo quando vuoi esaminarlo.', studio: 'Studio 3D', drawings: 'Disegno tecnico 2D' },
  'pt-br': { badge: 'Estúdio visual', title: 'Veja sua configuração como um produto', intro: 'O desenho técnico abre na hora; carregue o modelo 3D interativo só quando quiser examiná-lo.', studio: 'Estúdio 3D', drawings: 'Engenharia 2D' },
  pl: { badge: 'Studio wizualne', title: 'Zobacz swój zestaw jak produkt', intro: 'Rysunek techniczny otwiera się od razu; interaktywny model 3D wczytaj tylko wtedy, gdy chcesz go obejrzeć.', studio: 'Studio 3D', drawings: 'Rysunek techniczny 2D' },
  nl: { badge: 'Visuele studio', title: 'Bekijk je set-up als een product', intro: 'De technische tekening opent direct; laad het interactieve 3D-model alleen als je het wilt bekijken.', studio: '3D-studio', drawings: 'Technische 2D-tekening' },
  tr: { badge: 'Görsel stüdyo', title: 'Kurulumunuzu bir ürün gibi görün', intro: 'Teknik çizim anında açılır; etkileşimli 3D modeli yalnızca incelemek istediğinizde yükleyin.', studio: '3D Stüdyo', drawings: '2D Teknik Çizim' },
}[locale];
---
<section class="tire-visual-studio" data-tire-visual-studio aria-label={copy.title}>
  <header class="tire-visual-studio__header">
    <div><span>{copy.badge}</span><h3>{copy.title}</h3><p>{copy.intro}</p></div>
    <div class="tire-visual-studio__tabs" role="tablist" aria-label={copy.badge}>
      <button type="button" role="tab" aria-selected="false" tabindex="-1" data-visual-tab="3d">{copy.studio}</button>
      <button type="button" role="tab" aria-selected="true" data-visual-tab="2d">{copy.drawings}</button>
    </div>
  </header>
  <div role="tabpanel" data-visual-panel="3d" hidden><Parametric3DPanel mode="tire" {locale} /></div>
  <div role="tabpanel" data-visual-panel="2d"><TireComparisonVisual {locale} /></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tire-visual-studio]').forEach((studio) => {
    const buttons = [...studio.querySelectorAll<HTMLButtonElement>('[data-visual-tab]')];
    const panels = [...studio.querySelectorAll<HTMLElement>('[data-visual-panel]')];
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const selected = button.dataset.visualTab;
        for (const candidate of buttons) candidate.setAttribute('aria-selected', String(candidate === button));
        for (const panel of panels) panel.hidden = panel.dataset.visualPanel !== selected;
      });
    }
  });
</script>

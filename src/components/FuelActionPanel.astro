---
// Fuel dashboards keep their existing market-specific status note, while the destinations
// and decision copy come from the same shared graph used by vehicle and entity pages.
import DecisionGraph from './DecisionGraph.astro';
import { fuelDecisionGraph } from '../ui/decision-graph';
import type { EntityLocale } from '../seo/entity-routes';
interface Props {
  readonly locale: EntityLocale;
  /** Localized line saying whether a price will be carried into the calculators. Must be
   *  neutral while the market is pending — never promise a prefill that cannot happen. */
  readonly note: string;
}
const { locale, note } = Astro.props;
const model = fuelDecisionGraph(locale, note);
---
<DecisionGraph {model} {locale} id="fuel-decisions" />

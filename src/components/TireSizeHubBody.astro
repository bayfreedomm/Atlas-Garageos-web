---
// Shared body for the tire-size hub in every locale.
//
// The listing is rendered as real <a href> links, grouped by rim diameter, at build time.
// The search box only hides rows that are already there, so the hub is crawlable and fully
// usable without JavaScript. Even at hundreds of sourced sizes this remains a crawlable index;
// the client filter only helps readers narrow the already-rendered list.
import { tireSizeCatalog, tireSizesByRimDiameter, vehiclesForTireSize } from '../data/tire-size-catalog';
import { vehicleFitmentData } from '../data/vehicle-fitment';
import { tireSizePageText } from '../content/entity-page-text';
import { entityDetailPath, entityHubPath, type EntityLocale } from '../seo/entity-routes';
import { displayTireNotation, formatTireMetrics, homePath, tireDiameterGroupPath, tireDiameterGroups, tireSizeMetrics, vehicleHubPath } from '../ui/entity-page-model';
import { entitySearchText } from '../ui/entity-search';
import { localizedToolPath } from '../localization/locales';
import TireSizeLookup from './TireSizeLookup.astro';
import { tireSizeShortcuts } from '../ui/reference-links';

interface Props { readonly locale: EntityLocale; }
const { locale } = Astro.props;

const t = tireSizePageText[locale];
const groups = tireSizesByRimDiameter();
const total = tireSizeCatalog.length;
const shortcuts = tireSizeShortcuts(locale);

// Every card is fully resolved here, in the frontmatter, so the template below stays a plain
// loop over data — no lookups, no assertions, nothing that can silently miss.
const groupCards = groups.map(([rim, entries]) => ({
  rim,
  anchor: `rim-${String(rim).replace('.', '-')}`,
  cards: entries.map((entry) => {
    const vehicles = vehiclesForTireSize(entry.notation);
    const makes = [...new Set(vehicles.map((vehicle) => vehicle.make))];
    return {
      notation: displayTireNotation(entry.notation, locale),
      href: entityDetailPath('tire-size', locale, entry.slug),
      diameter: formatTireMetrics(tireSizeMetrics(entry), locale).overallDiameter,
      vehicles: vehicles.length,
      // Everything a reader might type: the code itself, the slug form, and the makes.
      // Normalized with the same function the live filter applies to the query, so a
      // reader typing any separator spelling of this entity still matches it.
      search: entitySearchText([entry.notation, entry.slug, displayTireNotation(entry.notation, locale), ...makes]),
    };
  }),
}));
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href={homePath(locale)}>{t.breadcrumbHome}</a><span aria-hidden="true">/</span>
  <span aria-current="page">{t.breadcrumbHub}</span>
</nav>

<header class="entity-hero">
  <p class="eyebrow">{t.hubKicker}</p>
  <h1>{t.hubH1}</h1>
  <p class="entity-hero__lead">{t.hubLead(total, vehicleFitmentData.length)}</p>
</header>

<section class="entity-section" aria-labelledby="hub-lookup">
  <h2 id="hub-lookup">{t.lookup.heading}</h2>
  <TireSizeLookup locale={locale} id="tire-lookup-hub" />
  <ul class="entity-chiplist">
    {shortcuts.map((shortcut) => <li><a class="entity-chip" href={shortcut.href}>{shortcut.label}</a></li>)}
  </ul>
</section>

<section class="entity-section" aria-labelledby="hub-notation">
  <h2 id="hub-notation">{t.notationHeading}</h2>
  <p class="entity-note">{t.notationIntro}</p>
  <ol class="entity-code entity-code--compact">
    {t.notationParts.map((part) => (
      <li class="entity-code__part">
        <span class="entity-code__token">{part.token}</span>
        <strong>{part.label}</strong>
        <span>{part.detail}</span>
      </li>
    ))}
  </ol>
</section>

<section class="entity-section" aria-labelledby="hub-heights">
  <h2 id="hub-heights">{t.diameter.hubHeading}</h2>
  <p class="entity-note">{t.diameter.hubIntro}</p>
  <ul class="entity-chiplist">
    {tireDiameterGroups().map((group) => <li><a class="entity-chip" href={tireDiameterGroupPath(group.inches, locale)}>{t.diameter.groupLink(group.inches)}</a></li>)}
  </ul>
</section>

<section class="entity-section" aria-labelledby="hub-list" data-entity-filter>
  <h2 id="hub-list">{t.backToHub}</h2>
  <form class="entity-filterbar" role="search" data-entity-search-form>
    <label class="entity-filterbar__label" for="tire-size-filter">{t.searchLabel}</label>
    <input id="tire-size-filter" class="entity-filterbar__input" type="search" autocomplete="off" placeholder={t.searchPlaceholder} data-entity-search />
    <span class="entity-filterbar__count" data-entity-count data-count-one={t.countLabel(1)} data-count-other={t.countLabel(0).replace('0', '{n}')}>{t.countLabel(total)}</span>
  </form>


  {groupCards.map((group) => (
    <details class="entity-group entity-group--fold" id={group.anchor} data-entity-group data-default-open="false">
      <summary>{t.groupHeading(group.rim)} <span>{group.cards.length}</span></summary>
      <ul class="entity-grid entity-grid--compact">
        {group.cards.map((card) => (
          <li class="entity-card" data-entity-card data-entity-search-text={card.search}>
            <a href={card.href}>
              <strong class="entity-card__title">{card.notation}</strong>
              <span class="entity-card__meta">⌀ {card.diameter}{card.vehicles > 0 ? ` · ${t.listedAs(card.vehicles)}` : ''}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ))}

  <p class="entity-empty" data-entity-empty hidden>{t.searchEmpty}</p>
</section>

<section class="entity-section" aria-labelledby="hub-tools">
  <h2 id="hub-tools">{t.toolsHeading}</h2>
  <div class="entity-links">
    <a class="entity-link-card" href={localizedToolPath(locale, 'tire-size-calculator', 'tool')}><strong>{t.calculatorCta}</strong><span>{t.calculatorCtaDetail}</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href={localizedToolPath(locale, 'tire-size-comparison', 'tool')}><strong>{t.comparisonCta}</strong><span>{t.comparisonCtaDetail}</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href={vehicleHubPath(locale)}><strong>{t.vehiclesCta}</strong><span>{t.vehiclesCtaDetail}</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href={entityHubPath('bolt-pattern', locale)}><strong>{t.boltHubCta}</strong><span>{t.boltHubCtaDetail}</span><i aria-hidden="true">›</i></a>
  </div>
</section>

<script>import { initializeEntityFilters } from '../ui/entity-filter'; initializeEntityFilters();</script>

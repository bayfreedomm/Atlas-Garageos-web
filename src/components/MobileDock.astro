---
interface Props { active?: 'home' | 'tools' | 'fitment'; }
const { active } = Astro.props;
---
<nav class="mobile-dock" aria-label="Mobile navigation">
  <a href="/" aria-current={active === 'home' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5v8a1.5 1.5 0 0 1-1.5 1.5h-5v-6h-5v6h-5A1.5 1.5 0 0 1 3 19.5z"/></svg><span>Home</span>
  </a>
  <a href="/tools/" aria-current={active === 'tools' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg><span>Tools</span>
  </a>
  <a href="/fitment-studio/" aria-current={active === 'fitment' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="12" r="4"/><circle cx="16" cy="12" r="4"/><path d="M12 12h0M4 12H2m20 0h-2"/></svg><span>Compare</span>
  </a>
</nav>
<script>import { initializeMobileDock } from '../ui/mobile-dock'; initializeMobileDock();</script>

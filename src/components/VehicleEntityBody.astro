---
import { carModelForVehicle, carModelPath, epaYears } from '../data/cars';
import { carModelPathFor, isLocalizedModel } from '../ui/car-locale';
import { carLocaleText } from '../content/car-locale-text';
// Shared mobile-first body for vehicle reference pages (EN/DE/ES/FR), matching the tire-size page:
// answer strip → spec table → same-pattern vehicles → sources → FAQ → next decisions.
import DecisionGraph from './DecisionGraph.astro';
import EntityImage from './EntityImage.astro';
import { vehicleImage } from '../seo/vehicle-images';
import TireSizeFlow from './TireSizeFlow.astro';
import { vehicleFlowText } from '../content/vehicle-flow-text';
import { isReferenceLocale } from '../localization/reference-locales';
import { vehiclePageText, type VehicleLocale } from '../content/vehicle-page-text';
import { vehicleFitmentData, vehicleNote, type VehicleFitment } from '../data/vehicle-fitment';
import { tireSizeBySlug, tireSizeSlug } from '../data/tire-size-catalog';
import { boltPatternSlug } from '../data/bolt-pattern-catalog';
import { entityDetailPath } from '../seo/entity-routes';
import { displayTireNotation, tireSizeMetrics, vehicleLink } from '../ui/entity-page-model';
import { formatDecimal, formatPlain } from '../ui/locale-format';
import { torquePresentation } from '../ui/vehicle-torque';
import { vehicleDecisionGraph } from '../ui/decision-graph';

interface Props { readonly vehicle: VehicleFitment; readonly locale: VehicleLocale; readonly faqs: readonly { readonly q: string; readonly a: string }[]; }
const { vehicle, locale, faqs } = Astro.props;
const pageImage = vehicleImage(vehicle, locale);
const t = vehiclePageText[locale];
const L = {
  en: { specs: 'Wheel and tire specs', options: 'Factory option sizes', fastener: 'Fastener', sameHeading: 'Other vehicles with the same bolt pattern', sameIntro: (p: string) => `Also on ${p} in the Atlas reference. Same holes, but center bore, offset and wheel size can still differ:`, tireHeight: 'Tire height', sources: 'Sources and confidence', nav: { specs: 'Specs', same: 'Same pattern', faq: 'FAQ' } },
  de: { specs: 'Rad- und Reifendaten', options: 'Werksoptionale Reifengrößen', fastener: 'Befestigung', sameHeading: 'Weitere Fahrzeuge mit gleichem Lochkreis', sameIntro: (p: string) => `Ebenfalls ${p} in der Atlas-Referenz. Gleiche Bohrungen – Nabenbohrung, ET und Felgengröße können trotzdem abweichen:`, tireHeight: 'Reifendurchmesser', sources: 'Quellen und Verlässlichkeit', nav: { specs: 'Daten', same: 'Gleicher Lochkreis', faq: 'FAQ' } },
  es: { specs: 'Datos de llanta y neumático', options: 'Medidas opcionales de fábrica', fastener: 'Fijación', sameHeading: 'Otros vehículos con el mismo patrón', sameIntro: (p: string) => `También con ${p} en la referencia Atlas. Mismos agujeros, pero el centro de rueda, el offset y la llanta pueden variar:`, tireHeight: 'Diámetro del neumático', sources: 'Fuentes y confianza', nav: { specs: 'Datos', same: 'Mismo patrón', faq: 'Preguntas' } },
  fr: { specs: 'Données jante et pneu', options: "Tailles optionnelles d'origine", fastener: 'Fixation', sameHeading: 'Autres véhicules avec le même entraxe', sameIntro: (p: string) => `Également en ${p} dans la référence Atlas. Mêmes trous, mais l'alésage, le déport et la taille de jante peuvent différer :`, tireHeight: 'Diamètre du pneu', sources: 'Sources et confiance', nav: { specs: 'Données', same: 'Même entraxe', faq: 'FAQ' } },
  'it': { specs: 'Dati cerchio e pneumatico', options: 'Misure opzionali di fabbrica', fastener: 'Fissaggio', sameHeading: 'Altri veicoli con la stessa foratura', sameIntro: (p: string) => `Anche con foratura ${p} nel riferimento Atlas. Stessi fori, ma foro centrale, offset e misura del cerchio possono differire:`, tireHeight: 'Diametro dello pneumatico', sources: 'Fonti e affidabilità', nav: { specs: 'Dati', same: 'Stessa foratura', faq: 'FAQ' } },
  'pt-br': { specs: 'Dados de roda e pneu', options: 'Medidas opcionais de fábrica', fastener: 'Fixação', sameHeading: 'Outros veículos com a mesma furação', sameIntro: (p: string) => `Também com ${p} na referência Atlas. Mesmos furos, mas o furo central, o offset e a medida da roda podem ser diferentes:`, tireHeight: 'Diâmetro do pneu', sources: 'Fontes e confiança', nav: { specs: 'Dados', same: 'Mesma furação', faq: 'FAQ' } },
  'pl': { specs: 'Dane felg i opon', options: 'Fabryczne rozmiary opcjonalne', fastener: 'Mocowanie', sameHeading: 'Inne pojazdy z tym samym rozstawem śrub', sameIntro: (p: string) => `Również z rozstawem ${p} w bazie Atlas. Te same otwory, ale otwór centralny, odsadzenie i rozmiar felgi mogą się różnić:`, tireHeight: 'Średnica opony', sources: 'Źródła i pewność', nav: { specs: 'Dane', same: 'Ten sam rozstaw', faq: 'FAQ' } },
  'nl': { specs: 'Velg- en bandgegevens', options: "Optionele fabrieksmaten", fastener: 'Bevestiging', sameHeading: 'Andere voertuigen met dezelfde steekmaat', sameIntro: (p: string) => `Ook met ${p} in de Atlas-referentie. Dezelfde gaten, maar naafgat, inpersdiepte en velgmaat kunnen verschillen:`, tireHeight: 'Banddiameter', sources: 'Bronnen en betrouwbaarheid', nav: { specs: 'Gegevens', same: 'Zelfde steekmaat', faq: 'FAQ' } },
  'tr': { specs: 'Jant ve lastik verileri', options: 'Fabrika opsiyonu ebatlar', fastener: 'Bağlantı', sameHeading: 'Aynı bijon aralığına sahip diğer araçlar', sameIntro: (p: string) => `Atlas referansında bijon aralığı ${p} olan diğer araçlar. Delikler aynı, ancak göbek çapı, ofset ve jant ölçüsü farklı olabilir:`, tireHeight: 'Lastik çapı', sources: 'Kaynaklar ve güven', nav: { specs: 'Veriler', same: 'Aynı bijon aralığı', faq: 'SSS' } },
}[locale];
const torque = torquePresentation(vehicle, locale);
const decisions = vehicleDecisionGraph(vehicle, locale);
const tireHref = entityDetailPath('tire-size', locale, tireSizeSlug(vehicle.tireSize));
const boltHref = entityDetailPath('bolt-pattern', locale, boltPatternSlug(vehicle.boltPattern));
const tireEntry = tireSizeBySlug(tireSizeSlug(vehicle.tireSize));
const tireMetrics = tireEntry ? tireSizeMetrics(tireEntry) : undefined;
const fastener = vehicle.fastenerType === 'lug-nut' ? t.lugNut : t.wheelBolt;
const note = isReferenceLocale(locale) ? undefined : locale === 'en' ? vehicle.notes : vehicleNote(vehicle, locale);
const samePattern = vehicleFitmentData
  .filter((other) => other.id !== vehicle.id && other.boltPattern === vehicle.boltPattern)
  .sort((a, b) => Number(b.centerBoreMm === vehicle.centerBoreMm) - Number(a.centerBoreMm === vehicle.centerBoreMm) || a.make.localeCompare(b.make))
  .slice(0, 12);
const answer = [
  { label: t.tireSize, value: displayTireNotation(vehicle.tireSize, locale), href: tireHref },
  { label: t.boltPattern, value: vehicle.boltPattern, href: boltHref },
  { label: t.torque, value: torque.value === '—' ? '—' : torque.value.replace(/\s*\(.*\)$/, ''), href: undefined },
  { label: t.centerBore, value: vehicle.centerBoreMm !== undefined ? `${formatPlain(vehicle.centerBoreMm, locale)} mm` : '—', href: undefined },
];
const matchedCarModel = carModelForVehicle(vehicle);
// English links to the MPG-first /cars/ page; other languages to the localized wheel page when one exists.
const carModel = matchedCarModel && (locale === 'en' || isLocalizedModel(matchedCarModel)) ? matchedCarModel : undefined;
const carText = carLocaleText[locale];
const carYears = carModel ? epaYears(carModel) : [];
const flow = vehicleFlowText[locale];
---
<header class="entity-hero entity-hero--tire">
  <p class="eyebrow">{t.kicker}</p>
  <h1 class="entity-hero__title">{t.h1(vehicle)}</h1>
  <dl class="entity-answer entity-answer--vehicle">
    {answer.map((item) => (
      <div class="entity-answer__item">
        <dt>{item.label}</dt>
        <dd><strong>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</strong></dd>
      </div>
    ))}
  </dl>
  <p class="entity-hero__lead">{t.intro(vehicle)}</p>
  {pageImage && <EntityImage image={pageImage} locale={locale} />}
  <nav class="entity-pagenav" aria-label={L.nav.specs}>
    <a href="#vehicle-specs">{L.nav.specs}</a>
    {samePattern.length > 0 && <a href="#vehicle-same">{L.nav.same}</a>}
    <a href="#vehicle-faq-heading">{L.nav.faq}</a>
  </nav>
</header>

<section class="entity-section" aria-labelledby="vehicle-specs">
  <h2 id="vehicle-specs">{L.specs}</h2>
  <table class="entity-spec entity-spec--two">
    <tbody>
      <tr><th scope="row">{t.tireSize}</th><td><a href={tireHref}>{displayTireNotation(vehicle.tireSize, locale)}</a></td></tr>
      {tireMetrics && <tr><th scope="row">{L.tireHeight}</th><td>{formatDecimal(tireMetrics.overallDiameterMm, 0, locale)} mm · {formatDecimal(tireMetrics.overallDiameterMm / 25.4, 1, locale)}″</td></tr>}
      {vehicle.optionalTireSizes && vehicle.optionalTireSizes.length > 0 && (
        <tr><th scope="row">{L.options}</th><td class="entity-spec__wrap">{vehicle.optionalTireSizes.map((size, index) => <>{index > 0 && ', '}<a href={entityDetailPath('tire-size', locale, tireSizeSlug(size))}>{displayTireNotation(size, locale)}</a></>)}</td></tr>
      )}
      <tr><th scope="row">{t.wheelSize}</th><td>{vehicle.wheelSize}</td></tr>
      <tr><th scope="row">{t.boltPattern}</th><td><a href={boltHref}>{vehicle.boltPattern}</a></td></tr>
      <tr><th scope="row">{L.fastener}</th><td>{vehicle.lugCount} × {fastener}</td></tr>
      {vehicle.centerBoreMm !== undefined && <tr><th scope="row">{t.centerBore}</th><td>{formatPlain(vehicle.centerBoreMm, locale)} mm</td></tr>}
      <tr><th scope="row">{t.torque}</th><td class={torque.qualified ? 'entity-soft' : undefined}>{torque.value}</td></tr>
      <tr><th scope="row">{t.generation}</th><td class="entity-spec__wrap">{vehicle.generation}</td></tr>
      <tr><th scope="row">{t.market}</th><td>{vehicle.market === 'us' ? t.hubUsMarket : t.hubEuMarket}</td></tr>
    </tbody>
  </table>
  {torque.qualifier && <p class="entity-note">{torque.qualifier}</p>}
  {note && <p class="entity-note">{t.notesLabel}: {note}</p>}
</section>

<TireSizeFlow
  locale={locale}
  id="vehicle-tire-flow"
  heading={flow.heading(`${vehicle.make} ${vehicle.model}`)}
  intro={flow.intro}
  sizes={[{ notation: vehicle.tireSize, role: 'standard' }, ...(vehicle.optionalTireSizes ?? []).map((notation) => ({ notation, role: 'option' as const }))]}
/>

{samePattern.length > 0 && (
  <section class="entity-section" aria-labelledby="vehicle-same">
    <h2 id="vehicle-same">{L.sameHeading}</h2>
    <p class="entity-note">{L.sameIntro(vehicle.boltPattern)}</p>
    <ul class="entity-chiplist">
      {samePattern.map((other) => {
        const link = vehicleLink(other, locale);
        return <li><a class="entity-chip" href={link.href} hreflang={link.crossLocale ? link.locale : undefined}>{other.make} {other.model}{other.centerBoreMm !== undefined ? ` · ${formatPlain(other.centerBoreMm, locale)} mm` : ''}</a></li>;
      })}
    </ul>
  </section>
)}

{carModel && locale !== 'en' && (
  <section class="entity-section" aria-labelledby="vehicle-cars">
    <h2 id="vehicle-cars">{carText.vehicleSectionHeading(`${carModel.make} ${carModel.model}`)}</h2>
    <div class="entity-links">
      <a class="entity-link-card" href={carModelPathFor(locale, carModel)}><strong>{carText.vehicleCardTitle(`${carModel.make} ${carModel.model}`)}</strong><span>{carText.vehicleCardDetail(carModel.wheels.length)}</span><i aria-hidden="true">›</i></a>
    </div>
  </section>
)}

{carModel && locale === 'en' && (
  <section class="entity-section" aria-labelledby="vehicle-cars">
    <h2 id="vehicle-cars">{carModel.make} {carModel.model}: MPG and wheel data by year</h2>
    <div class="entity-links">
      <a class="entity-link-card" href={carModelPath(carModel)}><strong>{carModel.make} {carModel.model} MPG by year{carModel.wheels.length ? ', bolt pattern and wheel sizes' : ''}</strong><span>{carYears.length ? `EPA fuel economy ${carYears[0]}–${carYears[carYears.length - 1]}` : 'Wheel fitment records'}{carModel.wheels.length ? ` · ${carModel.wheels.length} wheel records` : ''}</span><i aria-hidden="true">›</i></a>
    </div>
  </section>
)}

<section class="entity-section" aria-labelledby="vehicle-confidence-heading">
  <h2 id="vehicle-confidence-heading">{L.sources}</h2>
  <p><span class={`entity-confidence entity-confidence--${vehicle.confidence}`}>{t.confidence[vehicle.confidence]}</span></p>
  <p class="entity-note">{t.confidenceNote}</p>
  <p class="entity-note">{t.sourcesLabel}: {vehicle.sources.join(', ')}</p>
  <p class="entity-note">{t.disclaimer}</p>
</section>

<section class="entity-section" aria-labelledby="vehicle-faq-heading">
  <h2 id="vehicle-faq-heading">{t.faqHeading}</h2>
  {faqs.map((f) => <details class="entity-faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}
</section>

<DecisionGraph model={decisions} locale={locale} id="vehicle-decisions" />

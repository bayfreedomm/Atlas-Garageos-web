---
import { visualization3DLocale, visualization3DText, type Visualization3DLocale } from '../localization/visualization-3d';
import ParametricEngineering2D from './ParametricEngineering2D.astro';
import { studioCameraText } from '../lib/visualization/studio-camera';

interface Props {
  readonly mode: 'tire' | 'single' | 'speed' | 'gear' | 'compression' | 'ev' | 'fitment' | 'offset' | 'pcd';
  readonly locale?: Visualization3DLocale | undefined;
  readonly lugCount?: number | undefined;
  readonly pcdMm?: number | undefined;
  readonly centerBoreMm?: number | null | undefined;
}

const { mode, locale: requestedLocale = 'en', lugCount, pcdMm, centerBoreMm } = Astro.props;
const locale = visualization3DLocale(requestedLocale);
const t = visualization3DText[locale];
const title = mode === 'tire' ? t.tireTitle : mode === 'single' ? t.singleTitle : mode === 'speed' ? t.speedTitle : mode === 'gear' ? t.gearTitle : mode === 'compression' ? t.compressionTitle : mode === 'ev' ? t.evTitle : mode === 'fitment' ? t.fitmentTitle : mode === 'offset' ? t.offsetTitle : t.pcdTitle;
const intro = mode === 'tire' ? t.tireIntro : mode === 'single' ? t.singleIntro : mode === 'speed' ? t.speedIntro : mode === 'gear' ? t.gearIntro : mode === 'compression' ? t.compressionIntro : mode === 'ev' ? t.evIntro : mode === 'fitment' ? t.fitmentIntro : mode === 'offset' ? t.offsetIntro : t.pcdIntro;
const caution = mode === 'pcd' ? t.pcdOnly : mode === 'gear' ? t.gearOnly : mode === 'compression' ? t.compressionOnly : mode === 'ev' ? t.evOnly : t.geometryOnly;
const dual = mode === 'single' || mode === 'speed' || mode === 'gear' || mode === 'compression' || mode === 'ev' || mode === 'fitment';
const viewText = {
  en: { label: 'Visual mode', studio: '3D Studio', drawing: 'Engineering 2D', badge: 'VISUAL STUDIO' },
  de: { label: 'Ansichtsmodus', studio: '3D-Studio', drawing: 'Technische 2D-Ansicht', badge: 'VISUELLES STUDIO' },
  es: { label: 'Modo de visualización', studio: 'Estudio 3D', drawing: 'Ingeniería 2D', badge: 'ESTUDIO VISUAL' },
  fr: { label: 'Mode d’affichage', studio: 'Studio 3D', drawing: 'Plan technique 2D', badge: 'STUDIO VISUEL' },
  it: { label: 'Modalità di visualizzazione', studio: 'Studio 3D', drawing: 'Disegno tecnico 2D', badge: 'STUDIO VISIVO' },
  'pt-br': { label: 'Modo de visualização', studio: 'Estúdio 3D', drawing: 'Engenharia 2D', badge: 'ESTÚDIO VISUAL' },
  pl: { label: 'Tryb widoku', studio: 'Studio 3D', drawing: 'Rysunek techniczny 2D', badge: 'STUDIO WIZUALNE' },
  nl: { label: 'Weergavemodus', studio: '3D-studio', drawing: 'Technische 2D-tekening', badge: 'VISUELE STUDIO' },
  tr: { label: 'Görünüm modu', studio: '3D Stüdyo', drawing: '2D Teknik Çizim', badge: 'GÖRSEL STÜDYO' },
}[locale];
const cameraText = studioCameraText[locale];
const focusText = { en: { open: 'Expand studio', close: 'Close studio' }, de: { open: 'Studio vergrößern', close: 'Studio schließen' }, es: { open: 'Ampliar estudio', close: 'Cerrar estudio' }, fr: { open: 'Agrandir le studio', close: 'Fermer le studio' }, it: { open: 'Espandi studio', close: 'Chiudi studio' }, 'pt-br': { open: 'Ampliar estúdio', close: 'Fechar estúdio' }, pl: { open: 'Powiększ studio', close: 'Zamknij studio' }, nl: { open: 'Studio vergroten', close: 'Studio sluiten' }, tr: { open: 'Stüdyoyu büyüt', close: 'Stüdyoyu kapat' } }[locale];
---
<div class:list={[{ 'tire-visual-studio parametric-visual-studio': dual }]} data-parametric-visual-studio={dual ? '' : undefined}>
  {dual && <header class="tire-visual-studio__header"><div><span>{viewText.badge}</span><h3>{title}</h3><p>{intro}</p></div>
    <div class="tire-visual-studio__tabs" role="tablist" aria-label={viewText.label}>
      <button type="button" role="tab" id={`p3d-tab-${mode}`} aria-controls={`p3d-panel-${mode}`} aria-selected="false" tabindex="-1" data-visual-tab="3d">{viewText.studio}</button>
      <button type="button" role="tab" id={`p2d-tab-${mode}`} aria-controls={`p2d-panel-${mode}`} aria-selected="true" data-visual-tab="2d">{viewText.drawing}</button>
    </div>
  </header>}
  <div role={dual ? 'tabpanel' : undefined} id={dual ? `p3d-panel-${mode}` : undefined} aria-labelledby={dual ? `p3d-tab-${mode}` : undefined} data-visual-panel={dual ? '3d' : undefined} hidden={dual || undefined}>
{dual && <p class="parametric-visual-studio__hint">{t.dragHint}</p>}
<section
  class:list={['parametric-3d', `parametric-3d--${mode}`]}
  data-parametric-3d
  data-mode={mode}
  data-locale={locale}
  data-lug-count={lugCount}
  data-pcd-mm={pcdMm}
  data-center-bore-mm={centerBoreMm ?? undefined}
  aria-label={title}
>
  <header class="parametric-3d__head">
    <div>
      <span>{t.badge}</span>
      <h3>{title}</h3>
      <p>{intro}</p>
    </div>
    <p class="parametric-3d__hint">{t.dragHint}</p>
  </header>

  {mode === 'tire' && (
    <div class="parametric-3d__view-switch" aria-label={title}>
      <button type="button" data-p3d-tire-view="side-by-side" aria-pressed="true">{t.sideBySide}</button>
      <button type="button" data-p3d-tire-view="overlay" aria-pressed="false">{t.overlay}</button>
    </div>
  )}
  {mode === 'fitment' && (
    <div class="parametric-3d__view-switch" aria-label={title}>
      <button type="button" data-p3d-fitment-view="tires" aria-pressed="true">{t.tiresView}</button>
      <button type="button" data-p3d-fitment-view="wheels" aria-pressed="false">{t.wheelsView}</button>
    </div>
  )}

  <div class="parametric-3d__stage">
    <canvas data-p3d-canvas width="960" height="600"></canvas>
    <div class="parametric-3d__annotations" data-p3d-annotations aria-hidden="true"></div>
    <div class="parametric-3d__hud" aria-live="polite">
      <small>{mode === 'speed' ? t.speedReadout : t.alwaysVisible}</small>
      {mode === 'single' ? <div><span>{t.diameter}</span><strong data-p3d-value="hud-current">—</strong></div> : mode === 'speed' ? <div><span>{t.current} → {t.proposed}</span><strong data-p3d-value="hud-speed">—</strong></div> : mode === 'gear' || mode === 'compression' || mode === 'ev' ? <div><span>{mode === 'gear' ? t.gearHud : mode === 'compression' ? t.compressionHud : t.evHud}</span><strong data-p3d-value="hud-special">—</strong></div> : mode === 'fitment' ? <div><span>{t.current} → {t.proposed}</span><strong data-p3d-value="hud-fitment">—</strong></div> : mode === 'offset' ? <div><span>{t.innerDelta} / {t.outerDelta}</span><strong data-p3d-value="hud-offset">—</strong></div> : mode === 'pcd' ? <div><span>{t.pcd}</span><strong data-p3d-value="hud-pcd">—</strong></div> : <div><span>{t.current} → {t.proposed}</span><strong data-p3d-value="hud-diameters">—</strong></div>}
      {(mode === 'tire' || mode === 'single' || mode === 'speed' || mode === 'fitment') && <div><span>{t.width}</span><strong data-p3d-value="hud-width">—</strong></div>}
      {(mode === 'tire' || mode === 'single' || mode === 'speed') && <div><span>{t.sidewall} · {t.rim}</span><strong data-p3d-value="hud-profile">—</strong></div>}
    </div>
    <div class="parametric-3d__loading" data-p3d-loading>{t.loading}</div>
    <div class="parametric-3d__fallback" data-p3d-fallback hidden>{t.unavailable}</div>
    <div class="parametric-3d__legend" aria-hidden="true">
      {(mode === 'tire' || mode === 'speed' || mode === 'gear' || mode === 'fitment' || mode === 'offset') && <><span class="is-current"></span>{t.current}<span class="is-proposed"></span>{t.proposed}</>}
      {mode === 'ev' && <><span class="is-current"></span>{t.chargeFrom}<span class="is-proposed"></span>{t.chargeTo}</>}
      {mode === 'single' && <><span class="is-current"></span>{t.diameter}</>}
      {mode === 'compression' && <><span class="is-current"></span>{t.bore}<span class="is-proposed"></span>{t.stroke}</>}
      {mode === 'pcd' && <><span class="is-current"></span>{t.lugCount}<span class="is-accent"></span>{t.pcd}</>}
    </div>
  </div>

  <div class="parametric-3d__camera" role="group" aria-label={viewText.label}>
    <button type="button" data-p3d-camera="studio" aria-pressed="true">{cameraText.studio}</button>
    <button type="button" data-p3d-camera="front" aria-pressed="false">{cameraText.front}</button>
    <button type="button" data-p3d-camera="profile" aria-pressed="false">{cameraText.profile}</button>
    <button type="button" class="parametric-3d__focus" data-p3d-focus data-focus-open={focusText.open} data-focus-close={focusText.close} aria-expanded="false">{focusText.open}</button>
  </div>
  <div class="parametric-3d__controls" aria-label={t.dragHint}>
    <button type="button" data-p3d-zoom-out aria-label={t.zoomOut}>−</button>
    <button type="button" data-p3d-reset>{t.reset}</button>
    <button type="button" data-p3d-zoom-in aria-label={t.zoomIn}>+</button>
  </div>

  {(mode === 'tire' || mode === 'speed' || mode === 'single') && (
    <dl class="parametric-3d__metrics">
      <div><dt>{t.current} · {t.diameter}</dt><dd data-p3d-value="current">—</dd></div>
      {mode !== 'single' && <div><dt>{t.proposed} · {t.diameter}</dt><dd data-p3d-value="proposed">—</dd></div>}
      <div><dt>{t.width}</dt><dd data-p3d-value="width">—</dd></div>
      <div><dt>{t.sidewall}</dt><dd data-p3d-value="sidewall">—</dd></div>
      <div><dt>{t.rim}</dt><dd data-p3d-value="rim">—</dd></div>
      {mode !== 'single' && <div><dt>{t.diameterDelta}</dt><dd data-p3d-value="diameterDelta">—</dd></div>}
      {mode !== 'single' && <div><dt>{t.circumferenceDelta}</dt><dd data-p3d-value="circumferenceDelta">—</dd></div>}
      {mode !== 'single' && <div><dt>{t.speedometerDelta}</dt><dd data-p3d-value="speedometerDelta">—</dd></div>}
    </dl>
  )}

  {mode === 'offset' && (
    <dl class="parametric-3d__metrics">
      <div><dt>{t.currentOffset}</dt><dd data-p3d-value="currentOffset">—</dd></div>
      <div><dt>{t.newOffset}</dt><dd data-p3d-value="newOffset">—</dd></div>
      <div><dt>{t.width}</dt><dd data-p3d-value="width">—</dd></div>
      <div><dt>{t.innerDelta}</dt><dd data-p3d-value="innerDelta">—</dd></div>
      <div><dt>{t.outerDelta}</dt><dd data-p3d-value="outerDelta">—</dd></div>
    </dl>
  )}

  {mode === 'pcd' && (
    <dl class="parametric-3d__metrics">
      <div><dt>{t.pcd}</dt><dd data-p3d-value="pcd">—</dd></div>
      <div><dt>{t.lugCount}</dt><dd data-p3d-value="lugCount">—</dd></div>
      <div><dt>{t.holeSpacing}</dt><dd data-p3d-value="holeSpacing">—</dd></div>
      <div><dt>{t.centerBore}</dt><dd data-p3d-value="centerBore">—</dd></div>
    </dl>
  )}

  {(mode === 'gear' || mode === 'compression' || mode === 'ev') && (
    <dl class="parametric-3d__metrics">
      <div><dt>{mode === 'compression' ? t.bore : mode === 'ev' ? t.chargeFrom : t.current}</dt><dd data-p3d-value="special-current">—</dd></div>
      <div><dt>{mode === 'compression' ? t.stroke : mode === 'ev' ? t.chargeTo : t.proposed}</dt><dd data-p3d-value="special-proposed">—</dd></div>
    </dl>
  )}
  {mode === 'fitment' && <dl class="parametric-3d__metrics"><div><dt>{t.current} · {t.diameter}</dt><dd data-p3d-value="current">—</dd></div><div><dt>{t.proposed} · {t.diameter}</dt><dd data-p3d-value="proposed">—</dd></div><div><dt>{t.innerDelta}</dt><dd data-p3d-value="innerDelta">—</dd></div><div><dt>{t.outerDelta}</dt><dd data-p3d-value="outerDelta">—</dd></div></dl>}

  <p class="parametric-3d__caution">{caution}</p>
</section>
  </div>
{dual && <div role="tabpanel" id={`p2d-panel-${mode}`} aria-labelledby={`p2d-tab-${mode}`} data-visual-panel="2d">
  {mode === 'single' || mode === 'gear' || mode === 'ev' ? <div data-legacy-visual-target={mode}></div> : <ParametricEngineering2D mode={mode} locale={locale} />}
</div>}
</div>

<script>
  const pending3D = new WeakSet<HTMLElement>();
  // See the matching comment in Tool3DPanel.astro: this panel is usually
  // already in view when the IntersectionObserver below attaches, so it fires
  // almost immediately and the renderer's heavy synchronous setup (PBR
  // materials, procedural environment map, normal/AO textures) ends up
  // blocking the page's first paint. One yield lets the rest of the page
  // paint first.
  const yieldToBrowser = () => new Promise<void>((resolve) => {
    requestAnimationFrame(() => {
      if ('requestIdleCallback' in window) requestIdleCallback(() => resolve(), { timeout: 200 });
      else setTimeout(resolve, 0);
    });
  });
  const load3D = async (panel: HTMLElement) => {
    if (pending3D.has(panel) || panel.classList.contains('is-ready')) return;
    pending3D.add(panel);
    try {
      await yieldToBrowser();
      const module = await import('../ui/parametric-3d');
      await module.mountParametric3DPanel(panel);
    } finally {
      pending3D.delete(panel);
    }
  };

  document.querySelectorAll<HTMLElement>('[data-parametric-3d]').forEach((panel) => {
    if (!('IntersectionObserver' in window)) { void load3D(panel); return; }
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      void load3D(panel);
    }, { rootMargin: '0px 0px 80px' });
    observer.observe(panel);
  });

  document.querySelectorAll<HTMLElement>('[data-parametric-visual-studio]').forEach((studio) => {
    const tabs = [...studio.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...studio.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const legacyTarget = studio.querySelector<HTMLElement>('[data-legacy-visual-target]');
    const legacySelector = legacyTarget?.dataset.legacyVisualTarget === 'single' ? '.single-tire-visual' : legacyTarget?.dataset.legacyVisualTarget === 'gear' ? '.gear-technical-visual' : '.ev-technical-visual';
    const legacyVisual = legacyTarget ? studio.closest('form')?.querySelector<HTMLElement>(legacySelector) : null;
    if (legacyVisual && legacyTarget) legacyTarget.append(legacyVisual);
    const plate = studio.querySelector<HTMLElement>('[data-parametric-engineering-2d]');
    if (plate) {
      const source = studio.querySelector<HTMLElement>('[data-p3d-value="hud-speed"], [data-p3d-value="hud-special"], [data-p3d-value="hud-fitment"]');
      const reading = plate.querySelector<HTMLElement>('[data-parametric-engineering-reading]');
      const updateReading = () => {
        if (source && reading) reading.textContent = source.textContent?.trim() || '—';
        if (plate.dataset.parametricEngineering2d !== 'speed') return;
        const current = Number.parseFloat(studio.querySelector('[data-p3d-value="current"]')?.textContent ?? '');
        const proposed = Number.parseFloat(studio.querySelector('[data-p3d-value="proposed"]')?.textContent ?? '');
        if (!(current > 0 && proposed > 0)) return;
        const max = Math.max(current, proposed);
        studio.querySelector('[data-p2d-speed-original]')?.setAttribute('r', String(Math.round(100 * current / max)));
        studio.querySelector('[data-p2d-speed-new]')?.setAttribute('r', String(Math.round(100 * proposed / max)));
      };
      const observer = new MutationObserver(updateReading);
      const hud = studio.querySelector('.parametric-3d__hud');
      if (hud) observer.observe(hud, { subtree: true, characterData: true, childList: true });
      const metrics = studio.querySelector('.parametric-3d__metrics');
      if (metrics) observer.observe(metrics, { subtree: true, characterData: true, childList: true });
      updateReading();
    }
    const choose = (index: number, focus = false) => {
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
      if (focus) tabs[index]?.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => choose(i));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        choose(event.key === 'Home' ? 0 : event.key === 'End' ? 1 : (i + (event.key === 'ArrowRight' ? 1 : -1) + 2) % 2, true);
      });
    });
  });
</script>

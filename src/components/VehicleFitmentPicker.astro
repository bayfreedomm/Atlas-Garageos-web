---
interface Props { target: 'tire-size' | 'bolt-pattern'; }
const { target } = Astro.props;
---
<div class="vehicle-fitment-picker" data-vehicle-fitment-picker data-vfp-target={target}>
  <p class="vehicle-fitment-picker__label">
    <svg class="vehicle-fitment-picker__label-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 16.2 6 10.9a2.4 2.4 0 0 1 2.3-1.7h7.4a2.4 2.4 0 0 1 2.3 1.7l1.5 5.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><rect x="2.8" y="16.2" width="18.4" height="3.6" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="7.4" cy="19.8" r="1.5" fill="currentColor"/><circle cx="16.6" cy="19.8" r="1.5" fill="currentColor"/><path d="M5.6 13.2h12.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    <span>Or select your vehicle</span>
  </p>
  <div class="vehicle-fitment-picker__row">
    <label class="vehicle-fitment-picker__field"><span>Make</span><select data-vfp-make></select></label>
    <label class="vehicle-fitment-picker__field"><span>Year</span><select data-vfp-year disabled><option value="">Any year</option></select></label>
    <label class="vehicle-fitment-picker__field"><span>Model</span><select data-vfp-model disabled><option value="">Choose a make first</option></select></label>
  </div>
  <div class="vehicle-fitment-picker__result" data-vfp-result hidden role="status" aria-live="polite">
    <div class="vehicle-fitment-picker__result-text">
      <strong data-vfp-result-value></strong>
      <small data-vfp-result-note></small>
    </div>
    <button type="button" class="vehicle-fitment-picker__apply" data-vfp-apply hidden>Use this value</button>
  </div>
</div>
<script>import { initializeVehicleFitmentPicker } from '../ui/vehicle-fitment-picker'; initializeVehicleFitmentPicker();</script>

---
import SiteLayout from './SiteLayout.astro';
import type { ToolDefinition } from '../seo/tool-registry';
import { relatedTools, routeForTool } from '../seo/tool-registry';
import ToolIcon from './ToolIcon.astro';
import ToolVisual from './ToolVisual.astro';
import ToolInsights from './ToolInsights.astro';

interface Props { definition: ToolDefinition; eyebrow: string; intro: string; limitation: string; studioCta?: string; studioHref?: string; visual?: boolean; }
const { definition, eyebrow, intro, limitation, studioCta, studioHref = '/fitment-studio/', visual = true } = Astro.props;
const related = relatedTools(definition);
const hasLongTitle = definition.title.length > 24;
---
<SiteLayout {definition} active="tools">
  <nav class="breadcrumbs tool-breadcrumbs" aria-label="Breadcrumb"><a href="/tools/">← All tools</a><span class="sr-only" aria-current="page">{definition.title}</span></nav>

  <article class:list={['tool-machine', `tool-machine--${definition.category.toLowerCase().replaceAll(' & ', '-').replaceAll(' ', '-')}`, `tool-machine--${definition.id}`]} data-tool-id={definition.id}>
    <header class:list={['tool-intro', { 'tool-intro--long': hasLongTitle }]}>
      <ToolIcon id={definition.id} category={definition.category}/>
      <div><p class="eyebrow">{eyebrow}</p><h1>{definition.title}</h1><p class="hero-copy">{intro}</p></div>
    </header>

    <div class:list={['tool-stage', { 'tool-stage--single': !visual }]}>
      <section class="tool-workspace" aria-label={`${definition.title} calculator`}><slot name="tool" /></section>
      {visual && <aside class="tool-visual-wrap" aria-label={`${definition.title} visual explanation`}><p class="tool-visual-label">SEE WHAT THE NUMBERS MEAN</p><ToolVisual {definition} /></aside>}
    </div>
  </article>

  <ToolInsights id={definition.id} />
  <section class="tool-explanation"><div><p class="eyebrow">How it works</p><slot name="explanation" /></div><aside class="limitation-card"><strong>Keep in mind</strong><p>{limitation}</p></aside></section>
  {studioCta && <a class="studio-cta studio-cta--row" href={studioHref}><span><small>Advanced wheel &amp; tire tool</small><strong>{studioCta}</strong></span><i aria-hidden="true">›</i></a>}
  <section class="related-tools" aria-labelledby="related-heading"><h2 id="related-heading">Related tools</h2><div class="related-grid">{related.map((tool) => <a class="related-card" href={routeForTool(tool)}><ToolIcon id={tool.id} category={tool.category}/><span><strong>{tool.title}</strong><small>{tool.category}</small></span><i aria-hidden="true">›</i></a>)}</div></section>
</SiteLayout>
<script>import { initializeToolVisualMotion } from '../ui/tool-visual-motion'; initializeToolVisualMotion();</script>

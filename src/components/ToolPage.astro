---
import SiteLayout from './SiteLayout.astro';
import type { ToolDefinition } from '../seo/tool-registry';
import { uiStrings, type ContentLocale } from '../localization/site-catalog';
import { localizedToolPath } from '../localization/locales';
import ToolIcon from './ToolIcon.astro';
import ToolVisual from './ToolVisual.astro';
import ToolVisualStudio from './ToolVisualStudio.astro';
import ToolInsights from './ToolInsights.astro';
import DecisionGraph from './DecisionGraph.astro';
import { toolNextDecision } from '../ui/tool-next-decision';
import { additional3DToolIds } from '../localization/tool-3d-catalog';

interface HreflangAlternate { readonly hreflang: string; readonly href: string; }
interface Props { definition: ToolDefinition; eyebrow: string; intro: string; limitation: string; studioCta?: string | undefined; studioHref?: string; visual?: boolean; explanationBeforeInsights?: boolean; locale?: ContentLocale | undefined; titleOverride?: string | undefined; descriptionOverride?: string | undefined; alternates?: readonly HreflangAlternate[] | undefined; }
const { definition, eyebrow, intro, limitation, studioCta, studioHref, visual = true, explanationBeforeInsights = false, locale, titleOverride, descriptionOverride, alternates } = Astro.props;
const resolvedStudioHref = studioHref ?? (locale ? `/${locale}/fitment-studio/` : '/fitment-studio/');
const journeyLocale = locale ?? 'en';
const nextDecision = toolNextDecision(definition.id, journeyLocale);
const displayTitle = titleOverride ?? definition.title;
const hasLongTitle = displayTitle.length > 24;
const t = locale ? uiStrings[locale] : undefined;
const backHref = locale ? `/${locale}/tools/` : '/tools/';
const layoutTitle = titleOverride ?? definition.title;
const layoutDescription = descriptionOverride ?? definition.description;
const layoutPathname = locale ? localizedToolPath(locale, definition.id, definition.kind) : undefined;
// Every tool keeps a relevant visual explanation. The fourteen result-led
// tools use their dedicated Engineering 2D / optional 3D studio below the
// workspace; the remaining spatial tools either embed a native studio or use
// the compact tool-specific side visual.
const hasToolVisualStudio = (additional3DToolIds as readonly string[]).includes(definition.id);
const hasEmbeddedStudio = ['tire-size-calculator', 'speedometer-error-calculator', 'gear-ratio-calculator', 'compression-ratio-calculator', 'ev-charging-cost-calculator'].includes(definition.id);
// Without this, SiteLayout's own default breadcrumb trail (Home -> Tools, both English-only
// paths) is used for every locale, so the BreadcrumbList JSON-LD on every DE/ES tool page
// claimed the English homepage/tools-hub as its ancestors even though the page's own visible
// breadcrumb (backHref, above) and content are correctly localized.
const homeHref = locale ? `/${locale}/` : '/';
const breadcrumbs = [
  { name: t?.navHome ?? 'Home', href: homeHref },
  { name: t?.allToolsBack ? t.allToolsBack.replace(/^\W+/, '') : 'Tools', href: backHref },
  { name: displayTitle, href: layoutPathname ?? backHref },
];
---
<SiteLayout definition={definition} title={layoutTitle} description={layoutDescription} pathname={layoutPathname} active="tools" locale={locale} alternates={alternates} breadcrumbs={breadcrumbs}>
  <nav class="breadcrumbs tool-breadcrumbs" aria-label="Breadcrumb"><a href={backHref}>{t?.allToolsBack ?? '← All tools'}</a><span class="sr-only" aria-current="page">{displayTitle}</span></nav>

  <article class:list={['tool-machine', `tool-machine--${definition.category.toLowerCase().replaceAll(' & ', '-').replaceAll(' ', '-')}`, `tool-machine--${definition.id}`]} data-tool-id={definition.id}>
    <header class:list={['tool-intro', { 'tool-intro--long': hasLongTitle }]}>
      <ToolIcon id={definition.id} category={definition.category}/>
      <div><p class="eyebrow">{eyebrow}</p><h1>{displayTitle}</h1><p class="hero-copy">{intro}</p></div>
    </header>

    <div class:list={['tool-stage', { 'tool-stage--single': !visual || hasToolVisualStudio || hasEmbeddedStudio }]}> 
      <section class="tool-workspace" aria-label={`${displayTitle} calculator`}><slot name="tool" /></section>
      {visual && !hasToolVisualStudio && !hasEmbeddedStudio && <aside class="tool-visual-wrap" aria-label={`${displayTitle} visual explanation`}><p class="tool-visual-label">{t?.seeWhatNumbersLabel ?? 'SEE WHAT THE NUMBERS MEAN'}</p><ToolVisual {definition} /></aside>}
    </div>
  </article>

  {hasToolVisualStudio && <ToolVisualStudio {definition} locale={journeyLocale} />}

  {explanationBeforeInsights && <section class="tool-explanation"><div><p class="eyebrow">{t?.howItWorks ?? 'How it works'}</p><slot name="explanation" /></div><aside class="limitation-card"><strong>{t?.keepInMind ?? 'Keep in mind'}</strong><p>{limitation}</p></aside></section>}
  <ToolInsights id={definition.id} locale={locale} />
  {!explanationBeforeInsights && <section class="tool-explanation"><div><p class="eyebrow">{t?.howItWorks ?? 'How it works'}</p><slot name="explanation" /></div><aside class="limitation-card"><strong>{t?.keepInMind ?? 'Keep in mind'}</strong><p>{limitation}</p></aside></section>}
  {studioCta && <a class="studio-cta studio-cta--row" href={resolvedStudioHref}><span><small>{t?.advancedWheelTireTool ?? 'Advanced wheel & tire tool'}</small><strong>{studioCta}</strong></span><i aria-hidden="true">›</i></a>}
  {definition.id !== 'tire-size-comparison' && <section class="tool-decision-area" aria-label={t?.relatedTools ?? 'Related tools'}><DecisionGraph model={nextDecision} locale={journeyLocale} id="tool-next-decision" /></section>}
</SiteLayout>
<script>import { initializeToolVisualMotion } from '../ui/tool-visual-motion'; import { initializeShareableToolState } from '../ui/shareable-tool-state'; import { initializeToolHandoff } from '../ui/tool-handoff'; initializeToolVisualMotion(); initializeToolHandoff(); window.setTimeout(initializeShareableToolState, 0);</script>

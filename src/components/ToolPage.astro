---
import SiteLayout from './SiteLayout.astro';
import type { ToolDefinition } from '../seo/tool-registry';
import { relatedTools, routeForTool } from '../seo/tool-registry';
import ToolIcon from './ToolIcon.astro';

interface Props { definition: ToolDefinition; eyebrow: string; intro: string; limitation: string; studioCta?: string; studioHref?: string; }
const { definition, eyebrow, intro, limitation, studioCta, studioHref = '/en/fitment-studio/' } = Astro.props;
const related = relatedTools(definition);
---
<SiteLayout {definition} active="tools">
  <nav class="breadcrumbs tool-breadcrumbs" aria-label="Breadcrumb"><a href="/en/tools/">‹ All tools</a><span class="sr-only" aria-current="page">{definition.title}</span></nav>
  <header class="tool-intro"><ToolIcon id={definition.id} category={definition.category}/><div><p class="eyebrow">{eyebrow}</p><h1>{definition.title}</h1><p class="hero-copy">{intro}</p></div></header>
  <section class="tool-workspace" aria-label={`${definition.title} calculator`}><slot name="tool" /></section>
  <section class="tool-explanation"><div><p class="eyebrow">How it works</p><slot name="explanation" /></div><aside class="limitation-card"><strong>Keep in mind</strong><p>{limitation}</p></aside></section>
  {studioCta && <a class="studio-cta studio-cta--row" href={studioHref}><span><small>Fitment Studio</small><strong>{studioCta}</strong></span><i aria-hidden="true">›</i></a>}
  <section class="related-tools" aria-labelledby="related-heading"><h2 id="related-heading">Related tools</h2><div class="related-grid">{related.map((tool) => <a class="related-card" href={routeForTool(tool)}><ToolIcon id={tool.id} category={tool.category}/><span><strong>{tool.title}</strong><small>{tool.category}</small></span><i aria-hidden="true">›</i></a>)}</div></section>
</SiteLayout>

        <defs>
          <linearGradient id="wheelCurrentFill" x1="0" x2="1"><stop offset="0" stop-color="#223746"/><stop offset=".5" stop-color="#42647a"/><stop offset="1" stop-color="#1e2d36"/></linearGradient>
          <linearGradient id="metalFill" x1="0" x2="1"><stop offset="0" stop-color="#6c7c86"/><stop offset=".5" stop-color="#c3cdd2"/><stop offset="1" stop-color="#52616b"/></linearGradient>
        </defs>
        <path class="offset-fender-shell" d="M320 34c44 21 66 59 69 118v42h-22v-40c-2-44-17-72-47-91Z"/>
        <path class="offset-strut" d="M74 38l20 7-27 118-21-7Z"/>

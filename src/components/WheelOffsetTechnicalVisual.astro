          <rect data-current-offset-body x="102" y="88" width="183" height="74" rx="18" fill="url(#wheelCurrentFill)"/>
          <path data-current-centerline d="M194 76v98" />
        </g>
        <g class="offset-wheel offset-wheel--new" data-new-offset-wheel>
          <rect data-new-offset-body x="99" y="88" width="194" height="74" rx="18"/>

---
import type { Visualization3DLocale } from '../localization/visualization-3d';
import { renderFitmentSection } from '../ui/fitment-section';
interface Props { readonly locale?: Visualization3DLocale | undefined; }
const { locale = 'en' } = Astro.props;
const t = {
  en: { badge: 'Live wheel geometry', title: 'See where the wheel actually moves', intro: 'The hub mounting face stays fixed. Blue is the original wheel; orange is the new wheel. The drawing changes as width and ET change.', section: 'Wheel-well cutaway', proportional: 'PROPORTIONAL POSITION', cross: 'Wheel cross-section relative to hub, suspension and fender', diagram: 'Original and new wheel position overlaid relative to hub, suspension and fender', suspension: 'SUSPENSION', fender: 'FENDER', hub: 'HUB MOUNTING FACE · FIXED', current: 'CURRENT', proposed: 'NEW', explanation: 'Wheel offset explanation', changed: 'What changed', framework: 'NUMBER → SHAPE → MEANING', top: 'Top view showing current and new outer wheel positions', original: 'Original', inner: 'Inner edge', outer: 'Outer edge', read: 'Read the drawing like a cutaway', initInner: 'Inner edge moves farther inward.', initOuter: 'Outer edge moves farther toward the fender.', note: 'The mounting face does not move. Width and ET move the wheel body around that fixed plane. This is wheel geometry, not a brake/tire/fender fitment verdict.' },
  de: { badge: 'Live-Felgengeometrie', title: 'So verschiebt sich die Felge', intro: 'Die Nabenanlagefläche bleibt fest. Blau zeigt das ursprüngliche Rad, Orange das neue. Breite und ET ändern die Zeichnung.', section: 'Radhaus-Schnittansicht', proportional: 'PROPORTIONALE POSITION', cross: 'Felgenschnitt relativ zu Nabe, Fahrwerk und Kotflügel', diagram: 'Alte und neue Felgenposition relativ zu Nabe, Fahrwerk und Kotflügel', suspension: 'FAHRWERK', fender: 'KOTFLÜGEL', hub: 'NABENANLAGEFLÄCHE · FEST', current: 'AKTUELL', proposed: 'NEU', explanation: 'Erklärung des Felgenversatzes', changed: 'Was sich ändert', framework: 'ZAHL → FORM → BEDEUTUNG', top: 'Draufsicht auf alte und neue äußere Felgenposition', original: 'Bisher', inner: 'Innenkante', outer: 'Außenkante', read: 'Schnittansicht richtig lesen', initInner: 'Die Innenkante wandert weiter nach innen.', initOuter: 'Die Außenkante wandert weiter Richtung Kotflügel.', note: 'Die Anlagefläche bleibt fest. Breite und ET verschieben den Felgenkörper relativ dazu. Die Geometrie bestätigt keinen Bremsen-, Reifen- oder Kotflügelfreigang.' },
  es: { badge: 'Geometría de llanta en vivo', title: 'Mira cómo se desplaza la llanta', intro: 'La cara de montaje permanece fija. Azul es la llanta original; naranja, la nueva. El dibujo cambia con el ancho y el ET.', section: 'Sección del paso de rueda', proportional: 'POSICIÓN PROPORCIONAL', cross: 'Sección de la llanta respecto al buje, suspensión y guardabarros', diagram: 'Posiciones original y nueva de la llanta respecto al buje, suspensión y guardabarros', suspension: 'SUSPENSIÓN', fender: 'GUARDABARROS', hub: 'CARA DE MONTAJE · FIJA', current: 'ACTUAL', proposed: 'NUEVA', explanation: 'Explicación del offset', changed: 'Qué cambió', framework: 'NÚMERO → FORMA → SIGNIFICADO', top: 'Vista superior de las posiciones exteriores actual y nueva', original: 'Original', inner: 'Borde interior', outer: 'Borde exterior', read: 'Cómo leer la sección', initInner: 'El borde interior se desplaza más hacia dentro.', initOuter: 'El borde exterior se desplaza más hacia el guardabarros.', note: 'La cara de montaje no se mueve. El ancho y el ET desplazan la llanta alrededor de ese plano fijo. La geometría no confirma espacio libre con frenos, neumáticos ni guardabarros.' },
  fr: { badge: 'Géométrie de jante en direct', title: 'Voyez où la jante se déplace vraiment', intro: 'La face d’appui sur le moyeu reste fixe. Bleu : jante d’origine ; orange : nouvelle jante. Le dessin suit la largeur et l’ET.', section: 'Coupe du passage de roue', proportional: 'POSITION PROPORTIONNELLE', cross: 'Coupe de la jante par rapport au moyeu, à la suspension et à l’aile', diagram: 'Positions d’origine et nouvelle de la jante par rapport au moyeu, à la suspension et à l’aile', suspension: 'SUSPENSION', fender: 'AILE', hub: 'FACE D’APPUI MOYEU · FIXE', current: 'ACTUELLE', proposed: 'NOUVELLE', explanation: 'Explication du déport', changed: 'Ce qui change', framework: 'CHIFFRE → FORME → SENS', top: 'Vue de dessus des positions extérieures actuelle et nouvelle', original: 'Origine', inner: 'Bord intérieur', outer: 'Bord extérieur', read: 'Lire le dessin comme une coupe', initInner: 'Le bord intérieur rentre davantage.', initOuter: 'Le bord extérieur se rapproche de l’aile.', note: 'La face d’appui ne bouge pas. Largeur et ET déplacent la jante autour de ce plan fixe. Cette géométrie ne confirme pas le jeu avec freins, pneus ou aile.' },
  it: { badge: 'Geometria cerchio live', title: 'Guarda dove si sposta davvero il cerchio', intro: 'La superficie di appoggio sul mozzo resta fissa. Blu è il cerchio originale; arancione il nuovo. Il disegno cambia con larghezza ed ET.', section: 'Sezione del passaruota', proportional: 'POSIZIONE PROPORZIONALE', cross: 'Sezione del cerchio rispetto a mozzo, sospensione e parafango', diagram: 'Posizioni originale e nuova del cerchio rispetto a mozzo, sospensione e parafango', suspension: 'SOSPENSIONE', fender: 'PARAFANGO', hub: 'APPOGGIO MOZZO · FISSO', current: 'ATTUALE', proposed: 'NUOVO', explanation: 'Spiegazione dell’offset', changed: 'Cosa cambia', framework: 'NUMERO → FORMA → SIGNIFICATO', top: 'Vista dall’alto delle posizioni esterne attuale e nuova', original: 'Originale', inner: 'Bordo interno', outer: 'Bordo esterno', read: 'Leggi il disegno come una sezione', initInner: 'Il bordo interno si sposta più verso l’interno.', initOuter: 'Il bordo esterno si avvicina al parafango.', note: 'La superficie di appoggio non si muove. Larghezza ed ET spostano il cerchio attorno a quel piano fisso. La geometria non conferma il gioco con freni, pneumatici o parafango.' },
  'pt-br': { badge: 'Geometria da roda ao vivo', title: 'Veja para onde a roda realmente se move', intro: 'A face de fixação no cubo fica fixa. Azul é a roda original; laranja, a nova. O desenho muda com a largura e o ET.', section: 'Corte da caixa de roda', proportional: 'POSIÇÃO PROPORCIONAL', cross: 'Corte da roda em relação ao cubo, à suspensão e ao para-lama', diagram: 'Posições original e nova da roda em relação ao cubo, à suspensão e ao para-lama', suspension: 'SUSPENSÃO', fender: 'PARA-LAMA', hub: 'FACE DO CUBO · FIXA', current: 'ATUAL', proposed: 'NOVA', explanation: 'Explicação do offset', changed: 'O que mudou', framework: 'NÚMERO → FORMA → SIGNIFICADO', top: 'Vista superior das posições externas atual e nova', original: 'Original', inner: 'Borda interna', outer: 'Borda externa', read: 'Leia o desenho como um corte', initInner: 'A borda interna vai mais para dentro.', initOuter: 'A borda externa vai mais para o para-lama.', note: 'A face de fixação não se move. Largura e ET deslocam a roda em torno desse plano fixo. A geometria não confirma folga com freios, pneus ou para-lama.' },
  pl: { badge: 'Geometria felgi na żywo', title: 'Zobacz, gdzie naprawdę przesuwa się felga', intro: 'Powierzchnia przylegania do piasty pozostaje stała. Niebieska to felga oryginalna, pomarańczowa – nowa. Rysunek zmienia się wraz z szerokością i ET.', section: 'Przekrój nadkola', proportional: 'POZYCJA PROPORCJONALNA', cross: 'Przekrój felgi względem piasty, zawieszenia i nadkola', diagram: 'Oryginalna i nowa pozycja felgi względem piasty, zawieszenia i nadkola', suspension: 'ZAWIESZENIE', fender: 'NADKOLE', hub: 'PRZYLGA PIASTY · STAŁA', current: 'OBECNA', proposed: 'NOWA', explanation: 'Objaśnienie odsadzenia', changed: 'Co się zmienia', framework: 'LICZBA → KSZTAŁT → ZNACZENIE', top: 'Widok z góry obecnej i nowej pozycji zewnętrznej', original: 'Oryginał', inner: 'Krawędź wewn.', outer: 'Krawędź zewn.', read: 'Czytaj rysunek jak przekrój', initInner: 'Krawędź wewnętrzna przesuwa się bardziej do środka.', initOuter: 'Krawędź zewnętrzna przesuwa się bliżej nadkola.', note: 'Powierzchnia przylegania się nie przesuwa. Szerokość i ET przesuwają felgę wokół tej stałej płaszczyzny. Geometria nie potwierdza prześwitu względem hamulców, opon ani nadkola.' },
  nl: { badge: 'Live velggeometrie', title: 'Zie waar de velg echt naartoe schuift', intro: 'Het montagevlak op de naaf blijft vast. Blauw is de originele velg; oranje de nieuwe. De tekening verandert mee met breedte en ET.', section: 'Doorsnede wielkast', proportional: 'PROPORTIONELE POSITIE', cross: 'Velgdoorsnede ten opzichte van naaf, ophanging en spatbord', diagram: 'Originele en nieuwe velgpositie ten opzichte van naaf, ophanging en spatbord', suspension: 'OPHANGING', fender: 'SPATBORD', hub: 'NAAFVLAK · VAST', current: 'HUIDIG', proposed: 'NIEUW', explanation: 'Uitleg ET (inpersdiepte)', changed: 'Wat verandert', framework: 'GETAL → VORM → BETEKENIS', top: 'Bovenaanzicht van huidige en nieuwe buitenpositie', original: 'Origineel', inner: 'Binnenrand', outer: 'Buitenrand', read: 'Lees de tekening als een doorsnede', initInner: 'De binnenrand schuift verder naar binnen.', initOuter: 'De buitenrand schuift verder richting spatbord.', note: 'Het montagevlak beweegt niet. Breedte en ET verschuiven de velg rond dat vaste vlak. Deze geometrie bevestigt geen vrije ruimte tot remmen, banden of spatbord.' },
  tr: { badge: 'Canlı jant geometrisi', title: 'Jantın gerçekte nereye kaydığını görün', intro: 'Porya montaj yüzeyi sabit kalır. Mavi orijinal jant, turuncu yeni jant. Çizim genişlik ve ET ile değişir.', section: 'Çamurluk içi kesiti', proportional: 'ORANTILI KONUM', cross: 'Porya, süspansiyon ve çamurluğa göre jant kesiti', diagram: 'Poryaya, süspansiyona ve çamurluğa göre eski ve yeni jant konumu', suspension: 'SÜSPANSİYON', fender: 'ÇAMURLUK', hub: 'PORYA YÜZEYİ · SABİT', current: 'MEVCUT', proposed: 'YENİ', explanation: 'Jant ofseti açıklaması', changed: 'Ne değişti', framework: 'SAYI → ŞEKİL → ANLAM', top: 'Mevcut ve yeni dış jant konumunun üstten görünümü', original: 'Orijinal', inner: 'İç kenar', outer: 'Dış kenar', read: 'Çizimi bir kesit gibi okuyun', initInner: 'İç kenar daha içeri kayar.', initOuter: 'Dış kenar çamurluğa doğru kayar.', note: 'Montaj yüzeyi hareket etmez. Genişlik ve ET jantı bu sabit düzlem etrafında kaydırır. Bu geometri fren, lastik veya çamurluk boşluğunu doğrulamaz.' },
}[locale];
const titleCase = (text: string): string => text.charAt(0) + text.slice(1).toLocaleLowerCase(locale === 'tr' ? 'tr' : locale);
const sectionLabels = { current: t.current, next: t.proposed, hub: t.hub, suspension: t.suspension, fender: t.fender, inner: titleCase(t.inner), outer: titleCase(t.outer), aria: t.diagram };
const initialSection = renderFitmentSection({
  mode: 'wheel',
  current: { label: '8J ET40', rimInches: 18, wheelWidthInches: 8, offsetMm: 40 },
  next: { label: locale === 'en' ? '8.5J ET35' : '8,5J ET35', rimInches: 18, wheelWidthInches: 8.5, offsetMm: 35 },
  labels: sectionLabels,
  decimalComma: locale !== 'en',
});
---
<figure class="offset-tech-visual" data-offset-tech-visual aria-labelledby="offset-tech-title">
  <figcaption>
    <div><span class="visual-kicker">{t.badge}</span><strong id="offset-tech-title">{t.title}</strong></div>
    <p>{t.intro}</p>
  </figcaption>
  <div class="offset-tech-grid">
    <section class="offset-tech-card offset-tech-card--section" aria-label={t.cross}>
      <header><strong>{t.section}</strong><span>{t.proportional}</span></header>
      <div class="fitment-section-host" data-fitment-section data-labels={JSON.stringify(sectionLabels)} set:html={initialSection}></div>
      <div class="offset-position-summary"><span data-inner-meaning>{t.initInner}</span><span data-outer-meaning>{t.initOuter}</span></div>
    </section>

    <section class="offset-tech-card offset-tech-card--numbers" aria-label={t.explanation}>
      <header><strong>{t.changed}</strong><span>{t.framework}</span></header>
      <svg class="offset-mini-stance" viewBox="0 0 300 128" role="img" aria-label={t.top}>
        <path class="offset-mini-body" d="M78 20h144l36 29v42l-36 17H78L42 91V49Z"/>
        <path class="offset-mini-center" d="M150 13v102"/>
        <rect class="offset-mini-wheel offset-mini-wheel--current" data-current-mini-wheel x="202" y="31" width="30" height="68" rx="8"/>
        <rect class="offset-mini-wheel offset-mini-wheel--new" data-new-mini-wheel x="212" y="31" width="34" height="68" rx="8"/>
        <path class="offset-mini-arrow" data-mini-outer-arrow d="M232 110H246"/>
        <text data-mini-outer-text x="239" y="124" text-anchor="middle">+11.4 mm</text>
      </svg>
      <div class="offset-tech-values">
        <div><span>{t.original}</span><strong data-original-wheel-spec>8J · ET40</strong></div>
        <div><span>{t.proposed}</span><strong data-new-wheel-spec>8.5J · ET35</strong></div>
        <div><span>{t.inner}</span><strong data-inner-value>+1.35 mm</strong><small data-inner-copy>farther inward</small></div>
        <div><span>{t.outer}</span><strong data-outer-value>+11.35 mm</strong><small data-outer-copy>farther outward</small></div>
      </div>
      <aside class="offset-tech-note"><strong>{t.read}</strong><p>{t.note}</p></aside>
    </section>
  </div>
</figure>

const exampleAria = ({ en: 'Example tire size', de: 'Beispiel-Reifengröße', es: 'Medida de neumático de ejemplo', fr: 'Exemple de taille de pneu', it: 'Esempio di misura dello pneumatico', 'pt-br': 'Exemplo de medida de pneu', pl: 'Przykładowy rozmiar opony', nl: 'Voorbeeld bandenmaat', tr: 'Örnek lastik ebadı' } as const)[locale ?? 'en'];
---
<section class="tire-code-explainer" data-tire-code-explainer aria-labelledby="tire-code-heading">
  <div class="tire-code-explainer__heading"><p class="eyebrow">{t.eyebrow}</p><h2 id="tire-code-heading">{t.heading}</h2><p>{t.intro}</p></div>
  <div class="tire-code" aria-label={exampleAria}><strong data-tire-width>225</strong><b>/</b><strong data-tire-aspect>45</strong><b>R</b><strong data-tire-rim>18</strong></div>
  <div class="tire-code-legend">
    <article><span>225</span><strong>{t.widthLabel}</strong><p>{t.widthCopy}</p></article>
    <article><span>45</span><strong>{t.ratioLabel}</strong><p>{t.ratioCopy}</p></article>
    <article><span>R18</span><strong>{t.rimLabel}</strong><p>{t.rimCopy}</p></article>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-calculator="tire-size"]');
  const explainer = document.querySelector<HTMLElement>('[data-tire-code-explainer]');
  if (form && explainer) {
    const update = () => {
      const data = new FormData(form);
      explainer.querySelector<HTMLElement>('[data-tire-width]')!.textContent = String(data.get('widthMm') ?? '225');
      explainer.querySelector<HTMLElement>('[data-tire-aspect]')!.textContent = String(data.get('aspectRatio') ?? '45');
      explainer.querySelector<HTMLElement>('[data-tire-rim]')!.textContent = String(data.get('rimDiameterInches') ?? '18');
    };
    form.addEventListener('input', update); update();
  }
</script>

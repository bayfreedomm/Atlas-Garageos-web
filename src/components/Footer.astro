---
import { chromePrefix, chromeStrings, type ChromeLocale } from '../localization/site-catalog';
import { referenceLinks } from '../ui/reference-links';
import { isReferenceLocale } from '../localization/reference-locales';
import { referenceChromeText } from '../content/reference-locale-text';
import type { AtlasLocale } from '../localization/locales';
interface Props { locale?: ChromeLocale | undefined; }
const { locale } = Astro.props;
const t = chromeStrings(locale);
const prefix = chromePrefix(locale);
const fuelPricesPath = locale === 'de' ? '/de/kraftstoffpreise/' : locale === 'es' ? '/es/precio-gasolina-hoy/' : '/gas-prices-today/';
const FOOTER_ARIA: Readonly<Record<AtlasLocale, string>> = { en: 'Footer', de: 'Fußzeile', es: 'Pie de página', fr: 'Pied de page', it: 'Piè di pagina', 'pt-br': 'Rodapé', pl: 'Stopka', nl: 'Voettekst', tr: 'Alt bilgi' };
const DIAGNOSTICS_LABELS: Readonly<Record<AtlasLocale, string>> = { en: 'OBD Diagnostics', de: 'OBD-Diagnose (Englisch)', es: 'Diagnóstico OBD (inglés)', fr: 'Diagnostic OBD (anglais)', it: 'Diagnostica OBD (inglese)', 'pt-br': 'Diagnóstico OBD (inglês)', pl: 'Diagnostyka OBD (ang.)', nl: 'OBD-diagnose (Engels)', tr: 'OBD arıza teşhisi (İngilizce)' };
const reference = referenceLinks(locale ?? 'en');
const refChrome = isReferenceLocale(locale) ? referenceChromeText[locale] : undefined;
const footerAria = refChrome?.footerAria ?? FOOTER_ARIA[locale ?? 'en'];
const diagnosticsLabel = refChrome?.diagnosticsLabel ?? DIAGNOSTICS_LABELS[locale ?? 'en'];
const copy = (t?.footerCopy ?? '© {year} Atlas GarageOS. All calculations are estimates — verify anything safety-critical with your vehicle\'s manual.').replace('{year}', String(new Date().getFullYear()));
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <span class="brand-wordmark"><span class="brand-wordmark__kicker">Atlas</span><strong>Garage<span class="brand-wordmark__os">OS</span></strong></span>
      <p>{t?.footerTagline ?? 'Fast, honest automotive calculators. No account, no clutter.'}</p>
    </div>
    <nav class="site-footer__links" aria-label={footerAria}>
      <a href={`${prefix}/tools/`}>{t?.footerToolbox ?? 'Toolbox'}</a>
      {reference.map((link) => <a href={link.href}>{link.title}</a>)}
      <a href="/obd-codes/" hreflang={locale ? 'en' : undefined}>{diagnosticsLabel}</a>
      <a href={`${prefix}/fitment-studio/`}>{t?.footerFitment ?? 'Wheel & Tire Compare'}</a>
      <a href={`${prefix}/methodology/`}>{t?.footerMethodology ?? 'Accuracy & Methodology'}</a>
      <a href={`${prefix}/privacy-policy/`}>{t?.footerPrivacy ?? 'Privacy Policy'}</a>
      <a href={fuelPricesPath}>{t?.footerFuelPrices ?? 'Gas prices today'}</a>
      <a href={`${prefix}/contact/`}>{t?.footerContact ?? 'Contact'}</a>
    </nav>
  </div>
  <p class="site-footer__copy">{copy}</p>
</footer>

---
interface Props { primaryLabel: string; pending: string; visualTitle: string; visualNote: string; }
const { primaryLabel, pending, visualTitle, visualNote } = Astro.props;
---
<section class="standard-answer is-pending" data-standard-answer aria-live="polite">
  <div class="standard-answer__main"><span>{primaryLabel}</span><strong data-standard-primary>—</strong><p data-standard-context>{pending}</p></div>
  <div class="standard-answer__secondary"><span data-standard-secondary-label>Supporting result</span><strong data-standard-secondary>—</strong><small data-standard-secondary-note>Updates with your input.</small></div>
</section>
<p class="result-summary is-pending" data-result-summary aria-live="polite">{pending}</p>
<figure class="standard-visual is-pending" data-standard-visual aria-label={visualTitle}>
  <figcaption><span>{visualTitle}</span><small>{visualNote}</small></figcaption>
  <div class="standard-visual__equation"><div><small data-standard-visual-left-label>Input</small><strong data-standard-visual-left>—</strong></div><i aria-hidden="true">→</i><div><small data-standard-visual-right-label>Result</small><strong data-standard-visual-right>—</strong></div></div>
</figure>
<div class="fuel-detail-heading" aria-hidden="true"><span>Details</span><small>Calculated values</small></div>
<dl class="tool-results" data-results aria-live="polite"></dl>
<div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>

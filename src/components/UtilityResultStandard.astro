---
import type { ContentLocale } from '../localization/site-catalog';
interface Props { primaryLabel: string; pending: string; visualTitle: string; visualNote: string; locale?: ContentLocale | undefined; hideVisual?: boolean | undefined; deferDetails?: boolean | undefined; }
const { primaryLabel, pending, visualTitle, visualNote, locale, hideVisual = false, deferDetails = false } = Astro.props;
const L = {
  en: { supporting: 'Supporting result', updates: 'Updates with your input.', input: 'Input', result: 'Result', details: 'Details', calculated: 'Calculated values' },
  de: { supporting: 'Weiteres Ergebnis', updates: 'Aktualisiert sich mit Ihrer Eingabe.', input: 'Eingabe', result: 'Ergebnis', details: 'Details', calculated: 'Berechnete Werte' },
  es: { supporting: 'Resultado adicional', updates: 'Se actualiza con su entrada.', input: 'Entrada', result: 'Resultado', details: 'Detalles', calculated: 'Valores calculados' },
  fr: { supporting: 'Résultat complémentaire', updates: 'Se met à jour selon vos saisies.', input: 'Saisie', result: 'Résultat', details: 'Détails', calculated: 'Valeurs calculées' },
  it: { supporting: 'Risultato aggiuntivo', updates: 'Si aggiorna con i tuoi dati.', input: 'Dati inseriti', result: 'Risultato', details: 'Dettagli', calculated: 'Valori calcolati' },
  'pt-br': { supporting: 'Resultado complementar', updates: 'Atualiza conforme você digita.', input: 'Entrada', result: 'Resultado', details: 'Detalhes', calculated: 'Valores calculados' },
  pl: { supporting: 'Wynik dodatkowy', updates: 'Aktualizuje się na bieżąco z wpisanymi danymi.', input: 'Dane wejściowe', result: 'Wynik', details: 'Szczegóły', calculated: 'Obliczone wartości' },
  nl: { supporting: 'Aanvullend resultaat', updates: 'Wordt bijgewerkt met je invoer.', input: 'Invoer', result: 'Resultaat', details: 'Details', calculated: 'Berekende waarden' },
  tr: { supporting: 'Ek sonuç', updates: 'Girdiğiniz değerlere göre güncellenir.', input: 'Girdi', result: 'Sonuç', details: 'Ayrıntılar', calculated: 'Hesaplanan değerler' },
}[locale ?? 'en'];
---
<section class="standard-answer is-pending" data-standard-answer aria-live="polite">
  <div class="standard-answer__main"><span>{primaryLabel}</span><strong data-standard-primary>—</strong><p data-standard-context>{pending}</p></div>
  <div class="standard-answer__secondary"><span data-standard-secondary-label>{L.supporting}</span><strong data-standard-secondary>—</strong><small data-standard-secondary-note>{L.updates}</small></div>
</section>
<p class="result-summary is-pending" data-result-summary aria-live="polite">{pending}</p>
{!hideVisual && <figure class="standard-visual is-pending" data-standard-visual aria-label={visualTitle}>
  <figcaption><span>{visualTitle}</span><small>{visualNote}</small></figcaption>
  <div class="standard-visual__equation"><div><small data-standard-visual-left-label>{L.input}</small><strong data-standard-visual-left>—</strong></div><i aria-hidden="true">→</i><div><small data-standard-visual-right-label>{L.result}</small><strong data-standard-visual-right>—</strong></div></div>
</figure>}
{!deferDetails && <>
  <div class="fuel-detail-heading" aria-hidden="true"><span>{L.details}</span><small>{L.calculated}</small></div>
  <dl class="tool-results" data-results aria-live="polite"></dl>
  <div class="inline-errors" data-errors role="alert" aria-live="assertive" hidden></div>
</>}

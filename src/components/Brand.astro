---
interface Props { compact?: boolean; subtitle?: string; }
const { compact = false, subtitle } = Astro.props;
---
<span class:list={['brand-lockup', { 'brand-lockup--compact': compact }]}>
  <svg class="brand-glyph" viewBox="0 0 96 96" role="img" aria-label="Atlas GarageOS">
    <rect width="96" height="96" rx="22" fill="#0b1c29" />
    <path d="M22 63a26 26 0 0 1 52 0" fill="none" stroke="#233240" stroke-width="7" stroke-linecap="round" />
    <path d="M22 63a26 26 0 0 1 37 -24" fill="none" stroke="#1f98ff" stroke-width="7" stroke-linecap="round" />
    <line x1="48" y1="63" x2="65" y2="39" stroke="#f4f8fb" stroke-width="4" stroke-linecap="round" />
    <circle cx="48" cy="63" r="5.5" fill="#f4f8fb" />
  </svg>
  <span class="brand-wordmark">
    <span class="brand-wordmark__kicker">Atlas{subtitle && <span class="brand-wordmark__context"> · {subtitle}</span>}</span>
    <strong>Garage<span class="brand-wordmark__os">OS</span></strong>
  </span>
</span>

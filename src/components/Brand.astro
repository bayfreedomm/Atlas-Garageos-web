---
interface Props { compact?: boolean; subtitle?: string; }
const { compact = false, subtitle } = Astro.props;
---
<span class:list={['atlas-wordmark', { 'atlas-wordmark--compact': compact }]}>
  <strong>ATLAS</strong><i aria-hidden="true"></i><span>Garage<b>OS</b></span>{subtitle && <small>{subtitle}</small>}
</span>

---
interface Props { compact?: boolean; subtitle?: string; }
const { compact = false, subtitle } = Astro.props;
---
<span class:list={['brand-lockup', { 'brand-lockup--compact': compact }]}>
  <svg class="brand-glyph" viewBox="0 0 40 40" role="img" aria-label="Atlas GarageOS">
    <rect width="40" height="40" rx="11" fill="#0b1c29" />
    <path d="M11 29 17.6 12h4.8l6.6 17h-5.1l-1.5-4.4h-6.7L14.1 29H11Zm7.6-8.3h4.3l-2.15-6-2.15 6Z" fill="#f4f8fb" />
    <rect x="11" y="32" width="18" height="2.1" rx="1.05" fill="#1f98ff" />
  </svg>
  <span class="brand-wordmark">
    <span class="brand-wordmark__kicker">Atlas{subtitle && <span class="brand-wordmark__context"> · {subtitle}</span>}</span>
    <strong>Garage<span class="brand-wordmark__os">OS</span></strong>
  </span>
</span>

    current: 'OBECNA', next: 'NOWA', sideCaption: 'Nowa opona jest nałożona na obecną w tej samej skali.',
    frontAria: 'Porównanie szerokości nominalnej z przodu w rzeczywistej skali', front: 'Szerokość z przodu', nominalWidth: 'SZEROKOŚĆ NOMINALNA', frontSvgAria: 'Szerokość obecnej i nowej opony widziana z przodu',

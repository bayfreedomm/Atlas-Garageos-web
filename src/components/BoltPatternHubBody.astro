---
// Shared body for the bolt-pattern hub in every locale. Same construction as the tire-size
// hub: build-time <a href> listing grouped by lug count, with a filter that only hides rows.
import { boltPatternCatalog, boltPatternsByLugCount, vehiclesForBoltPattern } from '../data/bolt-pattern-catalog';
import { adjacentHoleSpacingMm } from '../data/bolt-pattern-geometry';
import { vehicleFitmentData } from '../data/vehicle-fitment';
import { boltPatternPageText } from '../content/entity-page-text';
import { entityDetailPath, entityHubPath, type EntityLocale } from '../seo/entity-routes';
import { homePath, vehicleHubPath } from '../ui/entity-page-model';
import { entitySearchText } from '../ui/entity-search';
import { localizedToolPath } from '../localization/locales';

interface Props { readonly locale: EntityLocale; }
const { locale } = Astro.props;

const t = boltPatternPageText[locale];
const groups = boltPatternsByLugCount();
const total = boltPatternCatalog.length;

// The worked example in the notation explainer is a real pattern from this catalog — the most
// widely used one — rather than a made-up illustration.
const example = [...boltPatternCatalog].sort((a, b) => vehiclesForBoltPattern(b.notation).length - vehiclesForBoltPattern(a.notation).length)[0];

// Fully resolved in the frontmatter so the template stays a plain loop over data.
const groupCards = groups.map(([lugs, entries]) => ({
  lugs,
  anchor: `lugs-${lugs}`,
  cards: entries.map((entry) => {
    const vehicles = vehiclesForBoltPattern(entry.notation);
    const makes = [...new Set(vehicles.map((vehicle) => vehicle.make))];
    return {
      notation: entry.notation,
      href: entityDetailPath('bolt-pattern', locale, entry.slug),
      spacing: `${adjacentHoleSpacingMm(entry.pcdMm, entry.lugCount).toFixed(2)} mm`,
      vehicles: vehicles.length,
      // Normalized with the same function the live filter applies to the query, so a
      // reader typing any separator spelling of this entity still matches it.
      search: entitySearchText([entry.notation, entry.slug, ...makes]),
    };
  }),
}));
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href={homePath(locale)}>{t.breadcrumbHome}</a><span aria-hidden="true">/</span>
  <span aria-current="page">{t.breadcrumbHub}</span>
</nav>

<header class="entity-hero">
  <p class="eyebrow">{t.hubKicker}</p>
  <h1>{t.hubH1}</h1>
  <p class="entity-hero__lead">{t.hubLead(total, vehicleFitmentData.length)}</p>
</header>

<section class="entity-section" aria-labelledby="hub-notation">
  <h2 id="hub-notation">{t.notationHeading}</h2>
  {example && <p class="entity-note">{t.notationIntro(example.notation, example.lugCount, example.pcdMm)}</p>}
  <ol class="entity-code">
    {t.notationParts.map((part) => (
      <li class="entity-code__part entity-code__part--plain">
        <strong>{part.label}</strong>
        <span>{part.detail}</span>
      </li>
    ))}
  </ol>
</section>

<section class="entity-section" aria-labelledby="hub-list" data-entity-filter>
  <h2 id="hub-list">{t.backToHub}</h2>
  <form class="entity-filterbar" role="search" data-entity-search-form>
    <label class="entity-filterbar__label" for="bolt-pattern-filter">{t.searchLabel}</label>
    <input id="bolt-pattern-filter" class="entity-filterbar__input" type="search" autocomplete="off" placeholder={t.searchPlaceholder} data-entity-search />
    <span class="entity-filterbar__count" data-entity-count data-count-one={t.countLabel(1)} data-count-other={t.countLabel(0).replace('0', '{n}')}>{t.countLabel(total)}</span>
  </form>

  <nav class="entity-jump" aria-label={t.jumpLabel}>
    <span>{t.jumpLabel}</span>
    {groupCards.map((group) => <a href={`#${group.anchor}`}>{group.lugs}×</a>)}
  </nav>

  {groupCards.map((group) => (
    <div class="entity-group" data-entity-group>
      <h3 class="entity-group__title" id={group.anchor}>{t.groupHeading(group.lugs)}</h3>
      <ul class="entity-grid">
        {group.cards.map((card) => (
          <li class="entity-card" data-entity-card data-entity-search-text={card.search}>
            <a href={card.href}>
              <strong class="entity-card__title">{card.notation}</strong>
              <span class="entity-card__meta">{t.metrics.holeSpacing}: {card.spacing}</span>
              <span class="entity-card__meta">{t.listedAs(card.vehicles)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <p class="entity-empty" data-entity-empty hidden>{t.searchEmpty}</p>
</section>

<section class="entity-section entity-section--warn" aria-labelledby="hub-safety">
  <h2 id="hub-safety">{t.safetyHeading}</h2>
  <p class="entity-caveat"><strong>⚠</strong> {t.safetyLead}</p>
  <ul class="entity-factors">
    {t.safetyFactors.map((factor) => <li><strong>{factor.label}</strong><span>{factor.detail}</span></li>)}
  </ul>
  <p class="entity-note">{t.safetyClose}</p>
</section>

<section class="entity-section" aria-labelledby="hub-tools">
  <h2 id="hub-tools">{t.toolsHeading}</h2>
  <div class="entity-links">
    <a class="entity-link-card" href={localizedToolPath(locale, 'bolt-pattern-calculator', 'tool')}><strong>{t.calculatorCta}</strong><span>{t.calculatorCtaDetail}</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href={localizedToolPath(locale, 'wheel-offset-calculator', 'tool')}><strong>{t.fitmentCta}</strong><span>{t.fitmentCtaDetail}</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href={vehicleHubPath(locale)}><strong>{t.vehiclesCta}</strong><span>{t.vehiclesCtaDetail}</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href={entityHubPath('tire-size', locale)}><strong>{t.tireHubCta}</strong><span>{t.tireHubCtaDetail}</span><i aria-hidden="true">›</i></a>
  </div>
</section>

<script>import { initializeEntityFilters } from '../ui/entity-filter'; initializeEntityFilters();</script>

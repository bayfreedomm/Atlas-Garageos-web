---
interface Props { readonly locale?: 'en' | 'de' | 'es' | undefined; }
const { locale = 'en' } = Astro.props;
const copy = {
  en: { aria: 'Fuel cost visual summary', flow: 'TRIP → FUEL → COST', live: 'Input changes update the whole picture', svgAria: 'Trip distance, fuel required, and estimated cost', distance: 'DISTANCE', fuel: 'FUEL REQUIRED', cost: 'EST. COST' },
  de: { aria: 'Visuelle Übersicht der Kraftstoffkosten', flow: 'STRECKE → KRAFTSTOFF → KOSTEN', live: 'Jede Eingabe aktualisiert das ganze Bild', svgAria: 'Strecke, benötigter Kraftstoff und geschätzte Kosten', distance: 'STRECKE', fuel: 'KRAFTSTOFFBEDARF', cost: 'KOSTEN (CA.)' },
  es: { aria: 'Resumen visual del coste de combustible', flow: 'TRAYECTO → COMBUSTIBLE → COSTE', live: 'Cada cambio actualiza todo el gráfico', svgAria: 'Distancia del trayecto, combustible necesario y coste estimado', distance: 'DISTANCIA', fuel: 'COMBUSTIBLE', cost: 'COSTE EST.' },
}[locale];
---
<figure class="fuel-technical-visual" data-fuel-technical-visual aria-label={copy.aria}>
  <div class="fuel-technical-visual__head">
    <span>{copy.flow}</span>
    <small>{copy.live}</small>
  </div>
  <svg viewBox="0 0 720 260" role="img" aria-label={copy.svgAria}>
    <defs>
      <linearGradient id="fuel-road" x1="0" x2="1">
        <stop offset="0" stop-color="currentColor" stop-opacity=".12"/>
        <stop offset="1" stop-color="currentColor" stop-opacity=".55"/>
      </linearGradient>
    </defs>
    <path class="fuel-v-road" d="M46 181C151 183 196 121 286 137s122 63 219 24 124-80 169-65"/>
    <path class="fuel-v-road fuel-v-road--dash" d="M46 181C151 183 196 121 286 137s122 63 219 24 124-80 169-65"/>

    <g class="fuel-v-marker" data-fuel-car>
      <path d="M181 112l20 20-20 20-20-20z"/>
      <circle cx="181" cy="132" r="6"/>
    </g>

    <g class="fuel-v-pump">
      <path d="M501 76h67v133h-67zM513 91h43v43h-43zM568 105h16l18 20v61c0 16 25 16 25 0v-47l-20-20"/>
      <path class="fuel-v-fill" data-fuel-fill d="M513 134h43v0h-43z"/>
    </g>

    <g class="fuel-v-callout fuel-v-callout--distance">
      <text x="44" y="42">{copy.distance}</text>
      <text class="fuel-v-value" data-fuel-visual-distance x="44" y="69">—</text>
    </g>
    <g class="fuel-v-callout fuel-v-callout--fuel">
      <text x="410" y="42">{copy.fuel}</text>
      <text class="fuel-v-value" data-fuel-visual-fuel x="410" y="69">—</text>
    </g>
    <g class="fuel-v-callout fuel-v-callout--cost">
      <text x="570" y="42">{copy.cost}</text>
      <text class="fuel-v-value" data-fuel-visual-cost x="570" y="69">—</text>
    </g>
  </svg>
  <figcaption><span data-fuel-visual-caption>—</span><strong data-fuel-visual-rate>—</strong></figcaption>
</figure>

    </g>
    <g class="fuel-v-callout fuel-v-callout--cost">
      <text x="570" y="42">EST. COST</text>
      <text class="fuel-v-value" data-fuel-visual-cost x="570" y="69">USD 64.80</text>
    </g>
  </svg>
  <figcaption><span data-fuel-visual-caption>500 km at 7.2 L/100km</span><strong data-fuel-visual-rate>USD 0.13 / km</strong></figcaption>
</figure>

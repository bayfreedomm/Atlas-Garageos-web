---
import type { ToolEntityLocale } from '../seo/entity-routes';
interface Props { readonly locale: ToolEntityLocale; }
const { locale } = Astro.props;
const copy = {
  en: { eyebrow: 'Vehicle context', text: 'Atlas does not store a trusted consumption figure for this vehicle. Enter your actual consumption below; any available market fuel price remains an editable reference.', open: 'Open vehicle reference' },
  de: { eyebrow: 'Fahrzeugkontext', text: 'Atlas speichert für dieses Fahrzeug keinen belastbaren Verbrauchswert. Geben Sie unten Ihren tatsächlichen Verbrauch ein; ein verfügbarer Marktpreis bleibt eine editierbare Referenz.', open: 'Fahrzeugreferenz öffnen' },
  es: { eyebrow: 'Contexto del vehículo', text: 'Atlas no guarda un consumo fiable para este vehículo. Introduzca abajo su consumo real; cualquier precio de mercado disponible seguirá siendo una referencia editable.', open: 'Abrir referencia del vehículo' },
  fr: { eyebrow: 'Contexte du véhicule', text: 'Atlas ne dispose pas d’une consommation fiable pour ce véhicule. Saisissez ci-dessous votre consommation réelle ; tout prix du marché disponible reste une référence modifiable.', open: 'Ouvrir la fiche du véhicule' },
  it: { eyebrow: 'Contesto del veicolo', text: 'Atlas non ha un dato di consumo affidabile per questo veicolo. Inserisci qui sotto il tuo consumo reale; l’eventuale prezzo di mercato disponibile resta un riferimento modificabile.', open: 'Apri la scheda del veicolo' },
  'pt-br': { eyebrow: 'Contexto do veículo', text: 'O Atlas não tem um consumo confiável para este veículo. Digite abaixo o seu consumo real; qualquer preço de mercado disponível continua sendo uma referência editável.', open: 'Abrir a ficha do veículo' },
  pl: { eyebrow: 'Kontekst pojazdu', text: 'Atlas nie przechowuje wiarygodnych danych o spalaniu dla tego pojazdu. Wpisz poniżej swoje rzeczywiste spalanie; dostępna cena rynkowa pozostaje edytowalną wartością orientacyjną.', open: 'Otwórz kartę pojazdu' },
  nl: { eyebrow: 'Voertuigcontext', text: 'Atlas heeft voor dit voertuig geen betrouwbaar verbruikscijfer. Vul hieronder je werkelijke verbruik in; een beschikbare marktprijs blijft een aanpasbare referentie.', open: 'Voertuiggegevens openen' },
  tr: { eyebrow: 'Araç bilgisi', text: 'Atlas bu araç için güvenilir bir tüketim değeri saklamaz. Gerçek tüketiminizi aşağıya girin; mevcut piyasa yakıt fiyatı düzenlenebilir bir referans olarak kalır.', open: 'Araç referansını açın' },
}[locale];
---
<aside class="vehicle-trip-context" data-vehicle-trip-context data-locale={locale} hidden>
  <p class="eyebrow">{copy.eyebrow}</p>
  <h2 data-trip-vehicle-name></h2>
  <p>{copy.text}</p>
  <a data-trip-vehicle-link>{copy.open}<span aria-hidden="true"> →</span></a>
</aside>
<script>import { initializeVehicleTripContext } from '../ui/vehicle-trip-context'; initializeVehicleTripContext();</script>

---
// One model year of one car model: EPA fuel economy for every configuration, annual fuel cost at
// today's U.S. price, and the ANKUSI wheel record (bolt pattern, center bore, wheel sizes).
import { type CarModel, ANNUAL_MILES, ANKUSI_SOURCE, EPA_SOURCE, annualFuelCost, carMakePath, carModelPath, carYearPath, curatedVehiclesFor, engineLabel, frequent, mpgSummary, mpgToL100, usFuelPrice, wheelRowsForYear, yearPageYears } from '../data/cars';
import { boltHref, carName, usd, wheelText, yearsText } from '../ui/car-pages';
import { vehiclePagePath } from '../ui/entity-page-model';

interface Props { readonly model: CarModel; readonly year: number; readonly faqs: readonly { readonly q: string; readonly a: string }[]; }
const { model, year, faqs } = Astro.props;
const variants = model.epa[String(year)] ?? [];
const name = carName(model);
const s = mpgSummary(variants);
const costs = variants.map((v) => annualFuelCost(v)).filter((n): n is number => n !== null);
const bestCost = costs.length ? Math.min(...costs) : null;
const exactWheels = wheelRowsForYear(model, year);
const nearbyWheels = exactWheels.length ? [] : model.wheels.filter((row) => row[1] !== null && Math.abs(row[1] - year) <= 3);
const wheelRows = exactWheels.length ? exactWheels : nearbyWheels;
const pcd = frequent(wheelRows.map((row) => row[4]))[0];
const bore = frequent(wheelRows.map((row) => row[5]))[0];
const otherYears = yearPageYears(model).filter((y) => y !== year);
const curated = curatedVehiclesFor(model);
const sorted = variants.slice().sort((a, b) => (b[8] ?? 0) - (a[8] ?? 0));
const answer = s.electric && s.best !== null
  ? [{ label: 'Combined MPGe', value: String(s.best) }, { label: 'City / highway', value: `${s.bestCity ?? '—'} / ${s.bestHighway ?? '—'}` }, { label: 'EPA range', value: (() => { const r = Math.max(...variants.map((v) => v[10] ?? 0)); return r > 0 ? `${r} mi` : '—'; })() }, { label: 'Bolt pattern', value: pcd ?? '—', href: boltHref(pcd) }]
  : [{ label: 'Combined MPG', value: s.best === null ? '—' : s.best === s.worst ? String(s.best) : `${s.worst}–${s.best}` }, { label: 'City / highway', value: `${s.bestCity ?? '—'} / ${s.bestHighway ?? '—'}` }, { label: 'Fuel cost / year', value: bestCost === null ? '—' : `from ${usd(bestCost)}` }, { label: 'Bolt pattern', value: pcd ?? '—', href: boltHref(pcd) }];
---
<header class="entity-hero entity-hero--tire">
  <p class="eyebrow">{model.make} · {year}</p>
  <h1 class="entity-hero__title">{year} {name} MPG, fuel cost and wheel specs</h1>
  <dl class="entity-answer entity-answer--vehicle">
    {answer.map((item) => <div class="entity-answer__item"><dt>{item.label}</dt><dd><strong>{'href' in item && item.href ? <a href={item.href}>{item.value}</a> : item.value}</strong></dd></div>)}
  </dl>
  <p class="entity-hero__lead">The {year} {name} is listed by the EPA in {variants.length} {variants.length === 1 ? 'configuration' : 'configurations'}{s.best !== null && !s.electric ? `, from ${s.worst} to ${s.best} MPG combined` : ''}. {pcd ? `It uses a ${pcd} bolt pattern${bore ? ` with a ${bore} mm center bore` : ''}.` : ''}</p>
  <nav class="entity-pagenav" aria-label="On this page">
    <a href="#car-mpg">MPG</a>
    {wheelRows.length > 0 && <a href="#car-wheels">Wheels</a>}
    {otherYears.length > 0 && <a href="#car-years">Other years</a>}
    <a href="#car-faq">FAQ</a>
  </nav>
</header>

<section class="entity-section" aria-labelledby="car-mpg">
  <h2 id="car-mpg">{year} {model.model} fuel economy by version</h2>
  <div class="entity-table-scroll">
    <table class="entity-table car-mpg-table">
      <thead><tr><th scope="col">Version</th><th scope="col" class="is-optional">Transmission</th><th scope="col" class="is-optional">Drive</th><th scope="col" class="is-optional">City</th><th scope="col" class="is-optional">Hwy</th><th scope="col">Comb.</th><th scope="col" class="is-optional">L/100 km</th><th scope="col">Fuel / year</th></tr></thead>
      <tbody>
        {sorted.map((v) => {
          const cost = annualFuelCost(v);
          return (
            <tr>
              <th scope="row">{v[0]}<span class="entity-card__meta"> · {engineLabel(v)}{v[5] !== 'Regular Gasoline' ? ` · ${v[5]}` : ''}</span></th>
              <td class="is-optional">{v[4]}</td>
              <td class="is-optional">{v[3]}</td>
              <td class="is-optional">{v[6] ?? '—'}</td><td class="is-optional">{v[7] ?? '—'}</td><td><strong>{v[8] ?? '—'}</strong>{v[6] && v[7] ? <span class="entity-card__meta car-cityhwy"> {v[6]}/{v[7]}</span> : null}</td>
              <td class="is-optional">{v[8] && !v[5].startsWith('Electricity') ? mpgToL100(v[8]).toFixed(1) : '—'}</td>
              <td>{cost !== null ? usd(cost) : v[9] ? `${usd(v[9])}*` : '—'}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="entity-note">Fuel cost per year: {ANNUAL_MILES.toLocaleString('en-US')} miles at today's U.S. average price{usFuelPrice.regular ? ` (regular ${usd(usFuelPrice.regular)}/gal` : ''}{usFuelPrice.diesel ? `, diesel ${usd(usFuelPrice.diesel)}/gal` : ''}{usFuelPrice.regular ? `, week of ${usFuelPrice.weekOf})` : ''}. * EPA's own estimate where the fuel is premium, E85 or electricity. MPG figures are EPA estimates; real-world mileage varies.</p>
  <div class="entity-links">
    <a class="entity-link-card" href="/tools/fuel-cost-calculator/"><strong>Fuel cost calculator</strong><span>Use your own mileage and gas price</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href="/gas-prices-today/"><strong>Gas prices today</strong><span>Current U.S. regular and diesel averages</span><i aria-hidden="true">›</i></a>
  </div>
</section>

{wheelRows.length > 0 && (
  <section class="entity-section" aria-labelledby="car-wheels">
    <h2 id="car-wheels">{name} bolt pattern and wheel sizes</h2>
    {!exactWheels.length && <p class="entity-note">No wheel record for exactly {year}; these are the closest model years on record.</p>}
    <div class="entity-table-scroll">
      <table class="entity-table">
        <thead><tr><th scope="col">Version</th><th scope="col">Year</th><th scope="col">Bolt pattern</th><th scope="col">Center bore</th><th scope="col" class="is-optional">Factory wheel</th><th scope="col" class="is-optional">Flush fit</th><th scope="col" class="is-optional">Max wheel</th></tr></thead>
        <tbody>
          {wheelRows.map((row) => { const href = boltHref(row[4]); return (
            <tr>
              <th scope="row">{row[0]}{row[12] ? <span class="entity-card__meta"> · {row[12]}</span> : null}</th>
              <td>{yearsText(row)}</td>
              <td>{href ? <a href={href}>{row[4]}</a> : row[4] ?? '—'}</td>
              <td>{row[5] !== null ? `${row[5]} mm` : '—'}</td>
              <td class="is-optional">{wheelText(row[8])}</td>
              <td class="is-optional">{wheelText(row[9])}</td>
              <td class="is-optional">{wheelText(row[10])}</td>
            </tr>
          ); })}
        </tbody>
      </table>
    </div>
    <p class="entity-note">"Flush fit" and "max wheel" are aftermarket guidance from the source, not factory approvals — check clearance, load rating and local rules before fitting.</p>
  </section>
)}

{curated.length > 0 && (
  <section class="entity-section" aria-labelledby="car-curated">
    <h2 id="car-curated">Tire size and wheel torque</h2>
    <div class="entity-links">
      {curated.map((vehicle) => <a class="entity-link-card" href={vehiclePagePath('en', vehicle.id)}><strong>{vehicle.make} {vehicle.model} — {vehicle.tireSize}</strong><span>{vehicle.generation} · tire size, bolt pattern and torque reference</span><i aria-hidden="true">›</i></a>)}
    </div>
  </section>
)}

{otherYears.length > 0 && (
  <section class="entity-section" aria-labelledby="car-years">
    <h2 id="car-years">Other {model.model} years</h2>
    <ul class="entity-chiplist">
      {otherYears.map((y) => <li><a class="entity-chip" href={carYearPath(model, y)}>{y}</a></li>)}
    </ul>
    <p class="entity-note"><a href={carModelPath(model)}>All {name} years and wheel data</a> · <a href={carMakePath(model.makeSlug)}>All {model.make} models</a></p>
  </section>
)}

<section class="entity-section" aria-labelledby="car-faq">
  <h2 id="car-faq">Frequently asked questions</h2>
  {faqs.map((f) => <details class="entity-faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}
</section>

<section class="entity-section" aria-labelledby="car-sources">
  <h2 id="car-sources">Sources</h2>
  <p class="entity-note">Fuel economy: <a href={EPA_SOURCE.url} rel="noopener">{EPA_SOURCE.name}</a> (U.S. government data). {wheelRows.length > 0 && <>Wheel fitment data: <a href={ANKUSI_SOURCE.url} rel="noopener">{ANKUSI_SOURCE.name}</a>.</>}</p>
</section>

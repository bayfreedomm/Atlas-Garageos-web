---
import type { ToolDefinition } from '../seo/tool-registry';
import { canonicalForPath, routeForTool, SITE_ORIGIN } from '../seo/tool-registry';
import '../styles/tire-size-calculator.css';

interface Props { definition: ToolDefinition; }
const { definition } = Astro.props;
const pathname = routeForTool(definition);
const canonical = canonicalForPath(pathname);
const websiteJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Atlas GarageOS', url: SITE_ORIGIN });
const applicationJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebApplication', name: definition.title, description: definition.description, url: canonical, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', browserRequirements: 'Requires a modern web browser', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } });
const breadcrumbJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: canonicalForPath('/') },
  { '@type': 'ListItem', position: 2, name: 'Tools', item: canonicalForPath('/tools/') },
  { '@type': 'ListItem', position: 3, name: definition.title, item: canonical },
] });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={definition.description} />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Atlas GarageOS" />
    <meta property="og:title" content={`${definition.title} — Atlas GarageOS`} />
    <meta property="og:description" content={definition.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/atlas-mark.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f3f0e8" />
    <script is:inline type="application/ld+json" set:html={websiteJsonLd}></script>
    <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd}></script>
    <script is:inline type="application/ld+json" set:html={applicationJsonLd}></script>
    <title>{definition.title} — Atlas GarageOS</title>
  </head>
  <body>
    <a class="ts-skip-link" href="#main-content">Skip to calculator</a>
    <header class="ts-header">
      <div class="ts-header__inner">
        <a class="ts-logo" href="/" aria-label="GarageOS home"><span>Garage</span><b>OS</b></a>
        <nav class="ts-header__actions" aria-label="Quick navigation">
          <a href="/tools/" aria-label="Search tools"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="5.5"></circle><path d="m15 15 4 4"></path></svg></a>
          <a href="/tools/" aria-label="Open tools menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14M5 12h14M5 16h14"></path></svg></a>
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="ts-footer"><span>GarageOS</span><a href="/methodology/">Accuracy &amp; methodology</a></footer>
  </body>
</html>

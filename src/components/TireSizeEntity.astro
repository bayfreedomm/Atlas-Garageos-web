---
// Shared body for every tire-size detail page, in every locale.
//
// The three route files (/tire-sizes/[slug]/, /de/reifengroessen/[slug]/,
// /es/medidas-neumaticos/[slug]/) are thin getStaticPaths() wrappers around this one
// component — there is exactly one copy of this markup, parameterized by `locale`.
//
// Mobile-first section order (2026-10 redesign): the reader came for the size's dimensions and
// what else fits, so those come first and the explanatory material follows.
//   HERO + ANSWER STRIP + PAGE NAV → SPEC TABLE (mm | inches) → ALTERNATIVES → VEHICLES
//   → SAME-RIM NEIGHBOURS → CODE BREAKDOWN → CROSS-SECTION → NEXT DECISIONS → RELATED → FAQ
import TireSizeCrossSection from './TireSizeCrossSection.astro';
import DecisionGraph from './DecisionGraph.astro';
import TireSizeLookup from './TireSizeLookup.astro';
import type { TireSizeEntry } from '../data/tire-size-catalog';
import { commercialTwin, vehicleFitsAsStandard, vehiclesForTireSize } from '../data/tire-size-catalog';
import { boltPatternSlug } from '../data/bolt-pattern-catalog';
import { tireSizePageText } from '../content/entity-page-text';
import { entityDetailPath, entityHubPath, type EntityLocale } from '../seo/entity-routes';
import {
  boltPatternsForTireSize, displayTireNotation, formatTireMetrics, homePath, inchShorthand,
  metricEquivalents, sameRimNeighbours, signed, splitHeadingAroundKey, tireAlternatives, tireComparisonHref,
  tireDiameterGroupFor, tireDiameterGroupPath, tireSizeMetrics, vehicleHubPath, vehicleLink, vehicleNames,
} from '../ui/entity-page-model';
import { formatDecimal, formatMm, formatPlain } from '../ui/locale-format';
import { tireDecisionGraph } from '../ui/decision-graph';

interface Props { readonly entry: TireSizeEntry; readonly locale: EntityLocale; }
const { entry, locale } = Astro.props;

const t = tireSizePageText[locale];
const shownNotation = displayTireNotation(entry.notation, locale);
const metrics = tireSizeMetrics(entry);
const shown = formatTireMetrics(metrics, locale);
const vehicles = vehiclesForTireSize(entry.notation);
const alternatives = tireAlternatives(entry);
const neighbours = sameRimNeighbours(entry);
const twin = commercialTwin(entry);
const relatedPatterns = boltPatternsForTireSize(entry.notation);
const hubHref = entityHubPath('tire-size', locale);
const boltHubHref = entityHubPath('bolt-pattern', locale);
const flotation = entry.flotation;
const rimText = formatPlain(entry.rimDiameterInches, locale);
const diameterGroup = tireDiameterGroupFor(entry);
const inchClass = diameterGroup ? (locale === 'en' ? `${diameterGroup.inches}-inch` : locale === 'de' ? `${diameterGroup.inches}-Zoll` : `${diameterGroup.inches} pulgadas`) : '';
const generalFaqs = t.faqs({ notation: shownNotation, vehicles: vehicles.length, makes: vehicleNames(vehicles), rim: entry.rimDiameterInches });
const faqs = [
  ...t.sizeFaqs(shownNotation, {
    diameterIn: formatDecimal(metrics.overallDiameterMm / 25.4, 1, locale),
    diameterMm: formatDecimal(metrics.overallDiameterMm, 0, locale),
    widthIn: formatDecimal(metrics.sectionWidthMm / 25.4, 1, locale),
    sidewallIn: formatDecimal(metrics.sidewallHeightMm / 25.4, 1, locale),
    metricEquivalents: flotation ? metricEquivalents(entry).map((candidate) => displayTireNotation(candidate.notation, locale)).join(', ') : '',
    inchClass,
  }, Boolean(flotation)),
  // The last generic answer explains the metric/inch mix of a metric code; it does not apply
  // to a flotation size, which is all inches.
  ...(flotation ? generalFaqs.slice(0, 3) : generalFaqs),
];
const breakdown = [
  ...(flotation
    ? t.flotationParts(formatPlain(flotation.overallDiameterIn, locale), formatDecimal(flotation.sectionWidthIn, 2, locale), rimText)
    : t.breakdownParts(entry.widthMm, entry.aspectRatio, entry.rimDiameterInches)),
  ...(entry.commercial ? [{ token: 'C', label: t.commercialBreakdown.label, detail: t.commercialBreakdown.detail }] : []),
];
// The <h1> carries the full semantic phrase ("235/45R18 tire size" / "Reifengröße 235/45 R18"),
// split around the notation so the code itself stays the visually dominant part of it.
const heading = splitHeadingAroundKey(t.detailH1(shownNotation), shownNotation);

const inchValue = (mm: number, digits = 1): string => `${formatDecimal(mm / 25.4, digits, locale)}″`;
// One spec table instead of two card grids: every measure once, metric and inches side by side.
const specRows = [
  { label: t.metrics.overallDiameter, metric: shown.overallDiameter, imperial: inchValue(metrics.overallDiameterMm, 2) },
  { label: t.metrics.sectionWidth, metric: shown.sectionWidth, imperial: inchValue(metrics.sectionWidthMm, 2) },
  { label: t.metrics.sidewallHeight, metric: shown.sidewallHeight, imperial: inchValue(metrics.sidewallHeightMm, 2) },
  { label: t.metrics.rimDiameterIn, metric: shown.rimDiameterMm, imperial: shown.rimDiameterIn },
  { label: t.metrics.circumference, metric: shown.circumference, imperial: inchValue(metrics.circumferenceMm, 1) },
  { label: t.revsLabel, metric: `${shown.revsPerKm} /km`, imperial: `${shown.revsPerMile} /mi` },
];
// The answer strip: the four numbers a searcher wants, readable without scrolling. English and
// Spanish readers (US/LatAm queries are "in inches"/"en pulgadas") get inches as the headline
// figure; German readers get millimetres.
const inchesFirst = locale !== 'de';
const answer = [
  { label: t.answerLabels.diameter, mm: formatMm(metrics.overallDiameterMm, 0, locale), inch: inchValue(metrics.overallDiameterMm) },
  { label: t.answerLabels.width, mm: formatMm(metrics.sectionWidthMm, 0, locale), inch: inchValue(metrics.sectionWidthMm) },
  { label: t.answerLabels.sidewall, mm: formatMm(metrics.sidewallHeightMm, 0, locale), inch: inchValue(metrics.sidewallHeightMm) },
  { label: t.answerLabels.circumference, mm: formatMm(metrics.circumferenceMm, 0, locale), inch: inchValue(metrics.circumferenceMm) },
];
const speedCell = (trueSpeedAt100: number): string =>
  `${formatDecimal((trueSpeedAt100 / 100) * t.speedBase.indicated, 1, locale)} ${t.speedBase.unit}`;
const decisions = tireDecisionGraph(entry, locale);
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href={homePath(locale)}>{t.breadcrumbHome}</a><span aria-hidden="true">/</span>
  <a href={hubHref}>{t.breadcrumbHub}</a><span aria-hidden="true">/</span>
  <span aria-current="page">{shownNotation}</span>
</nav>

<header class="entity-hero entity-hero--tire">
  <p class="eyebrow">{entry.commercial ? t.commercialKicker : flotation ? t.flotationKicker : t.detailKicker}</p>
  <h1 class="entity-hero__title">{heading.before}<span class="entity-hero__key">{heading.key}</span>{heading.after}</h1>
  <dl class="entity-answer">
    {answer.map((item) => (
      <div class="entity-answer__item">
        <dt>{item.label}</dt>
        <dd><strong>{inchesFirst ? item.inch : item.mm}</strong><span>{inchesFirst ? item.mm : item.inch}</span></dd>
      </div>
    ))}
  </dl>
  <p class="entity-hero__lead">{flotation
    ? t.flotationLead(formatPlain(flotation.overallDiameterIn, locale), formatDecimal(flotation.sectionWidthIn, 2, locale), rimText)
    : t.detailLead(entry.widthMm, entry.aspectRatio, entry.rimDiameterInches)}</p>
  {entry.commercial && <p class="entity-note">{t.commercialNote}</p>}
  {flotation && <p class="entity-note">{t.flotationNote}</p>}
  <div class="entity-hero__links">
    {diameterGroup && <a class="entity-inline-link" href={tireDiameterGroupPath(diameterGroup.inches, locale)}>{t.diameter.sizeLink(diameterGroup.inches)} ›</a>}
    {twin && <a class="entity-inline-link" href={entityDetailPath('tire-size', locale, twin.slug)}>{entry.commercial ? t.commercialTwinLink(displayTireNotation(twin.notation, locale)) : t.passengerTwinLink(displayTireNotation(twin.notation, locale))} ›</a>}
  </div>
  <nav class="entity-pagenav" aria-label={t.pageNav.label}>
    <a href="#entity-specs">{t.pageNav.specs}</a>
    <a href="#entity-compare">{t.pageNav.alternatives}</a>
    <a href="#entity-vehicles">{t.pageNav.vehicles}</a>
    <a href="#entity-breakdown">{t.pageNav.code}</a>
    <a href="#entity-faq">{t.pageNav.faq}</a>
  </nav>
</header>

<section class="entity-section" aria-labelledby="entity-specs">
  <h2 id="entity-specs">{t.metricsHeading}</h2>
  <table class="entity-spec">
    <thead><tr><th scope="col">{t.specCols.measure}</th><th scope="col">{t.specCols.metric}</th><th scope="col">{t.specCols.imperial}</th></tr></thead>
    <tbody>
      {specRows.map((row) => <tr><th scope="row">{row.label}</th><td>{row.metric}</td><td>{row.imperial}</td></tr>)}
      <tr><th scope="row">{t.metrics.aspectRatio}</th><td colspan="2">{shown.aspectRatio}</td></tr>
    </tbody>
  </table>
  <p class="entity-note">{t.inchIntro(inchShorthand(entry, metrics, locale))} {t.metricNote}</p>
</section>

<section class="entity-section" aria-labelledby="entity-compare">
  <h2 id="entity-compare">{t.alternativesHeading}</h2>
  {alternatives.length === 0 ? (
    <p class="entity-empty">{t.alternativesEmpty}</p>
  ) : (
    <>
      <p class="entity-note">{t.alternativesIntro}</p>
      <div class="entity-table-scroll">
        <table class="entity-table entity-table--alternatives">
          <thead><tr><th scope="col">{t.colSize}</th><th scope="col" class="is-optional">{t.colDiameter}</th><th scope="col">{t.colDifference}</th><th scope="col">{t.colSpeed}</th><th scope="col" class="is-optional">{t.compareLabel}</th></tr></thead>
          {alternatives.map((row) => (
            <tbody>
              <tr class="entity-table__group"><th scope="rowgroup" colspan="5">{t.rimRowLabel(formatPlain(row.rimDiameterInches, locale), row.rimDelta)}</th></tr>
              {row.options.map((option) => (
                <tr>
                  <th scope="row"><a href={entityDetailPath('tire-size', locale, option.entry.slug)}>{displayTireNotation(option.entry.notation, locale)}</a></th>
                  <td class="is-optional">{formatMm(option.overallDiameterMm, 1, locale)}</td>
                  <td>{signed(option.differencePercent, 1, '%', locale)}<span class="entity-subvalue">{signed(option.differenceMm, 0, 'mm', locale)}</span></td>
                  <td>{speedCell(option.trueSpeedAtIndicated100)}</td>
                  <td class="is-optional"><a class="entity-inline-link" href={tireComparisonHref(locale, entry, option.entry)}>{t.compareLabel}</a></td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </>
  )}
  <p class="entity-caveat"><strong>⚠</strong> {t.compareCaveat}</p>
</section>

<section class="entity-section" aria-labelledby="entity-vehicles">
  <h2 id="entity-vehicles">{t.vehiclesHeading}</h2>
  {vehicles.length === 0 ? (
    <p class="entity-empty">{t.vehiclesEmpty}</p>
  ) : (
    <>
      <p class="entity-note">{t.vehiclesIntro(vehicles.length)}</p>
      <div class="entity-table-scroll">
        <table class="entity-table">
          <thead><tr><th scope="col">{t.colVehicle}</th><th scope="col">{t.colGeneration}</th><th scope="col" class="is-optional">{t.colFitment}</th><th scope="col" class="is-optional">{t.colBoltPattern}</th><th scope="col" class="is-optional">{t.colConfidence}</th></tr></thead>
          <tbody>
            {vehicles.map((vehicle) => {
              const link = vehicleLink(vehicle, locale);
              return (
                <tr>
                  <th scope="row"><a href={link.href} hreflang={link.crossLocale ? link.locale : undefined}>{vehicle.make} {vehicle.model}</a></th>
                  <td>{vehicle.generation}</td>
                  <td class="is-optional">{vehicleFitsAsStandard(vehicle, entry.notation) ? t.fitmentStandard : t.fitmentOption}</td>
                  <td class="is-optional"><a href={entityDetailPath('bolt-pattern', locale, boltPatternSlug(vehicle.boltPattern))}>{vehicle.boltPattern}</a></td>
                  <td class="is-optional"><span class={`entity-confidence entity-confidence--${vehicle.confidence}`}>{t.confidence[vehicle.confidence]}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="entity-note">{t.confidenceNote}</p>
    </>
  )}
</section>

{neighbours.length > 0 && (
  <section class="entity-section" aria-labelledby="entity-neighbours">
    <h2 id="entity-neighbours">{t.neighboursHeading}</h2>
    <p class="entity-note">{t.neighboursIntro}</p>
    <ul class="entity-chiplist">
      {neighbours.map((neighbour) => <li><a class="entity-chip" href={entityDetailPath('tire-size', locale, neighbour.slug)}>{displayTireNotation(neighbour.notation, locale)}</a></li>)}
    </ul>
  </section>
)}

<section class="entity-section" aria-labelledby="entity-breakdown">
  <h2 id="entity-breakdown">{t.breakdownHeading}</h2>
  <ol class="entity-code entity-code--compact">
    {breakdown.map((part) => (
      <li class="entity-code__part">
        <span class="entity-code__token">{part.token}</span>
        <strong>{part.label}</strong>
        <span>{part.detail}</span>
      </li>
    ))}
  </ol>
</section>

<section class="entity-section" aria-labelledby="entity-visual">
  <h2 id="entity-visual">{t.visualHeading}</h2>
  <TireSizeCrossSection
    widthMm={entry.widthMm}
    sidewallHeightMm={metrics.sidewallHeightMm}
    rimDiameterInches={entry.rimDiameterInches}
    notation={shownNotation}
    ariaLabel={t.crossAria(shownNotation)}
    treadLabel={t.crossTread}
    sidewallLabel={t.crossSidewall}
    beadLabel={t.crossBead}
    rimCaption={t.crossRimCaption}
    locale={locale}
  />
  <p class="entity-note">{t.visualNote}</p>
</section>

<DecisionGraph model={decisions} {locale} id="tire-decisions" />

<section class="entity-section" aria-labelledby="entity-related">
  <h2 id="entity-related">{t.relatedHeading}</h2>
  <TireSizeLookup locale={locale} id="tire-lookup-related" showHeading />
  <div class="entity-links">
    <a class="entity-link-card" href={hubHref}><strong>{t.backToHub}</strong><span>{t.hubKicker}</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href={vehicleHubPath(locale)}><strong>{t.vehiclesCta}</strong><span>{t.vehiclesCtaDetail}</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href={boltHubHref}><strong>{t.boltHubCta}</strong><span>{t.boltHubCtaDetail}</span><i aria-hidden="true">›</i></a>
  </div>
  {relatedPatterns.length > 0 && (
    <ul class="entity-chiplist">
      {relatedPatterns.map((pattern) => <li><a class="entity-chip" href={entityDetailPath('bolt-pattern', locale, pattern.slug)}>{pattern.notation}</a></li>)}
    </ul>
  )}
</section>

<section class="entity-section" aria-labelledby="entity-faq">
  <h2 id="entity-faq">{t.faqHeading}</h2>
  {faqs.map((faq) => <details class="entity-faq"><summary>{faq.q}</summary><p>{faq.a}</p></details>)}
</section>

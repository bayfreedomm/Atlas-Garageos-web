---
interface Props { prefix: string; title: string; width: number; aspect: number; rim: number; }
const { prefix, title, width, aspect, rim } = Astro.props;
---
<fieldset class="calculator-group"><legend>{title}</legend><div class="tire-input-row">
  <label>Width<input name={`${prefix}widthMm`} type="number" value={width} inputmode="numeric" /></label><span aria-hidden="true">/</span>
  <label>Profile<input name={`${prefix}aspectRatio`} type="number" value={aspect} inputmode="numeric" /></label><span aria-hidden="true">R</span>
  <label>Rim<input name={`${prefix}rimDiameterInches`} type="number" value={rim} step="0.5" inputmode="decimal" /></label>
</div></fieldset>

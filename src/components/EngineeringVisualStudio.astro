---
import Parametric3DPanel from './Parametric3DPanel.astro';
import type { Visualization3DLocale } from '../localization/visualization-3d';

interface Props { readonly mode: 'offset' | 'pcd'; readonly locale: Visualization3DLocale; }
const { mode, locale } = Astro.props;
const copy = {
  en: { badge: 'Visual studio', title: 'See the geometry from every angle', intro: 'Start with the fast engineering drawing; open the interactive 3D model whenever you need it.', studio: '3D Studio', drawing: 'Engineering 2D' },
  de: { badge: 'Visual Studio', title: 'Geometrie aus jedem Blickwinkel', intro: 'Starten Sie mit der schnellen technischen Zeichnung und öffnen Sie das interaktive 3D-Modell bei Bedarf.', studio: '3D Studio', drawing: 'Technische 2D-Ansicht' },
  es: { badge: 'Estudio visual', title: 'Geometría desde todos los ángulos', intro: 'Empieza con el dibujo técnico rápido y abre el modelo 3D interactivo cuando lo necesites.', studio: 'Estudio 3D', drawing: 'Ingeniería 2D' },
  fr: { badge: 'Studio visuel', title: 'La géométrie sous tous les angles', intro: 'Commencez par le plan technique rapide et ouvrez le modèle 3D interactif quand vous en avez besoin.', studio: 'Studio 3D', drawing: 'Plan technique 2D' },
  it: { badge: 'Studio visivo', title: 'La geometria da ogni angolazione', intro: 'Parti dal disegno tecnico rapido e apri il modello 3D interattivo quando ti serve.', studio: 'Studio 3D', drawing: 'Disegno tecnico 2D' },
  'pt-br': { badge: 'Estúdio visual', title: 'A geometria de todos os ângulos', intro: 'Comece pelo desenho técnico rápido e abra o modelo 3D interativo quando precisar.', studio: 'Estúdio 3D', drawing: 'Engenharia 2D' },
  pl: { badge: 'Studio wizualne', title: 'Geometria z każdej strony', intro: 'Zacznij od szybkiego rysunku technicznego i otwórz interaktywny model 3D, gdy go potrzebujesz.', studio: 'Studio 3D', drawing: 'Rysunek techniczny 2D' },
  nl: { badge: 'Visuele studio', title: 'De geometrie vanuit elke hoek', intro: 'Begin met de snelle technische tekening en open het interactieve 3D-model wanneer je het nodig hebt.', studio: '3D-studio', drawing: 'Technische 2D-tekening' },
  tr: { badge: 'Görsel stüdyo', title: 'Geometriyi her açıdan görün', intro: 'Hızlı teknik çizimle başlayın; etkileşimli 3D modeli ihtiyaç duyduğunuzda açın.', studio: '3D Stüdyo', drawing: '2D Teknik Çizim' },
}[locale];
---
<section class="tire-visual-studio" data-engineering-visual-studio aria-label={copy.title}>
  <header class="tire-visual-studio__header">
    <div><span>{copy.badge}</span><h3>{copy.title}</h3><p>{copy.intro}</p></div>
    <div class="tire-visual-studio__tabs" role="tablist" aria-label={copy.badge}>
      <button type="button" role="tab" aria-selected="false" tabindex="-1" data-visual-tab="3d">{copy.studio}</button>
      <button type="button" role="tab" aria-selected="true" data-visual-tab="2d">{copy.drawing}</button>
    </div>
  </header>
  <div role="tabpanel" data-visual-panel="3d" hidden><Parametric3DPanel {mode} {locale} /></div>
  <div role="tabpanel" data-visual-panel="2d"><slot /></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-engineering-visual-studio]').forEach((studio) => {
    const buttons = [...studio.querySelectorAll<HTMLButtonElement>('[data-visual-tab]')];
    const panels = [...studio.querySelectorAll<HTMLElement>('[data-visual-panel]')];
    for (const button of buttons) button.addEventListener('click', () => {
      const selected = button.dataset.visualTab;
      for (const candidate of buttons) candidate.setAttribute('aria-selected', String(candidate === button));
      for (const panel of panels) panel.hidden = panel.dataset.visualPanel !== selected;
    });
  });
</script>

---
// Two complementary, geometry-driven tire diagrams:
//   A) SIDE VIEW — a side-elevation wheel ring (rim + tire radii derived
//      directly from the real rim-diameter / overall-diameter ratio) with
//      external dimension lines for sidewall height, overall diameter, and
//      rim diameter.
//   B) CROSS-SECTION — a true tire cross-sectional shape (bulging sidewall,
//      tread/crown, bead, a separate rim block, and a hollow inner cavity),
//      not a capsule/blob/trapezoid/gear. Geometry comes from
//      computeTireCrossSection() in ui/tire-cross-section.ts, the same
//      function the live updater uses, so the two never drift apart, and
//      both axes share one scale factor rather than being independently
//      clamped.
// Every numerical label always shows the true calculated value; only drawn
// extents are ever capped, and every label position is computed from that
// same geometry (never a fixed pixel guess), so extreme ratios cannot make
// a label collide, clip, or cross another element.
import type { ContentLocale } from '../localization/site-catalog';
import { computeTireCrossSection, CROSS_SECTION_VIEWBOX } from '../ui/tire-cross-section';

interface Props { readonly locale?: ContentLocale | undefined; }
const { locale } = Astro.props;

const SINGLE_TIRE_VISUAL_TEXT = {

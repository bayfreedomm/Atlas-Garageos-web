---
import type { ContentLocale } from '../localization/site-catalog';

interface Props { readonly locale?: ContentLocale | undefined; }
const { locale } = Astro.props;

const SINGLE_TIRE_VISUAL_TEXT = {
  en: {
    kicker: 'Live tire anatomy',
    title: 'See the tire behind the code',
    subtitle: 'The drawing updates with width, profile and rim size.',
    sidewallLabel: 'Sidewall',
    sidewallCaption: 'Width × profile %',
    diameterLabel: 'Overall diameter',
    diameterCaption: 'Rim + two sidewalls',
    meaningLabel: 'What changes visually',
    meaningDefault: 'Higher profile makes the sidewall taller; larger rim makes the wheel opening larger.',
  },
  de: {
    kicker: 'Reifenanatomie live',
    title: 'Sehen Sie den Reifen hinter dem Code',
    subtitle: 'Die Zeichnung passt sich an Breite, Profil und Felgengröße an.',
    sidewallLabel: 'Flankenhöhe',
    sidewallCaption: 'Breite × Profil %',
    diameterLabel: 'Gesamtdurchmesser',
    diameterCaption: 'Felge + zwei Flanken',
    meaningLabel: 'Was sich optisch ändert',
    meaningDefault: 'Ein höheres Profil macht die Flanke höher; eine größere Felge vergrößert die Radöffnung.',
  },
  es: {
    kicker: 'Anatomía del neumático en vivo',
    title: 'Vea el neumático detrás del código',
    subtitle: 'El dibujo se actualiza con el ancho, el perfil y el tamaño de la llanta.',
    sidewallLabel: 'Flanco',
    sidewallCaption: 'Ancho × perfil %',
    diameterLabel: 'Diámetro total',
    diameterCaption: 'Llanta + dos flancos',
    meaningLabel: 'Qué cambia visualmente',
    meaningDefault: 'Un perfil más alto hace el flanco más alto; una llanta más grande agranda la abertura de la rueda.',
  },
} as const;

const t = SINGLE_TIRE_VISUAL_TEXT[locale ?? 'en'];

const TREAD_BLOCK_COUNT = 26;
const treadBlocks = Array.from({ length: TREAD_BLOCK_COUNT }, (_, i) => {
  const angle = (i / TREAD_BLOCK_COUNT) * Math.PI * 2;
  const x = 98 * Math.cos(angle);
  const y = 98 * Math.sin(angle);
  const rotation = (angle * 180) / Math.PI + 90;
  return { x: x.toFixed(2), y: y.toFixed(2), rotation: rotation.toFixed(1) };
});
---
<figure class="single-tire-visual" data-single-tire-visual aria-labelledby="single-tire-title">
  <figcaption><span class="visual-kicker">{t.kicker}</span><strong id="single-tire-title">{t.title}</strong><p>{t.subtitle}</p></figcaption>
  <div class="single-tire-grid">
    <section class="single-tire-card single-tire-card--hero">
      <svg viewBox="0 0 460 300" role="img" aria-label="Technical tire illustration with live dimensions">
        <defs>
          <radialGradient id="singleRim" cx="38%" cy="32%" r="72%"><stop offset="0" stop-color="#f1f5f7"/><stop offset="1" stop-color="#a7b2ba"/></radialGradient>
          <radialGradient id="singleGroundShadow" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#000" stop-opacity=".38"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>
        </defs>
        <path class="single-ground" d="M45 248H375"/>
        <g data-single-tire-wheel transform="translate(210 145)">
          <ellipse class="single-tire-shadow" cx="0" cy="104" rx="72" ry="12" fill="url(#singleGroundShadow)"/>
          <ellipse data-single-tire-body class="single-tire-body" cx="0" cy="0" rx="94" ry="110"/>
          <g class="single-tread-blocks">
            {treadBlocks.map((b) => <rect class="single-tread-block" x="-3.3" y="-6" width="6.6" height="12" rx="1.6" transform={`translate(${b.x} ${b.y}) rotate(${b.rotation}) scale(1 1.17)`} />)}
          </g>
          <ellipse class="single-tire-sidewall" cx="0" cy="0" rx="72" ry="84"/>
          <ellipse class="single-tire-sidewall-ring" cx="0" cy="0" rx="72" ry="84" fill="none"/>
          <ellipse data-single-tire-rim cx="0" cy="0" rx="55" ry="64" fill="url(#singleRim)"/>
          <ellipse class="single-rim-lip" cx="0" cy="0" rx="55" ry="64" fill="none"/>
          <path class="single-spoke" d="M0 0 0-46M0 0 40-15M0 0 25 41M0 0-25 41M0 0-40-15"/>
          <ellipse cx="0" cy="0" rx="16" ry="18" class="single-hub"/>
          <g class="single-lugs">
            <circle class="single-lug" cx="0" cy="-24" r="2.6"/>
            <circle class="single-lug" cx="21" cy="-8" r="2.6"/>
            <circle class="single-lug" cx="13" cy="21" r="2.6"/>
            <circle class="single-lug" cx="-13" cy="21" r="2.6"/>
            <circle class="single-lug" cx="-21" cy="-8" r="2.6"/>
          </g>
        </g>
        <g class="single-measure single-measure--width"><path data-single-width-line d="M116 22H304"/><path d="M116 16v12M304 16v12"/><text data-single-width-text x="210" y="13" text-anchor="middle">225 mm width</text></g>
        <g class="single-measure single-measure--diameter"><path data-single-diameter-line d="M86 35V255"/><path d="M78 35h16M78 255h16"/><text data-single-diameter-text x="54" y="148" text-anchor="middle">659.7 mm</text></g>
        <g class="single-measure single-measure--rim"><path data-single-rim-line d="M344 81V209"/><path d="M336 81h16M336 209h16"/><text data-single-rim-text x="396" y="148" text-anchor="middle">18 in rim</text></g>
      </svg>
      <div class="single-tire-badge" data-single-size-label>225 / 45 R18</div>
    </section>
    <section class="single-tire-card single-tire-card--facts">
      <div><span>{t.sidewallLabel}</span><strong data-single-sidewall>101.3 mm</strong><small>{t.sidewallCaption}</small></div>
      <div><span>{t.diameterLabel}</span><strong data-single-diameter>659.7 mm</strong><small>{t.diameterCaption}</small></div>
      <div><span>{t.meaningLabel}</span><p data-single-meaning>{t.meaningDefault}</p></div>
    </section>
  </div>
</figure>

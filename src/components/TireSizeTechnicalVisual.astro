const t = SINGLE_TIRE_VISUAL_TEXT[locale ?? 'en'];

// Static defaults matching the form's default 225/45 R18, so the page looks
// correct before any JS has run. setSingleTireTechnicalVisual() in
// ui/tool-calculators.ts recomputes every value below on input.
const CENTER_X = 175;
const CENTER_Y = 150;
const OUTER_R = 92;
const RIM_R = 63.8; // 92 * (457.2 / 659.7)
const HUB_R = RIM_R * 0.3;
const SPOKE_R = RIM_R * 0.74;

const TREAD_TICK_COUNT = 40;
const treadTicks = Array.from({ length: TREAD_TICK_COUNT }, (_, i) => {
  const angle = (i / TREAD_TICK_COUNT) * Math.PI * 2;
  const cos = Math.cos(angle);
  const sin = Math.sin(angle);
  const innerR = OUTER_R - 7;
  return {
    x1: (CENTER_X + cos * innerR).toFixed(1),
    y1: (CENTER_Y + sin * innerR).toFixed(1),
    x2: (CENTER_X + cos * OUTER_R).toFixed(1),
    y2: (CENTER_Y + sin * OUTER_R).toFixed(1),
  };
});

const LUG_ANGLES = [ -90, -18, 54, 126, 198 ];

// Cross-section defaults for 225/45 R18 (width 225mm, sidewall 101.25mm).
const cs = computeTireCrossSection(225, 101.25);
const crownTreadTicks = [-0.32, -0.16, 0, 0.16, 0.32].map((f) => cs.hw * 0.5 * f);
const RIM_DEFAULT_LABEL = { en: '⌀ 18 in rim', de: '⌀ 18 Zoll Felge', es: '⌀ 18 pulg. de llanta', fr: '⌀ jante 18 po', it: '⌀ cerchio 18 pollici', 'pt-br': '⌀ aro 18 pol.', pl: '⌀ felga 18 cali', nl: '⌀ 18 inch velg', tr: '⌀ 18 inç jant' } as const;
const rimDefaultLabel = RIM_DEFAULT_LABEL[locale ?? 'en'];
---
<figure class="single-tire-visual" data-single-tire-visual aria-labelledby="single-tire-title">
  <figcaption><span class="visual-kicker">{t.kicker}</span><strong id="single-tire-title">{t.title}</strong><p>{t.subtitle}</p></figcaption>
  <div class="single-tire-grid">
    <section class="single-tire-card single-tire-card--hero">
      <div class="single-tire-panels">
        <div class="single-tire-panel">
          <p class="single-tire-panel__label">{t.sideViewLabel}</p>
          <svg viewBox="0 0 440 320" role="img" aria-label={t.sideViewAria} data-single-tire-svg>
            <defs>
              <radialGradient id="singleRim" cx="38%" cy="32%" r="72%"><stop offset="0" stop-color="#f1f5f7"/><stop offset="1" stop-color="#a7b2ba"/></radialGradient>
            </defs>
            <g data-single-tire-wheel>
              <ellipse class="single-tire-shadow" cx={CENTER_X} cy={CENTER_Y + OUTER_R + 10} rx={OUTER_R * 0.82} ry="9" />
              <circle data-single-tire-body class="single-tire-body" cx={CENTER_X} cy={CENTER_Y} r={OUTER_R} />
              <g class="single-tread-ticks" data-single-tread-ticks>
                {treadTicks.map((b) => <line x1={b.x1} y1={b.y1} x2={b.x2} y2={b.y2} />)}
              </g>
              <circle data-single-tire-rim-seat class="single-tire-rim-seat" cx={CENTER_X} cy={CENTER_Y} r={RIM_R + 6} />
              <circle data-single-tire-rim class="single-tire-rim" cx={CENTER_X} cy={CENTER_Y} r={RIM_R} fill="url(#singleRim)" />
              <g class="single-spokes" data-single-spokes>
                {LUG_ANGLES.map((deg) => {
                  const rad = (deg * Math.PI) / 180;
                  const x = (CENTER_X + Math.cos(rad) * SPOKE_R).toFixed(1);
                  const y = (CENTER_Y + Math.sin(rad) * SPOKE_R).toFixed(1);
                  return <path class="single-spoke" d={`M${CENTER_X} ${CENTER_Y} L${x} ${y}`} />;
                })}
              </g>
              <circle data-single-tire-hub class="single-hub" cx={CENTER_X} cy={CENTER_Y} r={HUB_R} />
              <g class="single-lugs" data-single-lugs>
                {LUG_ANGLES.map((deg) => {
                  const rad = (deg * Math.PI) / 180;
                  const x = (CENTER_X + Math.cos(rad) * (HUB_R + 6)).toFixed(1);
                  const y = (CENTER_Y + Math.sin(rad) * (HUB_R + 6)).toFixed(1);
                  return <circle class="single-lug" cx={x} cy={y} r="2.4" />;
                })}
              </g>
            </g>
            <g class="single-measure single-measure--sidewall">
              <path data-single-sidewall-tick1 d={`M${CENTER_X} ${CENTER_Y - RIM_R}H66`} />
              <path data-single-sidewall-tick2 d={`M${CENTER_X} ${CENTER_Y - OUTER_R}H66`} />
              <path data-single-sidewall-line d={`M66 ${CENTER_Y - RIM_R}V${CENTER_Y - OUTER_R}`} />
              <text data-single-sidewall-text x="60" y={CENTER_Y - (RIM_R + OUTER_R) / 2} text-anchor="end">101.3 mm</text>
            </g>
            <g class="single-measure single-measure--diameter">
              <path data-single-diameter-tick1 d={`M${CENTER_X} ${CENTER_Y - OUTER_R}H301`} />
              <path data-single-diameter-tick2 d={`M${CENTER_X} ${CENTER_Y + OUTER_R}H301`} />
              <path data-single-diameter-line d={`M301 ${CENTER_Y - OUTER_R}V${CENTER_Y + OUTER_R}`} />
              <text data-single-diameter-text x="308" y={CENTER_Y} text-anchor="start">⌀ 659.7 mm</text>
            </g>
            <g class="single-measure single-measure--rim">
              <path data-single-rim-tick1 d={`M${CENTER_X - RIM_R} ${CENTER_Y}V280`} />
              <path data-single-rim-tick2 d={`M${CENTER_X + RIM_R} ${CENTER_Y}V280`} />
              <path data-single-rim-line d={`M${CENTER_X - RIM_R} 280H${CENTER_X + RIM_R}`} />
              <text data-single-rim-text x={CENTER_X} y="296" text-anchor="middle">⌀ 18 in rim</text>
            </g>
          </svg>
        </div>
        <div class="single-tire-panel">
          <p class="single-tire-panel__label">{t.crossSectionLabel}</p>
          <svg viewBox={`0 0 ${CROSS_SECTION_VIEWBOX.width} ${CROSS_SECTION_VIEWBOX.height}`} role="img" aria-label={t.crossSectionAria} data-single-cross-svg>
            <g transform={`translate(${cs.originX} ${cs.baselineY})`} data-single-cross-group>
              <path data-single-cross-cavity class="single-cross-cavity" d={cs.cavityPathD} />
              <path data-single-cross-outer class="single-cross-outer" d={cs.outerPathD} />
              <g class="single-cross-tread-ticks" data-single-cross-tread-ticks>
                {crownTreadTicks.map((x) => <line x1={x.toFixed(1)} y1={(-cs.Hs + 2).toFixed(1)} x2={x.toFixed(1)} y2={(-cs.Hs + 9).toFixed(1)} />)}
              </g>
              <rect data-single-cross-rim-bar class="single-cross-rim" x={cs.rim.barX.toFixed(1)} y={cs.rim.barY.toFixed(1)} width={cs.rim.barW.toFixed(1)} height={cs.rim.barH.toFixed(1)} rx="3" />
              <rect data-single-cross-flange-l class="single-cross-rim" x={cs.rim.flangeLX.toFixed(1)} y={cs.rim.flangeY.toFixed(1)} width={cs.rim.flangeW.toFixed(1)} height={cs.rim.flangeH.toFixed(1)} rx="2" />
              <rect data-single-cross-flange-r class="single-cross-rim" x={cs.rim.flangeRX.toFixed(1)} y={cs.rim.flangeY.toFixed(1)} width={cs.rim.flangeW.toFixed(1)} height={cs.rim.flangeH.toFixed(1)} rx="2" />
            </g>
            <g class="single-cross-measure">
              <path data-single-cross-width-tick1 d={`M${(cs.originX - cs.hw).toFixed(1)} ${cs.widthLineY.toFixed(1)}V${(cs.widthLineY + 6).toFixed(1)}`} />
              <path data-single-cross-width-tick2 d={`M${(cs.originX + cs.hw).toFixed(1)} ${cs.widthLineY.toFixed(1)}V${(cs.widthLineY + 6).toFixed(1)}`} />
              <path data-single-cross-width-line d={`M${(cs.originX - cs.hw).toFixed(1)} ${cs.widthLineY.toFixed(1)}H${(cs.originX + cs.hw).toFixed(1)}`} />
              <text data-single-cross-width-text x={cs.originX} y={(cs.widthLineY - 6).toFixed(1)} text-anchor="middle">225 mm</text>
            </g>
            <g class="single-cross-measure">
              <path data-single-cross-height-tick1 d={`M${cs.heightLineX.toFixed(1)} ${cs.heightLineTopY.toFixed(1)}H${(cs.heightLineX + 6).toFixed(1)}`} />
              <path data-single-cross-height-tick2 d={`M${cs.heightLineX.toFixed(1)} ${cs.heightLineBottomY.toFixed(1)}H${(cs.heightLineX + 6).toFixed(1)}`} />
              <path data-single-cross-height-line d={`M${cs.heightLineX.toFixed(1)} ${cs.heightLineTopY.toFixed(1)}V${cs.heightLineBottomY.toFixed(1)}`} />
              <text data-single-cross-height-text x={(cs.heightLineX + 10).toFixed(1)} y={((cs.heightLineTopY + cs.heightLineBottomY) / 2).toFixed(1)} text-anchor="start">101.3 mm</text>
            </g>
            <g class="single-cross-legend">
              <path data-single-cross-tread-leader d={`M${cs.leaderStartX.toFixed(1)} ${cs.treadLabelY.toFixed(1)}H${cs.treadLeaderX2.toFixed(1)}`} />
              <path data-single-cross-sidewall-leader d={`M${cs.leaderStartX.toFixed(1)} ${cs.sidewallLabelY.toFixed(1)}H${cs.sidewallLeaderX2.toFixed(1)}`} />
              <path data-single-cross-bead-leader d={`M${cs.leaderStartX.toFixed(1)} ${cs.beadLabelY.toFixed(1)}H${cs.beadLeaderX2.toFixed(1)}`} />
              <text data-single-cross-tread-label x={cs.legendX.toFixed(1)} y={cs.treadLabelY.toFixed(1)} text-anchor="end">{t.treadLabel}</text>
              <text data-single-cross-sidewall-label x={cs.legendX.toFixed(1)} y={cs.sidewallLabelY.toFixed(1)} text-anchor="end">{t.sidewallPartLabel}</text>
              <text data-single-cross-bead-label x={cs.legendX.toFixed(1)} y={cs.beadLabelY.toFixed(1)} text-anchor="end">{t.beadLabel}</text>
            </g>
            <text data-single-cross-rim-label class="single-cross-rim-label" x={cs.originX} y={cs.rimLabelY.toFixed(1)} text-anchor="middle">{t.rimCavityCaption(rimDefaultLabel)}</text>
          </svg>
        </div>
      </div>
      <div class="single-tire-badge" data-single-size-label>225 / 45 R18</div>
    </section>
    <section class="single-tire-card single-tire-card--facts">
      <div><span>{t.sidewallLabel}</span><strong data-single-sidewall>101.3 mm</strong><small>{t.sidewallCaption}</small></div>
      <div><span>{t.diameterLabel}</span><strong data-single-diameter>659.7 mm</strong><small>{t.diameterCaption}</small></div>
      <div><span>{t.meaningLabel}</span><p data-single-meaning>{t.meaningDefault}</p></div>
    </section>
  </div>
</figure>

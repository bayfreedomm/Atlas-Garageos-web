    treadLabel: 'Bieżnik',
    sidewallPartLabel: 'Bok',
    beadLabel: 'Stopka',
    rimCavityCaption: (rim: string) => `${rim} · wnętrze nad felgą`,
  },
  nl: {
    kicker: 'Live bandanatomie',
    title: 'Zie de band achter de code',

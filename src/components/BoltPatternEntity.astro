---
import { boltMakePath, makesUsingPattern } from '../ui/bolt-make';
import { boltMakeText } from '../content/bolt-make-text';
import { isReferenceLocale } from '../localization/reference-locales';
import { referenceChromeText } from '../content/reference-locale-text';
import { toolLocaleFor } from '../seo/entity-routes';
// Shared body for every bolt-pattern detail page, in every locale. Same contract as
// TireSizeEntity.astro: one copy of the markup, three thin getStaticPaths() route wrappers.
//
//   HERO → KEY METRICS → LUG DIAGRAM → LISTED VEHICLES → SAFETY → CALCULATOR CTA
//   → RELATED DATA → FAQ
//
// The safety section is not optional decoration. A shared bolt pattern is the single most
// common reason someone buys a wheel that does not fit, so it is rendered as a first-class
// section on every one of these pages, above the tool CTA rather than buried under it.
import BoltPatternDiagram from './BoltPatternDiagram.astro';
import Parametric3DPanel from './Parametric3DPanel.astro';
import DecisionGraph from './DecisionGraph.astro';
import { vehiclesForBoltPattern, type BoltPatternEntry } from '../data/bolt-pattern-catalog';
import { adjacentHoleSpacingMm } from '../data/bolt-pattern-geometry';
import { tireSizeSlug } from '../data/tire-size-catalog';
import { boltPatternPageText } from '../content/entity-page-text';
import { millimetersToInches } from '../core/units/conversion';
import { entityDetailPath, entityHubPath, type EntityLocale } from '../seo/entity-routes';
import {
  displayTireNotation, distinctCenterBores, formatCenterBores, homePath, splitHeadingAroundKey,
  tireSizesForBoltPattern, vehicleHubPath, vehicleLink, vehicleNames,
} from '../ui/entity-page-model';
import { torquePresentation } from '../ui/vehicle-torque';
import { formatDecimal, formatPlain } from '../ui/locale-format';
import { boltDecisionGraph } from '../ui/decision-graph';

interface Props { readonly entry: BoltPatternEntry; readonly locale: EntityLocale; }
const { entry, locale } = Astro.props;

const t = boltPatternPageText[locale];
const LOAD_3D_LABELS: Readonly<Record<EntityLocale, string>> = {
  en: 'Open interactive 3D bolt pattern', de: 'Interaktiven 3D-Lochkreis öffnen', es: 'Abrir patrón de birlos 3D interactivo',
  fr: 'Ouvrir l’entraxe en 3D interactif', it: 'Apri la foratura in 3D interattivo', 'pt-br': 'Abrir a furação em 3D interativo',
  pl: 'Otwórz rozstaw śrub w interaktywnym 3D', nl: 'Steekmaat interactief in 3D openen', tr: 'Bijon aralığını etkileşimli 3B görünümde açın',
};
const load3d = isReferenceLocale(locale) ? referenceChromeText[locale].load3d : LOAD_3D_LABELS[locale];
const vehicles = vehiclesForBoltPattern(entry.notation);
const spacingMm = adjacentHoleSpacingMm(entry.pcdMm, entry.lugCount);
const spacingValue = `${formatDecimal(spacingMm, 2, locale)} mm`;
const bores = distinctCenterBores(vehicles);
const singleCenterBore = bores.length === 1 ? bores[0] : undefined;
const relatedTires = tireSizesForBoltPattern(entry.notation);
const hubHref = entityHubPath('bolt-pattern', locale);
const tireHubHref = entityHubPath('tire-size', locale);
const faqs = t.faqs({ notation: entry.notation, lugs: entry.lugCount, pcd: entry.pcdMm, vehicles: vehicles.length, makes: vehicleNames(vehicles) });
const heading = splitHeadingAroundKey(t.detailH1(entry.notation), entry.notation);

// The discrete bores actually present, not a min–max range: "57.1 / 66.5 / 66.6 mm" is true,
// "57.1–66.6 mm" would claim every bore in between is a real fitment on this pattern.
const boreLabel = formatCenterBores(bores, locale);
const metricRows = [
  { label: t.metrics.lugCount, value: String(entry.lugCount) },
  { label: t.metrics.pcdMm, value: `${formatPlain(entry.pcdMm, locale)} mm` },
  { label: t.metrics.pcdIn, value: `${formatDecimal(millimetersToInches(entry.pcdMm), 3, locale)}″` },
  { label: t.metrics.holeSpacing, value: spacingValue },
  { label: t.metrics.vehicleCount, value: String(vehicles.length) },
  { label: t.metrics.centerBore, value: boreLabel },
];
const decisions = boltDecisionGraph(entry, locale);
const usedBy = makesUsingPattern(entry.notation);
const makeText = boltMakeText[locale];
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href={homePath(locale)}>{t.breadcrumbHome}</a><span aria-hidden="true">/</span>
  <a href={hubHref}>{t.breadcrumbHub}</a><span aria-hidden="true">/</span>
  <span aria-current="page">{entry.notation}</span>
</nav>

<header class="entity-hero">
  <p class="eyebrow">{t.detailKicker}</p>
  <h1 class="entity-hero__title">{heading.before}<span class="entity-hero__key">{heading.key}</span>{heading.after}</h1>
  <dl class="entity-answer">
    {metricRows.slice(0, 4).map((row) => <div class="entity-answer__item"><dt>{row.label}</dt><dd><strong>{row.value}</strong></dd></div>)}
  </dl>
  <p class="entity-hero__lead">{t.detailLead(entry.lugCount, entry.pcdMm)}</p>
  <nav class="entity-pagenav" aria-label={t.metricsHeading}>
    <a href="#entity-metrics">{t.metricsHeading}</a>
    <a href="#entity-vehicles">{t.vehiclesHeading}</a>
    <a href="#entity-diagram">{t.diagramHeading}</a>
    <a href="#entity-faq">{t.faqHeading}</a>
  </nav>
</header>

<section class="entity-section" aria-labelledby="entity-metrics">
  <h2 id="entity-metrics">{t.metricsHeading}</h2>
  <table class="entity-spec entity-spec--two">
    <tbody>
      {metricRows.map((row) => <tr><th scope="row">{row.label}</th><td class="entity-spec__wrap">{row.value}</td></tr>)}
    </tbody>
  </table>
  <p class="entity-note">{t.metricNote} {t.holeSpacingNote}</p>
</section>


<section class="entity-section" aria-labelledby="entity-vehicles">
  <h2 id="entity-vehicles">{t.vehiclesHeading}</h2>
  {vehicles.length === 0 ? (
    <p class="entity-empty">{t.vehiclesEmpty}</p>
  ) : (
    <>
      <p class="entity-note">{t.vehiclesIntro(vehicles.length)}</p>
      <div class="entity-table-scroll">
        <table class="entity-table">
          <thead><tr>
            <th scope="col">{t.colVehicle}</th><th scope="col">{t.colTireSize}</th><th scope="col">{t.colCenterBore}</th>
            <th scope="col" class="is-optional">{t.colWheel}</th><th scope="col">{t.colTorque}</th><th scope="col" class="is-optional">{t.colFastener}</th>
            <th scope="col" class="is-optional">{t.colConfidence}</th>
          </tr></thead>
          <tbody>
            {vehicles.map((vehicle) => {
              const link = vehicleLink(vehicle, locale);
              // Torque is the one safety-critical number in this table, so a low-confidence or
              // explicitly extrapolated figure is muted and marked rather than shown as if it
              // carried the same weight as a manual-sourced one.
              const torque = torquePresentation(vehicle, locale);
              return (
                <tr>
                  <th scope="row"><a href={link.href} hreflang={link.crossLocale ? link.locale : undefined}>{vehicle.make} {vehicle.model}</a></th>
                  <td><a href={entityDetailPath('tire-size', locale, tireSizeSlug(vehicle.tireSize))}>{displayTireNotation(vehicle.tireSize, locale)}</a></td>
                  <td>{vehicle.centerBoreMm === undefined ? '—' : `${formatPlain(vehicle.centerBoreMm, locale)} mm`}</td>
                  <td class="is-optional">{vehicle.wheelSize}</td>
                  <td class={torque.qualified ? 'entity-soft' : undefined} title={torque.qualifier ?? undefined}>
                    {torque.value}
                    {torque.qualified && <abbr class="entity-soft__mark" title={torque.qualifier ?? t.torqueUnconfirmedTitle}>*</abbr>}
                  </td>
                  <td class="is-optional">{vehicle.fastenerType === 'lug-nut' ? t.lugNut : t.wheelBolt}</td>
                  <td class="is-optional"><span class={`entity-confidence entity-confidence--${vehicle.confidence}`}>{t.confidence[vehicle.confidence]}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="entity-note">{t.confidenceNote}</p>
    </>
  )}
</section>

{usedBy.length > 0 && (
  <section class="entity-section" aria-labelledby="entity-usedby">
    <h2 id="entity-usedby">{makeText.usedByHeading(entry.notation)}</h2>
    <p class="entity-note">{makeText.usedByIntro}</p>
    <ul class="entity-makelist">
      {usedBy.slice(0, 40).map((item) => <li><a href={boltMakePath(locale, item.make.makeSlug)}><strong>{item.make.make}</strong></a> <span>{item.models.slice(0, 12).join(', ')}{item.models.length > 12 ? ' …' : ''}</span></li>)}
    </ul>
  </section>
)}

<section class="entity-section" aria-labelledby="entity-diagram">
  <h2 id="entity-diagram">{t.diagramHeading}</h2>
  <BoltPatternDiagram
    entry={entry}
    ariaLabel={t.diagramAria(entry.lugCount, entry.pcdMm)}
    pcdLabel={t.pcdLabel}
    pcdText={`${formatPlain(entry.pcdMm, locale)} mm`}
    spacingLabel={t.metrics.holeSpacing}
    spacingValue={spacingValue}
  />
  <details class="visual-on-demand">
    <summary>{load3d}</summary>
    <Parametric3DPanel mode="pcd" locale={toolLocaleFor(locale)} lugCount={entry.lugCount} pcdMm={entry.pcdMm} centerBoreMm={singleCenterBore} />
  </details>
  <p class="entity-note">{t.diagramNote(entry.lugCount, entry.pcdMm)}</p>
</section>

<section class="entity-section entity-section--warn" aria-labelledby="entity-safety">
  <h2 id="entity-safety">{t.safetyHeading}</h2>
  <p class="entity-caveat"><strong>⚠</strong> {t.safetyLead}</p>
  <ul class="entity-factors">
    {t.safetyFactors.map((factor) => <li><strong>{factor.label}</strong><span>{factor.detail}</span></li>)}
  </ul>
  <p class="entity-note">{t.safetyClose}</p>
</section>

<DecisionGraph model={decisions} {locale} id="bolt-decisions" />

<section class="entity-section" aria-labelledby="entity-related">
  <h2 id="entity-related">{t.relatedHeading}</h2>
  <div class="entity-links">
    <a class="entity-link-card" href={hubHref}><strong>{t.backToHub}</strong><span>{t.hubKicker}</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href={vehicleHubPath(locale)}><strong>{t.vehiclesCta}</strong><span>{t.vehiclesCtaDetail}</span><i aria-hidden="true">›</i></a>
    <a class="entity-link-card" href={tireHubHref}><strong>{t.tireHubCta}</strong><span>{t.tireHubCtaDetail}</span><i aria-hidden="true">›</i></a>
  </div>
  {relatedTires.length > 0 && (
    <>
      <p class="entity-note">{t.relatedTireIntro}</p>
      <ul class="entity-chiplist">
        {relatedTires.map((tire) => <li><a class="entity-chip" href={entityDetailPath('tire-size', locale, tire.slug)}>{displayTireNotation(tire.notation, locale)}</a></li>)}
      </ul>
    </>
  )}
</section>

<section class="entity-section" aria-labelledby="entity-faq">
  <h2 id="entity-faq">{t.faqHeading}</h2>
  {faqs.map((faq) => <details class="entity-faq"><summary>{faq.q}</summary><p>{faq.a}</p></details>)}
</section>

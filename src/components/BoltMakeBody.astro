---
// Bolt pattern chart for one make, in every entity locale (ANKUSI open wheel fitment data).
import { boltMakeText } from '../content/bolt-make-text';
import { boltPatternPageText } from '../content/entity-page-text';
import { ANKUSI_SOURCE, carMakePath, carModelPath } from '../data/cars';
import { boltPatternCatalog } from '../data/bolt-pattern-catalog';
import { entityDetailPath, entityHubPath, type EntityLocale } from '../seo/entity-routes';
import { homePath } from '../ui/entity-page-model';
import { formatPlain } from '../ui/locale-format';
import { wheelText } from '../ui/car-pages';
import type { BoltMake } from '../ui/bolt-make';

interface Props { readonly make: BoltMake; readonly locale: EntityLocale; }
const { make, locale } = Astro.props;
const t = boltMakeText[locale];
const b = boltPatternPageText[locale];
const known = new Map(boltPatternCatalog.map((entry) => [entry.notation, entry.slug]));
const pcdLink = (pcd: string): string | undefined => { const slug = known.get(pcd); return slug ? entityDetailPath('bolt-pattern', locale, slug) : undefined; };
const linkModel = locale === 'en';
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href={homePath(locale)}>{b.breadcrumbHome}</a><span aria-hidden="true">/</span>
  <a href={entityHubPath('bolt-pattern', locale)}>{b.breadcrumbHub}</a><span aria-hidden="true">/</span>
  <span aria-current="page">{make.make}</span>
</nav>
<header class="entity-hero">
  <p class="eyebrow">{t.kicker}</p>
  <h1 class="entity-hero__title">{t.h1(make.make)}</h1>
  <p class="entity-hero__lead">{t.lead(make.make, make.rows.length)}</p>
  {make.top.length > 0 && (
    <>
      <p class="entity-note">{t.topHeading}:</p>
      <ul class="entity-chiplist">
        {make.top.map((pcd) => { const href = pcdLink(pcd); return <li>{href ? <a class="entity-chip" href={href}>{pcd}</a> : <span class="entity-chip">{pcd}</span>}</li>; })}
      </ul>
    </>
  )}
</header>
<section class="entity-section" aria-labelledby="make-table">
  <h2 id="make-table">{t.tableHeading(make.make)}</h2>
  <div class="entity-table-scroll">
    <table class="entity-table">
      <thead><tr><th scope="col">{t.cols.model}</th><th scope="col" class="is-optional">{t.cols.years}</th><th scope="col">{t.cols.pcd}</th><th scope="col">{t.cols.bore}</th><th scope="col" class="is-optional">{t.cols.factory}</th><th scope="col" class="is-optional">{t.cols.max}</th></tr></thead>
      <tbody>
        {make.rows.map((row) => (
          <tr>
            <th scope="row">{linkModel ? <a href={carModelPath(row.model)}>{row.model.model}</a> : row.model.model}</th>
            <td class="is-optional">{row.years}</td>
            <td>{row.pcds.map((pcd, i) => { const href = pcdLink(pcd); return <>{i > 0 && ', '}{href ? <a href={href}>{pcd}</a> : pcd}</>; })}</td>
            <td>{row.bores.length ? row.bores.slice(0, 2).map((bore) => `${formatPlain(bore, locale)} mm`).join(' / ') : '—'}</td>
            <td class="is-optional">{wheelText(row.factory)}</td>
            <td class="is-optional">{wheelText(row.max)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="entity-note">{t.note}</p>
  <p class="entity-note">{t.source}: <a href={ANKUSI_SOURCE.url} rel="noopener">{ANKUSI_SOURCE.name}</a> · <a href={carMakePath(make.makeSlug)} hreflang={locale === 'en' ? undefined : 'en'}>{t.mpgLink(make.make)}</a></p>
</section>

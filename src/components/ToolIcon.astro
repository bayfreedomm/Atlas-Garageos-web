---
import type { ToolCategory, ToolId } from '../seo/tool-registry';
interface Props { id: ToolId | 'all-tools' | 'garage'; category?: ToolCategory | 'Advanced'; }
const { id, category = 'Advanced' } = Astro.props;
---
<span class:list={['tool-icon', `tool-icon--${category.toLowerCase().replaceAll(' & ', '-').replaceAll(' ', '-')}`]} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" focusable="false">
    {id === 'fuel-cost-calculator' && <><path d="M6 20V5.5A1.5 1.5 0 0 1 7.5 4h6A1.5 1.5 0 0 1 15 5.5V20M5 20h11M8 7h5v4H8z"/><path d="M15 8h2l2 2v6.5a1.5 1.5 0 0 0 3 0V11l-2-2"/></>}
    {id === 'road-trip-cost-calculator' && <><circle cx="6" cy="17" r="2"/><circle cx="18" cy="7" r="2"/><path d="M7.5 15.5c2.5-3 6.5-1 8.8-6.8M5 8c0-2 1.5-3.5 3.5-3.5S12 6 12 8c0 2.5-3.5 5-3.5 5S5 10.5 5 8Z"/></>}
    {id === 'ev-charging-cost-calculator' && <><rect x="4" y="7" width="14" height="10" rx="2"/><rect x="18" y="10" width="2" height="4" rx="1"/><path d="M13 9.5 9.5 13H12l-1.5 3.5L14 13h-2.5z"/></>}
    {id === 'tire-size-calculator' && <><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><path d="M12 8v8M8 12h8"/></>}
    {id === 'tire-size-comparison' && <><circle cx="9" cy="12" r="6"/><circle cx="16" cy="12" r="4"/><path d="M9 6v12M16 8v8"/></>}
    {id === 'wheel-offset-calculator' && <><circle cx="10" cy="12" r="7"/><circle cx="10" cy="12" r="3"/><path d="M17 7v10M18 12h4M20 10l2 2-2 2"/></>}
    {id === 'speedometer-error-calculator' && <><path d="M4 17a8 8 0 1 1 16 0M12 17l4-5"/><path d="M7 17h10"/></>}
    {id === 'gear-ratio-calculator' && <><circle cx="8" cy="12" r="4"/><circle cx="17" cy="12" r="3"/><path d="M8 6V4M8 20v-2M2 12h2M12 12h2M17 7V5M17 19v-2M14.5 8.5l-2-2M19.5 15.5l2 2"/><circle cx="8" cy="12" r="1"/><circle cx="17" cy="12" r="1"/></>}
    {id === 'fitment-map' && <><path d="M5 4v16M19 4v16M5 7h14M5 17h14M9.5 7v10M14.5 7v10"/><circle cx="14.5" cy="12" r="2.2"/></>}
    {id === 'measure-my-car' && <><path d="M3 16h18l-2-5-3-2H8l-3 2-2 5ZM7 16v2M17 16v2"/><circle cx="8" cy="16" r="2"/><circle cx="16" cy="16" r="2"/><path d="M5 5h14M5 5l2-2M5 5l2 2M19 5l-2-2M19 5l-2 2"/></>}
    {id === 'mpg-l100km-converter' && <><path d="M6 20V5h8v15M8 8h4"/><path d="M16 8h3M17.5 6.5 19 8l-1.5 1.5M20 15h-3M18.5 13.5 17 15l1.5 1.5"/></>}
    {id === 'psi-bar-converter' && <><path d="M5 16a7 7 0 1 1 14 0M12 16l4-5"/><path d="M8 19h8M12 7v2"/></>}
    {id === 'hp-kw-converter' && <><path d="m13 2-7 11h6l-1 9 7-12h-6z"/></>}
    {id === 'nm-lb-ft-converter' && <><path d="M18 8a7 7 0 1 0 1 7M18 8h-5M18 8v-5"/><circle cx="12" cy="12" r="2"/></>}
    {id === 'power-to-weight-calculator' && <><path d="M4 18h16M12 5v13M7 8h10M5 8l-3 6h6L5 8ZM19 8l-3 6h6l-3-6Z"/><path d="m13 2-3 5h3l-1 4 4-6h-3V2"/></>}
    {id === 'bolt-pattern-calculator' && <><circle cx="12" cy="12" r="9"/><circle cx="12" cy="7" r="1.4"/><circle cx="16.3" cy="9.5" r="1.4"/><circle cx="16.3" cy="14.5" r="1.4"/><circle cx="12" cy="17" r="1.4"/><circle cx="7.7" cy="14.5" r="1.4"/><circle cx="7.7" cy="9.5" r="1.4"/></>}
    {id === 'tire-load-speed-rating' && <><rect x="3.5" y="6" width="17" height="12" rx="2"/><path d="M7 6v12M11 9h6M11 12h6M11 15h4"/></>}
    {id === 'tire-date-code-decoder' && <><circle cx="12" cy="12" r="8"/><path d="M9 10h6M9 13h4"/><path d="M15.5 15.5 18 18"/></>}
    {id === 'towing-capacity-calculator' && <><rect x="2" y="10" width="9" height="6" rx="1"/><path d="M11 12h3l3 2v2h-6"/><circle cx="5" cy="17.5" r="1.4"/><circle cx="16.5" cy="17.5" r="1.4"/><path d="M14 12V9a1 1 0 0 1 1-1h2.2a1 1 0 0 1 .8.4l2 2.6"/></>}
    {id === 'quarter-mile-calculator' && <><path d="M4 20 15 4M9 20 20 4"/><path d="M4 12h4M12 12h4" stroke-dasharray="1 3"/></>}
    {id === 'compression-ratio-calculator' && <><rect x="8" y="3" width="8" height="7" rx="1"/><path d="M9 10v3a3 3 0 0 0 3 3 3 3 0 0 0 3-3v-3"/><path d="M12 16v5M9 21h6"/></>}
    {id === 'vehicle-fitment-finder' && <><path d="M4 15h16l-1.5-5-2.5-2H8L5.5 10 4 15Z"/><circle cx="8" cy="16.5" r="1.6"/><circle cx="16" cy="16.5" r="1.6"/><circle cx="18" cy="7" r="4"/><path d="m21 10 2 2"/></>}
    {id === 'fitment-studio' && <><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="3"/><path d="M3 12h4M17 12h4M12 3v4M12 17v4"/></>}
    {id === 'garage' && <><path d="m3 10 9-6 9 6v10H3zM7 20v-7h10v7"/><path d="M9 16h6"/></>}
    {id === 'all-tools' && <><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></>}
  </svg>
</span>

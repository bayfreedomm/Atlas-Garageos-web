---
// Under every calculator: "Download PDF report" (always, no gate) and, once the email backend is
// configured (src/config/lead-capture.ts), "Email me this report" with an optional double
// opt-in list checkbox. Behaviour: src/ui/report-actions.ts. Endpoint: src/worker/index.ts.
import { reportCaptureText } from '../content/report-capture-text';
import { EMAIL_REPORTS_ENABLED } from '../config/lead-capture';
import type { AtlasLocale } from '../localization/locales';

interface Props { readonly locale: AtlasLocale; readonly title: string }
const { locale, title } = Astro.props;
const t = reportCaptureText[locale];
const privacyHref = locale === 'en' ? '/privacy-policy/' : `/${locale}/privacy-policy/`;
const messages = { sending: t.sending, sent: t.sent, sentConfirm: t.sentConfirm, errorInvalid: t.errorInvalid, errorRate: t.errorRate, errorUnavailable: t.errorUnavailable, errorGeneric: t.errorGeneric, send: t.send };
---
<section class="report-actions" data-report-actions data-report-locale={locale} data-report-messages={JSON.stringify(messages)} aria-label={t.printTitle}>
  <div class="report-actions__row">
    <button type="button" class="report-actions__button" data-report-pdf>
      <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 14.5V16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>{t.pdf}</span>
    </button>
    {EMAIL_REPORTS_ENABLED && (
      <button type="button" class="report-actions__button" data-report-email-toggle aria-expanded="false" aria-controls="report-email-form">
        <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M3.5 5.5h13v9h-13zM3.5 6l6.5 5 6.5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        <span>{t.email}</span>
      </button>
    )}
  </div>
  {EMAIL_REPORTS_ENABLED && (
    <form class="report-actions__form" id="report-email-form" data-report-email novalidate hidden>
      <label class="report-actions__field"><span>{t.emailLabel}</span><input type="email" name="email" autocomplete="email" inputmode="email" required maxlength="254" placeholder={t.emailPlaceholder} /></label>
      <div class="report-actions__hp" aria-hidden="true"><label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>
      <label class="report-actions__check"><input type="checkbox" name="subscribe" value="1" /><span>{t.subscribe}</span></label>
      <p class="report-actions__privacy">{t.privacy} <a href={privacyHref}>{t.privacyLink}</a></p>
      <div class="report-actions__submit"><button type="submit" class="report-actions__send">{t.send}</button><p class="report-actions__status" data-report-status role="status" aria-live="polite"></p></div>
    </form>
  )}
  <div class="report-print-header" data-report-print aria-hidden="true">
    <p class="report-print-header__brand">Atlas GarageOS · {t.printTitle}</p>
    <p class="report-print-header__title">{title}</p>
    <p class="report-print-header__meta"><span>{t.printCreated}: <span data-report-print-date></span></span></p>
    <p class="report-print-header__url"><span>{t.printReopen}:</span> <span data-report-print-url></span></p>
  </div>
</section>
<script>
  import { initializeReportActions } from '../ui/report-actions';
  initializeReportActions();
</script>

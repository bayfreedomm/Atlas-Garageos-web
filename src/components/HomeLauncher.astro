---
import ToolIcon from './ToolIcon.astro';
import { routeForTool, toolRegistry, type ToolId } from '../seo/tool-registry';
import { localizedTool, platformCatalog, type ContentLocale } from '../localization/site-catalog';
import { localizedToolPath, type AtlasLocale } from '../localization/locales';
import fuelPrices from '../data/fuel-prices.json';
import { normalizeFuelStatus } from '../data/fuel-prices-types';
import { referenceCopy, referenceLinks, tireSizeShortcuts } from '../ui/reference-links';
import TireSizeLookup from './TireSizeLookup.astro';

// The hero capability badges (Tires & wheels / Fuel & trips / EV tools /
// Performance) must route to a real, already-existing destination. Three of
// them are real tool categories (the same English category strings used by
// the Tools-page filter buttons and by ?category= on /tools/), so they reuse
// that existing filter mechanism. There is no dedicated "EV tools" category
// in the registry (EV charging lives under Fuel & Trips), so rather than
// invent a thin category page for it, it links straight to the EV Charging
// Cost Calculator tool page — the single most appropriate existing page.

interface Props { locale?: ContentLocale | undefined; }
const { locale } = Astro.props;
const entityLocale = locale ?? 'en';
const reference = referenceLinks(entityLocale);
const refCopy = referenceCopy(entityLocale);
const shortcuts = tireSizeShortcuts(entityLocale);
const homeChrome = {
  en: { search: 'Search automotive tools', empty: 'No matching tool. Try a simpler word.', findAria: 'Find a calculator', categoriesAria: 'Tool categories', obdBadge: 'ATLAS DIAGNOSTICS', obdTitle: 'OBD-II Code Lookup', obdCopy: 'Enter a scanner code, understand what the monitor detected, and see what to check before replacing a part.' },
  de: { search: 'Kfz-Werkzeuge durchsuchen', empty: 'Kein passendes Werkzeug. Versuchen Sie ein einfacheres Wort.', findAria: 'Rechner finden', categoriesAria: 'Werkzeugkategorien', obdBadge: 'ATLAS DIAGNOSE · ENGLISCH', obdTitle: 'OBD-II-Fehlercodes nachschlagen', obdCopy: 'Code aus dem Diagnosegerät eingeben, verstehen, was erkannt wurde, und sehen, was vor einem Teiletausch zu prüfen ist (Inhalte auf Englisch).' },
  es: { search: 'Buscar herramientas', empty: 'Ninguna herramienta coincide. Pruebe con una palabra más sencilla.', findAria: 'Buscar una calculadora', categoriesAria: 'Categorías de herramientas', obdBadge: 'ATLAS DIAGNÓSTICO · INGLÉS', obdTitle: 'Consulta de códigos OBD-II', obdCopy: 'Introduzca el código del escáner, entienda qué detectó el sistema y vea qué comprobar antes de cambiar una pieza (contenido en inglés).' },
  fr: { search: 'Rechercher un outil auto', empty: 'Aucun outil ne correspond. Essayez un mot plus simple.', findAria: 'Trouver un calculateur', categoriesAria: 'Catégories d’outils', obdBadge: 'ATLAS DIAGNOSTIC · ANGLAIS', obdTitle: 'Recherche de codes OBD-II', obdCopy: 'Saisissez le code lu par la valise, comprenez ce que le système a détecté et voyez quoi vérifier avant de remplacer une pièce (contenu en anglais).' },
  it: { search: 'Cerca strumenti auto', empty: 'Nessuno strumento trovato. Prova con una parola più semplice.', findAria: 'Trova un calcolatore', categoriesAria: 'Categorie di strumenti', obdBadge: 'ATLAS DIAGNOSTICA · INGLESE', obdTitle: 'Ricerca codici OBD-II', obdCopy: 'Inserisci il codice letto dallo scanner, capisci cosa ha rilevato il sistema e scopri cosa controllare prima di sostituire un pezzo (contenuti in inglese).' },
  'pt-br': { search: 'Buscar ferramentas automotivas', empty: 'Nenhuma ferramenta encontrada. Tente uma palavra mais simples.', findAria: 'Encontrar uma calculadora', categoriesAria: 'Categorias de ferramentas', obdBadge: 'ATLAS DIAGNÓSTICO · INGLÊS', obdTitle: 'Consulta de códigos OBD-II', obdCopy: 'Digite o código do scanner, entenda o que o sistema detectou e veja o que verificar antes de trocar uma peça (conteúdo em inglês).' },
  pl: { search: 'Szukaj narzędzi motoryzacyjnych', empty: 'Brak pasujących narzędzi. Wpisz prostsze słowo.', findAria: 'Znajdź kalkulator', categoriesAria: 'Kategorie narzędzi', obdBadge: 'ATLAS DIAGNOSTYKA · PO ANGIELSKU', obdTitle: 'Wyszukiwarka kodów OBD-II', obdCopy: 'Wpisz kod z testera, sprawdź, co wykrył system, i dowiedz się, co skontrolować przed wymianą części (treści po angielsku).' },
  nl: { search: 'Autotools zoeken', empty: 'Geen passende tool gevonden. Probeer een eenvoudiger woord.', findAria: 'Zoek een calculator', categoriesAria: 'Toolcategorieën', obdBadge: 'ATLAS DIAGNOSE · ENGELS', obdTitle: 'OBD-II-codes opzoeken', obdCopy: 'Vul de code van je uitleesapparaat in, begrijp wat het systeem heeft gedetecteerd en zie wat je moet controleren voordat je een onderdeel vervangt (inhoud in het Engels).' },
  tr: { search: 'Otomotiv araçlarında arayın', empty: 'Eşleşen araç bulunamadı. Daha basit bir kelime deneyin.', findAria: 'Hesaplayıcı bulun', categoriesAria: 'Araç kategorileri', obdBadge: 'ATLAS ARIZA TEŞHİSİ · İNGİLİZCE', obdTitle: 'OBD-II Arıza Kodu Sorgulama', obdCopy: 'Arıza tespit cihazındaki kodu girin, sistemin neyi algıladığını anlayın ve parça değiştirmeden önce neleri kontrol etmeniz gerektiğini görün (içerik İngilizce).' },
}[entityLocale];
const prefix = locale ? `/${locale}` : '';
const home = locale ? platformCatalog[locale].home : undefined;

const tools = toolRegistry.filter(({ kind }) => kind === 'tool');
const popularIds: readonly ToolId[] = [
  'fuel-cost-calculator',
  'tire-size-calculator',
  'tire-fit-check',
  'road-trip-cost-calculator',
  'wheel-offset-calculator',
  'psi-bar-converter',
  'mpg-l100km-converter',
  'power-to-weight-calculator',
];
const ordered = [
  ...popularIds.map((id) => tools.find((tool) => tool.id === id)!),
  ...tools.filter((tool) => !popularIds.includes(tool.id)),
];
const shortNames = new Map<ToolId, string>([
  ['fuel-cost-calculator', 'Fuel cost'],
  ['tire-size-calculator', 'Tire size'],
  ['road-trip-cost-calculator', 'Road trip cost'],
  ['wheel-offset-calculator', 'Wheel offset'],
  ['psi-bar-converter', 'PSI ↔ Bar'],
  ['mpg-l100km-converter', 'MPG ↔ L/100km'],
  ['power-to-weight-calculator', 'Power-to-weight'],
  ['tire-size-comparison', 'Tire size comparison'],
  ['tire-fit-check', 'Can I fit this tire?'],
  ['speedometer-error-calculator', 'Speedometer error'],
  ['gear-ratio-calculator', 'Gear ratio'],
  ['fitment-map', 'Fitment map'],
  ['measure-my-car', 'Measure my car'],
  ['hp-kw-converter', 'HP ↔ kW'],
  ['nm-lb-ft-converter', 'Nm ↔ lb-ft'],
  ['ev-charging-cost-calculator', 'EV charging cost'],
]);
const helper = new Map<ToolId, string>([
  ['fuel-cost-calculator', 'Distance, consumption and fuel price'],
  ['tire-size-calculator', 'Diameter, sidewall and circumference'],
  ['tire-fit-check', 'Every check for a size change, on one page'],
  ['road-trip-cost-calculator', 'Fuel, extras and cost per traveller'],
  ['wheel-offset-calculator', 'Inner clearance and outer position'],
  ['psi-bar-converter', 'Pressure in PSI, bar and kPa'],
  ['mpg-l100km-converter', 'US MPG, Imperial MPG and L/100km'],
  ['power-to-weight-calculator', 'Power relative to vehicle weight'],
]);
const fuelPricesPath = locale === 'de' ? '/de/kraftstoffpreise/' : locale === 'es' ? '/es/precio-gasolina-hoy/' : '/gas-prices-today/';
// The homepage badge links to a single most-relevant market per locale: the US weekly EIA
// average for the English site, Spain's official national dataset for the Spanish site, and
// for the German site the Atlas monitored city sample — which is never called a national
// average or a live board, because it is neither. The US figure is genuinely weekly, so its
// badge never uses "live" wording either; only the dot color reflects whether the latest
// refresh actually succeeded.
const fuelStatus = normalizeFuelStatus(locale === 'de' ? fuelPrices.de.status : locale === 'es' ? fuelPrices.es.status : fuelPrices.us.status);
const FUEL_BADGE_TEXT: Record<AtlasLocale, Record<'pending' | 'fresh' | 'stale', string>> = {
  en: { pending: 'WEEKLY FUEL DATA — AWAITING FIRST UPDATE', fresh: 'WEEKLY FUEL DATA', stale: 'WEEKLY FUEL DATA — LAST KNOWN PRICE' },
  de: { pending: 'KRAFTSTOFFDATEN AUSSTEHEND', fresh: 'BEOBACHTETE STICHPROBE', stale: 'LETZTER BESTÄTIGTER PREIS' },
  es: { pending: 'DATOS PENDIENTES', fresh: 'MEDIA NACIONAL OFICIAL', stale: 'ÚLTIMO PRECIO VERIFICADO' },
  fr: { pending: 'DONNÉES CARBURANT US — EN ATTENTE (ANGLAIS)', fresh: 'PRIX HEBDOMADAIRES AUX ÉTATS-UNIS (ANGLAIS)', stale: 'ÉTATS-UNIS — DERNIER PRIX CONNU (ANGLAIS)' },
  it: { pending: 'DATI CARBURANTE USA — IN ATTESA (INGLESE)', fresh: 'PREZZI SETTIMANALI NEGLI USA (INGLESE)', stale: 'USA — ULTIMO PREZZO NOTO (INGLESE)' },
  'pt-br': { pending: 'DADOS DE COMBUSTÍVEL DOS EUA — AGUARDANDO (INGLÊS)', fresh: 'PREÇOS SEMANAIS NOS EUA (INGLÊS)', stale: 'EUA — ÚLTIMO PREÇO CONHECIDO (INGLÊS)' },
  pl: { pending: 'DANE O PALIWIE Z USA — OCZEKIWANIE (PO ANGIELSKU)', fresh: 'TYGODNIOWE CENY W USA (PO ANGIELSKU)', stale: 'USA — OSTATNIA ZNANA CENA (PO ANGIELSKU)' },
  nl: { pending: 'BRANDSTOFDATA VS — IN AFWACHTING (ENGELS)', fresh: 'WEKELIJKSE PRIJZEN IN DE VS (ENGELS)', stale: 'VS — LAATST BEKENDE PRIJS (ENGELS)' },
  tr: { pending: 'ABD YAKIT VERİSİ — BEKLENİYOR (İNGİLİZCE)', fresh: 'ABD HAFTALIK YAKIT FİYATLARI (İNGİLİZCE)', stale: 'ABD — SON BİLİNEN FİYAT (İNGİLİZCE)' },
};
const fuelBadgeText = FUEL_BADGE_TEXT[locale ?? 'en'][fuelStatus];
const fuelBadgeModifier = fuelStatus === 'pending' ? 'home-fuel-feature__badge--pending' : fuelStatus === 'stale' ? 'home-fuel-feature__badge--stale' : '';
const evChargingTool = tools.find((tool) => tool.id === 'ev-charging-cost-calculator')!;
const evChargingHref = locale ? localizedToolPath(locale, evChargingTool.id, 'tool') : routeForTool(evChargingTool);
const heroCapabilities = [
  { key: 'tires', icon: '◉', label: home?.capTires ?? 'Tires & wheels', href: `${prefix}/tools/?category=${encodeURIComponent('Tires & Wheels')}` },
  { key: 'fuel', icon: '▰', label: home?.capFuel ?? 'Fuel & trips', href: `${prefix}/tools/?category=${encodeURIComponent('Fuel & Trips')}` },
  { key: 'ev', icon: '⚡', label: home?.capEv ?? 'EV tools', href: evChargingHref },
  { key: 'performance', icon: '⌁', label: home?.capPerformance ?? 'Performance', href: `${prefix}/tools/?category=${encodeURIComponent('Performance')}` },
] as const;
const categories = home
  ? home.categories.map((c) => [c.name, c.copy] as const)
  : ([
      ['Fuel & Trips', 'Fuel cost, road trips and EV charging'],
      ['Tires & Wheels', 'Tire sizes, wheel offset and geometry'],
      ['Converters', 'Pressure, economy, power and torque'],
      ['Performance', 'Power-to-weight and gearing'],
    ] as const);
---
<section class="home-launcher home-launcher--v4" data-toolbox data-mode="home" aria-labelledby="home-heading">
  <section class="home-v4-hero home-v7-hero">
    <div class="home-v7-media" aria-hidden="true">
      <img src="/atlas-hero-car.webp" alt="" width="1672" height="941" loading="eager" decoding="async" fetchpriority="high" />
    </div>

    <div class="home-v4-copy home-v7-copy">
      <p class="home-kicker">{home?.kicker ?? 'GARAGE TOOLS FOR REAL DRIVERS'}</p>
      <h1 id="home-heading">{home?.h1 ?? 'Smarter tools for every drive.'}</h1>
      <p class="home-lead">{home?.lead ?? 'Calculate tire fitment, wheel offset, fuel cost, road trips and EV charging with clear answers built for real-world ownership.'}</p>

      <TireSizeLookup locale={entityLocale} id="tire-lookup-home" variant="hero" />
      <div class="home-v7-actions" aria-label="Primary actions">
        <a class="home-v7-cta home-v7-cta--primary" href={`${prefix}/tools/`}>{home?.ctaExplore ?? 'Explore tools'} <span aria-hidden="true">→</span></a>
        <a class="home-v7-cta home-v7-cta--secondary" href={`${prefix}/fitment-studio/`}>{home?.ctaCompare ?? 'Compare fitment'}</a>
      </div>

      <nav class="home-v7-capabilities" aria-label="Tool families">
        {heroCapabilities.map((cap) => (
          <a href={cap.href} aria-label={cap.label}>
            <span aria-hidden="true">{cap.icon}</span><strong>{cap.label}</strong>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="home-v4-surface">
    <section class="home-v7-search-panel" aria-label={homeChrome.findAria}>
      <div><p>{home?.findToolLabel ?? 'FIND A TOOL'}</p><h2>{home?.findToolQuestion ?? 'What do you want to calculate?'}</h2></div>
      <form class="home-search" data-tool-search-form>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg>
        <label class="sr-only" for="tool-search-home">{homeChrome.search}</label>
        <input id="tool-search-home" type="search" placeholder={home?.searchPlaceholder ?? 'Tire size, fuel cost, wheel offset...'} autocomplete="off" data-tool-search />
        <button type="submit">{home?.searchButton ?? 'Find'}</button>
      </form>
    </section>
    <div class="home-category-grid" aria-label={homeChrome.categoriesAria}>
      {categories.map(([name, copy]) => (
        <a href={`${prefix}/tools/?category=${encodeURIComponent(name)}`}>
          <span>{name}</span><small>{copy}</small><i aria-hidden="true">›</i>
        </a>
      ))}
    </div>

    <section class="home-popular" aria-labelledby="popular-heading">
      <div class="home-section-heading"><div><p>{home?.popularLabel ?? 'POPULAR TOOLS'}</p><h2 id="popular-heading">{home?.popularHeading ?? 'Start with a job'}</h2></div><a href={`${prefix}/tools/`}>{home?.seeAll ?? 'See all'} <span aria-hidden="true">→</span></a></div>
      <div class="tool-launch-list" data-tool-rows>
        {ordered.map((tool) => { const label = locale ? localizedTool(tool.id, locale) : undefined; const href = locale ? localizedToolPath(locale, tool.id, 'tool') : routeForTool(tool); const displayTitle = label?.title ?? shortNames.get(tool.id) ?? tool.title; const displayHelper = label?.intro ?? helper.get(tool.id); return (
        <a class:list={['tool-launch-row', { 'is-secondary': !popularIds.includes(tool.id) }]} href={href} data-tool-row data-tool-category-name={tool.category} data-tool-search-text={`${label?.title ?? tool.title} ${label?.description ?? tool.description} ${tool.id} ${shortNames.get(tool.id) ?? ''}`.toLowerCase()} data-popular={popularIds.includes(tool.id) ? 'true' : 'false'}>
          <ToolIcon id={tool.id} category={tool.category}/><span><strong>{displayTitle}</strong>{displayHelper && <small>{displayHelper}</small>}</span><i aria-hidden="true">›</i>
        </a>); })}
      </div>
      <p class="toolbox-empty" data-tool-empty hidden>{homeChrome.empty}</p>
    </section>

    <section class="home-popular home-reference" aria-labelledby="reference-heading">
      <div class="home-section-heading"><div><p>{refCopy.popularKicker}</p><h2 id="reference-heading">{refCopy.popularHeading}</h2></div><a href={reference[0]!.href}>{refCopy.allSizes} <span aria-hidden="true">→</span></a></div>
      <p class="entity-note">{refCopy.popularLead}</p>
      <ul class="entity-chiplist">
        {shortcuts.map((shortcut) => <li><a class="entity-chip" href={shortcut.href}>{shortcut.label}</a></li>)}
      </ul>
      <div class="entity-links">
        {reference.map((link) => <a class="entity-link-card" href={link.href}><strong>{link.title}</strong><span>{link.helper}</span><i aria-hidden="true">›</i></a>)}
      </div>
    </section>

    <a class="home-fuel-feature" href={fuelPricesPath}><span class:list={['home-fuel-feature__badge', fuelBadgeModifier]}><i aria-hidden="true"></i>{fuelBadgeText}</span><span class="home-fuel-feature__copy"><strong>{home?.fuelTitle ?? 'Gas Prices Today'}</strong><small>{home?.fuelCopy ?? 'Weekly US average for regular, midgrade, premium and diesel, with price history.'}</small></span><span class="home-fuel-feature__arrow" aria-hidden="true">→</span></a>
    <a class="home-diagnostics-feature" href="/obd-codes/" hreflang={locale ? 'en' : undefined}><span class="home-diagnostics-feature__badge">{homeChrome.obdBadge}</span><span class="home-diagnostics-feature__copy"><strong>{homeChrome.obdTitle}</strong><small>{homeChrome.obdCopy}</small></span><span class="home-diagnostics-feature__code" aria-hidden="true">P0420</span><span class="home-diagnostics-feature__arrow" aria-hidden="true">→</span></a>
    <a class="home-fitment-feature" href={`${prefix}/fitment-studio/`}><span class="home-fitment-feature__badge">{home?.fitmentBadge ?? 'ADVANCED VISUAL TOOL'}</span><span class="home-fitment-feature__copy"><strong>{home?.fitmentTitle ?? 'Wheel & Tire Fitment Compare'}</strong><small>{home?.fitmentCopy ?? 'See how a new setup changes diameter, inner position and outer stance before you buy.'}</small></span><span class="home-fitment-feature__arrow" aria-hidden="true">→</span></a>
  </section>
</section>
<script>import { initializeToolboxes } from '../ui/toolbox-filter'; initializeToolboxes();</script>

---
import ToolIcon from './ToolIcon.astro';
import { routeForTool, toolRegistry, type ToolId } from '../seo/tool-registry';

const tools = toolRegistry.filter(({ kind }) => kind === 'tool');
const order: readonly ToolId[] = [
  'fuel-cost-calculator', 'road-trip-cost-calculator', 'tire-size-calculator',
  'tire-size-comparison', 'wheel-offset-calculator', 'speedometer-error-calculator',
  'psi-bar-converter', 'mpg-l100km-converter', 'ev-charging-cost-calculator',
  'power-to-weight-calculator', 'hp-kw-converter', 'nm-lb-ft-converter',
  'gear-ratio-calculator', 'fitment-map', 'measure-my-car',
];
const ordered = order.map((id) => tools.find((tool) => tool.id === id)).filter(Boolean);
const labels = new Map<ToolId, string>([
  ['fuel-cost-calculator', 'Calculate fuel cost'], ['road-trip-cost-calculator', 'Plan a road trip'],
  ['tire-size-calculator', 'Calculate tire size'], ['tire-size-comparison', 'Compare tire sizes'],
  ['wheel-offset-calculator', 'Compare wheel offset'], ['speedometer-error-calculator', 'Check speedometer error'],
  ['psi-bar-converter', 'Convert tire pressure'], ['mpg-l100km-converter', 'Convert fuel economy'],
  ['ev-charging-cost-calculator', 'Estimate EV charging'], ['power-to-weight-calculator', 'Check power-to-weight'],
  ['hp-kw-converter', 'Convert horsepower'], ['nm-lb-ft-converter', 'Convert torque'],
  ['gear-ratio-calculator', 'Compare gear ratios'], ['fitment-map', 'Explore fitment geometry'],
  ['measure-my-car', 'Measure my car'],
]);
---
<section class="home-toolbox" data-toolbox data-mode="home" aria-labelledby="home-heading">
  <header class="home-intro">
    <p class="home-intro__eyebrow">AUTOMOTIVE TOOLS</p>
    <h1 id="home-heading">What do you need to do?</h1>
    <p>Choose a tool. Enter your numbers. Get a clear answer.</p>
  </header>
  <div class="home-search">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg>
    <label class="sr-only" for="tool-search-home">Search automotive tools</label>
    <input id="tool-search-home" type="search" placeholder="Search tools" autocomplete="off" data-tool-search />
    <kbd aria-hidden="true">/</kbd>
  </div>
  <nav class="home-tool-list" aria-label="Automotive tools" data-tool-rows>
    {ordered.map((tool) => tool && (
      <a class="home-tool-row" href={routeForTool(tool)} data-tool-row data-tool-category-name={tool.category} data-tool-search-text={`${tool.title} ${tool.description} ${labels.get(tool.id) ?? ''}`.toLowerCase()} data-popular="true">
        <ToolIcon id={tool.id} category={tool.category}/><span><strong>{labels.get(tool.id) ?? tool.title}</strong><small>{tool.description}</small></span>
        <svg class="row-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
      </a>
    ))}
  </nav>
  <p class="toolbox-empty" data-tool-empty hidden>No matching tool. Try a shorter search.</p>
  <section class="home-advanced" aria-labelledby="advanced-heading">
    <div><p class="section-kicker">MORE FROM ATLAS</p><h2 id="advanced-heading">Advanced fitment</h2></div>
    <a href="/en/fitment-studio/"><span><strong>Fitment Studio</strong><small>Compare wheel and tire geometry</small></span><span aria-hidden="true">›</span></a>
    <a href="/en/fitment-studio/#garage"><span><strong>My Garage</strong><small>Saved vehicles and measurements</small></span><span aria-hidden="true">›</span></a>
  </section>
</section>
<script>
  import { initializeToolboxes } from '../ui/toolbox-filter';
  initializeToolboxes();
  const search = document.querySelector<HTMLInputElement>('#tool-search-home');
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement?.tagName !== 'INPUT') { event.preventDefault(); search?.focus(); }
  });
</script>

---
import ToolIcon from './ToolIcon.astro';
import { routeForTool, TOOL_CATEGORY_ORDER, toolRegistry, type ToolId } from '../seo/tool-registry';
import { localizedTool, platformCatalog, type ContentLocale } from '../localization/site-catalog';
import { localizedToolPath } from '../localization/locales';
import fuelPrices from '../data/fuel-prices.json';
import { normalizeFuelStatus } from '../data/fuel-prices-types';
interface Props { mode?: 'home' | 'all'; locale?: ContentLocale | undefined; }
const { mode = 'all', locale } = Astro.props;

// Gas Prices Today is a real registry entity (kind: 'data-product' in src/seo/tool-registry.ts)
// with its own id, category, localized titles and localized route — not a hand-written row
// bolted on above the list. It is mapped, filtered, searched and counted by exactly the same
// code as every calculator row below, so it is structurally impossible for it to be visible
// while the "no matching tools" empty state also shows.
const fuelStatus = normalizeFuelStatus(locale === 'de' ? fuelPrices.de.status : locale === 'es' ? fuelPrices.es.status : fuelPrices.us.status);
// Status-aware helper text. Never "LIVE" for the weekly US figure, and never "national
// average" for Germany, whose data is an Atlas monitored city sample.
const FUEL_FEATURE_TEXT: Record<'en' | 'de' | 'es', { helper: Record<'pending' | 'fresh' | 'stale', string>; keywords: string }> = {
  en: {
    helper: { pending: 'Weekly fuel data — awaiting first verified update', fresh: 'Weekly US average for regular, midgrade, premium and diesel, with history', stale: 'Weekly fuel data — showing last verified price' },
    keywords: 'gas prices today fuel price petrol diesel gasoline average per gallon per litre',
  },
  de: {
    helper: { pending: 'Kraftstoffdaten — noch nicht verifiziert', fresh: 'Beobachtete Stichprobe für Super E5, E10 und Diesel, mit Verlauf', stale: 'Kraftstoffdaten — letzter bestätigter Wert' },
    keywords: 'kraftstoffpreise heute benzin diesel super e10 tanken spritpreise',
  },
  es: {
    helper: { pending: 'Datos de combustible — aún sin verificar', fresh: 'Precio medio nacional de gasolina y diésel, con histórico', stale: 'Datos de combustible — último valor verificado' },
    keywords: 'precio gasolina hoy combustible diesel gasoleo carburante',
  },
};
const fuelFeature = FUEL_FEATURE_TEXT[locale ?? 'en'];
const categoryLabels = locale ? new Map(platformCatalog[locale].home.categories.map((c, i) => [TOOL_CATEGORY_ORDER[i], c.name] as const)) : undefined;
const allLabel = locale === 'de' ? 'Alle' : locale === 'es' ? 'Todo' : 'All';
const searchPlaceholder = locale ? platformCatalog[locale].home.searchPlaceholder : 'Search automotive tools...';
const allToolsHeading = locale === 'de' ? 'Alle Kfz-Werkzeuge' : locale === 'es' ? 'Todas las herramientas' : 'All automotive tools';
const quickToolsHeading = locale === 'de' ? 'Schnellwerkzeuge' : locale === 'es' ? 'Herramientas rápidas' : 'Quick tools';
const allToolsLink = locale === 'de' ? 'Alle Werkzeuge' : locale === 'es' ? 'Todas' : 'All tools';
const emptyLabel = locale === 'de' ? 'Keine passenden Werkzeuge. Versuchen Sie eine allgemeinere Suche.' : locale === 'es' ? 'No hay herramientas coincidentes. Pruebe una búsqueda más amplia.' : 'No matching tools. Try a broader search.';
const viewAllLabel = locale === 'de' ? 'Alle Werkzeuge ansehen' : locale === 'es' ? 'Ver todas las herramientas' : 'View all tools';
const toolsWord = locale === 'de' ? 'Werkzeuge' : locale === 'es' ? 'herramientas' : 'tools';
const hubPrefix = locale ? `/${locale}` : '';
const tools = toolRegistry.filter(({ kind }) => kind === 'tool');
const dataProducts = toolRegistry.filter(({ kind }) => kind === 'data-product');
// One list, one mapping, one count. Data products lead their category so the fuel market
// dashboard is the first thing in the Fuel & Trips view (which is itself the first category
// in TOOL_CATEGORY_ORDER), without any per-row special case in the markup.
const listedEntries = [...dataProducts, ...tools];
const popularIds: readonly ToolId[] = ['gas-prices-today', 'fuel-cost-calculator', 'road-trip-cost-calculator', 'tire-size-calculator', 'tire-fit-check', 'wheel-offset-calculator', 'psi-bar-converter', 'mpg-l100km-converter', 'power-to-weight-calculator'];
const displayedTools = mode === 'home'
  ? [...popularIds.map((id) => listedEntries.find((tool) => tool.id === id)!), ...listedEntries.filter((tool) => !popularIds.includes(tool.id))]
  : [...listedEntries].sort((left, right) => TOOL_CATEGORY_ORDER.indexOf(left.category) - TOOL_CATEGORY_ORDER.indexOf(right.category));
const helper = new Map<ToolId, string>([
  ['fuel-cost-calculator', 'Fuel used and total journey cost'], ['road-trip-cost-calculator', 'Trips, extras, and cost per person'],
  ['tire-size-calculator', 'See the tire behind the numbers'], ['tire-size-comparison', 'Compare diameter and ride height'], ['tire-fit-check', 'Every check for a size change, on one page'],
  ['wheel-offset-calculator', 'See inner clearance and outer position'], ['speedometer-error-calculator', 'Compare indicated and actual speed'],
  ['fitment-map', 'Explore width and offset geometry'], ['measure-my-car', 'Record real clearance measurements'],
  ['gear-ratio-calculator', 'See tire-size effects on gearing and RPM'],
  ['power-to-weight-calculator', 'Power relative to vehicle weight'],
  ['gas-prices-today', fuelFeature.helper[fuelStatus]],
]);
---
<section class:list={['toolbox', { 'toolbox--home': mode === 'home' }]} data-toolbox data-mode={mode} aria-labelledby="toolbox-heading">
  <div class="toolbox-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg><label class="sr-only" for={`tool-search-${mode}`}>Search automotive tools</label><input id={`tool-search-${mode}`} type="search" placeholder={searchPlaceholder} autocomplete="off" data-tool-search /></div>
  {mode === 'all' && <div class="category-filters" role="group" aria-label="Filter tools by category">
    <button type="button" aria-pressed="true" data-tool-category="All">{allLabel}</button>
    {TOOL_CATEGORY_ORDER.map((category) => <button type="button" aria-pressed="false" data-tool-category={category}>{categoryLabels?.get(category) ?? category}</button>)}
  </div>}
  {mode === 'all' && <div class="tool-list-heading"><h2 id="toolbox-heading">{allToolsHeading}</h2><span data-tool-count>{listedEntries.length} {toolsWord}</span></div>}
  {mode === 'home' && <div class="tool-list-heading tool-list-heading--home"><h2 id="toolbox-heading">{quickToolsHeading}</h2><a href={`${hubPrefix}/tools/`}>{allToolsLink}</a></div>}
  <div class="tool-rows" data-tool-rows>
    {displayedTools.map((tool) => { const label = locale ? localizedTool(tool.id, locale) : undefined; const href = locale ? localizedToolPath(locale, tool.id, tool.kind) : routeForTool(tool); const displayTitle = label?.title ?? tool.title; const isDataProduct = tool.kind === 'data-product'; const displayHelper = isDataProduct ? helper.get(tool.id) : (label?.intro ?? helper.get(tool.id)); const searchExtras = isDataProduct ? fuelFeature.keywords : ''; return (
    <a class:list={['tool-row', { 'is-secondary': mode === 'home' && !popularIds.includes(tool.id), 'tool-row--data': isDataProduct }, isDataProduct ? `is-${fuelStatus}` : undefined]} href={href} data-tool-row data-tool-category-name={tool.category} data-tool-search-text={`${displayTitle} ${label?.description ?? tool.description} ${displayHelper ?? ''} ${searchExtras} ${tool.id}`.toLowerCase()} data-popular={popularIds.includes(tool.id) ? 'true' : 'false'}>
      <ToolIcon id={tool.id} category={tool.category} />
      <span class="tool-row__copy"><strong>{displayTitle}</strong>{displayHelper && <small>{displayHelper}</small>}</span><span class="tool-row__arrow" aria-hidden="true">›</span>
    </a>); })}
  </div>
  <p class="toolbox-empty" data-tool-empty hidden>{emptyLabel}</p>
  {mode === 'home' && <a class="all-tools-link" href={`${hubPrefix}/tools/`}>{viewAllLabel} <span aria-hidden="true">›</span></a>}
</section>
<script>import { initializeToolboxes } from '../ui/toolbox-filter'; initializeToolboxes();</script>

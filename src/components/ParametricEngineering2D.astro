---
import type { Visualization3DLocale } from '../localization/visualization-3d';
import ToolDrawingFrame from './ToolDrawingFrame.astro';
import { tireComparisonText } from '../content/tire-comparison-text';
interface Props { readonly mode: 'tire' | 'single' | 'speed' | 'gear' | 'compression' | 'ev' | 'fitment' | 'offset' | 'pcd'; readonly locale: Visualization3DLocale; }
const { mode, locale } = Astro.props;
const t = {
  en: { section: 'ENGINEERING SECTION', input: 'LIVE GEOMETRY', note: 'Measured or entered geometry · not a fitment or safety verdict', speed: 'Indicated vs theoretical speed', compression: 'Cylinder volume section', fitment: 'Tire and wheel clearance' },
  de: { section: 'TECHNISCHE ANSICHT', input: 'LIVE-GEOMETRIE', note: 'Gemessene oder eingegebene Geometrie · keine Freigabe', speed: 'Anzeige gegen theoretische Geschwindigkeit', compression: 'Zylindervolumen im Schnitt', fitment: 'Reifen- und Radabstand' },
  es: { section: 'SECCIÓN TÉCNICA', input: 'GEOMETRÍA EN VIVO', note: 'Geometría medida o introducida · no certifica seguridad ni ajuste', speed: 'Velocidad indicada y teórica', compression: 'Sección del volumen del cilindro', fitment: 'Espacio entre neumático y rueda' },
  fr: { section: 'COUPE TECHNIQUE', input: 'GÉOMÉTRIE EN DIRECT', note: 'Géométrie mesurée ou saisie · ne valide ni sécurité ni montage', speed: 'Vitesse affichée et théorique', compression: 'Coupe du volume du cylindre', fitment: 'Jeu entre pneu et jante' },
  it: { section: 'SEZIONE TECNICA', input: 'GEOMETRIA LIVE', note: 'Geometria misurata o inserita · non certifica sicurezza né montaggio', speed: 'Velocità indicata e teorica', compression: 'Sezione del volume del cilindro', fitment: 'Gioco tra pneumatico e cerchio' },
  'pt-br': { section: 'SEÇÃO TÉCNICA', input: 'GEOMETRIA AO VIVO', note: 'Geometria medida ou informada · não certifica segurança nem encaixe', speed: 'Velocidade indicada e teórica', compression: 'Seção do volume do cilindro', fitment: 'Folga entre pneu e roda' },
  pl: { section: 'PRZEKRÓJ TECHNICZNY', input: 'GEOMETRIA NA ŻYWO', note: 'Zmierzona lub wpisana geometria · to nie ocena dopasowania ani bezpieczeństwa', speed: 'Prędkość wskazana i teoretyczna', compression: 'Przekrój objętości cylindra', fitment: 'Prześwit opony i felgi' },
  nl: { section: 'TECHNISCHE DOORSNEDE', input: 'LIVE GEOMETRIE', note: 'Gemeten of ingevoerde geometrie · geen oordeel over pasvorm of veiligheid', speed: 'Aangegeven en theoretische snelheid', compression: 'Doorsnede cilindervolume', fitment: 'Vrije ruimte band en velg' },
  tr: { section: 'TEKNİK KESİT', input: 'CANLI GEOMETRİ', note: 'Ölçülen veya girilen geometri · uyum ya da güvenlik onayı değildir', speed: 'Gösterilen ve teorik hız', compression: 'Silindir hacmi kesiti', fitment: 'Lastik ve jant boşluğu' },
}[locale];
const title = mode === 'speed' ? t.speed : mode === 'compression' ? t.compression : t.fitment;
const speedText = tireComparisonText[locale];
---
{mode === 'speed' && <ToolDrawingFrame kind="speedometer" labels={{ indicated: speedText.colIndicated, actual: speedText.colTrue }} locale={locale} readoutLabel={t.input} />}
{mode === 'compression' && <ToolDrawingFrame kind="compression" labels={{}} locale={locale} readoutLabel={t.input} />}
{mode === 'fitment' && <ToolDrawingFrame kind="fitment-setup" labels={{}} locale={locale} readoutLabel={t.input} attrs={{ 'data-drawing-form': 'fitment-form' }} />}
{mode !== 'speed' && mode !== 'compression' && mode !== 'fitment' && (
<div class:list={['tool-engineering-plate', `parametric-engineering-plate--${mode}`]} data-parametric-engineering-2d={mode}>
  <div class="tool-engineering-plate__top"><span>{t.section} / {title.toUpperCase()}</span><span>ATLAS · 02</span></div>
  <div class="tool-engineering-plate__drawing">
    <svg viewBox="0 0 760 340" role="img" aria-label={title} preserveAspectRatio="xMidYMid meet">
      <defs><pattern id={`pgrid-${mode}`} width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" class="bp-grid" /></pattern><marker id={`parrow-${mode}`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M10 0 0 5l10 5Z" class="bp-arrow" /></marker></defs>
      <rect x="0" y="0" width="760" height="340" fill={`url(#pgrid-${mode})`} />
      <path class="bp-center" d="M380 12v316M18 170h724" />
    </svg>
  </div>
  <div class="tool-engineering-plate__bottom"><div><small>{t.input}</small><strong data-parametric-engineering-reading>—</strong></div><p>{t.note}</p></div>
</div>
)}

---
import { tool3DText, type Additional3DToolId, type Tool3DLocale } from '../localization/tool-3d-catalog';
interface Props { id: Additional3DToolId; locale: Tool3DLocale; }
const { id, locale } = Astro.props;
const t = tool3DText(locale, id);
const words = {
  en: ['ENGINEERING EXPLAINER','LIVE RESULT','Concept diagram · calculator values remain authoritative','INNER GAP','OUTER GAP','WHEEL WIDTH','OFFSET (ET)','DISTANCE','FUEL USE','PRICE','FUEL','EXTRAS','TRIP TOTAL','DISTANCE PER GALLON','LITRES PER 100 KM','SAME FUEL USE','ONE PRESSURE','Unit conversion — not a recommended pressure','SAME OUTPUT','FORCE','LEVER ARM','TORQUE','PIVOT','ENGINE POWER','VEHICLE MASS','POWER ÷ MASS','91 = LOAD INDEX','V = SPEED RATING','TIRE SIDEWALL','22 = WEEK','19 = YEAR','DOT DATE CODE','LOADED VEHICLE','TRAILER','AVAILABLE TRAILER MASS','START','1/4 MILE','ELAPSED TIME','TRAP SPEED','SOURCED VEHICLE RECORD','BOLT PATTERN','Reference data — verify exact trim and hardware'],
  de: ['TECHNISCHE ERKLÄRUNG','LIVE-ERGEBNIS','Konzeptdarstellung · Rechnerwerte sind maßgeblich','INNERER ABSTAND','ÄUSSERER ABSTAND','FELGENBREITE','EINPRESSTIEFE (ET)','STRECKE','VERBRAUCH','PREIS','KRAFTSTOFF','EXTRAS','FAHRTKOSTEN','STRECKE PRO GALLONE','LITER PRO 100 KM','GLEICHER VERBRAUCH','EIN DRUCK','Einheitenumrechnung — keine Druckempfehlung','GLEICHE LEISTUNG','KRAFT','HEBELARM','DREHMOMENT','DREHPUNKT','MOTORLEISTUNG','FAHRZEUGMASSE','LEISTUNG ÷ MASSE','91 = LASTINDEX','V = GESCHW.-INDEX','REIFENFLANKE','22 = WOCHE','19 = JAHR','DOT-DATUMSCODE','BELADENES FAHRZEUG','ANHÄNGER','VERFÜGBARE ANHÄNGERMASSE','START','1/4 MEILE','FAHRZEIT','ENDGESCHWINDIGKEIT','BELEGTER FAHRZEUGDATENSATZ','LOCHKREIS','Referenzdaten — Ausstattung und Hardware prüfen'],
  es: ['EXPLICACIÓN TÉCNICA','RESULTADO EN VIVO','Diagrama conceptual · prevalecen los valores del cálculo','ESPACIO INTERIOR','ESPACIO EXTERIOR','ANCHO DE LLANTA','DESPLAZAMIENTO (ET)','DISTANCIA','CONSUMO','PRECIO','COMBUSTIBLE','EXTRAS','TOTAL DEL VIAJE','DISTANCIA POR GALÓN','LITROS POR 100 KM','MISMO CONSUMO','UNA PRESIÓN','Conversión de unidades — no recomienda una presión','MISMA POTENCIA','FUERZA','BRAZO DE PALANCA','PAR','EJE','POTENCIA DEL MOTOR','MASA DEL VEHÍCULO','POTENCIA ÷ MASA','91 = ÍNDICE DE CARGA','V = CÓDIGO DE VELOCIDAD','FLANCO DEL NEUMÁTICO','22 = SEMANA','19 = AÑO','CÓDIGO DE FECHA DOT','VEHÍCULO CARGADO','REMOLQUE','MASA DISPONIBLE DEL REMOLQUE','SALIDA','1/4 DE MILLA','TIEMPO','VELOCIDAD FINAL','REGISTRO DOCUMENTADO','PATRÓN DE PERNOS','Datos de referencia — verifica versión y herrajes'],
}[locale];
const [drawing, live, reference, inner, outer, width, offset, distance, economy, price, fuel, extras, total, mpg, l100, sameUse, pressure, noTarget, sameOutput, force, arm, torque, pivot, vehiclePower, vehicleMass, ratio, loadIndex, speedRating, sidewall, week, year, dot, loadedVehicle, trailer, allowance, start, finish, elapsed, trap, sourced, boltPattern, noApproval] = words;
---
<div class="tool-engineering-plate tool-engineering-plate--specific" data-tool-engineering-2d={id}>
  <div class="tool-engineering-plate__top"><span>{drawing} / {t.title.toUpperCase()}</span><span>ATLAS · 02</span></div>
  <div class="tool-engineering-plate__drawing">
    <svg viewBox="0 0 760 340" role="img" aria-label={t.title} preserveAspectRatio="xMidYMid meet">
      <defs><pattern id={`grid-${id}`} width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" class="bp-grid" /></pattern><marker id={`arrow-${id}`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M10 0 0 5l10 5Z" class="bp-arrow" /></marker></defs>
      <rect width="760" height="340" fill={`url(#grid-${id})`} />
      {id === 'measure-my-car' && <g><path class="bp-boundary" d="M112 60v220M648 60v220"/><path class="bp-solid bp-fill" d="M270 82h220v176H270zM334 100h92v140h-92z"/><path class="bp-accent" d="M270 276H112M490 276h158" marker-start={`url(#arrow-${id})`} marker-end={`url(#arrow-${id})`}/><text class="bp-label" x="190" y="306">{inner}</text><text class="bp-label" x="570" y="306">{outer}</text><text class="bp-title" x="380" y="52">WHEEL / BODY</text></g>}
      {id === 'fitment-map' && <g><path class="bp-axis" d="M126 270V72M126 270h520" marker-end={`url(#arrow-${id})`}/><path class="bp-solid" d="M188 226h92v44h-92zM316 174h92v96h-92zM444 116h92v154h-92z"/><path class="bp-accent bp-fill-accent" d="M316 174h92v96h-92z"/><text class="bp-label" x="386" y="314">{width}</text><text class="bp-label bp-vertical" x="72" y="198">{offset}</text><text class="bp-title" x="362" y="155">ET</text></g>}
      {id === 'fuel-cost-calculator' && <g><path class="bp-solid bp-fill" d="M70 94h158v92H70zM302 94h158v92H302zM534 94h158v92H534z"/><path class="bp-accent" d="M228 140h74M460 140h74" marker-end={`url(#arrow-${id})`}/><text class="bp-kpi" x="149" y="140">km</text><text class="bp-kpi" x="381" y="140">L</text><text class="bp-kpi" x="613" y="140">¤</text><text class="bp-label" x="149" y="218">{distance}</text><text class="bp-label" x="381" y="218">{economy}</text><text class="bp-label" x="613" y="218">{price}</text><text class="bp-title" x="380" y="294">{distance} × {economy} × {price} = {total}</text></g>}
      {id === 'road-trip-cost-calculator' && <g><path class="bp-solid" d="M84 158c110-102 210 102 320 0s194-60 272 0"/><circle class="bp-accent bp-fill-accent" cx="84" cy="158" r="12"/><path class="bp-accent" d="M664 146l12 12-12 12"/><path class="bp-solid bp-fill" d="M160 236h130v62H160zM316 236h130v62H316zM472 236h130v62H472z"/><text class="bp-label" x="225" y="272">{fuel}</text><text class="bp-label" x="381" y="272">{extras}</text><text class="bp-label" x="537" y="272">{total}</text><text class="bp-title" x="380" y="78">{distance}</text></g>}
      {id === 'mpg-l100km-converter' && <g><path class="bp-solid bp-fill" d="M82 82h254v162H82zM424 82h254v162H424z"/><text class="bp-kpi" x="209" y="156">MPG</text><text class="bp-kpi" x="551" y="156">L/100 km</text><text class="bp-label" x="209" y="202">{mpg}</text><text class="bp-label" x="551" y="202">{l100}</text><path class="bp-accent" d="M350 162h60" marker-start={`url(#arrow-${id})`} marker-end={`url(#arrow-${id})`}/><text class="bp-title" x="380" y="292">{sameUse}</text></g>}
      {id === 'psi-bar-converter' && <g><path class="bp-solid bp-fill" d="M258 246a136 136 0 1 1 244 0"/><path class="bp-secondary" d="M282 226a112 112 0 1 1 196 0"/><path class="bp-accent" d="M380 214l72-88"/><circle class="bp-accent bp-fill-accent" cx="380" cy="214" r="10"/><text class="bp-title" x="380" y="286">{pressure}</text><text class="bp-label" x="270" y="94">PSI</text><text class="bp-label" x="380" y="62">BAR</text><text class="bp-label" x="490" y="94">KPA</text><text class="bp-note" x="380" y="320">{noTarget}</text></g>}
      {id === 'hp-kw-converter' && <g><circle class="bp-solid bp-fill" cx="160" cy="170" r="70"/><path class="bp-accent" d="M104 170h112M160 114v112"/><path class="bp-solid" d="M230 154h92v32h-92"/><path class="bp-accent" d="M340 170h76" marker-start={`url(#arrow-${id})`} marker-end={`url(#arrow-${id})`}/><path class="bp-solid bp-fill" d="M434 98h242v144H434z"/><text class="bp-kpi" x="494" y="174">hp</text><text class="bp-kpi" x="616" y="174">kW</text><path class="bp-secondary" d="M555 118v104"/><text class="bp-title" x="555" y="278">{sameOutput}</text></g>}
      {id === 'nm-lb-ft-converter' && <g><circle class="bp-solid bp-fill" cx="250" cy="198" r="64"/><circle class="bp-accent bp-fill-accent" cx="250" cy="198" r="10"/><path class="bp-solid" d="M250 198L500 82"/><path class="bp-accent" d="M500 42v78" marker-end={`url(#arrow-${id})`}/><path class="bp-dimension" d="M278 228L505 123" marker-start={`url(#arrow-${id})`} marker-end={`url(#arrow-${id})`}/><path class="bp-accent" d="M180 194a72 72 0 0 1 56-66" marker-end={`url(#arrow-${id})`}/><text class="bp-title" x="534" y="72">{force}</text><text class="bp-label" x="414" y="205">{arm}</text><text class="bp-title" x="155" y="108">{torque}</text><text class="bp-note" x="250" y="292">{pivot}</text></g>}
      {id === 'power-to-weight-calculator' && <g><path class="bp-solid bp-fill" d="M66 92h238v148H66zM456 92h238v148H456z"/><path class="bp-accent" d="M322 166h116" marker-end={`url(#arrow-${id})`}/><path class="bp-solid" d="M100 178h168l-22-50h-94l-30 22h-22z"/><circle class="bp-solid" cx="138" cy="185" r="19"/><circle class="bp-solid" cx="230" cy="185" r="19"/><path class="bp-accent" d="M124 118l22-34 16 34 22-34 18 34"/><path class="bp-solid" d="M506 125h138v82H506z"/><text class="bp-kpi" x="575" y="170">kg</text><text class="bp-label" x="185" y="272">{vehiclePower}</text><text class="bp-label" x="575" y="272">{vehicleMass}</text><text class="bp-title" x="380" y="316">{ratio}</text></g>}
      {id === 'tire-load-speed-rating' && <g><circle class="bp-solid bp-fill" cx="270" cy="170" r="126"/><circle class="bp-secondary" cx="270" cy="170" r="86"/><circle class="bp-solid" cx="270" cy="170" r="58"/><text class="bp-code" x="270" y="104">225/45 R17 <tspan class="bp-code-accent">91V</tspan></text><path class="bp-accent" d="M350 105h92L512 64M350 116h92l70 112"/><text class="bp-title" x="590" y="64">{loadIndex}</text><text class="bp-title" x="590" y="236">{speedRating}</text><text class="bp-note" x="270" y="320">{sidewall}</text></g>}
      {id === 'tire-date-code-decoder' && <g><circle class="bp-solid bp-fill" cx="270" cy="170" r="126"/><circle class="bp-secondary" cx="270" cy="170" r="86"/><circle class="bp-solid" cx="270" cy="170" r="58"/><rect class="bp-accent bp-fill-accent" x="202" y="76" width="136" height="44" rx="9"/><text class="bp-code" x="270" y="105">DOT 2219</text><path class="bp-accent" d="M338 88h104L520 54M338 108h104l78 126"/><text class="bp-title" x="588" y="56">{week}</text><text class="bp-title" x="588" y="242">{year}</text><text class="bp-note" x="270" y="320">{dot}</text></g>}
      {id === 'towing-capacity-calculator' && <g><path class="bp-solid bp-fill" d="M54 158h300l-38-70H158l-58 44H54z"/><circle class="bp-solid" cx="132" cy="194" r="30"/><circle class="bp-solid" cx="286" cy="194" r="30"/><path class="bp-accent" d="M354 176h58"/><path class="bp-solid bp-fill" d="M412 122h266v72H412z"/><circle class="bp-solid" cx="574" cy="210" r="24"/><path class="bp-dimension" d="M68 270h600" marker-start={`url(#arrow-${id})`} marker-end={`url(#arrow-${id})`}/><text class="bp-label" x="204" y="238">{loadedVehicle}</text><text class="bp-label" x="545" y="238">{trailer}</text><text class="bp-title" x="368" y="308">{allowance}</text></g>}
      {id === 'quarter-mile-calculator' && <g><path class="bp-solid" d="M74 128h612M74 212h612"/><path class="bp-secondary" d="M112 92v156M648 92v156"/><path class="bp-accent" d="M132 170h496" marker-end={`url(#arrow-${id})`}/><path class="bp-solid bp-fill" d="M168 146h104l-16-28h-48l-20 12h-20z"/><circle class="bp-solid" cx="196" cy="153" r="12"/><circle class="bp-solid" cx="246" cy="153" r="12"/><text class="bp-label" x="112" y="278">{start}</text><text class="bp-label" x="648" y="278">{finish}</text><text class="bp-title" x="294" y="64">{elapsed}</text><text class="bp-title" x="490" y="64">{trap}</text></g>}
      {id === 'vehicle-fitment-finder' && <g><path class="bp-solid bp-fill" d="M54 144h312l-42-72H166l-64 44H54z"/><circle class="bp-solid" cx="132" cy="184" r="34"/><circle class="bp-solid" cx="294" cy="184" r="34"/><circle class="bp-solid bp-fill" cx="540" cy="158" r="100"/><circle class="bp-secondary" cx="540" cy="158" r="32"/><circle class="bp-accent" cx="540" cy="96" r="8"/><circle class="bp-accent" cx="599" cy="139" r="8"/><circle class="bp-accent" cx="576" cy="208" r="8"/><circle class="bp-accent" cx="504" cy="208" r="8"/><circle class="bp-accent" cx="481" cy="139" r="8"/><text class="bp-label" x="210" y="260">{sourced}</text><text class="bp-label" x="540" y="282">{boltPattern}</text><text class="bp-note" x="380" y="320">{noApproval}</text></g>}
    </svg>
  </div>
  <div class="tool-engineering-plate__bottom"><div><small>{live}</small><strong data-tool-engineering-reading>—</strong></div><p>{reference}</p></div>
</div>

}[locale];
const wheelBody = ({ en: 'WHEEL / BODY', de: 'RAD / KAROSSERIE', es: 'RUEDA / CARROCERÍA', fr: 'ROUE / CARROSSERIE', it: 'RUOTA / CARROZZERIA', 'pt-br': 'RODA / CARROCERIA', pl: 'KOŁO / NADWOZIE', nl: 'WIEL / CARROSSERIE', tr: 'TEKERLEK / KAROSER' } as const)[locale];
const [drawing, live, reference, inner, outer, width, offset, distance, economy, price, fuel, extras, total, , , sameUse, pressure, noTarget, sameOutput, force, arm, torque, pivot, vehiclePower, vehicleMass, ratio, loadIndex, speedRating, sidewall, week, year, dot, loadedVehicle, trailer, allowance, start, finish, elapsed, trap, sourced, boltPattern, noApproval] = words;
---
<div class="tool-engineering-plate tool-engineering-plate--specific" data-tool-engineering-2d={id}>
  <div class="tool-engineering-plate__top"><span>{drawing} / {t.title.toUpperCase()}</span><span>ATLAS · 02</span></div>
  <div class="tool-engineering-plate__drawing">
    <svg viewBox="0 0 760 340" role="img" aria-label={t.title} preserveAspectRatio="xMidYMid meet">
      <defs><pattern id={`grid-${id}`} width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" class="bp-grid" /></pattern><marker id={`arrow-${id}`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M10 0 0 5l10 5Z" class="bp-arrow" /></marker></defs>
      <rect width="760" height="340" fill={`url(#grid-${id})`} />
      {id === 'measure-my-car' && <g><path class="bp-boundary" d="M112 60v220M648 60v220"/><path class="bp-solid bp-fill" d="M270 82h220v176H270zM334 100h92v140h-92z"/><path class="bp-accent" d="M270 276H112M490 276h158" marker-start={`url(#arrow-${id})`} marker-end={`url(#arrow-${id})`}/><text class="bp-label" x="190" y="306">{inner}</text><text class="bp-label" x="570" y="306">{outer}</text><text class="bp-title" x="380" y="52">{wheelBody}</text></g>}
      {id === 'fitment-map' && <g><path class="bp-axis" d="M126 270V72M126 270h520" marker-end={`url(#arrow-${id})`}/><path class="bp-solid" d="M188 226h92v44h-92zM316 174h92v96h-92zM444 116h92v154h-92z"/><path class="bp-accent bp-fill-accent" d="M316 174h92v96h-92z"/><text class="bp-label" x="386" y="314">{width}</text><text class="bp-label bp-vertical" x="72" y="198">{offset}</text><text class="bp-title" x="362" y="155">ET</text></g>}
      {id === 'fuel-cost-calculator' && <g><path class="bp-solid bp-fill" d="M70 94h158v92H70zM302 94h158v92H302zM534 94h158v92H534z"/><path class="bp-accent" d="M228 140h74M460 140h74" marker-end={`url(#arrow-${id})`}/><text class="bp-kpi" x="149" y="140">km</text><text class="bp-kpi" x="381" y="140">L</text><text class="bp-kpi" x="613" y="140">¤</text><text class="bp-label" x="149" y="218">{distance}</text><text class="bp-label" x="381" y="218">{economy}</text><text class="bp-label" x="613" y="218">{price}</text><path class="bp-secondary" d="M180 268h400"/><path class="bp-accent" data-tool-level d="M180 268h80"/><text class="bp-title" x="380" y="304">{distance} × {economy} × {price} = {total}</text></g>}
      {id === 'road-trip-cost-calculator' && <g><path class="bp-solid" d="M84 158c110-102 210 102 320 0s194-60 272 0"/><circle class="bp-accent bp-fill-accent" cx="84" cy="158" r="12"/><circle class="bp-accent bp-fill-accent" data-tool-progress cx="160" cy="128" r="9"/><path class="bp-accent" d="M664 146l12 12-12 12"/><path class="bp-solid bp-fill" d="M160 236h130v62H160zM316 236h130v62H316zM472 236h130v62H472z"/><text class="bp-label" x="225" y="272">{fuel}</text><text class="bp-label" x="381" y="272">{extras}</text><text class="bp-label" x="537" y="272">{total}</text><text class="bp-title" x="380" y="78">{distance}</text></g>}
      {id === 'mpg-l100km-converter' && <g><path class="bp-solid" d="M72 226h616M98 226v-54h174v54M488 226v-54h174v54"/><path class="bp-secondary" d="M122 197h126M512 197h126"/><circle class="bp-solid bp-fill" cx="148" cy="226" r="24"/><circle class="bp-solid bp-fill" cx="232" cy="226" r="24"/><circle class="bp-solid bp-fill" cx="538" cy="226" r="24"/><circle class="bp-solid bp-fill" cx="622" cy="226" r="24"/><path class="bp-accent" d="M118 116h164" marker-start={`url(#arrow-${id})`} marker-end={`url(#arrow-${id})`}/><path class="bp-accent" d="M478 116h194" marker-start={`url(#arrow-${id})`} marker-end={`url(#arrow-${id})`}/><path class="bp-solid bp-fill" d="M330 92h100v134H330zM346 112h68v50h-68zM430 126h24v72h-24"/><path class="bp-accent bp-fill-accent" d="M350 180h60v34h-60z"/><text class="bp-label" x="200" y="82">US MPG</text><text class="bp-kpi" data-fuel-us-mpg x="200" y="142">—</text><text class="bp-label" x="575" y="82">IMP MPG</text><text class="bp-kpi" data-fuel-imperial-mpg x="575" y="142">—</text><text class="bp-label" x="380" y="256">L/100 KM</text><text class="bp-kpi" data-fuel-l100 x="380" y="294">—</text><text class="bp-note" x="380" y="52">{sameUse}</text></g>}
      {id === 'psi-bar-converter' && <g><path class="bp-solid bp-fill" d="M54 92h200v152H54zM280 92h200v152H280zM506 92h200v152H506z"/><text class="bp-label" x="154" y="124">PSI</text><text class="bp-kpi" data-pressure-psi x="154" y="174">32.0</text><text class="bp-label" x="380" y="124">BAR</text><text class="bp-kpi" data-pressure-bar x="380" y="174">2.206</text><text class="bp-label" x="606" y="124">KPA</text><text class="bp-kpi" data-pressure-kpa x="606" y="174">220.63</text><path class="bp-accent" d="M254 168h26M480 168h26" marker-start={`url(#arrow-${id})`} marker-end={`url(#arrow-${id})`}/><text class="bp-title" x="380" y="278">{pressure}</text><text class="bp-note" x="380" y="316">{noTarget}</text></g>}
      {id === 'hp-kw-converter' && <g><circle class="bp-solid bp-fill" cx="178" cy="166" r="82"/><circle class="bp-secondary" cx="178" cy="166" r="28"/><g class="bp-dynamic" data-tool-rotor>{Array.from({length:6},(_,index)=><path class="bp-accent bp-fill-accent" d="M178 138c34-34 52-10 38 12-12 18-24 18-38 16Z" transform={`rotate(${index*60} 178 166)`}/>)}</g><circle class="bp-solid" cx="178" cy="166" r="9"/><path class="bp-solid" d="M260 150h94v32h-94"/><path class="bp-accent" d="M356 166h66" marker-end={`url(#arrow-${id})`}/><path class="bp-solid bp-fill" d="M438 82h250v168H438z"/><path class="bp-secondary" d="M563 100v132M458 208h210"/><path class="bp-accent" data-tool-level d="M458 208h42"/><text class="bp-label" x="501" y="122">MECHANICAL HP</text><text class="bp-kpi" data-power-hp x="501" y="166">—</text><text class="bp-label" x="625" y="122">kW</text><text class="bp-kpi" data-power-kw x="625" y="166">—</text><text class="bp-title" x="563" y="286">{sameOutput}</text></g>}
      {id === 'nm-lb-ft-converter' && <g><circle class="bp-solid bp-fill" cx="206" cy="208" r="58"/><path class="bp-solid" d="M176 178l60 60M236 178l-60 60"/><circle class="bp-accent bp-fill-accent" cx="206" cy="208" r="11"/><g class="bp-dynamic" data-tool-lever><path class="bp-solid" d="M206 208L520 78"/><path class="bp-accent" d="M520 34v82" marker-end={`url(#arrow-${id})`}/><path class="bp-dimension" d="M242 240L532 120" marker-start={`url(#arrow-${id})`} marker-end={`url(#arrow-${id})`}/></g><path class="bp-accent" d="M136 204a74 74 0 0 1 58-70" marker-end={`url(#arrow-${id})`}/><path class="bp-solid bp-fill" d="M520 164h176v116H520z"/><text class="bp-label" x="608" y="188">Nm</text><text class="bp-kpi" data-torque-nm x="608" y="222">—</text><text class="bp-label" x="608" y="252">LB-FT</text><text class="bp-kpi bp-kpi--small" data-torque-lbft x="608" y="276">—</text><text class="bp-title" x="552" y="58">{force}</text><text class="bp-label" x="394" y="212">{arm}</text><text class="bp-title" x="126" y="106">{torque}</text><text class="bp-note" x="206" y="306">{pivot}</text></g>}
      {id === 'power-to-weight-calculator' && <g><path class="bp-solid bp-fill" d="M54 78h252v174H54zM454 78h252v174H454z"/><path class="bp-accent" d="M326 164h108" marker-end={`url(#arrow-${id})`}/><circle class="bp-solid bp-fill" cx="180" cy="146" r="54"/><g class="bp-dynamic" data-tool-rotor><path class="bp-accent" d="M142 146h76M180 108v76"/></g><path class="bp-secondary" d="M82 226h196"/><path class="bp-accent" data-tool-power-level d="M82 226h42"/><path class="bp-solid" d="M486 186h186l-24-58h-104l-34 28h-24z"/><circle class="bp-solid bp-fill" cx="530" cy="194" r="22"/><circle class="bp-solid bp-fill" cx="632" cy="194" r="22"/><path class="bp-secondary" d="M480 226h200"/><path class="bp-accent" data-tool-mass-level d="M480 226h42"/><text class="bp-kpi" data-pw-power x="180" y="304">—</text><text class="bp-label" x="180" y="278">{vehiclePower}</text><text class="bp-kpi" data-pw-mass x="580" y="304">—</text><text class="bp-label" x="580" y="278">{vehicleMass}</text><rect class="bp-accent bp-fill-accent" x="316" y="232" width="128" height="74" rx="10"/><text class="bp-label" x="380" y="252">{ratio}</text><text class="bp-kpi bp-kpi--small" data-pw-ratio x="380" y="282">—</text></g>}
      {id === 'tire-load-speed-rating' && <g><circle class="bp-solid bp-fill" cx="270" cy="170" r="126"/><circle class="bp-secondary" cx="270" cy="170" r="86"/><circle class="bp-solid" cx="270" cy="170" r="58"/><text class="bp-code" x="270" y="104"><tspan>225/45 R17 </tspan><tspan class="bp-code-accent" data-tool-code>91V</tspan></text><path class="bp-accent" d="M350 105h92L512 64M350 116h92l70 112"/><text class="bp-title" data-tool-load-label x="590" y="64">{loadIndex}</text><text class="bp-title" data-tool-speed-label x="590" y="236">{speedRating}</text><text class="bp-note" x="270" y="320">{sidewall}</text></g>}
      {id === 'tire-date-code-decoder' && <g><circle class="bp-solid bp-fill" cx="270" cy="170" r="126"/><circle class="bp-secondary" cx="270" cy="170" r="86"/><circle class="bp-solid" cx="270" cy="170" r="58"/><rect class="bp-accent bp-fill-accent" x="202" y="76" width="136" height="44" rx="9"/><text class="bp-code" data-tool-dot-code x="270" y="105">DOT 2219</text><path class="bp-accent" d="M338 88h104L520 54M338 108h104l78 126"/><text class="bp-title" data-tool-week-label x="588" y="56">{week}</text><text class="bp-title" data-tool-year-label x="588" y="242">{year}</text><text class="bp-note" x="270" y="320">{dot}</text></g>}
      {id === 'towing-capacity-calculator' && <g><path class="bp-solid bp-fill" d="M54 158h300l-38-70H158l-58 44H54z"/><circle class="bp-solid" cx="132" cy="194" r="30"/><circle class="bp-solid" cx="286" cy="194" r="30"/><path class="bp-accent" d="M354 176h58"/><path class="bp-solid bp-fill" d="M412 122h266v72H412z"/><circle class="bp-solid" cx="574" cy="210" r="24"/><path class="bp-secondary" d="M68 270h600"/><path class="bp-accent" data-tool-level d="M68 270h100"/><text class="bp-label" x="204" y="238">{loadedVehicle}</text><text class="bp-label" x="545" y="238">{trailer}</text><text class="bp-title" x="368" y="308">{allowance}</text></g>}
      {id === 'quarter-mile-calculator' && <g><path class="bp-solid" d="M74 128h612M74 212h612"/><path class="bp-secondary" d="M112 92v156M648 92v156"/><path class="bp-accent" d="M132 170h496" marker-end={`url(#arrow-${id})`}/><g class="bp-dynamic" data-tool-car><path class="bp-solid bp-fill" d="M168 146h104l-16-28h-48l-20 12h-20z"/><circle class="bp-solid" cx="196" cy="153" r="12"/><circle class="bp-solid" cx="246" cy="153" r="12"/></g><text class="bp-label" x="112" y="278">{start}</text><text class="bp-label" x="648" y="278">{finish}</text><text class="bp-title" x="294" y="64">{elapsed}</text><text class="bp-title" x="490" y="64">{trap}</text></g>}
      {id === 'vehicle-fitment-finder' && <g><path class="bp-solid bp-fill" d="M54 144h312l-42-72H166l-64 44H54z"/><circle class="bp-solid" cx="132" cy="184" r="34"/><circle class="bp-solid" cx="294" cy="184" r="34"/><circle class="bp-solid bp-fill" cx="540" cy="158" r="100"/><circle class="bp-secondary" cx="540" cy="158" r="32"/><g data-tool-lugs>{Array.from({ length: 8 }, (_, index) => <circle class="bp-accent bp-fill-accent" data-tool-lug={index} cx="540" cy="96" r="8"/>)}</g><text class="bp-label" x="210" y="260">{sourced}</text><text class="bp-label" x="540" y="282">{boltPattern}</text><text class="bp-note" x="380" y="320">{noApproval}</text></g>}
    </svg>
  </div>
  <div class="tool-engineering-plate__bottom"><div><small>{live}</small><strong data-tool-engineering-reading>—</strong></div><p>{reference}</p></div>
</div>

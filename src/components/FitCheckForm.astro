---
/**
 * Form + result regions for "Can I fit this tire size?" (ui/fit-check.ts renders the results).
 * Field names deliberately match the tire comparison ("original-" and "new-" prefixes) and the wheel offset
 * calculator (originalWidthInches…), so the 3D panel, share links, the print sheet and tool
 * hand-off links all work on this page without special cases.
 */
import TireInputGroup from './TireInputGroup.astro';
import Parametric3DPanel from './Parametric3DPanel.astro';
import DecisionPanel from './DecisionPanel.astro';
import MyVehicleBar from './MyVehicleBar.astro';
import type { ContentLocale } from '../localization/site-catalog';

interface Props { readonly locale?: ContentLocale | undefined; }
const { locale } = Astro.props;
const t = {
  en: { current: 'Current tire', proposed: 'Tire you want to fit', wheels: 'Add wheel sizes (optional)', wheelsHint: 'Fill in all four to see how far the wheel edges move.', cw: 'Current wheel width (J)', ce: 'Current offset (ET)', nw: 'New wheel width (J)', ne: 'New offset (ET)', submit: 'Check this size', result: 'Fit check result', shape: 'Tire shape comparison', checks: 'Individual checks', load3d: 'Open interactive 3D comparison' },
  de: { current: 'Aktueller Reifen', proposed: 'Gewünschter Reifen', wheels: 'Felgenmaße ergänzen (optional)', wheelsHint: 'Alle vier ausfüllen, um die Verschiebung der Felgenkanten zu sehen.', cw: 'Aktuelle Felgenbreite (J)', ce: 'Aktuelle Einpresstiefe (ET)', nw: 'Neue Felgenbreite (J)', ne: 'Neue Einpresstiefe (ET)', submit: 'Diese Größe prüfen', result: 'Ergebnis der Passprüfung', shape: 'Reifenvergleich als Grafik', checks: 'Einzelne Prüfungen', load3d: 'Interaktiven 3D-Vergleich öffnen' },
  es: { current: 'Neumático actual', proposed: 'Neumático que quiere montar', wheels: 'Añadir medidas de llanta (opcional)', wheelsHint: 'Rellene los cuatro campos para ver cuánto se desplazan los bordes de la llanta.', cw: 'Ancho de llanta actual (J)', ce: 'Offset actual (ET)', nw: 'Ancho de llanta nuevo (J)', ne: 'Offset nuevo (ET)', submit: 'Comprobar esta medida', result: 'Resultado de la comprobación', shape: 'Comparación gráfica de neumáticos', checks: 'Comprobaciones individuales', load3d: 'Abrir comparación 3D interactiva' },
  fr: { current: 'Pneu actuel', proposed: 'Pneu que vous voulez monter', wheels: 'Ajouter les dimensions de jante (facultatif)', wheelsHint: 'Remplissez les quatre champs pour voir de combien les bords de la jante se déplacent.', cw: 'Largeur de jante actuelle (J)', ce: 'Déport actuel (ET)', nw: 'Nouvelle largeur de jante (J)', ne: 'Nouveau déport (ET)', submit: 'Vérifier cette dimension', result: 'Résultat de la vérification', shape: 'Comparaison visuelle des pneus', checks: 'Vérifications détaillées', load3d: 'Ouvrir la comparaison 3D interactive' },
  it: { current: 'Pneumatico attuale', proposed: 'Pneumatico che vuoi montare', wheels: 'Aggiungi le misure del cerchio (facoltativo)', wheelsHint: 'Compila tutti e quattro i campi per vedere di quanto si spostano i bordi del cerchio.', cw: 'Larghezza cerchio attuale (J)', ce: 'Offset attuale (ET)', nw: 'Nuova larghezza cerchio (J)', ne: 'Nuovo offset (ET)', submit: 'Verifica questa misura', result: 'Risultato della verifica', shape: 'Confronto grafico dei pneumatici', checks: 'Verifiche singole', load3d: 'Apri il confronto 3D interattivo' },
  'pt-br': { current: 'Pneu atual', proposed: 'Pneu que você quer montar', wheels: 'Adicionar medidas da roda (opcional)', wheelsHint: 'Preencha os quatro campos para ver quanto as bordas da roda se deslocam.', cw: 'Largura da roda atual (J)', ce: 'Offset atual (ET)', nw: 'Largura da roda nova (J)', ne: 'Offset novo (ET)', submit: 'Verificar esta medida', result: 'Resultado da verificação', shape: 'Comparação visual dos pneus', checks: 'Verificações individuais', load3d: 'Abrir comparação 3D interativa' },
  pl: { current: 'Obecna opona', proposed: 'Opona, którą chcesz założyć', wheels: 'Dodaj wymiary felg (opcjonalnie)', wheelsHint: 'Wypełnij wszystkie cztery pola, aby zobaczyć, o ile przesuną się krawędzie felgi.', cw: 'Obecna szerokość felgi (J)', ce: 'Obecne odsadzenie (ET)', nw: 'Nowa szerokość felgi (J)', ne: 'Nowe odsadzenie (ET)', submit: 'Sprawdź ten rozmiar', result: 'Wynik sprawdzenia', shape: 'Graficzne porównanie opon', checks: 'Poszczególne kontrole', load3d: 'Otwórz interaktywne porównanie 3D' },
  nl: { current: 'Huidige band', proposed: 'Band die je wilt monteren', wheels: 'Velgmaten toevoegen (optioneel)', wheelsHint: 'Vul alle vier de velden in om te zien hoeveel de velgranden verschuiven.', cw: 'Huidige velgbreedte (J)', ce: 'Huidige ET (inpersdiepte)', nw: 'Nieuwe velgbreedte (J)', ne: 'Nieuwe ET (inpersdiepte)', submit: 'Controleer deze maat', result: 'Resultaat van de controle', shape: 'Visuele bandenvergelijking', checks: 'Afzonderlijke controles', load3d: 'Interactieve 3D-vergelijking openen' },
  tr: { current: 'Mevcut lastik', proposed: 'Takmak istediğiniz lastik', wheels: 'Jant ölçülerini ekleyin (isteğe bağlı)', wheelsHint: 'Jant kenarlarının ne kadar kaydığını görmek için dört alanı da doldurun.', cw: 'Mevcut jant genişliği (J)', ce: 'Mevcut jant ofseti (ET)', nw: 'Yeni jant genişliği (J)', ne: 'Yeni jant ofseti (ET)', submit: 'Bu ebadı kontrol edin', result: 'Uyum kontrolü sonucu', shape: 'Görsel lastik karşılaştırması', checks: 'Tek tek kontroller', load3d: 'Etkileşimli 3D karşılaştırmayı açın' },
}[locale ?? 'en'];
---
<form class="calculator-form fit-check-form" data-calculator="tire-fit-check" novalidate>
  <MyVehicleBar locale={locale ?? 'en'} />
  <div class="calculator-columns">
    <TireInputGroup locale={locale} prefix="original-" title={t.current} width={225} aspect={45} rim={17} />
    <TireInputGroup locale={locale} prefix="new-" title={t.proposed} width={235} aspect={40} rim={18} />
  </div>
  <details class="fit-check-wheels" data-fit-wheels>
    <summary>{t.wheels}</summary>
    <p>{t.wheelsHint}</p>
    <div class="grid">
      <label>{t.cw}<input name="originalWidthInches" type="number" step="0.5" inputmode="decimal" /></label>
      <label>{t.ce}<input name="originalOffsetMm" type="number" step="1" inputmode="numeric" /></label>
      <label>{t.nw}<input name="newWidthInches" type="number" step="0.5" inputmode="decimal" /></label>
      <label>{t.ne}<input name="newOffsetMm" type="number" step="1" inputmode="numeric" /></label>
    </div>
  </details>
  <div class="form-actions"><button type="submit">{t.submit}</button></div>
  <div class="inline-errors" data-fit-errors role="alert" hidden></div>

  <div class="fit-result" data-fit-result aria-label={t.result} hidden>
    <section class="fit-verdict" data-fit-verdict aria-live="polite" aria-labelledby="fit-verdict-title"></section>
    <figure class="fit-shape" aria-label={t.shape}><div data-fit-shape></div></figure>
    <ol class="fit-checks" data-fit-checks aria-label={t.checks}></ol>
    <nav class="fit-actions" data-fit-actions></nav>
    <details class="visual-on-demand">
      <summary>{t.load3d}</summary>
      <Parametric3DPanel mode="tire" locale={locale ?? 'en'} />
    </details>
    <section class="fit-legend" data-fit-legend></section>
  </div>
  <DecisionPanel locale={locale ?? 'en'} mode="checklist" />
</form>
<script>import { initializeDecisionPanels } from '../ui/decision-panel'; initializeDecisionPanels();</script>

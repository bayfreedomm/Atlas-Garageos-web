import ThemeControl from './ThemeControl.astro';
---
<button class="menu-button" type="button" aria-label="Open menu" aria-controls="navigation-drawer" aria-expanded="false" data-menu-open><span></span><span></span><span></span></button>
<dialog id="navigation-drawer" class="drawer-layer" data-drawer-layer aria-label="Atlas menu">
  <div class="navigation-drawer">
    <div class="drawer-shell">
      <header><a href="/en/" class="drawer-home"><span>ATLAS</span><small>GarageOS</small></a><button class="drawer-close" type="button" aria-label="Close menu" data-menu-close>×</button></header>
      <div class="drawer-grid">
        <nav class="drawer-primary" aria-label="Main navigation"><p>GO STRAIGHT TO</p><a href="/en/"><strong>Toolbox home</strong><span>Choose a job and get an answer</span><i>01</i></a><a href="/en/tools/"><strong>All automotive tools</strong><span>Browse the complete collection</span><i>02</i></a><a href="/en/fitment-studio/"><strong>Fitment Studio</strong><span>Explore wheel and tire geometry</span><i>03</i></a><a href="/en/fitment-studio/#garage"><strong>My Garage</strong><span>Your vehicles and saved setups</span><i>04</i></a></nav>

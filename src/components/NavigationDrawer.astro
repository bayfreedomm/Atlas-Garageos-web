---
import ThemeControl from './ThemeControl.astro';
import { uiStrings, type ContentLocale } from '../localization/site-catalog';
interface LocaleLink { readonly code: 'en' | 'de' | 'es'; readonly label: string; readonly href: string; }
interface Props { locale?: ContentLocale; localeLinks?: readonly LocaleLink[]; }
const { locale, localeLinks } = Astro.props;
const t = locale ? uiStrings[locale] : undefined;
const prefix = locale ? `/${locale}` : '';
const links: readonly LocaleLink[] = localeLinks ?? [
  { code: 'en', label: 'English', href: '/' },
  { code: 'de', label: 'Deutsch', href: '/de/' },
  { code: 'es', label: 'Español', href: '/es/' },
];
---
<button class="menu-button" type="button" aria-label="Open menu" aria-controls="navigation-drawer" aria-expanded="false" data-menu-open><span></span><span></span><span></span></button>
<dialog id="navigation-drawer" class="drawer-layer" data-drawer-layer aria-label="Atlas menu">
  <div class="navigation-drawer">
    <div class="drawer-shell">
      <header><a href={`${prefix}/`} class="drawer-home"><span>ATLAS</span><small>GarageOS</small></a><button class="drawer-close" type="button" aria-label="Close menu" data-menu-close>×</button></header>
      <div class="drawer-grid">
        <nav class="drawer-primary" aria-label="Main navigation">
          <p>GO STRAIGHT TO</p>
          <a href={`${prefix}/`}><strong>{t?.navHome ?? 'Home'}</strong><span>Pick a job and get an answer</span><i>01</i></a>
          <a href={`${prefix}/tools/`}><strong>All automotive tools</strong><span>Browse every calculator and converter</span><i>02</i></a>
          <a href="/fitment-studio/"><strong>{t?.navFitment ?? 'Wheel & Tire Compare'}</strong><span>Compare two setups visually</span><i>03</i></a>
        </nav>
        <div class="drawer-secondary"><nav aria-label="Tool categories"><p>TOOLS BY JOB</p><a href={`${prefix}/tools/?category=Fuel%20%26%20Trips`}>Fuel &amp; trips <span>›</span></a><a href={`${prefix}/tools/?category=Tires%20%26%20Wheels`}>Tires &amp; wheels <span>›</span></a><a href={`${prefix}/tools/?category=Converters`}>Converters <span>›</span></a><a href={`${prefix}/tools/?category=Performance`}>Performance <span>›</span></a></nav><section class="drawer-settings" aria-labelledby="settings-heading"><p id="settings-heading">DISPLAY</p><ThemeControl /><a class="drawer-methodology-link" href={`${prefix}/methodology/`}>Accuracy &amp; methodology <span>›</span></a><div class="language-setting language-setting--switcher"><span>{t?.langLabel ?? 'Language'}</span><div class="language-options" role="group" aria-label={t?.langSwitchAria ?? 'Switch language'}>{links.map((link) => <a href={link.href} class:list={['language-option', { 'is-active': link.code === (locale ?? 'en') }]} aria-current={link.code === (locale ?? 'en') ? 'true' : undefined}>{link.label}</a>)}</div></div></section></div>
      </div>
    </div>
  </div>
</dialog>
<script>import { initializeNavigationDrawer } from '../ui/navigation-drawer'; initializeNavigationDrawer();</script>

---
import ThemeControl from './ThemeControl.astro';
import { chromePrefix, chromeStrings, platformCatalog, type ChromeLocale } from '../localization/site-catalog';
import { TOOL_CATEGORY_ORDER, type ToolCategory } from '../seo/tool-registry';
import { referenceCopy, referenceLinks } from '../ui/reference-links';
interface LocaleLink { readonly code: 'en' | 'de' | 'es' | 'fr'; readonly label: string; readonly href: string; }
interface Props { locale?: ChromeLocale | undefined; localeLinks?: readonly LocaleLink[] | undefined; }
const { locale, localeLinks } = Astro.props;
const t = chromeStrings(locale);
const prefix = chromePrefix(locale);
const homeHref = locale ? `/${locale}/` : '/';
const links: readonly LocaleLink[] = localeLinks ?? [
  { code: 'en', label: 'English', href: '/' },
  { code: 'de', label: 'Deutsch', href: '/de/' },
  { code: 'es', label: 'Español', href: '/es/' },
];
const FALLBACK_CATEGORY_LABELS: Readonly<Record<ToolCategory, string>> = { 'Fuel & Trips': 'Fuel & trips', 'Tires & Wheels': 'Tires & wheels', Converters: 'Converters', Performance: 'Performance' };
const entityLocale = locale ?? 'en';
const reference = referenceLinks(entityLocale);
const refCopy = referenceCopy(entityLocale);
const chrome = {
  en: { open: 'Open menu', close: 'Close menu', dialog: 'Atlas menu', main: 'Main navigation', categories: 'Tool categories', reference: 'Reference data', diagnostics: 'Diagnostics', diagnosticsHelper: 'Look up OBD-II codes and next checks' },
  de: { open: 'Menü öffnen', close: 'Menü schließen', dialog: 'Atlas-Menü', main: 'Hauptnavigation', categories: 'Werkzeugkategorien', reference: 'Referenzdaten', diagnostics: 'Diagnose (Englisch)', diagnosticsHelper: 'OBD-II-Fehlercodes nachschlagen' },
  es: { open: 'Abrir menú', close: 'Cerrar menú', dialog: 'Menú de Atlas', main: 'Navegación principal', categories: 'Categorías de herramientas', reference: 'Datos de referencia', diagnostics: 'Diagnóstico (inglés)', diagnosticsHelper: 'Consultar códigos OBD-II' },
  fr: { open: 'Ouvrir le menu', close: 'Fermer le menu', dialog: 'Menu Atlas', main: 'Navigation principale', categories: 'Catégories d’outils', reference: 'Données de référence', diagnostics: 'Diagnostic (anglais)', diagnosticsHelper: 'Consulter les codes OBD-II' },
}[entityLocale];
const FR_CATEGORY_LABELS: Readonly<Record<ToolCategory, string>> = { 'Fuel & Trips': 'Carburant et trajets', 'Tires & Wheels': 'Pneus et jantes', Converters: 'Convertisseurs', Performance: 'Performances' };
const categoryLabels: Readonly<Record<ToolCategory, string>> = locale === 'fr'
  ? FR_CATEGORY_LABELS
  : locale
  ? Object.fromEntries(platformCatalog[locale].home.categories.map((c, i) => [TOOL_CATEGORY_ORDER[i], c.name])) as Record<ToolCategory, string>
  : FALLBACK_CATEGORY_LABELS;
---
<button class="menu-button" type="button" aria-label={chrome.open} aria-controls="navigation-drawer" aria-expanded="false" data-menu-open><span></span><span></span><span></span></button>
<dialog id="navigation-drawer" class="drawer-layer" data-drawer-layer aria-label={chrome.dialog}>
  <div class="navigation-drawer">
    <div class="drawer-shell">
      <header><a href={homeHref} class="drawer-home"><span>ATLAS</span><small>GarageOS</small></a><button class="drawer-close" type="button" aria-label={chrome.close} data-menu-close>×</button></header>
      <div class="drawer-grid">
        <nav class="drawer-primary" aria-label={chrome.main}>
          <p>{t?.goStraightTo ?? 'GO STRAIGHT TO'}</p>
          <a href={homeHref}><strong>{t?.navHome ?? 'Home'}</strong><span>{t?.navHomeHelper ?? 'Pick a job and get an answer'}</span><i>01</i></a>
          <a href={`${prefix}/tools/`}><strong>{t?.allToolsTitle ?? 'All automotive tools'}</strong><span>{t?.allToolsHelper ?? 'Browse every calculator and converter'}</span><i>02</i></a>
          <a href="/obd-codes/" hreflang={locale ? 'en' : undefined}><strong>{chrome.diagnostics}</strong><span>{chrome.diagnosticsHelper}</span><i>03</i></a>
          <a href={`${prefix}/fitment-studio/`}><strong>{t?.navFitment ?? 'Wheel & Tire Compare'}</strong><span>{t?.fitmentHelper ?? 'Compare two setups visually'}</span><i>04</i></a>
          <a href={`${prefix}/fitment-studio/#garage`}><strong>{t?.navGarage ?? 'My Garage'}</strong><span>{t?.garageHelper ?? 'Your vehicles and saved setups'}</span><i>05</i></a>
        </nav>
        <div class="drawer-secondary"><nav aria-label={chrome.categories}><p>{t?.toolsByJob ?? 'TOOLS BY JOB'}</p><a href={`${prefix}/tools/?category=Fuel%20%26%20Trips`}>{categoryLabels['Fuel & Trips']} <span>›</span></a><a href={`${prefix}/tools/?category=Tires%20%26%20Wheels`}>{categoryLabels['Tires & Wheels']} <span>›</span></a><a href={`${prefix}/tools/?category=Converters`}>{categoryLabels.Converters} <span>›</span></a><a href={`${prefix}/tools/?category=Performance`}>{categoryLabels.Performance} <span>›</span></a></nav><nav aria-label={chrome.reference}><p>{refCopy.group}</p>{reference.map((link) => <a href={link.href}>{link.title} <span>›</span></a>)}</nav><section class="drawer-settings" aria-labelledby="settings-heading"><p id="settings-heading">{t?.displayLabel ?? 'DISPLAY'}</p><ThemeControl /><a class="drawer-methodology-link" href={`${prefix}/methodology/`}>{t?.footerMethodology ?? 'Accuracy & methodology'} <span>›</span></a><div class="language-setting language-setting--switcher"><span>{t?.langLabel ?? 'Language'}</span><div class="language-options" role="group" aria-label={t?.langSwitchAria ?? 'Switch language'}>{links.map((link) => <a href={link.href} class:list={['language-option', { 'is-active': link.code === (locale ?? 'en') }]} aria-current={link.code === (locale ?? 'en') ? 'true' : undefined}>{link.label}</a>)}</div></div></section></div>
      </div>
    </div>
  </div>
</dialog>
<script>import { initializeNavigationDrawer } from '../ui/navigation-drawer'; initializeNavigationDrawer();</script>

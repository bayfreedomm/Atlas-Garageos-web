---
import type { ToolDefinition } from '../seo/tool-registry';
import { canonicalForPath, routeForTool, SITE_ORIGIN, toolById } from '../seo/tool-registry';
import '../styles/global.css';

interface Props { definition: ToolDefinition; active?: 'fitment' | 'tools'; }
const { definition, active = definition.kind === 'flagship' ? 'fitment' : 'tools' } = Astro.props;
const pathname = routeForTool(definition);
const canonical = canonicalForPath(pathname);
const websiteJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Atlas GarageOS', url: SITE_ORIGIN });
const breadcrumbJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: definition.kind === 'flagship'
  ? [{ '@type': 'ListItem', position: 1, name: definition.title, item: canonical }]
  : [{ '@type': 'ListItem', position: 1, name: 'Fitment Studio', item: canonicalForPath('/en/fitment-studio/') }, { '@type': 'ListItem', position: 2, name: definition.title, item: canonical }]
});
---
<!doctype html>
<html lang={definition.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={definition.description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonicalForPath('/')} />
    <script is:inline type="application/ld+json" set:html={websiteJsonLd}></script>
    <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd}></script>
    <title>{definition.title} — Atlas GarageOS</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="app-header"><div class="app-header__inner">
      <a class="brand" href={routeForTool(toolById('fitment-studio'))} aria-label="Atlas GarageOS home"><span class="brand-mark" aria-hidden="true">AG</span><span class="brand-copy"><strong>Atlas GarageOS</strong><span>Automotive tools</span></span></a>
      <nav class="desktop-nav" aria-label="Primary navigation"><a href="/en/fitment-studio/#garage">Garage</a><a href="/en/fitment-studio/" aria-current={active === 'fitment' ? 'page' : undefined}>Fitment</a><a href="/en/tools/tire-size-calculator/" aria-current={active === 'tools' ? 'page' : undefined}>Tools</a></nav>
      <span class="locale-chip">EN</span>
    </div></header>
    <main id="main-content"><slot /></main>
    <nav class="bottom-nav" aria-label="Mobile navigation"><a href="/en/fitment-studio/#garage">Garage</a><a href="/en/fitment-studio/" aria-current={active === 'fitment' ? 'page' : undefined}>Fitment</a><a href="/en/tools/tire-size-calculator/" aria-current={active === 'tools' ? 'page' : undefined}>Tools</a></nav>
  </body>
</html>

---
import type { ToolDefinition } from '../seo/tool-registry';
import { canonicalForPath, routeForTool, SITE_ORIGIN } from '../seo/tool-registry';
import { serializeJsonLd } from '../seo/safe-json-ld';
import { chromeHtmlLang, chromePrefix, chromeStrings, type ChromeLocale } from '../localization/site-catalog';
import { REFERENCE_LOCALE_META, REFERENCE_LOCALES, isReferenceLocale } from '../localization/reference-locales';
import { referenceChromeText } from '../content/reference-locale-text';
import { entityHubPath } from '../seo/entity-routes';
import type { AtlasLocale } from '../localization/locales';
import type { PageImage } from '../seo/entity-images';
import Brand from './Brand.astro';
import ThemeBoot from './ThemeBoot.astro';
import NavigationDrawer from './NavigationDrawer.astro';
import Footer from './Footer.astro';
import ThemeQuickToggle from './ThemeQuickToggle.astro';
import LanguageQuickToggle from './LanguageQuickToggle.astro';
import '../styles/global.css';
import '../styles/product-v3.css';
import '../styles/product-v4.css';

interface Breadcrumb { readonly name: string; readonly href: string; }
interface HreflangAlternate { readonly hreflang: string; readonly href: string; }
interface Props { definition?: ToolDefinition; title?: string; description?: string; pathname?: string | undefined; active?: 'home' | 'garage' | 'fitment' | 'tools' | 'diagnostics'; breadcrumbs?: readonly Breadcrumb[]; locale?: ChromeLocale | undefined; alternates?: readonly HreflangAlternate[] | undefined; image?: PageImage | undefined; }
const props = Astro.props;
const definition = props.definition;
const title = props.title ?? definition?.title;
const description = props.description ?? definition?.description;
const pathname = props.pathname ?? (definition ? routeForTool(definition) : undefined);
if (!title || !description || !pathname) throw new Error('SiteLayout requires definition or explicit page metadata.');
const active = props.active ?? (definition?.kind === 'flagship' ? 'fitment' : definition ? 'tools' : undefined);
const canonical = canonicalForPath(pathname);
const locale = props.locale;
const t = chromeStrings(locale);
const prefix = chromePrefix(locale);
const homeHref = locale ? `/${locale}/` : '/';
const htmlLang = locale ? chromeHtmlLang(locale) : definition?.locale ?? 'en';
const alternates = props.alternates ?? [{ hreflang: 'en', href: canonical }, { hreflang: 'x-default', href: canonical }];
// Keyed by hreflang value; reference locales come from their registry.
const LOCALE_SHORT_LABELS: Readonly<Record<string, string>> = { en: 'EN', de: 'DE', es: 'ES', ...Object.fromEntries(REFERENCE_LOCALES.map((code) => [REFERENCE_LOCALE_META[code].hreflang, REFERENCE_LOCALE_META[code].short])) };
const LOCALE_FULL_LABELS: Readonly<Record<string, string>> = { en: 'English', de: 'Deutsch', es: 'Español', ...Object.fromEntries(REFERENCE_LOCALES.map((code) => [REFERENCE_LOCALE_META[code].hreflang, REFERENCE_LOCALE_META[code].full])) };
const HREFLANG_TO_CODE: Readonly<Record<string, string>> = { en: 'en', de: 'de', es: 'es', ...Object.fromEntries(REFERENCE_LOCALES.map((code) => [REFERENCE_LOCALE_META[code].hreflang, code])) };
// Every language is always offered: a language without a translation of this exact page links
// to its own home page. Only the page's real translations are emitted as hreflang alternates.
const ALL_LOCALE_HOMES: readonly { readonly hreflang: string; readonly href: string }[] = [
  { hreflang: 'en', href: 'https://atlasgarageos.com/' },
  { hreflang: 'de', href: 'https://atlasgarageos.com/de/' },
  { hreflang: 'es', href: 'https://atlasgarageos.com/es/' },
  ...REFERENCE_LOCALES.map((code) => ({ hreflang: REFERENCE_LOCALE_META[code].hreflang, href: `https://atlasgarageos.com/${code}/` })),
];
const pageAlternates = alternates.filter((alt) => alt.hreflang !== 'x-default' && alt.hreflang in LOCALE_SHORT_LABELS);
const publishedLocaleAlternates = [...pageAlternates, ...ALL_LOCALE_HOMES.filter((home) => !pageAlternates.some((alt) => alt.hreflang === home.hreflang))]
  .sort((a, b) => ALL_LOCALE_HOMES.findIndex((h) => h.hreflang === a.hreflang) - ALL_LOCALE_HOMES.findIndex((h) => h.hreflang === b.hreflang));
const headerLocaleLinks = publishedLocaleAlternates.map((alt) => ({ code: alt.hreflang, label: LOCALE_SHORT_LABELS[alt.hreflang]!, href: alt.href }));
const drawerLocaleLinks = publishedLocaleAlternates.map((alt) => ({ code: HREFLANG_TO_CODE[alt.hreflang] ?? alt.hreflang, label: LOCALE_FULL_LABELS[alt.hreflang]!, href: alt.href }));
const refChrome = isReferenceLocale(locale) ? referenceChromeText[locale] : undefined;
const navTiresHref = entityHubPath('tire-size', locale ?? 'en');
const NAV_TIRES_LABELS: Readonly<Record<AtlasLocale, string>> = { en: 'Tire sizes', de: 'Reifengrößen', es: 'Medidas', fr: 'Dimensions de pneus', it: 'Misure pneumatici', 'pt-br': 'Medidas de pneus', pl: 'Rozmiary opon', nl: 'Bandenmaten', tr: 'Lastik ebatları' };
const NAV_OBD_LABELS: Readonly<Record<AtlasLocale, string>> = { en: 'Diagnostics', de: 'OBD (Englisch)', es: 'OBD (inglés)', fr: 'OBD (anglais)', it: 'OBD (inglese)', 'pt-br': 'OBD (inglês)', pl: 'OBD (ang.)', nl: 'OBD (Engels)', tr: 'OBD (İngilizce)' };
const navTiresLabel = refChrome?.navTires ?? NAV_TIRES_LABELS[locale ?? 'en'];
const navObdLabel = refChrome?.navObd ?? NAV_OBD_LABELS[locale ?? 'en'];
const websiteJsonLd = serializeJsonLd({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Atlas GarageOS', url: SITE_ORIGIN });
const applicationJsonLd = definition && definition.kind === 'tool' ? serializeJsonLd({ '@context': 'https://schema.org', '@type': 'WebApplication', name: definition.title, description, url: canonical, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', browserRequirements: 'Requires a modern web browser', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } }) : undefined;
const breadcrumbs = props.breadcrumbs ?? (definition?.kind === 'flagship'
  ? [{ name: definition.title, href: pathname }]
  : definition ? [{ name: 'Home', href: '/' }, { name: 'Tools', href: '/tools/' }, { name: definition.title, href: pathname }] : [{ name: title, href: pathname }]);
// Page-specific image (reference pages): the same file is the visible <img>, og:image,
// twitter:image and primaryImageOfPage. Other pages keep the brand image for social cards only.
const pageImage = props.image;
const shareImage = pageImage
  ? { url: canonicalForPath(pageImage.src), width: pageImage.width, height: pageImage.height, alt: pageImage.alt }
  : { url: `${SITE_ORIGIN}/atlas-hero-car.png`, width: 1672, height: 941, alt: 'Atlas GarageOS' };
const webPageJsonLd = pageImage ? serializeJsonLd({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: canonical, primaryImageOfPage: { '@type': 'ImageObject', url: shareImage.url, width: shareImage.width, height: shareImage.height, caption: shareImage.alt } }) : undefined;
const breadcrumbJsonLd = serializeJsonLd({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: canonicalForPath(item.href) })) });
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <ThemeBoot />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Atlas GarageOS" />
    <meta property="og:title" content={title === 'Atlas GarageOS' ? title : `${title} — Atlas GarageOS`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage.url} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title === 'Atlas GarageOS' ? title : `${title} — Atlas GarageOS`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage.url} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="icon" href="/atlas-mark.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f7f8f5" />
    <script is:inline type="application/ld+json" set:html={websiteJsonLd}></script>
    <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd}></script>
    {webPageJsonLd && <script is:inline type="application/ld+json" set:html={webPageJsonLd}></script>}
    {applicationJsonLd && <script is:inline type="application/ld+json" set:html={applicationJsonLd}></script>}
    <title>{title === 'Atlas GarageOS' ? title : `${title} — Atlas GarageOS`}</title>
  </head>
  <body class={active === 'home' ? 'page-home' : undefined}>
    <a class="skip-link" href="#main-content">{t?.skipToContent ?? 'Skip to main content'}</a>
    <header class="app-header"><div class="app-header__inner">
      <a class="brand" href={homeHref} aria-label="Atlas GarageOS home"><Brand /></a>
      <div class="app-header__actions">
        <nav class="desktop-nav" aria-label="Primary navigation"><a href={homeHref} aria-current={active === 'home' ? 'page' : undefined}>{t?.navHome ?? 'Home'}</a><a href={`${prefix}/tools/`} aria-current={active === 'tools' ? 'page' : undefined}>{t?.navTools ?? 'Tools'}</a><a href={navTiresHref}>{navTiresLabel}</a><a href="/obd-codes/" aria-current={active === 'diagnostics' ? 'page' : undefined}>{navObdLabel}</a><a href={`${prefix}/fitment-studio/`} aria-current={active === 'fitment' ? 'page' : undefined}>{t?.navFitment ?? 'Wheel & Tire Compare'}</a><a href={`${prefix}/fitment-studio/#garage`} aria-current={active === 'garage' ? 'page' : undefined}>{t?.navGarage ?? 'My Garage'}</a></nav>
        <LanguageQuickToggle links={headerLocaleLinks} current={htmlLang} />
        <ThemeQuickToggle />
        <NavigationDrawer locale={locale} localeLinks={drawerLocaleLinks} />
      </div>
    </div></header>
    <main id="main-content"><slot /></main>
    <Footer locale={locale} />
    <script>
      import { enhanceStateLinks } from '../ui/state-link-enhancer';
      enhanceStateLinks();
    </script>
  </body>
</html>

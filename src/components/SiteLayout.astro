---
import type { ToolDefinition } from '../seo/tool-registry';
import { canonicalForPath, routeForTool, SITE_ORIGIN } from '../seo/tool-registry';
import { serializeJsonLd } from '../seo/safe-json-ld';
import { uiStrings, type ContentLocale } from '../localization/site-catalog';
import Brand from './Brand.astro';
import ThemeBoot from './ThemeBoot.astro';
import NavigationDrawer from './NavigationDrawer.astro';
import Footer from './Footer.astro';
import ThemeQuickToggle from './ThemeQuickToggle.astro';
import LanguageQuickToggle from './LanguageQuickToggle.astro';
import '../styles/global.css';
import '../styles/product-v3.css';
import '../styles/product-v4.css';

interface Breadcrumb { readonly name: string; readonly href: string; }
interface HreflangAlternate { readonly hreflang: string; readonly href: string; }
interface Props { definition?: ToolDefinition; title?: string; description?: string; pathname?: string | undefined; active?: 'home' | 'garage' | 'fitment' | 'tools'; breadcrumbs?: readonly Breadcrumb[]; locale?: ContentLocale | undefined; alternates?: readonly HreflangAlternate[] | undefined; }
const props = Astro.props;
const definition = props.definition;
const title = props.title ?? definition?.title;
const description = props.description ?? definition?.description;
const pathname = props.pathname ?? (definition ? routeForTool(definition) : undefined);
if (!title || !description || !pathname) throw new Error('SiteLayout requires definition or explicit page metadata.');
const active = props.active ?? (definition?.kind === 'flagship' ? 'fitment' : definition ? 'tools' : undefined);
const canonical = canonicalForPath(pathname);
const locale = props.locale;
const t = locale ? uiStrings[locale] : undefined;
const htmlLang = locale ?? definition?.locale ?? 'en';
const alternates = props.alternates ?? [{ hreflang: 'en', href: canonical }, { hreflang: 'x-default', href: canonical }];
const LOCALE_SHORT_LABELS: Readonly<Record<string, string>> = { en: 'EN', de: 'DE', es: 'ES' };
const LOCALE_FULL_LABELS: Readonly<Record<string, string>> = { en: 'English', de: 'Deutsch', es: 'Español' };
const publishedLocaleAlternates = alternates.filter((alt) => alt.hreflang !== 'x-default' && alt.hreflang in LOCALE_SHORT_LABELS);
const headerLocaleLinks = publishedLocaleAlternates.map((alt) => ({ code: alt.hreflang as 'en' | 'de' | 'es', label: LOCALE_SHORT_LABELS[alt.hreflang]!, href: alt.href }));
const drawerLocaleLinks = publishedLocaleAlternates.map((alt) => ({ code: alt.hreflang as 'en' | 'de' | 'es', label: LOCALE_FULL_LABELS[alt.hreflang]!, href: alt.href }));
const websiteJsonLd = serializeJsonLd({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Atlas GarageOS', url: SITE_ORIGIN });
const applicationJsonLd = definition && definition.kind === 'tool' ? serializeJsonLd({ '@context': 'https://schema.org', '@type': 'WebApplication', name: definition.title, description, url: canonical, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', browserRequirements: 'Requires a modern web browser', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } }) : undefined;
const breadcrumbs = props.breadcrumbs ?? (definition?.kind === 'flagship'
  ? [{ name: definition.title, href: pathname }]
  : definition ? [{ name: 'Home', href: '/' }, { name: 'Tools', href: '/tools/' }, { name: definition.title, href: pathname }] : [{ name: title, href: pathname }]);
const breadcrumbJsonLd = serializeJsonLd({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: canonicalForPath(item.href) })) });
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <ThemeBoot />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Atlas GarageOS" />
    <meta property="og:title" content={title === 'Atlas GarageOS' ? title : `${title} — Atlas GarageOS`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_ORIGIN}/atlas-hero-car.png`} />
    <meta property="og:image:width" content="1672" />
    <meta property="og:image:height" content="941" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title === 'Atlas GarageOS' ? title : `${title} — Atlas GarageOS`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_ORIGIN}/atlas-hero-car.png`} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="icon" href="/atlas-mark.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f7f8f5" />
    <script is:inline type="application/ld+json" set:html={websiteJsonLd}></script>
    <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd}></script>
    {applicationJsonLd && <script is:inline type="application/ld+json" set:html={applicationJsonLd}></script>}
    <title>{title === 'Atlas GarageOS' ? title : `${title} — Atlas GarageOS`}</title>
  </head>
  <body class={active === 'home' ? 'page-home' : undefined}>
    <a class="skip-link" href="#main-content">{t?.skipToContent ?? 'Skip to main content'}</a>
    <header class="app-header"><div class="app-header__inner">
      <a class="brand" href={locale ? `/${locale}/` : '/'} aria-label="Atlas GarageOS home"><Brand /></a>
      <div class="app-header__actions">
        <nav class="desktop-nav" aria-label="Primary navigation"><a href={locale ? `/${locale}/` : '/'} aria-current={active === 'home' ? 'page' : undefined}>{t?.navHome ?? 'Home'}</a><a href={locale ? `/${locale}/tools/` : '/tools/'} aria-current={active === 'tools' ? 'page' : undefined}>{t?.navTools ?? 'Tools'}</a><a href={locale ? `/${locale}/fitment-studio/` : '/fitment-studio/'} aria-current={active === 'fitment' ? 'page' : undefined}>{t?.navFitment ?? 'Wheel & Tire Compare'}</a><a href={locale ? `/${locale}/fitment-studio/#garage` : '/fitment-studio/#garage'} aria-current={active === 'garage' ? 'page' : undefined}>{t?.navGarage ?? 'My Garage'}</a></nav>
        <LanguageQuickToggle links={headerLocaleLinks} current={htmlLang} />
        <ThemeQuickToggle />
        <NavigationDrawer locale={locale} localeLinks={drawerLocaleLinks} />
      </div>
    </div></header>
    <main id="main-content"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>

---
import { tool3DText, type Additional3DToolId, type Tool3DLocale } from '../localization/tool-3d-catalog';
interface Props { id: Additional3DToolId; locale: Tool3DLocale; }
const { id, locale } = Astro.props;
const t = tool3DText(locale, id);
---
<section class="parametric-3d tool-3d-expansion" data-tool-3d={id} data-tool-3d-locale={locale} aria-label={t.title}>
  <header class="parametric-3d__head"><div><span>{t.badge}</span><h3>{t.title}</h3><p>{t.intro}</p></div><p class="parametric-3d__hint">{t.hint}</p></header>
  <div class="parametric-3d__stage">
    <canvas data-tool-3d-canvas width="960" height="600"></canvas>
    <div class="parametric-3d__annotations" data-p3d-annotations aria-hidden="true"></div>
    <div class="parametric-3d__hud" aria-live="polite"><small>{t.badge}</small><div><span data-tool-3d-detail>—</span><strong data-tool-3d-readout>—</strong></div></div>
    <div class="parametric-3d__loading" data-tool-3d-loading>{t.hint}</div>
    <div class="parametric-3d__fallback" data-tool-3d-fallback hidden>{t.fallback}</div>
  </div>
  <div class="parametric-3d__controls"><button type="button" data-tool-3d-zoom-out aria-label={locale === 'de' ? 'Verkleinern' : locale === 'es' ? 'Alejar' : 'Zoom out'}>−</button><button type="button" data-tool-3d-reset>{t.reset}</button><button type="button" data-tool-3d-zoom-in aria-label={locale === 'de' ? 'Vergrößern' : locale === 'es' ? 'Acercar' : 'Zoom in'}>+</button></div>
  <p class="parametric-3d__caution">{t.caution}</p>
</section>
<script>
  const pending = new WeakSet<HTMLElement>();
  const load = async (panel: HTMLElement) => {
    if (pending.has(panel) || panel.classList.contains('is-ready')) return;
    pending.add(panel);
    try { const module = await import('../ui/tool-3d'); await module.mountTool3D(panel); }
    finally { pending.delete(panel); }
  };
  document.querySelectorAll<HTMLElement>('[data-tool-3d]').forEach((panel) => {
    if (!('IntersectionObserver' in window)) { void load(panel); return; }
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect(); void load(panel);
    }, { rootMargin: '0px 0px 80px' });
    observer.observe(panel);
  });
</script>
